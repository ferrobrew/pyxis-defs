        /// device exists and `0` otherwise.
        #[index(43)]
        pub fn SetMouseCursorCount(&mut self, count: u32);

        /// Returns the movie's memory heap, [`pHeap`](Self::pHeap).
        #[index(48)]
        pub fn GetHeap(&self) -> *mut MemoryHeap;
    },

    /// The AS3 `MovieRoot` (the [`Movie`] interface): SetVariable, Invoke, and the display tree.
    #[address(0x18)]
    pub pASMovieRoot: *mut Movie,

    /// The `GFx::Value::ObjectInterface` for this movie: the dispatcher every `GFx::Value`
    /// display-object/member operation goes through.
    #[address(0x38)]
    pub pObjectInterface: *mut void,

    /// The Scaleform [`MemoryHeap`] the movie allocates from.
    #[address(0x40)]
    pub pHeap: *mut MemoryHeap,

    /// The main `MovieDefImpl`. [`UpdateViewport`](Self::UpdateViewport) reads the stage
    /// frame rectangle (twips) through it; while null, the view scale and offset reset to
    /// identity.
    #[address(0x48)]
    pub pMainMovieDef: *mut void,

    /// The root `DisplayObjContainer` (the main movie clip).
    #[address(0x50)]
    pub pMainMovie: *mut void,

    /// The movie's render-tree root ([`TreeRoot`]): the entry `CUIManager::Render` draws via the
    /// display handle. The whole display tree's render nodes hang off it.
    #[address(0x88)]
    pub pRenderRoot: *mut TreeRoot,

    /// The movie's current [`Viewport`], as last copied in by
    /// [`SetViewportImpl`](Self::SetViewportImpl). [`TreeRoot::SetViewport`] takes it
    /// directly (copying the `Render::Viewport` prefix).
    #[address(0xA0)]
    pub Viewport: Viewport,

    /// The larger of `1 / ViewScaleX` and `1 / ViewScaleY`, recomputed by
    /// [`UpdateViewport`](Self::UpdateViewport) (0.005 when a scale is zero).
    #[address(0xD4)]
    pub PixelScale: f32,

    /// The stage-pixel to view-rectangle-pixel scale on X, derived from
    /// [`ViewScaleMode`](Self::ViewScaleMode) by [`UpdateViewport`](Self::UpdateViewport)
    /// (for `SM_SHOW_ALL`/`SM_NO_BORDER`, the visible-frame to view-rectangle ratio).
    #[address(0xD8)]
    pub ViewScaleX: f32,

    /// See [`ViewScaleX`](Self::ViewScaleX).
    #[address(0xDC)]
    pub ViewScaleY: f32,

    /// [`VisibleFrameRect`](Self::VisibleFrameRect) `x1` in stage pixels (`x1 / 20`).
    #[address(0xE0)]
    pub ViewOffsetX: f32,

    /// [`VisibleFrameRect`](Self::VisibleFrameRect) `y1` in stage pixels (`y1 / 20`).
    #[address(0xE4)]
    pub ViewOffsetY: f32,

    /// The `SM_*` stage scale mode. Constructed as [`SM_SHOW_ALL`](Self::SM_SHOW_ALL); the
    /// engine never changes it on the main UI movie (`CRenderToTextureUI`/`CDynUI` set it on
    /// their own movies).
    #[address(0xE8)]
    pub ViewScaleMode: u32,

    /// The `Align_*` stage alignment used by the `SM_NO_SCALE` mode. Constructed as
    /// [`ALIGN_CENTER`](Self::ALIGN_CENTER).
    #[address(0xEC)]
    pub ViewAlignment: u32,

    /// The stage region mapped onto the view rectangle, in twips (`x1, y1, x2, y2`), computed by
    /// [`UpdateViewport`](Self::UpdateViewport) from the [`Viewport`](Self::Viewport),
    /// the stage frame rectangle, and the [`ViewScaleMode`](Self::ViewScaleMode). Under
    /// `SM_SHOW_ALL` with a view rectangle matching the stage aspect, this is the whole stage.
    #[address(0xF0)]
    pub VisibleFrameRect: [f32; 4],

    /// The stage-to-viewport matrix (`Matrix2x4<float>`, rows `[sx, shx, shy, tx]` and
    /// `[shx, sy, shy, ty]`; in practice `sx` at `[0]`, `tx` at `[3]`, `sy` at `[5]`, and `ty` at
    /// `[7]`) the movie sets on [`pRenderRoot`](Self::pRenderRoot) via `TreeNode::SetMatrix`
    /// whenever the viewport changes. Built by
    /// [`ResetViewportMatrix`](Self::ResetViewportMatrix) as `sx = Viewport.Width /
    /// (VisibleFrameRect.x2 - VisibleFrameRect.x1)`, `tx = -VisibleFrameRect.x1 * sx` (and
    /// likewise for Y), mapping stage twips to pixels relative to the view rectangle's top-left
    /// corner -- `Viewport.Left`/`Top` are *not* part of the matrix.
    ///
    /// This same matrix, inverted, is the entire mouse-to-stage transform:
    /// [`HandleEvent`](Self::HandleEvent) and
    /// [`NotifyMouseState`](Self::NotifyMouseState) run incoming positions through
    /// `TransformByInverse` before queueing, so mouse coordinates are expected in view-rectangle
    /// pixels (`stage_twips = (pos - t) / s` per axis).
    #[address(0x110)]
    pub ViewportMatrix: [f32; 8],

    /// The tracked mice ([`MouseState`] per index; the engine's main UI movie uses only index
    /// 0). The array ends exactly at [`MouseCursorCount`](Self::MouseCursorCount).
    #[address(0x2_210)]
    pub MouseStates: [MouseState; 6],

    /// The number of mouse cursors the movie tracks (see
    /// [`SetMouseCursorCount`](Self::SetMouseCursorCount)); mouse input with an index at or
    /// beyond it is dropped.
    #[address(0x2_3F0)]
    pub MouseCursorCount: u32,

    /// The movie's `FLAG_*` state bits (`MovieImpl::Flags`), among them
    /// [`FLAG_NEED_MOUSE_UPDATE`](Self::FLAG_NEED_MOUSE_UPDATE).
    #[address(0x5_2F0)]
    pub Flags: u32,

    /// The movie's embedded `Render::Context` (the snapshot pipeline: active/pending/displaying
    /// snapshots, the capture locks, and the once-a-frame consumption latch).
    #[address(0x5_350)]
    pub RenderContext: RenderContext,
}
impl MovieImpl {
    /// The concrete implementation behind the [`Capture`](Self::Capture) virtual: gates on `Context::HasChanges` when `if_changed` is set, suspends the GC, and
    /// runs `Render::Context::Capture` to publish the frame's display-tree changes as the pending
    /// snapshot. `CUIManager::PreRender` calls it right after `Advance`, on the game update
    /// thread with the deferred render lock held -- the only point in the frame where every
    /// display-tree writer is quiescent.
    #[address(0x141_98B_7D0)]
    pub fn CaptureImpl(&mut self, if_changed: bool) -> u64;

    /// The concrete implementation behind [`HandleEvent`](Self::HandleEvent). For mouse move/down/up/wheel events it transforms the event's position by the
    /// inverse of [`ViewportMatrix`](Self::ViewportMatrix) (view-rectangle pixels to stage
    /// twips) and queues the result on the input-events queue; nothing is stored raw. The next
    /// `Advance` drains the queue into AS3 mouse processing.
    #[address(0x141_983_0D0)]
    pub fn HandleEventImpl(&mut self, event: *const MouseEvent) -> u32;

    /// The concrete implementation behind [`NotifyMouseState`](Self::NotifyMouseState). Transforms `(x, y)` by the inverse of
    /// [`ViewportMatrix`](Self::ViewportMatrix), queues a mouse move at the resulting stage
    /// position (twips), then diffs `buttons` against the tracked per-mouse button state and
    /// queues a button event per changed bit.
    #[address(0x141_983_830)]
    pub fn NotifyMouseStateImpl(&mut self, x: f32, y: f32, buttons: u32, mouse_index: u32);

    /// The concrete implementation behind the `SetViewport` virtual. When `desc` differs from
    /// [`Viewport`](Self::Viewport) (a memcmp over the whole [`Viewport`]), copies
    /// it in, runs [`UpdateViewport`](Self::UpdateViewport), and pushes the new state to the
    /// render tree ([`TreeRoot::SetViewport`], background color, and `TreeNode::SetMatrix` with
    /// [`ViewportMatrix`](Self::ViewportMatrix) on [`pRenderRoot`](Self::pRenderRoot)).
    #[address(0x141_98E_4F0)]
    pub fn SetViewportImpl(&mut self, desc: *const Viewport);

    /// Recomputes [`VisibleFrameRect`](Self::VisibleFrameRect), the view scales and offsets,
    /// and [`PixelScale`](Self::PixelScale) from [`Viewport`](Self::Viewport), the
    /// stage frame rectangle, and [`ViewScaleMode`](Self::ViewScaleMode), then calls
    /// [`ResetViewportMatrix`](Self::ResetViewportMatrix). Called only from
    /// [`SetViewportImpl`](Self::SetViewportImpl); nothing engine-side recomputes the
    /// viewport per frame.
    #[address(0x141_98A_CC0)]
    pub fn UpdateViewport(&mut self);

    /// Rebuilds [`ViewportMatrix`](Self::ViewportMatrix) from
    /// [`Viewport`](Self::Viewport) `Width`/`Height` and
    /// [`VisibleFrameRect`](Self::VisibleFrameRect) (see the matrix field for the formula).
    /// Does not push the matrix to the render tree.
    #[address(0x141_987_380)]
    pub fn ResetViewportMatrix(&mut self);

    /// Drains the input-events queue during `Advance`: keyboard entries go to focus handling,
    /// mouse entries to `ProcessMouse` (which runs `MouseState::UpdateState` and hit-tests the
    /// display tree at the entry's stage-twips position). Afterwards, for any tracked mouse that
    /// saw no entry this drain while [`FLAG_NEED_MOUSE_UPDATE`](Self::FLAG_NEED_MOUSE_UPDATE) is
    /// set and the mouse is [`FLAG_ACTIVATED`](MouseState::FLAG_ACTIVATED), re-resolves the hover
    /// target from [`MouseState::LastPosition`].
    #[address(0x141_994_890)]
    pub fn ProcessInput(&mut self);

    /// The concrete implementation behind [`GetMouseState`](Self::GetMouseState).
    #[address(0x141_983_920)]
    pub fn GetMouseStateImpl(&mut self, mouse_index: u32, x: *mut f32, y: *mut f32, buttons: *mut u32);

    /// The concrete implementation behind [`HitTest`](Self::HitTest).
    #[address(0x141_983_9A0)]
    pub fn HitTestImpl(&mut self, x: f32, y: f32, test_cond: u32, controller_idx: u32) -> bool;
}

/// A Scaleform [`MemoryHeap`]. Opaque apart from its vtable, through which allocation goes.
#[min_size(8)]
pub type MemoryHeap {
    vftable {
        /// Allocates `size` bytes from the heap.
        #[index(10)]
        pub fn Alloc(&mut self, size: u64) -> *mut void;
    },
}

/// The Scaleform `Render::D3D1x::HAL` behind `CUIManager::m_RenderHAL`: the D3D11 rendering
/// backend the UI render worker draws through.
#[min_size(0x473B8)]
pub type RenderHAL {
    vftable {
        /// Binds `target` as the frame's display render target. `CUIManager::Render`
        /// calls it with `m_RenderBuffer` before `BeginFrame`, paired with a trailing
        /// [`PopRenderTarget`](Self::PopRenderTarget).
        #[index(3)]
        pub fn SetRenderTarget(&mut self, target: *mut RenderTarget, set_state: bool);

        /// Pushes `target` for nested rendering within a frame, as
        /// `RenderOffScreenTextures` does per off-screen movie. `frame_rect` is `[x0, y0, x1,
        /// y1]` floats; `clear_color` points at a packed color (0 = transparent).
        #[index(4)]
        pub fn PushRenderTarget(&mut self, target: *mut RenderTarget, flags: u64, frame_rect: *const f32, clear_color: *const u32);

        /// Pops the pushed (or set) render target.
        #[index(5)]
        pub fn PopRenderTarget(&mut self, flags: u32);

        /// Begins the HAL frame. `EndFrame` clears every context's once-a-frame
        /// consumption latch via `EndFrameContextNotify`.
        #[index(11)]
        pub fn BeginFrame(&mut self) -> bool;

        /// Ends the HAL frame.
        #[index(12)]
        pub fn EndFrame(&mut self);

        /// Begins a scene (draw batch) within the frame.
        #[index(15)]
        pub fn BeginScene(&mut self) -> bool;

        /// Ends the scene.
        #[index(16)]
        pub fn EndScene(&mut self);

        /// The HAL's `Render::ContextImpl::RenderNotify`, passed to
        /// [`RTHandle::NextCapture`].
        #[index(19)]
        pub fn GetContextNotify(&mut self) -> *mut void;
    },

    /// The `ID3D11Device` the HAL was initialized with.
    #[address(0x47_3A8)]
    pub pDevice: *mut void,

    /// The `ID3D11DeviceContext` every HAL draw goes through (possibly a deferred context; see
    /// the HAL's `UsingDeferredContext` flag). Work recorded on it from the UI render worker is
    /// ordered with the HAL's own draws.
    #[address(0x47_3B0)]
    pub pDeviceContext: *mut void,
}
impl RenderHAL {
    /// Builds a [`RenderTarget`] from D3D color/depth views (`ID3D11RenderTargetView*` /
    /// `ID3D11DepthStencilView*`); the concrete implementation behind the `CreateRenderTarget`
    /// virtual.
    /// `RenderOffScreenTextures` creates one per off-screen draw and releases it afterwards.
    /// Render thread only.
    #[address(0x141_DE1_110)]
    pub fn CreateRenderTarget(&mut self, color: *mut void, depth: *mut void) -> *mut RenderTarget;

    /// Draws a [`TreeRoot`]'s displaying-snapshot subtree into the bound target
    /// (`Scaleform::Render::HAL::Draw`). Render thread only, within `BeginFrame`/`BeginScene`.
    #[address(0x141_9B4_850)]
    pub fn Draw(&mut self, root: *mut TreeRoot);
}

/// A Scaleform `GFx::Value`: the tagged union the AS3 interface traffics in. Starts with a
/// `ListNode<Value>` (managed values are tracked on the movie's `ExternalObjRefs` list); a
/// stack-constructed unmanaged value leaves the list pointers and
/// [`pObjectInterface`](Self::pObjectInterface) null.
#[size(0x30)]
pub type Value {
    /// The type tag for a boolean value ([`mValue`](Self::mValue) carries the `bool` in its
    /// first byte).
    pub const VT_BOOLEAN: u32 = 2,
    /// The type tag for an int value.
    pub const VT_INT: u32 = 3,
    /// The type tag for a number (f64) value.
    pub const VT_NUMBER: u32 = 5,
    /// The type tag for a string value (`mValue` is a `*const c_char`).
    pub const VT_STRING: u32 = 6,
    /// The type tag for a display-object value (managed; owned by the movie).
    pub const VT_DISPLAY_OBJECT: u32 = 0xA,
    /// The managed bit: set on values owned by the movie (which must be released through the
    /// object interface, never constructed by hand).
    pub const VTC_MANAGED_BIT: u32 = 0x40,
    /// The mask isolating the base `VT_*` value-type tag in [`Type`](Self::Type) from the `VTC_*`
    /// control bits (the game compares `Type & VT_TYPE_MASK` against the `VT_*` tags).
    pub const VT_TYPE_MASK: u32 = 0x8F,

    /// `ListNode<Value>::pPrev`; null for unmanaged values.
    pub pPrev: *mut Value,
    /// `ListNode<Value>::pNext`; null for unmanaged values.
    pub pNext: *mut Value,
    /// The owning movie's object interface; null for unmanaged values.
    pub pObjectInterface: *mut ValueObjectInterface,
    /// The `ValueType` tag, possibly with `VTC_*` control bits (so not modeled as an enum).
    pub Type: u32,

    /// The value union: `bool` / `i32` / `u32` / `f64` / `*const c_char` / object pointer,
    /// selected by [`Type`](Self::Type).
    #[address(0x20)]
    pub mValue: u64,
    /// Auxiliary data (e.g. the closure's user pointer).
    pub DataAux: u64,
}
#[cfg(backend = "rust")]
impl Value {
    /// The base `VT_*` value-type tag, with the `VTC_*` control bits masked off. The `as_*` accessors
    /// compare it against the `VT_*` tags.
    #[external_body]
    pub fn value_type(&self) -> u32;
}

#[cfg(backend = "rust")]
epilogue for Value r#"
    #[allow(dead_code)]
    impl Value {
        pub fn value_type(&self) -> u32 {
            self.Type & Value::VT_TYPE_MASK
        }

        /// The boolean payload, or `None` if this is not a boolean value.
        pub fn as_bool(&self) -> Option<bool> {
            (self.value_type() == Value::VT_BOOLEAN).then_some(self.mValue & 0xFF != 0)
        }

        /// The 32-bit integer payload, or `None` if this is not an int value.
        pub fn as_int(&self) -> Option<i32> {
            (self.value_type() == Value::VT_INT).then_some(self.mValue as i32)
        }

        /// The `f64` payload, or `None` if this is not a number value.
        pub fn as_number(&self) -> Option<f64> {
            (self.value_type() == Value::VT_NUMBER).then_some(f64::from_bits(self.mValue))
        }

        /// The NUL-terminated string payload, or `None` if this is not a string value.
        pub fn as_string(&self) -> Option<*const ::std::ffi::c_char> {
            (self.value_type() == Value::VT_STRING).then_some(self.mValue as *const ::std::ffi::c_char)
        }

        /// The managed display object payload, or `None` if this is not a display-object value.
        pub fn as_display_object(&self) -> Option<*mut Object> {
            (self.value_type() == Value::VT_DISPLAY_OBJECT).then_some(self.mValue as *mut Object)
        }
    }
"#;

/// The `GFx::Value::ObjectInterface`: the dispatcher for operations on managed values (display
/// objects, arrays). One per movie ([`MovieImpl::pObjectInterface`]); a managed [`Value`] carries
/// its owning interface in [`Value::pObjectInterface`].
#[min_size(1)]
pub type ValueObjectInterface;
impl ValueObjectInterface {
    /// Reads a display object's [`DisplayInfo`] (position, scale, alpha, visibility). `data` is the
    /// value's [`mValue`](Value::mValue) payload. Returns false when the value is not a display
    /// object.
    #[address(0x141_BB8_690)]
    pub fn GetDisplayInfo(&mut self, data: *mut void, info: *mut DisplayInfo) -> bool;

    /// Writes the `DisplayInfo` fields selected by [`DisplayInfo::VarsSet`] directly at the
    /// display-object level -- no AVM path resolution and no AS3 property setters.
    /// `CHUDUI::UpdatePOIs` drives POI positions and visibility through it every frame.
    #[address(0x141_BAE_F00)]
    pub fn SetDisplayInfo(&mut self, data: *mut void, info: *const DisplayInfo) -> bool;

    /// Releases a managed value: unlinks it from the movie's external-references list and drops
    /// the AS3 object reference. Call on the capture thread. `data` is the value's
    /// [`mValue`](Value::mValue) payload.
    #[address(0x141_BC8_D70)]
    pub fn ObjectRelease(&mut self, value: *mut Value, data: *mut void);
}

/// A display object's presentation state, read and written through
/// [`ValueObjectInterface::GetDisplayInfo`] / [`SetDisplayInfo`](ValueObjectInterface::SetDisplayInfo).
/// [`VarsSet`](Self::VarsSet) selects which fields a write applies.
#[defaultable, size(0xE0), align(16)]
pub type DisplayInfo {
    /// The [`VarsSet`](Self::VarsSet) bit selecting [`Visible`](Self::Visible).
    pub const V_VISIBLE: u32 = 0x40,

    pub X: f64,
    pub Y: f64,
    pub Rotation: f64,
    pub XScale: f64,
    pub YScale: f64,
    pub Alpha: f64,
    pub Z: f64,
    pub XRotation: f64,
    pub YRotation: f64,
    pub ZScale: f64,
    pub FOV: f64,

    /// `Render::Matrix3x4<float>` (3D view matrix).
    #[address(0x60)]
    pub ViewMatrix3D: [f32; 12],
    /// `Render::Matrix4x4<float>` (3D projection matrix).
    pub ProjectionMatrix3D: [f32; 16],

    /// `Render::EdgeAAMode`.
    #[address(0xD0)]
    pub EdgeAAMode: u32,
    /// Which fields a [`SetDisplayInfo`](ValueObjectInterface::SetDisplayInfo) call applies
    /// (`V_*` bits, such as [`V_VISIBLE`](Self::V_VISIBLE)).
    pub VarsSet: u16,
    pub Visible: bool,
}

#[cfg(backend = "rust")]
epilogue for Value r#"
    #[allow(dead_code)]
    impl Value {
        /// An unmanaged boolean value, safe to pass to [`SetVariable`](Movie::SetVariable) (the movie copies it;
        /// nothing needs releasing).
        pub fn new_boolean(value: bool) -> Self {
            // SAFETY: all-zero is the unmanaged null value; every field tolerates zero.
            let mut v: Self = unsafe { ::core::mem::zeroed() };
            v.Type = Self::VT_BOOLEAN;
            v.mValue = value as u64;
            v
        }
    }
"#;

/// A node in the display tree returned by [`GetDisplayObjectsTree`](Movie::GetDisplayObjectsTree). Inherits from
/// [`RefCountImpl`] and embeds a `Scaleform::String` for the name and a
/// `Scaleform::ArrayDataBase<Ptr<AmpMovieObjectDesc>>` for children.
///
/// Layout verified from `DisplayObjContainer::GetChildDescTree`.
#[size(0x30)]
pub type AmpMovieObjectDesc {
    #[base]
    pub ref_count_impl: RefCountImpl,

    /// The clip's instance name, or `"Unnamed"`: a `Scaleform::String`, i.e. a pointer to a
    /// [`StringDataDesc`] with heap flags packed into the pointer's low bits (mask off
    /// [`HEAP_FLAGS_MASK`](StringDataDesc::HEAP_FLAGS_MASK)).
    #[address(0x10)]
    pub name: *const u8,

    /// Pointer to the child array. Each element is a `Ptr<AmpMovieObjectDesc>` (a raw pointer
    /// to another [`AmpMovieObjectDesc`]).
    #[address(0x18)]
    pub children: *mut *mut AmpMovieObjectDesc,

    /// Number of children in [`children`](Self::children).
    #[address(0x20)]
    pub child_count: u64,

    /// Allocated capacity of [`children`](Self::children).
    #[address(0x28)]
    pub child_capacity: u64,
}

/// The heap data descriptor behind a `Scaleform::String`: an allocated size and a refcount,
/// followed by the NUL-terminated character data. Reached from the string's pointer after masking
/// off the heap flags ([`HEAP_FLAGS_MASK`](Self::HEAP_FLAGS_MASK)).
#[min_size(0x10)]
pub type StringDataDesc {
    /// The low bits of a `Scaleform::String` pointer that carry heap flags rather than address.
    pub const HEAP_FLAGS_MASK: u64 = 0x7,

    /// The allocated size.
    pub Size: u64,
    /// The reference count.
    pub RefCount: u32,

    /// The first character of the NUL-terminated string data.
    #[address(0xC)]
    pub m_Data: c_char,
}
#[cfg(backend = "rust")]
impl StringDataDesc {
    /// A pointer to the NUL-terminated character data.
    #[external_body]
    pub fn as_ptr(&self) -> *const c_char;
}

#[cfg(backend = "rust")]
epilogue for StringDataDesc r#"
    impl StringDataDesc {
        pub fn as_ptr(&self) -> *const ::std::ffi::c_char {
            ::std::ptr::addr_of!(self.m_Data)
        }
    }
"#;

#[cfg(backend = "rust")]
epilogue for AmpMovieObjectDesc r#"
    #[allow(dead_code)]
    impl AmpMovieObjectDesc {
        /// The instance name's [`StringDataDesc`], with the heap flags masked off the string pointer's
        /// low 3 bits, or `None` if the name is null.
        ///
        /// # Safety
        /// The descriptor must outlive the borrow (true while the node is alive).
        pub unsafe fn name_data(&self) -> Option<&StringDataDesc> {
            unsafe { ((self.name as usize & !7) as *const StringDataDesc).as_ref() }
        }
    }
"#;

/// Static clip names placed on the root timeline of `ui/hud.gfx` via PlaceObject2 tags. The root
/// movie (`ui/root.gfx`) creates its clips entirely through ActionScript, so it has no static
/// PlaceObject2 tags; `hud.gfx` uses a mix of static placement and dynamic creation.
///
/// | Instance name | Depth | Char ID |
/// |---|---|---|
/// | `MCI_hud` | 1432 | 1548 |
/// | `MCI_poi_stage` | 180 | 1066 |
/// | `MCI_weapon_selection_wheel` | 182 | 1078 |
/// | `MCI_safe_area_center` | 1 | 1065 |
/// | `MCI_safe_area_top_left` | 839 | 1538 |
/// | `MCI_safe_area_top_middle` | 636 | 1532 |
/// | `MCI_safe_area_top_right` | 562 | 1395 |
/// | `MCI_safe_area_bottom_left` | 450 | 1330 |
/// | `MCI_safe_area_bottom_middle` | 307 | 1286 |
/// | `MCI_safe_area_bottom_right` | 246 | 1161 |
///
/// UI movie registry from `root.gfx` maps each `CUIBase` subclass to its `.gfx` file:
/// `CSharedLibUI` -> `shared_lib`, `COverlayUI` -> `overlay`, `CHUDUI` -> `hud`, `CIntroUI` ->
/// `intro`, `CTitleUI` -> `title`, `CPauseUI` -> `pause`, `CTutorialsUI` -> `tutorials`,
/// `CCreditsUI` -> `credits`, `CLobbyUI` -> `lobby`, `CMainUI` -> `main`, `CCommLinkUI` ->
/// `comm_link`, `CCommCollectiblesUI` -> `comm_collectibles`, `CCommCommunityUI` ->
/// `comm_community`, `CCommMapUI` -> `comm_map`, `CCommSkillUI` -> `comm_skill`,
/// `CCommStatsUI` -> `comm_stats`, `CCommBragsFeatsUI` -> `comm_brags_feats`,
/// `CCommStoreUI` -> `comm_store`, `CRewardUI` -> `reward`, `CROMUI` -> (none).
pub type ScaleformInfo;

/// `GFx::Loader`: the Scaleform movie loader.
pub type Loader {
    /// The load flag that skips import binding: `MovieBindProcess::BindNextFrame` tests it before
    /// resolving a movie's imported symbol libraries (`LoadDisableImports`).
    pub const LOAD_DISABLE_IMPORTS: u32 = 0x100000,
}
impl Loader {
    /// Loads (or fetches from the resource library) the movie definition at `filename` with the
    /// given load flags.
    #[address(0x141_976_DD0)]
    pub fn CreateMovie(&mut self, filename: *const u8, load_constants: u32, memory_arena: u64) -> *mut void;
}
