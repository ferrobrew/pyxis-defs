/// Scaleform [`RefCountImpl`] -- the base class for reference-counted Scaleform objects. Provides
/// a vtable pointer and an atomic [`ref_count`](Self::ref_count). `AddRef`/`Release` are
/// non-virtual; the virtual [`destructor`](Self::destructor) runs when the refcount reaches zero.
#[size(0x10)]
pub type RefCountImpl {
    vftable {
        /// Virtual destructor. Called by `Release` when the refcount reaches zero.
        pub fn destructor(&mut self, flags: u32);
    },

    /// Atomic reference count. Incremented by `AddRef`, decremented by `Release`.
    #[address(0x8)]
    pub ref_count: u32,
}
impl RefCountImpl {
    /// Increments the reference count atomically.
    #[address(0x141_998_430)]
    pub fn AddRef(&self);

    /// Decrements the reference count atomically. When it reaches zero, calls the virtual
    /// [`destructor`](Self::destructor).
    #[address(0x141_998_440)]
    pub fn Release(&self);
}

/// The Scaleform AS3 `MovieRoot` (the `ASMovieRootBase` interface), which `CUIManager::m_Movie`
/// points at. The engine drives the movie through this interface's virtuals; the bound
/// [`SetVariable`](Self::SetVariable) / [`GetVariable`](Self::GetVariable) /
/// [`Invoke`](Self::Invoke) are its concrete implementations. The vtable is `MovieRoot`'s at
/// [`VFTABLE`](Self::VFTABLE).
#[min_size(0x18)]
pub type Movie {
    /// The `AS3::MovieRoot` vtable address (the `ASMovieRootBase` layout, which holds
    /// [`GetDisplayObjectsTree`](Self::GetDisplayObjectsTree) and the virtuals whose
    /// implementations are the bound SetVariable/GetVariable/Invoke).
    pub const VFTABLE: u64 = 0x1426216B0,
    /// The [`SetVariable`](Self::SetVariable) `set_var_type` (`GFx::Movie::SetVarType`) for a
    /// plain assignment with no persistence across clip re-creation.
    pub const SV_NORMAL: u32 = 0,
    /// The `set_var_type` that re-applies the value when the clip is re-created.
    pub const SV_STICKY: u32 = 1,
    /// The `set_var_type` that keeps the value for the life of the movie.
    pub const SV_PERMANENT: u32 = 2,

    vftable {
        /// Recursively walks the runtime display tree from the root movie clip: returns a tree of
        /// [`AmpMovieObjectDesc`] nodes, each carrying the clip's instance name (or `"Unnamed"`)
        /// and a child array, calling `DisplayObject::GetName` on every child and recursing into
        /// containers. `heap` is the Scaleform `MemoryHeap*` used for the allocations (e.g.
        /// [`MovieImpl::pHeap`]); the tree is freed by releasing the root node. The implementation
        /// is [`GetDisplayObjectsTreeImpl`](Self::GetDisplayObjectsTreeImpl). Call on the capture
        /// (game update) thread, where the display tree is stable.
        #[index(35)]
        pub fn GetDisplayObjectsTree(&self, heap: *mut MemoryHeap) -> *mut AmpMovieObjectDesc;
    },

    /// The backing `GFx::MovieImpl` (`GetDisplayObjectsTree` reads `pMovieImpl->pMainMovie`
    /// through it).
    #[address(0x10)]
    pub pMovieImpl: *mut MovieImpl,
}
impl Movie {
    /// The `AS3::MovieRoot` implementation of the
    /// [`GetDisplayObjectsTree`](Self::GetDisplayObjectsTree) virtual: allocates the root
    /// [`AmpMovieObjectDesc`] from `heap`, names it after the root movie clip, and fills its
    /// children through `DisplayObjContainer::GetChildDescTree`. Returns null without a root clip.
    #[address(0x141_BED_530)]
    pub fn GetDisplayObjectsTreeImpl(&self, heap: *mut MemoryHeap) -> *mut AmpMovieObjectDesc;

    /// Sets an AS3 variable by clip path. The path is a dot-separated string like
    /// `"MCI_hud.MCI_poi_stage._visible"`, resolved from the root timeline. `set_var_type` (one of
    /// [`SV_NORMAL`](Self::SV_NORMAL), [`SV_STICKY`](Self::SV_STICKY), and
    /// [`SV_PERMANENT`](Self::SV_PERMANENT)) controls persistence across clip re-creation. Call on
    /// the capture (game update) thread.
    #[address(0x141_C47_FA0)]
    pub fn SetVariable(&self, path: *const u8, value: *const Value, set_var_type: u32) -> bool;

    /// Reads an AS3 variable by clip path into a [`Value`]. Returns false if the path is not
    /// found. A returned managed value (display object, string) must be released through the
    /// movie's object interface; plain bool/int/number values need no cleanup.
    #[address(0x141_C47_DF0)]
    pub fn GetVariable(&self, value: *mut Value, path: *const u8) -> bool;

    /// Invokes an AS3 method on the movie's root timeline by name. This is the call path used by
    /// the engine's `CUIBase::Invoke`. The `args` are a `GFx::Value` array; `result` receives the
    /// return value (or null). Note the parameter order: `result` comes *before* `args`, unlike
    /// the engine's `CUIBase::Invoke` wrapper (which also adds a timeout).
    #[address(0x141_C49_CD0)]
    pub fn Invoke(&self, method_name: *const u8, result: *mut void, args: *const void, num_args: u32) -> bool;
}

/// The Scaleform `Render::ContextImpl::Context`: the display-tree snapshot pipeline between the
/// update thread and the renderer. `Capture` (update thread) merges the active snapshot's changes
/// into the pending snapshot; [`NextCapture`](RTHandle::NextCapture) (render thread) consumes the pending
/// snapshot into the displaying one, at most once per HAL frame. Only some fields are modeled;
/// the declared size covers only the modeled prefix.
#[size(0x118)]
pub type RenderContext {
    /// The once-a-frame consumption latch: while set, [`NextCapture`](RTHandle::NextCapture) keeps the current
    /// displaying snapshot instead of consuming the pending one. Set by the first `NextCapture`
    /// of a HAL frame and cleared by `HAL::EndFrame` (`EndFrameContextNotify`), so within one
    /// `CUIManager::Render` call every draw sees the same snapshot.
    #[address(0x99)]
    pub NextCaptureCalledInFrame: bool,

    /// The per-slot snapshot frame ids, indexed like `pSnapshots`: `[0]` the active snapshot
    /// (incremented by every `Capture`), `[1]` pending, `[2]` displaying, `[3]` finalizing. The
    /// gap between `[0]` and `[2]` is how far the displayed UI trails the update thread -- a
    /// growing gap means the render side is not consuming captures.
    #[address(0xF0)]
    pub SnapshotFrameIds: [u64; 4],
}
impl RenderContext {
    /// Creates a fresh [`TreeRoot`] entry in this context (`Context::CreateEntry<TreeRoot>`):
    /// allocates its `NodeData` from the context heap and registers the entry. The root starts
    /// parentless with no viewport; [`TreeRoot::SetViewport`] sets its viewport and
    /// [`TreeNode::SetMatrix`] its stage matrix. Call on the capture (game update) thread.
    #[address(0x141_994_560)]
    pub fn CreateEntryTreeRoot(&mut self) -> *mut TreeRoot;

    /// Creates a fresh empty [`TreeContainer`] entry in this context
    /// (`Context::CreateEntry<TreeContainer>`). Call on the capture (game update) thread.
    #[address(0x141_990_AF0)]
    pub fn CreateEntryTreeContainer(&mut self) -> *mut TreeContainer;
}

/// A Scaleform render-tree node: a `Render::ContextImpl::Entry` (a slot in a 0x1000-aligned entry
/// page) whose per-snapshot `NodeData` carries the transform, visibility, and bounds.
/// [`TreeContainer`] and [`TreeRoot`] share this header; a pointer to either casts to this
/// freely. Each write to an entry's `NodeData` records a `Render::TreeChangeConstants` change
/// bit (`Change_*`) on the entry.
#[size(0x38)]
pub type TreeNode {
    /// The change bit for a child insertion (`Change_ChildInsert`).
    pub const CHANGE_CHILD_INSERT: u32 = 0x100,
    /// The change bit for a child removal (`Change_ChildRemove`).
    pub const CHANGE_CHILD_REMOVE: u32 = 0x200,
    /// The change bit for a viewport write (`Change_Viewport`).
    pub const CHANGE_VIEWPORT: u32 = 0x1000,

    /// The entry's reference count. [`TreeContainer::Insert`] increments it and
    /// [`TreeContainer::Remove`] decrements it (destroying the entry at zero), so a node moved
    /// between containers without an extra count held across the remove is destroyed.
    #[address(0x8)]
    pub RefCount: u64,

    /// The displaying-snapshot `EntryData` the renderer reads (low bit carries a flag).
    #[address(0x10)]
    pub pNative: *mut void,

    /// The renderer's `TreeCacheNode` for this entry, once drawn.
    #[address(0x18)]
    pub pRenderer: *mut void,

    /// The parent container entry, or null while detached. [`TreeContainer::Remove`] nulls it;
    /// a null parent on a node the display side owned means the display list dropped it.
    #[address(0x20)]
    pub pParent: *mut TreeNode,
}
impl TreeNode {
    /// Writes the node's 2D transform (`Matrix2x4<float>`, 8 floats) through the entry-change
    /// protocol. Call on the capture (game update) thread.
    #[address(0x141_9E7_230)]
    pub fn SetMatrix(&mut self, matrix: *const f32);

    /// Destroys the entry (`Entry::destroyHelper`): queues its `NodeData` on the context's
    /// destroyed-nodes list (freed at the next capture) and frees the slot. Call only when
    /// [`RefCount`](Self::RefCount) reached zero, on the capture (game update) thread.
    #[address(0x141_9A6_110)]
    pub fn DestroyHelper(&mut self);
}

/// A render-tree container node (`Render::TreeContainer`): a [`TreeNode`] whose `NodeData` holds
/// a child `TreeNodeArray`. The display side mirrors every `DisplayObjContainer` into one, and
/// addresses children by cached numeric index (`GFx::DisplayList`'s `TreeIndex`), so removing a
/// child without the display list's knowledge shifts its siblings out of step with their cached
/// indices.
#[size(0x38)]
pub type TreeContainer;
impl TreeContainer {
    /// Inserts `node` at `index`, recording
    /// [`CHANGE_CHILD_INSERT`](TreeNode::CHANGE_CHILD_INSERT): refcounts the node, sets its
    /// [`pParent`](TreeNode::pParent), and propagates. Capture (game update) thread only.
    #[address(0x141_9E6_720)]
    pub fn Insert(&mut self, index: u64, node: *mut TreeNode) -> bool;

    /// Removes `count` children starting at `index`, recording
    /// [`CHANGE_CHILD_REMOVE`](TreeNode::CHANGE_CHILD_REMOVE): nulls each child's
    /// [`pParent`](TreeNode::pParent) and drops its refcount (destroying it at zero). Capture
    /// (game update) thread only.
    #[address(0x141_9E6_790)]
    pub fn Remove(&mut self, index: u64, count: u64);

    /// The child at `index` of the active snapshot's child array, or null out of range.
    #[address(0x141_9EA_460)]
    pub fn GetAt(&self, index: u64) -> *mut TreeNode;

    /// The active snapshot's child count.
    #[address(0x141_97D_A10)]
    pub fn GetSize(&self) -> u64;
}

/// A render-tree root (`Render::TreeRoot`): a [`TreeContainer`] whose `NodeData` adds the
/// viewport and background color. `HAL::Draw` takes one; the engine draws several per frame
/// through the same HAL (the UI movie, the off-screen movies, the debug text).
#[size(0x38)]
pub type TreeRoot;
impl TreeRoot {
    /// Writes the root's viewport, recording [`CHANGE_VIEWPORT`](TreeNode::CHANGE_VIEWPORT) only
    /// when the viewport differs. `viewport` is a [`Viewport`] (e.g. [`MovieImpl::Viewport`]);
    /// the `Render::Viewport` prefix, up to and including [`Flags`](Viewport::Flags), is copied.
    /// Capture (game update) thread only.
    #[address(0x141_9E6_860)]
    pub fn SetViewport(&mut self, viewport: *const Viewport);
}

/// A Scaleform `GFx::DisplayObjectBase`: the display-side object behind a display-list entry.
/// Reached from a managed display-object [`Value`]'s [`Object::m_DisplayObject`] (guarded by the
/// traits check `GetDisplayInfo` performs through [`Object::m_Traits`]).
#[min_size(1)]
pub type DisplayObjectBase;
impl DisplayObjectBase {
    /// The object's render-tree node, created lazily. Capture (game update) thread only.
    #[address(0x141_9EB_6F0)]
    pub fn GetRenderNode(&self) -> *mut TreeNode;
}

/// A Scaleform AS3 object (the managed payload behind a display-object [`Value::mValue`]): its type
/// [`m_Traits`](Self::m_Traits) classify it, and for a display object its
/// [`m_DisplayObject`](Self::m_DisplayObject) is the presentation-side [`DisplayObjectBase`].
pub type Object {
    /// The object's type traits (class metadata), used to check it really is a display object
    /// before reaching [`m_DisplayObject`](Self::m_DisplayObject).
    #[address(0x28)]
    pub m_Traits: *mut Traits,

    /// The presentation-side display object, valid once [`m_Traits`](Self::m_Traits) confirm a
    /// display-object kind.
    #[address(0x88)]
    pub m_DisplayObject: *mut DisplayObjectBase,
}

/// A Scaleform AS3 object's type traits: the class metadata identifying an [`Object`]'s kind. The
/// display-object type-id range and flag values are hard-coded magic in the engine too (the same
/// constants appear inline in `Value::ObjectInterface::GetDisplayInfo`); their deeper AS3-builtin-type
/// meaning is not recoverable from the stripped Scaleform code, so they are named here by role.
#[min_size(0x80)]
pub type Traits {
    /// The first [`m_TypeId`](Self::m_TypeId) of the display-object AS3 builtin-class range.
    pub const DISPLAY_OBJECT_TYPE_ID_FIRST: u32 = 24,
    /// The number of type ids in the display-object range (so display objects are
    /// `FIRST..FIRST + COUNT`).
    pub const DISPLAY_OBJECT_TYPE_ID_COUNT: u32 = 12,
    /// A [`m_Flags`](Self::m_Flags) bit marking a kind excluded from the display-object check.
    pub const FLAG_NON_DISPLAY_OBJECT: u8 = 0x20,

    /// Trait flags; see [`FLAG_NON_DISPLAY_OBJECT`](Self::FLAG_NON_DISPLAY_OBJECT).
    #[address(0x70)]
    pub m_Flags: u8,

    /// The traits' AS3 builtin-class type id; see [`is_display_object`](Self::is_display_object).
    #[address(0x78)]
    pub m_TypeId: u32,
}
#[cfg(backend = "rust")]
impl Traits {
    /// Whether these traits identify a display object -- the guard `GetDisplayInfo` performs before
    /// reaching an [`Object`](Object)'s [`DisplayObjectBase`](DisplayObjectBase): a
    /// [`m_TypeId`](Self::m_TypeId) in the display-object range and without the
    /// [`FLAG_NON_DISPLAY_OBJECT`](Self::FLAG_NON_DISPLAY_OBJECT) flag.
    #[external_body]
    pub fn is_display_object(&self) -> bool;
}

#[cfg(backend = "rust")]
epilogue for Traits r#"
    impl Traits {
        pub fn is_display_object(&self) -> bool {
            self.m_TypeId.wrapping_sub(Traits::DISPLAY_OBJECT_TYPE_ID_FIRST) < Traits::DISPLAY_OBJECT_TYPE_ID_COUNT
                && self.m_Flags & Traits::FLAG_NON_DISPLAY_OBJECT == 0
        }
    }
"#;

/// A Scaleform `GFx::Viewport` (a `Render::Viewport` plus `Scale` and `AspectRatio`): the
/// description [`MovieImpl::SetViewportImpl`] copies into [`MovieImpl::Viewport`]. `BufferWidth`
/// and `BufferHeight` describe the whole output surface; `Left`/`Top`/`Width`/`Height` are the
/// view rectangle the movie occupies within it. `CUIManager::SetMovieViewport` builds one as
/// `{BufferWidth: vw, BufferHeight: vh, Left: (vw - movie_w) / 2, Top: (vh - movie_h) / 2,
/// Width: movie_w, Height: movie_h, Scissor*: 0, Flags: 0, Scale: 1.0, AspectRatio: 1.0}`, where
/// `movie_w`/`movie_h` are [`m_MovieScaleWidth`](ui::ui_manager::UIManager::m_MovieScaleWidth)/`Height` at call time (not the
/// arguments).
#[copyable, defaultable, size(0x34), align(4)]
pub type Viewport {
    /// The [`Flags`](Self::Flags) bit for a render-texture target (`View_IsRenderTexture`).
    pub const VIEW_IS_RENDER_TEXTURE: u32 = 0x1,
    /// The [`Flags`](Self::Flags) bit that enables the scissor rectangle
    /// (`View_UseScissorRect`).
    pub const VIEW_USE_SCISSOR_RECT: u32 = 0x4,
    /// The [`Flags`](Self::Flags) mask for the orientation (`View_Orientation_Mask`).
    pub const VIEW_ORIENTATION_MASK: u32 = 0x30,

    pub BufferWidth: i32,
    pub BufferHeight: i32,
    pub Left: i32,
    pub Top: i32,
    pub Width: i32,
    pub Height: i32,
    pub ScissorLeft: i32,
    pub ScissorTop: i32,
    pub ScissorWidth: i32,
    pub ScissorHeight: i32,
    /// `View_*` flags, among them [`VIEW_IS_RENDER_TEXTURE`](Self::VIEW_IS_RENDER_TEXTURE),
    /// [`VIEW_USE_SCISSOR_RECT`](Self::VIEW_USE_SCISSOR_RECT), and the
    /// [`VIEW_ORIENTATION_MASK`](Self::VIEW_ORIENTATION_MASK) bits.
    pub Flags: u32,
    /// The view scale used by the `SM_NO_SCALE` mode; every engine caller passes 1.0.
    pub Scale: f32,
    /// The pixel aspect used as an extra horizontal factor by [`MovieImpl::UpdateViewport`];
    /// every engine caller passes 1.0.
    pub AspectRatio: f32,
}

/// A Scaleform `GFx::MouseState`: one tracked mouse's per-movie state
/// ([`MovieImpl::MouseStates`]). `MouseState::UpdateState` fills it while
/// [`MovieImpl::ProcessInput`] drains the input-events queue during `Advance`: it copies
/// [`CurButtonsState`](Self::CurButtonsState) into
/// [`PrevButtonsState`](Self::PrevButtonsState), applies the entry's button/wheel payload,
/// sets or clears [`FLAG_MOUSE_MOVED`](Self::FLAG_MOUSE_MOVED) by integer-comparing the
/// entry's position against [`LastPosition`](Self::LastPosition), and stores the entry's
/// position. `MovieImpl::ProcessMouse` then hit-tests the display tree at that stored position
/// directly (`GetTopMostEntity` recurses with each display object's own local transforms) -- no
/// further viewport, view-scale, or flag-dependent transform runs between the queue and the hit
/// test.
#[size(0x50), align(8)]
pub type MouseState {
    /// The [`CurButtonsState`](Self::CurButtonsState) bit for the left button
    /// (`MouseButton_Left`).
    pub const MOUSE_BUTTON_LEFT: u32 = 0x1,
    /// The [`CurButtonsState`](Self::CurButtonsState) bit for the right button
    /// (`MouseButton_Right`).
    pub const MOUSE_BUTTON_RIGHT: u32 = 0x2,
    /// The [`CurButtonsState`](Self::CurButtonsState) bit for the middle button
    /// (`MouseButton_Middle`).
    pub const MOUSE_BUTTON_MIDDLE: u32 = 0x4,
    /// [`Flags`](Self::Flags) bit: the topmost entity resolved to null on the last update.
    pub const FLAG_TOPMOST_ENTITY_IS_NULL: u8 = 0x1,
    /// [`Flags`](Self::Flags) bit: the previous topmost entity was null.
    pub const FLAG_PREV_TOPMOST_ENTITY_WAS_NULL: u8 = 0x2,
    /// [`Flags`](Self::Flags) bit: the mouse was inside the active entity on the last
    /// test.
    pub const FLAG_MOUSE_INSIDE_ENTITY_LAST: u8 = 0x4,
    /// [`Flags`](Self::Flags) bit: the position changed on the last processed queue entry
    /// (compared as truncated integers).
    pub const FLAG_MOUSE_MOVED: u8 = 0x8,
    /// [`Flags`](Self::Flags) bit: this mouse has received input since the movie started.
    pub const FLAG_ACTIVATED: u8 = 0x10,

    /// `WeakPtr<InteractiveObject>`: the entity under the cursor (the hover target), written
    /// during `ProcessInput` via `MouseState::SetTopmostEntity`.
    #[address(0x0)]
    pub TopmostEntity: *mut void,

    /// `WeakPtr<InteractiveObject>`: the previous hover target.
    #[address(0x8)]
    pub PrevTopmostEntity: *mut void,

    /// `WeakPtr<InteractiveObject>`: the entity that received the last button press.
    #[address(0x10)]
    pub ActiveEntity: *mut void,

    /// `ArrayLH<WeakPtr<InteractiveObject>>` (`{data, size, capacity}`): the per-button press
    /// targets.
    #[address(0x18)]
    pub MouseButtonDownEntities: [u64; 3],

    /// The current button bitmask (`MOUSE_BUTTON_*` bits), as last applied from the queue. [`MovieImpl::NotifyMouseState`] diffs its `buttons` argument against this when
    /// queueing.
    #[address(0x30)]
    pub CurButtonsState: u32,

    /// The button bitmask before the last processed queue entry.
    #[address(0x34)]
    pub PrevButtonsState: u32,

    /// The mouse position in stage twips (`Render::Point<float>`): the authoritative position
    /// hit-testing uses, i.e. the queued output of the
    /// [`ViewportMatrix`](MovieImpl::ViewportMatrix)-inverse transform once `Advance` has
    /// drained the queue. Divide by 20 for stage pixels. Between a
    /// [`NotifyMouseState`](MovieImpl::NotifyMouseState) call and the next `Advance`, the new
    /// position exists only in the input-events queue; this field still holds the previous one.
    #[address(0x38)]
    pub LastPosition: [f32; 2],

    /// The cursor type forced via `MovieImpl::ChangeMouseCursorType`, if any.
    #[address(0x40)]
    pub PresetCursorType: u32,

    /// The current cursor type.
    #[address(0x44)]
    pub CursorType: u32,

    /// The wheel delta of the last processed queue entry (zero when it carried no wheel bit).
    #[address(0x48)]
    pub WheelDelta: i32,

    /// The `FLAG_*` state bits.
    #[address(0x4C)]
    pub Flags: u8,
}

/// A pinned `DisplayHandle<TreeRoot>` as returned by
/// [`GetDisplayHandle`](MovieImpl::GetDisplayHandle): one refcounted `HandleData` pointer.
#[size(0x8)]
pub type DisplayHandle {
    /// The refcounted `RTHandle::HandleData` (starts with [`RefCountImpl`], so
    /// [`RefCountImpl::AddRef`] pins a copied handle).
    #[address(0x0)]
    pub pData: *mut RefCountImpl,
}

/// A stack `Render::ContextImpl::RTHandle` over a copied
/// [`DisplayHandle::pData`] (AddRef'd first, destructed after use).
#[size(0x8)]
pub type RTHandle {
    /// The shared, refcounted handle data.
    #[address(0x0)]
    pub pData: *mut RefCountImpl,
}
impl RTHandle {
    /// Consumes the context's pending snapshot into the displaying one (at most once per HAL
    /// frame: the context's [`NextCaptureCalledInFrame`](ui::scaleform::RenderContext::NextCaptureCalledInFrame)
    /// latch short-circuits repeats). Returns whether the handle is valid to draw. `notify` is
    /// the HAL's context notify ([`RenderHAL::GetContextNotify`]); `frame_id` is 0.
    #[address(0x141_9A7_970)]
    pub fn NextCapture(&mut self, notify: *mut void, frame_id: u64) -> bool;

    /// The handle's root entry in the current displaying snapshot, for `HAL::Draw`.
    #[address(0x141_9A4_620)]
    pub fn GetRenderEntry(&self) -> *mut TreeRoot;

    /// The RTHandle destructor (releases the handle data).
    #[address(0x141_9A4_600)]
    pub fn Destruct(&mut self);
}

/// A Scaleform `Render::RenderTarget`: the target wrapper `SetRenderTarget`/`PushRenderTarget`
/// take. `RenderOffScreenTextures` creates one per draw from D3D views
/// ([`RenderHAL::CreateRenderTarget`]) and releases it after the pop.
#[min_size(0x18)]
pub type RenderTarget {
    vftable {
        /// Releases the target (refcounted).
        #[index(2)]
        pub fn Release(&mut self);
    },
}

/// A `GFx::MouseEvent` (a `GFx::Event` with the mouse payload): the argument
/// `CUIManager::SendMouseEvents` builds for [`MovieImpl::HandleEvent`]. `x` and `y` are in
/// movie-viewport pixels: window-client pixels minus the centering offset
/// `(cached viewport size - movie rectangle size) / 2`, i.e. relative to the top-left corner of
/// the centered movie rectangle (see
/// [`UIManager::m_MovieScaleWidth`](ui::ui_manager::UIManager::m_MovieScaleWidth)).
#[copyable, size(0x1C), align(4)]
pub type MouseEvent {
    /// The [`Button`](Self::Button) index of the left button.
    pub const BUTTON_LEFT: u32 = 0,
    /// The [`Button`](Self::Button) index of the right button.
    pub const BUTTON_RIGHT: u32 = 1,
    /// The [`Type`](Self::Type) of a mouse-move event.
    pub const TYPE_MOUSE_MOVE: u32 = 1,
    /// The [`Type`](Self::Type) of a button-press event.
    pub const TYPE_MOUSE_DOWN: u32 = 2,
    /// The [`Type`](Self::Type) of a button-release event.
    pub const TYPE_MOUSE_UP: u32 = 3,
    /// The [`Type`](Self::Type) of a wheel event ([`ScrollDelta`](Self::ScrollDelta)
    /// carries the amount).
    pub const TYPE_MOUSE_WHEEL: u32 = 4,

    /// The `GFx::Event::Type` tag (`TYPE_MOUSE_*`).
    pub Type: u32,
    /// `GFx::KeyModifiers::States` (ctrl/alt/shift bits); the engine always sends 0.
    pub Modifiers: u8,

    #[address(0x8)]
    pub x: f32,
    pub y: f32,
    /// The wheel amount in Flash line units; the engine sends `lZ / 120 * 3` from the DirectInput
    /// mouse's z axis.
    pub ScrollDelta: f32,
    /// The button index for down/up events: [`BUTTON_LEFT`](Self::BUTTON_LEFT) or
    /// [`BUTTON_RIGHT`](Self::BUTTON_RIGHT).
    pub Button: u32,
    pub MouseIndex: u32,
}

/// The `GFx::MovieImpl` behind [`UIManager::m_Movie`](ui::ui_manager::UIManager::m_Movie): the
/// `GFx::Movie` instance. The rendering-side virtuals live on its own vtable; the AS3 side
/// (SetVariable, Invoke, the display tree) lives on [`pASMovieRoot`](Self::pASMovieRoot).
#[min_size(0x58)]
pub type MovieImpl {
    /// The [`ViewScaleMode`](Self::ViewScaleMode) that maps the movie 1:1 at
    /// [`Viewport::Scale`] with no stretching (the view rectangle crops or pads the stage).
    pub const SM_NO_SCALE: u32 = 0,
    /// The [`ViewScaleMode`](Self::ViewScaleMode) that fits the whole stage inside the view
    /// rectangle, preserving aspect (letterboxing as needed). The constructor default.
    pub const SM_SHOW_ALL: u32 = 1,
    /// The [`ViewScaleMode`](Self::ViewScaleMode) that stretches the stage to the view
    /// rectangle exactly, ignoring aspect.
    pub const SM_EXACT_FIT: u32 = 2,
    /// The [`ViewScaleMode`](Self::ViewScaleMode) that fills the view rectangle, preserving
    /// aspect (cropping as needed).
    pub const SM_NO_BORDER: u32 = 3,
    /// The [`ViewAlignment`](Self::ViewAlignment) that centres the stage (`Align_Center`), the
    /// constructor default.
    pub const ALIGN_CENTER: u32 = 0,
    /// The [`HitTest`](Self::HitTest) `test_cond` (`GFx::Movie::HitTestType`) that tests bounds.
    pub const HIT_TEST_BOUNDS: u32 = 0,
    /// The `test_cond` that tests shapes.
    pub const HIT_TEST_SHAPES: u32 = 1,
    /// The `test_cond` that tests for button events from `controller_idx`.
    pub const HIT_TEST_BUTTON_EVENTS: u32 = 2,
    /// The `test_cond` that tests shapes, counting invisible ones.
    pub const HIT_TEST_SHAPES_NO_INVISIBLE: u32 = 3,
    /// The [`Flags`](Self::Flags) bit (`Flag_NeedMouseUpdate`) marking mouse state pending
    /// re-resolution; [`ProcessInput`](Self::ProcessInput) tests and clears it.
    pub const FLAG_NEED_MOUSE_UPDATE: u32 = 0x80,

    vftable {
        /// Advances the movie by `delta_t` seconds: processes queued
        /// input, runs the timeline and AS3 frame, and, when `capture` is set, finishes with
        /// [`CaptureImpl`](Self::CaptureImpl). Returns the time until the next frame is due.
        #[index(24)]
