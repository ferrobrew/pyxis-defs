use character::character::Character;
use character::inventory::WeaponSlot;
use character::player::Player;
use graphics_engine::device::CRITICAL_SECTION;
use types::math::Vector4;
use types::shared_ptr::SharedPtr;
use ui::poi::{POI, WeakPtrPOI};
use ui::scaleform::Value;

/// `CHUDUI::EHUDState`: which parts of the HUD are shown. [`HUDUI::Update`] skips most per-frame
/// element updates (reticles, health, vehicle, points of interest, button hints) in
/// [`HUD_HIDE_ALL`](Self::HUD_HIDE_ALL) and
/// [`HUD_HIDE_ALL_NON_OVERLAY`](Self::HUD_HIDE_ALL_NON_OVERLAY).
#[copyable]
pub enum HUDState: u32 {
    HUD_SHOW_ALL = 0x0,
    HUD_CINEMATIC = 0x1,
    /// Hides the whole HUD.
    HUD_HIDE_ALL = 0x2,
    HUD_ROM = 0x3,
    HUD_MISSION_B = 0x4,
    /// Hides the main HUD while keeping the overlay elements (the state used by the pause menu
    /// and the comm-link).
    HUD_HIDE_ALL_NON_OVERLAY = 0x5,
    HUD_REWARD_SEQUENCE = 0x6,
    HUD_ALL_DISABLED = 0x7,
    HUD_ALL_DISABLED_KEEP_RETICLE = 0x8,
}

/// One registered point of interest (`CHUDUI::SPOIRecord`): the [`POI`] and the HUD's marker clip
/// for it.
#[size(0x58)]
pub type POIRecord {
    /// The POI. [`HUDUI::UpdatePOIs`] drops the record once the POI is destroyed.
    pub m_POI: WeakPtrPOI,
    /// A strong reference that keeps the POI alive while it is registered, for POIs registered with
    /// the keep flag of `CHUDUI::RegisterPOI`; null otherwise.
    pub m_KeepPOI: SharedPtr<POI>,
    /// The marker clip: a managed display-object value taken from the movie's pooled `poi` clips by
    /// `CHUDUI::CreatePOI` on the record's first update, and undefined (a zero type) until then.
    /// [`HUDUI::UpdatePOIs`] writes its position each frame through
    /// [`SetDisplayInfo`](ui::scaleform::ValueObjectInterface::SetDisplayInfo).
    pub m_Element: Value,
    /// Whether the marker is shown: the last visibility [`HUDUI::UpdatePOIs`] pushed to the movie
    /// (`ShowPoi` / `HidePoi`).
    pub m_Visible: bool,
}

/// A node of [`HUDUI::m_POIListHead`] (an MSVC `std::list<CHUDUI::SPOIRecord>` node). The list's head
/// node is a sentinel without a record: its [`m_Next`](Self::m_Next) is the first element, and the
/// last element's links back to it.
#[size(0x68)]
pub type POIListNode {
    pub m_Next: *mut POIListNode,
    pub m_Prev: *mut POIListNode,
    pub m_Record: POIRecord,
}

/// The weapon selection's state as [`Inventory::UpdateWeaponHandling`](character::inventory::Inventory::UpdateWeaponHandling)
/// computes it each frame for the player (`CHUDUI::SWeaponSelectionParams`), passed to
/// [`HUDUI::UpdateWeaponSelection`].
#[copyable, size(0xC), align(4)]
pub type WeaponSelectionParams {
    /// Whether the selection is shown: while a slot-select input is held (always under gamepad
    /// semantics; under keyboard semantics not for the planted explosive), and for a short while
    /// after a release whose commit is still pending or a weapon cycle step.
    pub m_Show: bool,

    /// The highlighted slot: the winning slot-select input's slot, the pending or cycled slot, or
    /// [`E_NONE`](WeaponSlot::E_NONE) when the winner holds no weapon.
    #[address(0x4)]
    pub m_SelectedSlot: WeaponSlot,
    /// Whether the [`E_SLOT_DUAL_WIELD`](WeaponSlot::E_SLOT_DUAL_WIELD) slot is offered: it holds a
    /// weapon.
    pub m_DualWieldIsValid: bool,
    /// Whether the [`E_SLOT_TWO_HANDED`](WeaponSlot::E_SLOT_TWO_HANDED) slot is offered: it holds a
    /// weapon.
    pub m_TwoHandedIsValid: bool,
    /// Whether the [`E_SLOT_TWO_HANDED_SPECIAL`](WeaponSlot::E_SLOT_TWO_HANDED_SPECIAL) slot is
    /// offered: it holds a weapon, other than a mortar whose mortar mode is unavailable.
    pub m_TwoHandedSpecialIsValid: bool,
    /// Whether the [`E_SLOT_PLANTED_EXPLOSIVE`](WeaponSlot::E_SLOT_PLANTED_EXPLOSIVE) slot is
    /// offered (see
    /// [`Inventory::m_DoesAnimationAllowSwitchToPlantedExplosive`](character::inventory::Inventory::m_DoesAnimationAllowSwitchToPlantedExplosive)).
    pub m_PlantedExplosiveIsValid: bool,
}

/// The in-game HUD (`CHUDUI`, a `CUIBase` Scaleform movie wrapper). Only the fields and methods
/// below are mapped.
#[singleton(0x142_F38_820), min_size(0x488)]
pub type HUDUI {
    /// The value `OnOmniDamage` writes into [`UIManager::m_GrabScreenTimer`](ui::ui_manager::UIManager::m_GrabScreenTimer) (seconds) when
    /// omnidirectional damage is taken.
    pub const OMNI_DAMAGE_GRAB_SCREEN_TIME: f32 = 2.0,
    /// The value, in seconds, that [`UpdateShowWeaponsAndGrenadesUiTimer`](Self::UpdateShowWeaponsAndGrenadesUiTimer)
    /// sets [`m_ShowWeaponsUiTimer`](Self::m_ShowWeaponsUiTimer) and
    /// [`m_ShowGrenadesUiTimer`](Self::m_ShowGrenadesUiTimer) to while their readouts should show.
    pub const SHOW_WEAPONS_UI_TIME: f32 = 10.0,

    /// The current HUD visibility state.
    #[address(0x184)]
    pub m_State: HUDState,

    /// Seconds left before the weapon readout hides.
    /// [`UpdateShowWeaponsAndGrenadesUiTimer`](Self::UpdateShowWeaponsAndGrenadesUiTimer) sets it to
    /// [`SHOW_WEAPONS_UI_TIME`](Self::SHOW_WEAPONS_UI_TIME) on every update in which
    /// `CCharacter::ShouldShowWeaponsUi` holds, counts it down otherwise, and zeroes it while the
    /// character holsters its weapon.
    #[address(0x18C)]
    pub m_ShowWeaponsUiTimer: f32,
    /// Whether the weapon readout is shown: the last of the movie's `ShowWeaponsUi` /
    /// `HideWeaponsUi` that [`UpdateShowWeaponsAndGrenadesUiTimer`](Self::UpdateShowWeaponsAndGrenadesUiTimer)
    /// invoked.
    pub m_IsShowingWeaponsUi: bool,

    /// Seconds left before the grenade readout hides; the grenade counterpart of
    /// [`m_ShowWeaponsUiTimer`](Self::m_ShowWeaponsUiTimer).
    #[address(0x194)]
    pub m_ShowGrenadesUiTimer: f32,
    /// Whether the grenade readout is shown (`ShowGrenadesUi` / `HideGrenadesUi`).
    pub m_IsShowingGrenadesUi: bool,

    /// The lock guarding [`m_POIListHead`](Self::m_POIListHead): POIs are registered and unregistered from
    /// other systems, and [`UpdatePOIs`](Self::UpdatePOIs) holds it for its whole walk.
    #[address(0x1D0)]
    pub m_POIListLock: *mut CRITICAL_SECTION,
    /// The head (sentinel) node of the registered points of interest
    /// (`std::list<CHUDUI::SPOIRecord>`).
    pub m_POIListHead: *mut POIListNode,
    /// The number of records in [`m_POIListHead`](Self::m_POIListHead).
    pub m_POIListSize: u64,

    /// The [`m_ID`](ui::poi::POI::m_ID) of the one on-screen POI whose label is shown: the one
    /// nearest the screen centre among those whose label box contains the centre, chosen by
    /// [`UpdatePOIs`](Self::UpdatePOIs). Zero when none qualifies.
    #[address(0x1F0)]
    pub m_ShowingLabelPOIId: u32,

    /// Whether the sniper-scope overlay is shown, set by [`ShowSniperOverlay`](Self::ShowSniperOverlay)
    /// and cleared by [`HideSniperOverlay`](Self::HideSniperOverlay).
    #[address(0x218)]
    pub m_ShowingSniperOverlay: bool,

    /// The selection state last pushed to the movie by
    /// [`UpdateWeaponSelection`](Self::UpdateWeaponSelection).
    #[address(0x21C)]
    pub m_LastWeaponSelectionParams: WeaponSelectionParams,
    /// The movie's weapon selection clip, `MCI_weapon_selection_wheel`: a managed display-object
    /// value. [`UpdateWeaponSelectionPlacement`](Self::UpdateWeaponSelectionPlacement) writes its
    /// position each frame.
    pub m_SelectionWheelUi: Value,

    /// The selection clip's extent around its position for the current layout, in stage pixels, as
    /// the movie's `GetWeaponSelectionWheelBB{Bottom,Top,Left,Right}` report it, in that order (`x`
    /// to `w`). [`RecalculateWheelBB`](Self::RecalculateWheelBB) refreshes it.
    /// [`UpdateWeaponSelectionPlacement`](Self::UpdateWeaponSelectionPlacement) keeps the clip's x
    /// between the safe area's left minus `z` and its right minus `w`, and its y between the safe
    /// area's top minus `y` and its bottom minus `x`, so each component is an edge's signed offset
    /// from the clip's position.
    #[address(0x270)]
    pub m_SelectionWheelBB: Vector4,

    /// The health last pushed to the movie by [`UpdateHealth`](Self::UpdateHealth);
    /// [`InitHealth`](Self::InitHealth) resets it to -1 so the next update pushes again.
    #[address(0x482)]
    pub m_LastHealth: i16,
}
impl HUDUI {
    /// The per-frame HUD update: refreshes [`m_State`](Self::m_State) through `UpdateState`, then,
    /// unless the state hides the HUD, updates the reticles, health, vehicle, wingsuit, points of
    /// interest, tethers, heat, button hints, subtitles, and notifications. `CUIManager::PreRender`
    /// calls it (through the UI's vtable) on every active UI before it advances the movie and
    /// captures it once, so each capture follows exactly one HUD update.
    #[address(0x140_F11_D40)]
    pub fn Update(&mut self, dt: f32, dtf: f32);

    /// Projects and places every registered point of interest. Unless
    /// [`m_State`](Self::m_State) is [`HUD_CINEMATIC`](HUDState::HUD_CINEMATIC), it holds
    /// [`m_POIListLock`](Self::m_POIListLock) and walks [`m_POIListHead`](Self::m_POIListHead):
    /// records whose POI is destroyed are removed (invoking the movie's `RemovePoi`), invisible POIs
    /// are skipped, and a record without a clip gets one. For each POI it calls
    /// [`POI::UpdatePOI`](ui::poi::POI::UpdatePOI), takes the translation of
    /// [`POI::m_Transform`](ui::poi::POI::m_Transform) as the world point, and projects it through
    /// [`UIManager::Get2DInfo`](ui::ui_manager::UIManager::Get2DInfo) with the active camera's
    /// view-projection, its orthonormalised transform, its field of view, a fixed screen margin,
    /// the POI's [`m_ClampToScreen`](ui::poi::POI::m_ClampToScreen), and its
    /// [`m_Attach2DOffset`](ui::poi::POI::m_Attach2DOffset). The marker shows while the distance to
    /// the player character is within the POI's range, it is not behind the camera (unless
    /// clamped), and the vehicle, use, settlement, mission, and ROM filters pass; a change invokes
    /// `ShowPoi` / `HidePoi` and updates [`POIRecord::m_Visible`]. A shown marker gets its icon
    /// scale and alpha, ping, distance text, edge-arrow state, flash, label, progress, and weapon
    /// icon through the movie's `UpdatePoi`, and then its x and y (rounded to whole stage pixels)
    /// through [`SetDisplayInfo`](ui::scaleform::ValueObjectInterface::SetDisplayInfo). Finally it
    /// stores the labelled POI in [`m_ShowingLabelPOIId`](Self::m_ShowingLabelPOIId). Called from
    /// [`Update`](Self::Update) with the local player and character.
    #[address(0x140_F03_B70)]
    pub fn UpdatePOIs(&mut self, player: *mut Player, character: *mut Character, dt: f32);

    /// Drives the weapon and grenade readouts' visibility timers
    /// ([`m_ShowWeaponsUiTimer`](Self::m_ShowWeaponsUiTimer),
    /// [`m_ShowGrenadesUiTimer`](Self::m_ShowGrenadesUiTimer)) and invokes the movie's
    /// `ShowWeaponsUi` / `HideWeaponsUi` and `ShowGrenadesUi` / `HideGrenadesUi` on their edges. It
    /// also shows and hides the beacon helper with the selected grenade slot.
    #[address(0x140_E12_730)]
    pub fn UpdateShowWeaponsAndGrenadesUiTimer(&mut self, player: *mut Player, character: *mut Character, dt: f32) -> bool;

    /// Pushes the character's health ([`Character::GetHealth`]) to the movie's `UpdateHealth`
    /// with `dt` whenever it differs from [`m_LastHealth`](Self::m_LastHealth). The movie draws it
    /// as the full-screen damage vignette and the reticle's low-health outline; there is no
    /// numeric readout.
    #[address(0x140_E2C_C00)]
    pub fn UpdateHealth(&mut self, character: *mut Character, dt: f32);

    /// Resets [`m_LastHealth`](Self::m_LastHealth) and invokes the movie's `InitHealth` with the
    /// local player character's [`m_MaxHealth`](Character::m_MaxHealth) and a second, unidentified
    /// value from the local player's data.
    #[address(0x140_E2C_A90)]
    pub fn InitHealth(&mut self);

    /// Sets [`m_ShowingSniperOverlay`](Self::m_ShowingSniperOverlay) and invokes the movie's
    /// `ShowSniperOverlay`.
    #[address(0x140_DFA_3D0)]
    pub fn ShowSniperOverlay(&mut self);

    /// Clears [`m_ShowingSniperOverlay`](Self::m_ShowingSniperOverlay) and invokes the movie's
    /// `HideSniperOverlay`.
    #[address(0x140_DFA_410)]
    pub fn HideSniperOverlay(&mut self);

    /// Updates the weapon reticle for the local player's character: shape, spread, and hit and
    /// target feedback, pushed to the movie.
    #[address(0x140_E28_890)]
    pub fn UpdateWeaponReticle(&mut self, player: *mut Player, character: *mut Character, dt: f32, dtf: f32);

    /// Updates the grapple reticle: projects the grapple aim and active-wire attachment points to
    /// the screen through `CUIManager::Convert3DCoords` and pushes them to the movie.
    #[address(0x140_E29_410)]
    pub fn UpdateGrappleReticle(&mut self, player: *mut Player, character: *mut Character, dt: f32, dtf: f32);

    /// Sets the UI manager's grab-screen timer to
    /// [`OMNI_DAMAGE_GRAB_SCREEN_TIME`](Self::OMNI_DAMAGE_GRAB_SCREEN_TIME) and invokes the movie's
    /// `OnOmniDamage`.
    #[address(0x140_E2C_DB0)]
    pub fn OnOmniDamage(&mut self);

    /// Invokes the movie's `OnOutOfAmmoFire`, the out-of-ammunition notice. Its only caller is
    /// [`WeaponBase::CheckIfReloadShouldBeTriggeredBase`](equipment::weapon::WeaponBase::CheckIfReloadShouldBeTriggeredBase),
    /// at a trigger pull of the local player's weapon that is empty, cannot reload, and found no
    /// weapon to switch to.
    #[address(0x140_DFA_520)]
    pub fn OnOutOfAmmoFire(&mut self);

    /// Pushes the weapon selection to the movie's `UpdateWeaponSelection` (the selected slot, the
    /// shown flag, and the four valid flags) when any field differs from
    /// [`m_LastWeaponSelectionParams`](Self::m_LastWeaponSelectionParams), and stores it there. Its
    /// only caller is [`Inventory::UpdateWeaponHandling`](character::inventory::Inventory::UpdateWeaponHandling),
    /// which calls it every frame for the player, so it runs in the characters' parallel update. In
    /// the movie, a show edge tweens the arms out, the shown selection highlights the selected arm
    /// and dims the others, and a hide edge fades the selected arm out while scaling it up.
    #[address(0x140_E2B_CA0)]
    pub fn UpdateWeaponSelection(&mut self, params: *const WeaponSelectionParams);

    /// Places the weapon selection clip ([`m_SelectionWheelUi`](Self::m_SelectionWheelUi)) over
    /// `character`'s hips. It takes the hips bone's world position, projects it through the render
    /// camera's view-projection with [`UIManager::Convert3DCoords`](ui::ui_manager::UIManager::Convert3DCoords),
    /// clamps it so that [`m_SelectionWheelBB`](Self::m_SelectionWheelBB) stays inside
    /// [`UIManager::m_SafeArea`](ui::ui_manager::UIManager::m_SafeArea) (or, when the point does not
    /// project, centres it horizontally at the bottom of the safe area), averages it with the last
    /// three positions, and writes the clip's x and y through
    /// [`SetDisplayInfo`](ui::scaleform::ValueObjectInterface::SetDisplayInfo). Called every frame
    /// from [`Update`](Self::Update); it does not read `dt`.
    #[address(0x140_E2B_F20)]
    pub fn UpdateWeaponSelectionPlacement(&mut self, character: *mut Character, dt: f32);

    /// Refreshes [`m_SelectionWheelBB`](Self::m_SelectionWheelBB) from the movie. Called when the
    /// weapons are initialised and when gamepad use changes, which changes the clip's layout.
    #[address(0x140_E11_7E0)]
    pub fn RecalculateWheelBB(&mut self);
}
