/// `CUIMenu`: the menu screens' shared helpers. Only its static helpers are mapped.
pub type UIMenu;
impl UIMenu {
    /// Returns the display name of the weapon type whose name hash is `name_hash`
    /// ([`WeaponBase::m_WeaponNameHash`](equipment::weapon::WeaponBase::m_WeaponNameHash)): the
    /// localisation store's string for that hash in the current language
    /// ([`Locator::GetLocalizedStringRaw`](ui::locator::Locator::GetLocalizedStringRaw)), or an
    /// empty string when the store has none. The HUD names weapons through it, as
    /// [`HUDUI::OnPickupWeapon`](ui::hud_ui::HUDUI::OnPickupWeapon) does.
    #[address(0x140_F1E_250)]
    pub fn GetWeaponNameById(name_hash: u32) -> *const u8;
}
