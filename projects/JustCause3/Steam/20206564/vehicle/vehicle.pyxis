use character::character::Character;
use game::GameObjectUpdateContext;
use types::math::{Matrix4, Vector3};
use vehicle::parts::{PartInstance, PfxBreakable};

/// The engine's vehicle classification (`NVehicle::EVehicleType`), stored on a vehicle as
/// `CVehicle::m_VehicleType` and returned by `CVehicle::GetVehicleType`, which is inlined at every
/// use in this build. Jetskis classify as [`EBOAT`](Self::EBOAT). The field's offset is not mapped.
pub enum VehicleType: i32 {
    ECAR = 0x0,
    EHELICOPTER = 0x1,
    EBOAT = 0x2,
    EAIRPLANE = 0x3,
    EMOTORCYCLE = 0x4,
    ESUB = 0x5,
    ETRAIN = 0x6,
}

/// A vehicle seat identifier (`NVehicle::ESeat`): an index into [`Vehicle::m_Seats`], with the
/// seat categories laid out in bands (driver, passengers, gunners, stunt positions, scripted).
pub enum Seat: i32 {
    EDriverSeat = 0x0,
    EPassengerSeat = 0x1,
    EGunnerSeat = 0x6,
    EStuntSeat = 0x8,
    EScriptedSeats = 0x14,
    /// No seat: returned by [`Vehicle::GetSeat`] for a character that is not seated in the vehicle.
    ENoSeatIdentifier = -1,
}

/// One seat of a vehicle (`CVehicle::CSeat`). It is interaction-graph metadata (the graph node the
/// seated character occupies, the door slot, the window part, and whether the player may use it)
/// and carries no transform: a seated character's pose comes from its own attach bone and offset.
#[size(0x30)]
pub type VehicleSeat {
    /// The interaction-graph node a character occupies while in this seat.
    /// [`Vehicle::GetSeat`] matches a character's current node against it.
    pub m_GraphNode: *mut u8,
}

/// A vehicle (`CVehicle`). Like other game objects it carries its `CGameObject` base at the same
/// offset as a character does
/// ([`Character::GAME_OBJECT_BASE_OFFSET`](character::character::Character::GAME_OBJECT_BASE_OFFSET)),
/// and the vtable there serves RTTI and the transform virtuals. Only some members are bound.
#[min_size(0x53A4)]
pub type Vehicle {
    /// The number of entries in [`m_Seats`](Self::m_Seats).
    pub const MAX_SEATS: u64 = 42,

    /// The signed throttle the vehicle's input reader last applied (`m_SteeringValues.Acceleration`).
    /// A plane's reader ([`AirPlane::UpdateVehicleInputsFromActionMap`]) sets it to the
    /// `PLANE_INC_TRUST` value less the `PLANE_DEC_TRUST` value, so it is negative while braking.
    /// [`UpdateLandingGearVariables`](Self::UpdateLandingGearVariables) reads it.
    #[address(0x440)]
    pub m_SteeringAcceleration: f32,
    /// The brake the vehicle's input reader last applied (`m_SteeringValues.Brake`), `0..=1`: a
    /// plane's is the `PLANE_DEC_TRUST` value.
    pub m_SteeringBrake: f32,

    /// The signed steering amount the vehicle's controller last applied
    /// (`m_SteeringValues.Turn`). It is the value of the vehicle's `steering_turn` variable, which
    /// value-driven effects and hinged parts can be driven by.
    #[address(0x454)]
    pub m_SteeringTurn: f32,

    /// The vehicle's world transform at the start of the current simulation step, as the engine's
    /// row-major matrix.
    #[address(0x478)]
    pub m_WorldMatrixT0: Matrix4,
    /// The vehicle's world transform at the end of the current simulation step.
    pub m_WorldMatrixT1: Matrix4,
    /// The render transform: [`m_WorldMatrixT0`](Self::m_WorldMatrixT0) and
    /// [`m_WorldMatrixT1`](Self::m_WorldMatrixT1) interpolated by the render update's frame
    /// fraction. `CVehicle::UpdateRender_Parallel` hands it to
    /// [`UpdateRender_ModelMatrices`](Self::UpdateRender_ModelMatrices).
    pub m_InterpolatedWorldMatrix: Matrix4,

    /// The vehicle's seats, indexed by [`Seat`].
    #[address(0xB28)]
    pub m_Seats: [VehicleSeat; 42],

    /// The seat the local player occupies, or [`Seat::ENoSeatIdentifier`]. The game's input
    /// contexts test it against [`Seat::EDriverSeat`] to decide whether driver controls apply.
    #[address(0x1_5DC)]
    pub m_LocalPlayerSeat: Seat,

    /// The vehicle's doors, hood, trunk, hatches, and other opening parts, and their state.
    #[address(0x1_668)]
    pub m_VehicleDoorController: VehicleDoorController,

    /// Whether the landing gear should be down. While the local player drives,
    /// [`UpdateLandingGearVariables`](Self::UpdateLandingGearVariables) rewrites it on every update;
    /// otherwise it keeps the value the AI steering last set.
    #[address(0x1_81D)]
    pub m_DesiredLandingGearState: bool,

    /// The world-space point the vehicle's weapons aim at, written by
    /// [`SetAimTargetPosition`](Self::SetAimTargetPosition).
    #[address(0x4_C34)]
    pub m_AimingTargetPosition: Vector3,

    /// The nitrous input, `0..=1`: a plane's input reader raises it to the thrust input while that
    /// is above [`AirPlane::NITROUS_THRUST_THRESHOLD`].
    #[address(0x4_CCC)]
    pub m_NitrousInput: f32,

    /// How long, in seconds, AI-controlled vehicle weapons keep an externally supplied aim target.
    /// [`SetAimTargetPosition`](Self::SetAimTargetPosition) sets it to `-1` when the local player
    /// drives and to `2` otherwise.
    #[address(0x4_D48)]
    pub m_AIVehicleWeaponAimTimeout: f32,

    /// The vehicle's physics body (`CPfxVehicle*`), whose breakable base, with the vehicle's
    /// parts, is at offset zero. [`IsMech`](Self::IsMech) tests its strafing wheel-steering
    /// controller.
    #[address(0x4_DD0)]
    pub m_PfxVehicle: *mut PfxBreakable,

    /// The hash of the vehicle's type name (`HashString` of names such as
    /// `v1706_boat_na_rocketboat`), compared by [`IsRocketBoat`](Self::IsRocketBoat).
    #[address(0x5_3A0)]
    pub m_VehicleTypeNameHash: u32,
}
impl Vehicle {
    /// `CVehicle::TYPE_ID`: the run-time type id of `CVehicle`, for
    /// [`GameObject::IsType`](game::GameObject::IsType). Registers it on first use.
    #[address(0x140_60F_3F0)]
    pub fn TYPE_ID() -> *const u32;

    /// Asks every door of `slot` to open: makes sure the vehicle's physics body is in the world
    /// and the vehicle is in the update, then sets each [`DoorInfo`] of the slot's
    /// [`m_PendingState`](DoorInfo::m_PendingState) to [`DoorState::DOOR_OPENING`] and clears its
    /// [`m_Flags`](DoorInfo::m_Flags). With `keep_open`, the door is held open at least
    /// `keep_open_angle_deg` below its hinge's largest angle and reopens when pushed back
    /// ([`DoorInfo::FLAG_KEEP_OPEN`]). The door controller acts on the request in the vehicle's
    /// post-simulation update (`CVehicle::UpdatePostSim_Doors`), which loosens the part onto its
    /// hinge ([`PfxBreakable::EnablePart`](vehicle::parts::PfxBreakable::EnablePart)) and turns
    /// the hinge with a motor to the open angle.
    #[address(0x140_FC7_320)]
    pub fn OpenDoor(&mut self, slot: DoorSlot, keep_open: bool, keep_open_angle_deg: f32);

    /// Asks every door of `slot` to close, the same way [`OpenDoor`](Self::OpenDoor) asks it to
    /// open: the door controller turns the hinge's motor back to its smallest angle and merges the
    /// part into the body there.
    #[address(0x140_FC7_2B0)]
    pub fn CloseDoor(&mut self, slot: DoorSlot);

    /// Sets [`m_AimingTargetPosition`](Self::m_AimingTargetPosition) and refreshes
    /// [`m_AIVehicleWeaponAimTimeout`](Self::m_AIVehicleWeaponAimTimeout).
    #[address(0x140_F24_B00)]
    pub fn SetAimTargetPosition(&mut self, position: *const Vector3);

    /// Returns the seat `character` occupies: the index of the seat whose graph node is the
    /// character's current interaction-graph node, or [`Seat::ENoSeatIdentifier`].
    #[address(0x140_F24_FB0)]
    pub fn GetSeat(&self, character: *const Character) -> Seat;

    /// Whether the vehicle is a mech: its physics body has a strafing wheel-steering controller.
    #[address(0x140_F23_990)]
    pub fn IsMech(&self) -> bool;

    /// Moves the vehicle to `transform` directly (through the `CGameObject` transform setter),
    /// invalidates its collision caches, and detaches any player grapple wire attached to it.
    /// Seated characters follow through their attachment.
    #[address(0x140_F4F_C60)]
    pub fn TeleportVehicle(&mut self, transform: *const Matrix4, p2: f32);

    /// The current yaw angle of the vehicle's weapon turret, read from the powered hinge controller
    /// of the turret part; `0` when the vehicle has no turret.
    #[address(0x140_F90_FC0)]
    pub fn GetWeaponTurretCurrentYawAngle(&self) -> f32;

    /// Sets the model matrix of every valid, unbroken part with a model to the part's
    /// [`m_RootSpaceTransform`](vehicle::parts::PartInstance::m_RootSpaceTransform) times
    /// `transform` (through `NPfxBreakable::ForEachValidRenderablePart`), then copies the root-space
    /// transforms of the parts that attached objects hang from into those attachments. A zero
    /// `dtf`, or a vehicle flagged to snap, initialises each model matrix instead of updating it.
    /// Called from
    /// `CVehicle::UpdateRender_Parallel` with
    /// [`m_InterpolatedWorldMatrix`](Self::m_InterpolatedWorldMatrix) on the parallel render update,
    /// and from `CVehicle::InitTransform`.
    #[address(0x140_F90_740)]
    pub fn UpdateRender_ModelMatrices(&mut self, transform: *const Matrix4, dtf: f32);

    /// Whether the vehicle is the rocket boat: [`m_VehicleTypeNameHash`](Self::m_VehicleTypeNameHash)
    /// equals the hash of `v1706_boat_na_rocketboat` (computed once and cached). The sea-vehicle
    /// input, water-contact, and player action contexts use it. IDA labels this address
    /// `CWeaponBase::MarkNextWeaponComponentForFire`, but every caller passes a vehicle; the name
    /// here is descriptive.
    #[address(0x140_F6F_8F0)]
    pub fn IsRocketBoat(&self) -> bool;

    /// Moves the landing gear and its hatches toward
    /// [`m_DesiredLandingGearState`](Self::m_DesiredLandingGearState), and plays the gear's attached
    /// effects as they open, close, and lock. While the local player drives, it first chooses the
    /// desired state itself: down while the vehicle is low over the ground, slower than a deploy
    /// speed that the throttle in [`m_SteeringAcceleration`](Self::m_SteeringAcceleration) moves
    /// between the vehicle's take-off and landing speeds, and not tilted past the vehicle's landing
    /// tilt in the air; up otherwise while airborne. There is no player input for the gear.
    #[address(0x140_F6F_1D0)]
    pub fn UpdateLandingGearVariables(&mut self, context: *const GameObjectUpdateContext);
}

/// A plane (`CAirPlane`): a [`Vehicle`] with fixed wings. Only some members are bound.
#[min_size(0x53A4)]
pub type AirPlane {
    /// The thrust input above which a plane's input reader feeds the nitrous
    /// ([`Vehicle::m_NitrousInput`]): the plane's nitrous is a full `PLANE_INC_TRUST` rather than an
    /// input of its own.
    pub const NITROUS_THRUST_THRESHOLD: f32 = 0.9,

    /// The plane's vehicle base.
    pub vehicle: Vehicle,
}
impl AirPlane {
    /// The plane's per-tick input reader, on top of the vehicle's own. Unless the plane is
    /// destroyed, its driver is knocked out or dead, an AI's input is stale, or it is under an EMP,
    /// it reads `action_map` (a `CActionMap`): the turn from `PLANE_TURN_LEFT` and
    /// `PLANE_TURN_RIGHT`, the roll from `PLANE_ROLL_LEFT` and `PLANE_ROLL_RIGHT`, the pitch from
    /// `PLANE_PITCH_UP` and `PLANE_PITCH_DOWN`, and the throttle into
    /// [`Vehicle::m_SteeringAcceleration`] and [`Vehicle::m_SteeringBrake`] (no acceleration while
    /// the movement is locked). With a living driver and the plane in control, a `PLANE_INC_TRUST`
    /// value above [`NITROUS_THRUST_THRESHOLD`](Self::NITROUS_THRUST_THRESHOLD) raises
    /// [`Vehicle::m_NitrousInput`] to it; otherwise the nitrous input is kept.
    #[address(0x141_060_950)]
    pub fn UpdateVehicleInputsFromActionMap(&mut self, action_map: *mut void);
}

/// `NStateTask_InputVehicleExitTask::TeleportUpwards`, run from the vehicle-exit animation event
/// callback: probes upward from the character with a raycast and a sphere collision test for clear
/// space, forces the neutral state, and relocates the character there directly rather than through
/// the physics proxy (the placement itself is inferred from the call shape).
#[address(0x140_81A_3C0)]
pub fn NStateTask_InputVehicleExitTask_TeleportUpwards(character: *mut Character);

/// The door slots of a vehicle (`NVehicle::EDoorSlot`): which opening a [`DoorInfo`] is. A slot
/// may hold several door parts that open together.
#[copyable]
pub enum DoorSlot: i32 {
    FRONT_LEFT = 0x0,
    FRONT_RIGHT = 0x1,
    REAR_LEFT = 0x2,
    REAR_RIGHT = 0x3,
    CENTER_LEFT = 0x4,
    CENTER_RIGHT = 0x5,
    TURRET_DOOR = 0x6,
    TRUNK = 0x7,
    HOOD = 0x8,
    REAR_DOOR = 0x9,
    CARGO_BAY_DOOR = 0xA,
    FOLDING_WING = 0xB,
    MISSILE_HATCH = 0xC,
}

/// A door's state (`NVehicle::EDoorState`), as [`DoorInfo::m_State`] and
/// [`DoorInfo::m_PendingState`] hold it.
#[copyable]
pub enum DoorState: i32 {
    /// Open: the part is loose on its hinge, swinging freely or held open by the hinge's motor.
    DOOR_OPEN = 0x0,
    /// Being turned open by the hinge's motor.
    DOOR_OPENING = 0x1,
    /// Being turned shut by the hinge's motor.
    DOOR_CLOSING = 0x2,
    /// The part broke off.
    DOOR_MISSING = 0x3,
    /// Closed: the part is merged into the vehicle's body. As a pending state, it means that no
    /// request is pending.
    DOOR_CLOSED = 0x4,
}

/// `CDoorInfo`: one door part of a vehicle's [`VehicleDoorController`] and its state. A closed door
/// is merged into the vehicle's body; opening it loosens the part onto the hinge constraint of the
/// vehicle's physics prototype, as a body of its own
/// ([`PartInstance::GetPfxVehiclePartIfAny`](vehicle::parts::PartInstance::GetPfxVehiclePartIfAny))
/// owned by a [`VehiclePartGameObject`](vehicle::parts::VehiclePartGameObject).
///
/// Each post-simulation update, the controller acts on [`m_PendingState`](Self::m_PendingState).
/// An opening request loosens the part
/// ([`PfxBreakable::EnablePart`](vehicle::parts::PfxBreakable::EnablePart) with
/// [`PartEventReason::EPER_PartOperated`](vehicle::parts::PartEventReason::EPER_PartOperated)),
/// and both requests convert the hinge to a powered one whose motor turns it toward the open or the
/// closed angle. A door that has opened stops its motor, unless it is kept open, and then swings
/// freely on its hinge. A freely swinging door whose hinge angle above its minimum
/// ([`PfxBreakable::GetHingeAngleAboveMin`](vehicle::parts::PfxBreakable::GetHingeAngleAboveMin))
/// falls below a small angle while it swings shut faster than a threshold speed is merged back into
/// the body (`CPartInstance::MergePart`): a door swung shut hard latches. A door the motor closes
/// is merged once it reaches its smallest angle. Only some members are bound.
#[size(0x50)]
pub type DoorInfo {
    /// The flag of [`m_Flags`](Self::m_Flags) an opening request that keeps the door open sets.
    pub const FLAG_KEEP_OPEN: u32 = 0x2,

    /// The state the controller moves the door to on its next update, or
    /// [`DoorState::DOOR_CLOSED`] when nothing is pending.
    pub m_PendingState: DoorState,
    pub m_State: DoorState,
    pub m_DoorSlot: DoorSlot,

    /// The door's part instance in the vehicle's physics body.
    #[address(0x10)]
    pub m_PartInstance: *mut PartInstance,

    /// The hinge's smallest angle, radians.
    #[address(0x1C)]
    pub m_HingeMinAngle_Rad: f32,
    /// The hinge's largest angle, radians.
    pub m_HingeMaxAngle_Rad: f32,

    /// The smallest angle a door kept open is held at, radians.
    #[address(0x28)]
    pub m_KeepOpenMinAngle_Rad: f32,
    /// A freely swinging door's hinge angle above its minimum on the controller's last update,
    /// degrees, from which it measures how fast the door swings shut.
    pub m_PreviousAngle_Deg: f32,

    #[address(0x3C)]
    pub m_Flags: u32,
}

/// `CVehicleDoorController`: a vehicle's doors ([`DoorInfo`]), kept in a
/// `std::map<NVehicle::EDoorSlot, std::vector<CDoorInfo>>` keyed by [`DoorSlot`], and updated from
/// the vehicle's post-simulation update. Only some members are bound.
#[min_size(0x28)]
pub type VehicleDoorController {
    /// The map's head node (`_Myhead`): its [`m_Parent`](DoorMapNode::m_Parent) is the tree's
    /// root, and the tree's leaf links point back at it.
    #[address(0x8)]
    pub m_DoorMapHead: *mut DoorMapNode,

    /// The vehicle the doors belong to.
    #[address(0x20)]
    pub m_Vehicle: *mut Vehicle,
}

/// One node of the red-black tree behind [`VehicleDoorController`]'s door map
/// (`std::_Tree_nod<...>::_Node`): a slot and its doors.
#[min_size(0x42)]
pub type DoorMapNode {
    pub m_Left: *mut DoorMapNode,
    pub m_Parent: *mut DoorMapNode,
    pub m_Right: *mut DoorMapNode,
    /// The slot this node holds.
    pub m_DoorSlot: DoorSlot,

    /// The first of the slot's doors (the vector's `_Myfirst`).
    #[address(0x20)]
    pub m_DoorsBegin: *mut DoorInfo,
    /// One past the last of the slot's doors (`_Mylast`).
    pub m_DoorsEnd: *mut DoorInfo,

    /// Whether the node is the head, the tree's sentinel, rather than a slot (`_Isnil`).
    #[address(0x41)]
    pub m_IsNil: bool,
}
