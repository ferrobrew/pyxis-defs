/// A Havok body (`hknpBody`): its transform, collision data, and the motion that moves it. Only
/// some members are bound.
#[size(0x90), align(16)]
pub type hknpBody {
    /// The [`m_flags`](Self::m_flags) bit of a static body. A slot with neither this nor
    /// [`IS_DYNAMIC`](Self::IS_DYNAMIC) holds no valid body, which is how
    /// [`PfxCharacterInstance::IsGroundBodyValid`] tells a body from an empty slot.
    pub const IS_STATIC: u32 = 0x1,
    /// The [`m_flags`](Self::m_flags) bit of a dynamic body, the only kind the velocity and impulse
    /// setters ([`hknpWorld::setBodyVelocity`], [`hknpWorld::applyBodyImpulseAt`]) act on.
    pub const IS_DYNAMIC: u32 = 0x2,
    /// The [`m_flags`](Self::m_flags) bit that has the solver raise a
    /// [`hknpContactImpulseEvent`](havok::hknpContactImpulseEvent) for the body's contacts.
    /// [`PfxRigidBody::SetContactImpulseEventActive`] sets and clears it.
    pub const RAISE_CONTACT_IMPULSE_EVENTS: u32 = 0x80,
    /// The [`m_flags`](Self::m_flags) bit of a keyframed body: one moved along a set path that
    /// collisions do not push. `CPfxCharacterInstance::IsGroundBodyStaticOrKeyFramed` tests it with
    /// [`IS_STATIC`](Self::IS_STATIC).
    pub const IS_KEYFRAMED: u32 = 0x4,
    /// The [`m_motionId`](Self::m_motionId) of a freed body slot.
    pub const INVALID_MOTION_ID: u32 = 0x7FFFFFFF,
    /// The [`m_broadPhaseId`](Self::m_broadPhaseId) of a body that is not in the broad phase: one
    /// created but not added to the simulation, or removed from it.
    pub const INVALID_BROAD_PHASE_ID: u32 = 0xFFFFFFFF,

    /// The body's transform, Havok space: the frame a constraint's pivots are given in
    /// ([`hkpFixedConstraintData::setInBodySpace`](havok::hkpFixedConstraintData::setInBodySpace)).
    #[address(0x0)]
    pub m_transform: hkTransformf,

    /// The body's flags; see [`IS_DYNAMIC`](Self::IS_DYNAMIC).
    #[address(0x40)]
    pub m_flags: u32,
    /// The body's collision-filter word, read by the world's collision filter; see
    /// [`CustomGroupCollisionFilter`] for its fields.
    pub m_collisionFilterInfo: u32,
    /// The body's collision shape, in body space. The body holds a reference of its own to it,
    /// taken from the construction info's shape
    /// ([`hknpBodyCinfo::m_shape`](havok::hknpBodyCinfo::m_shape)) when the body is created
    /// and released when it is destroyed, so several bodies may share one shape.
    pub m_shape: *mut hknpShape,
    /// The body's box in the broad phase, quantized into the world's integer space
    /// ([`hknpWorld::m_intSpaceUtil`]); [`hknpWorld::getBodyAabb`] restores it.
    pub m_aabb: hkAabb16,

    /// The body's motion in [`hknpWorld::m_motions`]; bodies attached to one another share it.
    #[address(0x68)]
    pub m_motionId: u32,
    /// The body's entry in the broad phase, or
    /// [`INVALID_BROAD_PHASE_ID`](Self::INVALID_BROAD_PHASE_ID) while it is not in the simulation.
    /// The engine's body wrapper reports a body as added to the world
    /// ([`PfxRigidBody::IsAddedToWorld`]) when it has an entry, or an addition pending.
    pub m_broadPhaseId: u32,
}

