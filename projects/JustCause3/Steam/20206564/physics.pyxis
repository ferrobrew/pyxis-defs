use character::character::Character;
use damage::DamageMsg;
use graphics_engine::model_instance::{Model, ModelInstance};
use havok::{hkAabb, hkAabb16, hkIntSpaceUtil, hkReferencedObject, hkSimdFloat32, hkTransformf, hknpBodyCinfo, hknpConstraintCinfo, hknpContactImpulseEvent, hknpMotionCinfo, hknpShape};
use types::math::{Matrix4, Vector3};
use types::shared_ptr::SharedPtr;
use types::vector_math::{AlignedQuat, AlignedVector3};

/// The physics system (`CPhysicsSystem`), a `Base::CSingle` singleton that owns the Havok world and
/// serves the engine's scene queries. The queries are sim-phase calls against the live Havok world.
/// Only some members are bound.
#[singleton(0x142_EDC_120), min_size(0x1381D0)]
pub type PhysicsSystem {
    /// The collision layer [`CastRaySimple`](Self::CastRaySimple) hardcodes, and the one the
    /// player's direct-aim query passes to [`CastRay`](Self::CastRay).
    pub const QUERY_LAYER: i32 = 21,
    /// The simulation step, seconds. [`Update`](Self::Update) steps the world once per call by
    /// exactly this, whatever time it is given. The value is stored once in the image and shared:
    /// [`Update`](Self::Update) loads it to pin its step, and the vehicles' parallel post-solve
    /// update reads it too.
    pub const STEP_SECONDS: f32 = 0.033333335,
    /// The intra-[`Update`](Self::Update) site of the step pin: after comparing the time it was
    /// given with [`STEP_SECONDS`](Self::STEP_SECONDS) and skipping ahead when they are equal, a
    /// `movaps` copies the constant over the time, so every step uses the constant. Without the
    /// copy the world steps by the time it was given, and the step global the pre-collision
    /// handler reads carries that time too.
    pub const UPDATE_STEP_PIN_OFFSET: u64 = 0xC3,
    /// The length in bytes of the `movaps` at [`UPDATE_STEP_PIN_OFFSET`](Self::UPDATE_STEP_PIN_OFFSET).
    pub const UPDATE_STEP_PIN_LENGTH: u64 = 3,

    /// The Havok world.
    #[address(0x30)]
    pub m_World: *mut hknpWorld,

    /// The world-origin shift: the Havok world is simulated about a moving origin, and a Havok-space
    /// position plus this offset is the game-space position. [`CastRay`](Self::CastRay) subtracts it
    /// from its game-space ray before the Havok query, and the engine adds it back to the positions
    /// a query reports. [`hknpWorld::applyBodyImpulseAt`] takes a Havok-space position.
    #[address(0x138_1C4)]
    pub m_AccumulatedShift: Vector3,
}
impl PhysicsSystem {
    /// Advances the physics by one step. It fires the pre-update signal, clears the collision
    /// array, and updates the bodies that do not simulate; then, unless one of its two suspend
    /// flags is set (`CGameStateRun::Update` sets one from its update context's pause), and when
    /// the world exists and `dt` is above a small threshold, it fires the pre-simulation callbacks
    /// ([`FirePreSimulationCallbacks`](Self::FirePreSimulationCallbacks)) with the world and `dt`
    /// as given, then replaces `dt` with [`STEP_SECONDS`](Self::STEP_SECONDS) when they differ
    /// (the pin at [`UPDATE_STEP_PIN_OFFSET`](Self::UPDATE_STEP_PIN_OFFSET)), and steps the world
    /// once by it on the physics thread pool, joining the pool before it returns. The game states'
    /// updates (`CGameStateRun::Update` and the loading and front-end states' updates) call it
    /// inline on the thread that runs them, through the physics update
    /// ([`GameState::UpdatePhysics`](game::GameState::UpdatePhysics) in the run state), which
    /// dispatches the queued collisions and the damage listeners' events after it.
    #[address(0x140_2D1_B40)]
    pub fn Update(&mut self, dt: f32);

    /// Calls every pre-simulation callback's
    /// [`preSimulationCallback`](PfxPreSimulationCallback::preSimulationCallback) with `world` and
    /// `dt`, in the order they were added, compacting away the entries
    /// [`RemovePreSimulationCallback`](Self::RemovePreSimulationCallback) cleared as it walks.
    /// [`Update`](Self::Update) calls it before the step with the time it was given, before that
    /// time is pinned to [`STEP_SECONDS`](Self::STEP_SECONDS).
    #[address(0x140_29C_9C0)]
    pub fn FirePreSimulationCallbacks(&mut self, world: *mut hknpWorld, dt: f32);

    /// Appends `callback` to the pre-simulation callbacks [`Update`](Self::Update) fires before
    /// each step, a plain `std::vector` push. The ragdolls, the grappling hook's wire, and the AI
    /// world register themselves this way. A callback added while the callbacks fire would
    /// invalidate the walk over them.
    #[address(0x140_2BE_A00)]
    pub fn AddPreSimulationCallback(&mut self, callback: *mut PfxPreSimulationCallback);

    /// Clears every entry of the pre-simulation callbacks that is `callback`. The entry is not
    /// erased at once: the next walk over the callbacks (before a step, or on a world shift)
    /// compacts the cleared entries away, so a callback may remove itself, or another, while they
    /// fire.
    #[address(0x140_286_FC0)]
    pub fn RemovePreSimulationCallback(&mut self, callback: *mut PfxPreSimulationCallback);

    /// The general ray query: casts `ray` (world space, normalized direction) from `min_fraction`
    /// out to `max_distance` along its direction against collision `layer`, returning whether it
    /// hit. `info`, when non-null, receives the closest hit; `filter`, when non-null, replaces the
    /// default hit filter (and can exclude materials or an instance); `flags` is a
    /// collision-filter-info word, `0` for a plain query. Backed by [`hknpWorld::castRay`].
    #[address(0x140_286_740)]
    pub fn CastRay(&mut self, ray: *const Ray3, min_fraction: f32, max_distance: f32, info: *mut CastRayInfoBase, filter: *mut RaycastFilter, flags: u32, layer: i32) -> bool;

    /// Whether the segment from `start` to `end` is blocked: builds the ray from the two points and
    /// calls [`CastRay`](Self::CastRay) with no hit info, the default filter, and
    /// [`QUERY_LAYER`](Self::QUERY_LAYER).
    #[address(0x140_286_BE0)]
    pub fn CastRaySimple(&mut self, start: *const Vector3, end: *const Vector3, flags: u32) -> bool;

    /// A ray query against the terrain only, with the parameters of [`CastRay`](Self::CastRay).
    #[address(0x140_286_CE0)]
    pub fn CastRayTerrain(&mut self, ray: *const Ray3, min_fraction: f32, max_distance: f32, info: *mut CastRayInfoBase) -> bool;

    /// Intersects the segment from `start` to `end` with the water surface, writing the hit point
    /// to `hit` and returning whether there was one.
    #[address(0x140_23C_150)]
    pub fn CastRayWaterSurface(&mut self, start: *const Vector3, end: *const Vector3, hit: *mut Vector3) -> bool;

    /// Collects every body overlapping a box of half extents `half_extents` placed by `transform`
    /// (game space), on collision `layer`, ignoring the bodies of collision system group
    /// `system_group`, into `collector` (an `hknpCollisionQueryCollector`); returns whether any
    /// overlapped. Each collected `hknpCollisionResult` carries the Havok-space position and the
    /// body id of one overlapping body. The player's melee hit message
    /// ([`Character::HandleTrackMessage`](character::character::Character::HandleTrackMessage))
    /// runs it with an `hknpAllHitsCollector` to find the objects in front of the character when no
    /// character is the target, then damages each hit object and pushes its body.
    #[address(0x140_29A_120)]
    pub fn CollideBox(&mut self, half_extents: *const Vector3, transform: *const Matrix4, system_group: u32, layer: u32, collector: *mut void) -> bool;

    /// Sweeps a sphere of `radius` from `start` to `end`, reporting hits to `collector` (an
    /// `hknpCollisionQueryCollector`).
    #[address(0x140_202_C90)]
    pub fn CastSphere(&mut self, start: *const Vector3, end: *const Vector3, radius: f32, p4: f32, collector: *mut void, filter_info: u32, p7: f32) -> bool;

    /// Sweeps an arbitrary Havok shape (`hknpShape*`) with the rotation `rotation` (`hkRotationf`)
    /// from `start` to `end`, reporting hits to `collector`.
    #[address(0x140_1F0_890)]
    pub fn CastShape(&mut self, start: *const Vector3, end: *const Vector3, p3: f32, shape: *const void, rotation: *const void, collector: *mut void, filter_info: u32, p8: f32) -> bool;
}

/// The water query interface (`CPhysicsSystem::IWaterProxy`) through which physics code reads
/// water heights, reached through [`PhysicsSystem_s_WaterQueryProxy`]. Only the first slot is bound.
pub type WaterProxy {
    vftable {
        /// The world sea level, the height of the open-sea water plane.
        /// [`PhysicsSystem::CastRayWaterSurface`] tests a segment against it after the water boxes.
        #[index(0)]
        pub fn GetWorldSeaLevel(&mut self) -> f32;
    },
}

/// `CPhysicsSystem::s_WaterQueryProxy`: the water query singleton buoyancy, water interaction,
/// vehicle fin forces, and the water-surface ray query read water heights from.
#[address(0x142_EDC_230)]
pub extern PhysicsSystem_s_WaterQueryProxy: *mut WaterProxy;

/// A ray (`CRay3`): an origin and a direction, both world space when passed to
/// [`PhysicsSystem::CastRay`].
#[copyable, size(0x18), align(4)]
pub type Ray3 {
    pub Origin: Vector3,
    /// The ray direction; the queries expect it normalized.
    pub Direction: Vector3,
}

/// Material pass bits of a [`RaycastFilter`]'s material masks. Game materials carry per-pass
/// "holey" flags (a bullet passes foliage, a ray passes glass, and similar); a filter that sets a
/// bit in its ignore mask does not stop at materials flagged for that pass.
#[copyable]
pub bitflags MaterialPassFlags: u32 {
    /// Materials a bullet passes through. Set by
    /// [`IgnoreMaterialFlagFilter::SetIgnoreBulletPass`].
    BULLET_PASS = 0x20,
    /// Materials the camera passes through. Set by
    /// [`IgnoreMaterialFlagFilter::SetIgnoreCameraPass`].
    CAMERA_PASS = 0x40,
    /// Materials a ray passes through. Set by [`IgnoreMaterialFlagFilter::SetIgnoreRayPass`].
    RAY_PASS = 0x80,
}

/// The engine's closest-hit ray filter (`CRaycastFilter`, derived from Havok's
/// `hknpClosestHitCollector`): collects the closest hit while skipping ignored materials and one
/// ignored instance.
#[size(0xC0), align(16)]
pub type RaycastFilter {
    /// Materials whose pass flags are in this mask do not count as hits.
    #[address(0x90)]
    pub m_IgnoreMaterialMask: MaterialPassFlags,
    /// Materials whose pass flags are in this mask always count as hits.
    pub m_ForceMaterialMask: MaterialPassFlags,
    /// An instance the query never hits (`IPfxInstance*`), such as the caster's own proxy.
    pub m_IgnorePfxInstance: *mut void,

    /// The Havok world the filter resolves bodies in; the physics system's world when constructed
    /// with null.
    #[address(0xB0)]
    pub m_World: *const hknpWorld,
}
impl RaycastFilter {
    /// `CRaycastFilter::CRaycastFilter`: constructs the filter with its two material masks, the
    /// instance to ignore (may be null), and the world (null selects [`PhysicsSystem::m_World`]).
    #[address(0x140_1FC_BA0)]
    pub fn Construct(&mut self, ignore_material_mask: MaterialPassFlags, force_material_mask: MaterialPassFlags, ignore_instance: *mut void, world: *const hknpWorld) -> *mut RaycastFilter;
}

/// A [`RaycastFilter`] whose ignore mask is set pass by pass (`CIgnoreMaterialFlagFilter`).
#[size(0xC0), align(16)]
pub type IgnoreMaterialFlagFilter {
    #[base]
    pub base: RaycastFilter,
}
impl IgnoreMaterialFlagFilter {
    /// Sets or clears [`BULLET_PASS`](MaterialPassFlags::BULLET_PASS) in the ignore mask.
    #[address(0x140_B86_840)]
    pub fn SetIgnoreBulletPass(&mut self, ignore: bool);

    /// Sets or clears [`RAY_PASS`](MaterialPassFlags::RAY_PASS) in the ignore mask.
    #[address(0x140_B86_860)]
    pub fn SetIgnoreRayPass(&mut self, ignore: bool);

    /// Sets or clears [`CAMERA_PASS`](MaterialPassFlags::CAMERA_PASS) in the ignore mask.
    #[address(0x140_B86_880)]
    pub fn SetIgnoreCameraPass(&mut self, ignore: bool);
}

/// The result of a ray query (`CCastRayInfoBase`): the hit normal and fraction, and the hit object
/// and body. [`PhysicsSystem::CastRay`] fills it from the query's closest hit, and on a miss sets the
/// fraction to one and clears the object. Engine callers construct it on the stack: the
/// [`VFTABLE`](Self::VFTABLE) pointer, a null [`m_HitObjectId`](Self::m_HitObjectId), then
/// [`Reset`](Self::Reset).
#[size(0x38), align(8)]
pub type CastRayInfoBase {
    /// The address of the `CCastRayInfoBase` virtual table.
    pub const VFTABLE: u64 = 0x142343F08,

    pub __vftable: u64,

    /// The surface normal at the hit.
    #[address(0x8)]
    pub m_Normal: Vector3,

    /// The hit's position along the queried segment, as a fraction of the segment from the query's
    /// start distance to its end distance; one on a miss.
    #[address(0x14)]
    pub m_HitDistance: f32,

    /// The object id (`SObjectID`) of the hit object, or null for world geometry.
    #[address(0x18)]
    pub m_HitObjectId: u64,

    /// The Havok body id of the hit body.
    #[address(0x30)]
    pub m_BodyId: u32,
}
impl CastRayInfoBase {
    /// Clears the result for reuse: a unit normal and fraction, a null object, an invalid body,
    /// then the virtual hit-object setter with null. It calls through the virtual table, which must
    /// already be set.
    #[address(0x140_255_8C0)]
    pub fn Reset(&mut self);

    /// Whether the hit material lets bullets pass
    /// ([`BULLET_PASS`](MaterialPassFlags::BULLET_PASS)); false for two special material ids.
    #[address(0x140_23B_DF0)]
    pub fn DidHitBulletPassMaterial(&self) -> bool;
}

/// A [`CastRayInfoBase`] that records the hit object and resolves the hit material on demand
/// (`CCastRayInfo`). Engine callers construct the base first and then switch the virtual table to
/// [`VFTABLE`](Self::VFTABLE) and clear [`m_GameObject`](Self::m_GameObject).
#[size(0x48), align(8)]
pub type CastRayInfo {
    /// The address of the `CCastRayInfo` virtual table.
    pub const VFTABLE: u64 = 0x1423452C8,

    #[base]
    pub base: CastRayInfoBase,

    /// The hit object: the [`PhysicsGameObject`] that owns the hit physics instance (for a
    /// character, the `CCharacter`), written by the virtual hit-object setter [`PhysicsSystem::CastRay`] calls. Null
    /// for world geometry and on a miss.
    #[address(0x38)]
    pub m_GameObject: *mut void,
}
impl CastRayInfo {
    /// `CCastRayInfo::GetHitMaterial` (a virtual): the hit shape's game material
    /// (`EGameMaterialId`), looked up through the physics system's world.
    #[address(0x140_2B3_BA0)]
    pub fn GetHitMaterial(&self) -> i32;
}

/// A game material (`EGameMaterialId`): the surface kind a physics shape is tagged with, which
/// picks the impact effects and sounds played against it. Only the values the melee hit's impact
/// lookup uses are bound.
#[copyable]
pub enum GameMaterialId: u32 {
    /// A character's body, the material a melee hit on a character plays its impact against.
    EGameMaterialId_Flesh = 0x19,
    /// The fallback material: a lookup with no entry for a material uses this one's.
    EGameMaterialId_Default = 0x1F,
}

/// The physics system's global collision listener. Contact impulse dispatch resolves both body
/// instances and calls each instance's event virtual when its subscription flag is active.
pub type HavokCollisionListener;
impl HavokCollisionListener {
    /// Dispatches a contact impulse event without modifying the contact's solver impulses.
    #[address(0x140_1CE_500)]
    pub fn onContactImpulseEvent(&mut self, input: *const void, event: *const hknpContactImpulseEvent);
}

impl hknpWorld {
    /// Adds collision flags and rebuilds collision caches when `rebuild_mode` selects rebuilding.
    /// The disassembler labels this function as a rigid-body constructor.
    #[address(0x141_4CE_4C0)]
    pub fn enableBodyFlags(&mut self, body: u32, flags: u32, rebuild_mode: i32);

    /// Removes collision flags and rebuilds collision caches when `rebuild_mode` selects rebuilding.
    /// The disassembler labels this function as a signal subscription.
    #[address(0x141_4CE_550)]
    pub fn disableBodyFlags(&mut self, body: u32, flags: u32, rebuild_mode: i32);
}

/// A physics game object (`CPhysicsGameObject`): a game object with a physics instance, the owner a
/// physics query reports for a hit body ([`CastRayInfo::m_GameObject`]). Characters, vehicles,
/// and rigid props are physics game objects. Its `CGameObject` subobject sits at
/// [`GAME_OBJECT_BASE_OFFSET`](Self::GAME_OBJECT_BASE_OFFSET), and its run-time type test goes
/// through that subobject ([`GameObject::IsType`](game::GameObject::IsType)). Only one virtual is
/// bound.
pub type PhysicsGameObject {
    /// The offset of the `CGameObject` subobject.
    pub const GAME_OBJECT_BASE_OFFSET: u64 = 0x8,

    vftable {
        /// The object's engine physics instance, or null. A rigid object
        /// ([`RigidObject`]) returns its one body's wrapper, a [`PfxRigidBody`], whose
        /// [`PfxInstance::m_GameObject`] is the object.
        #[index(1)]
        pub fn GetIPfxInstance(&mut self) -> *mut PfxInstance;

        /// How the grapple treats the object; see [`GrapplingMode`]. The player aim reads it for
        /// the grapple slot's direct hit
        /// ([`PlayerAimControl::m_DirectGrapplePosIsGrapplable`](aim::aim::PlayerAimControl::m_DirectGrapplePosIsGrapplable)),
        /// and a wire end's attach refuses an ungrapplable object
        /// ([`WireEnd::SetupProxyForAttachment`](equipment::wire_end::WireEnd::SetupProxyForAttachment)).
        #[index(13)]
        pub fn GetGrapplingMode(&self) -> GrapplingMode;

        /// Takes the damage in `msg` and returns the damage dealt. Each kind of object overrides
        /// it: a character (`CCharacter::OnDamage`) takes the health, sends the hit effects, and
        /// runs its hit reaction from the message's impulse, position, and direction; a rigid
        /// object (`CRigidObject::OnDamage`) takes the health of its damage controller.
        #[index(20)]
        pub fn OnDamage(&mut self, msg: *mut DamageMsg) -> i16;
    },
}

/// How the grapple treats a physics game object (`CPhysicsGameObject::EGrapplingMode`), from
/// [`PhysicsGameObject::GetGrapplingMode`].
#[copyable]
pub enum GrapplingMode: i32 {
    E_GM_Normal = 0x0,
    /// Grapplable, without attaching at the end of a reel. A weapon's mode
    /// ([`WeaponBase::GetGrapplingModeWeapon`](equipment::weapon::WeaponBase::GetGrapplingModeWeapon)).
    E_GM_ReelInNoAttach = 0x1,
    /// Not grapplable: the aim does not count it, and a wire end does not attach to it.
    E_GM_UnGrappable = 0x2,
}

/// The ragdoll's proxy phantom (`CRagdollProxyPhantom`), the shape set that stands in for a
/// character's ragdoll bodies in hit tests. Only one method is bound.
pub type RagdollProxyPhantom;
impl RagdollProxyPhantom {
    /// The name hash of the ragdoll part a ray hit (the hit's shape key matched against the
    /// phantom's shapes), or `0` when the hit is not one of them. `CCharacter::OnDamage` uses it to
    /// find the body part a hit struck.
    #[address(0x140_3E4_8E0)]
    pub fn GetHitNameHash(&mut self, info: *const CastRayInfoBase) -> u32;
}

/// The Havok physics world (`hknpWorld`, Havok Physics 2014.1). Its body manager is embedded at
/// the start; bodies and motions live in arrays indexed by body id and motion id. Only some members
/// are bound.
#[min_size(0x1C0), align(16)]
pub type hknpWorld {
    /// Rebuild the body's collision caches after changing flags.
    pub const REBUILD_COLLISION_CACHES: i32 = 0,
    /// The body property that holds a body's engine instance ([`PfxInstance`]), as the physics
    /// queries read it to report the body's owner.
    pub const BODY_PROPERTY_PFX_INSTANCE: u16 = 1,

    /// The body manager's body array, indexed by body id. A body id below or at
    /// [`m_peakBodyIndex`](Self::m_peakBodyIndex) has a slot; a freed slot's
    /// [`hknpBody::m_motionId`] is [`hknpBody::INVALID_MOTION_ID`].
    #[address(0x20)]
    pub m_bodies: *mut hknpBody,

    /// The body manager's property buffers: per-property arrays indexed by body id, looked up by
    /// property key ([`hknpBodyPropertyMap::getWithDefault`]).
    #[address(0x58)]
    pub m_bodyProperties: hknpBodyPropertyMap,

    /// The highest body id the body manager has allocated.
    #[address(0x70)]
    pub m_peakBodyIndex: u32,

    /// The motion manager's motion array, indexed by [`hknpBody::m_motionId`].
    #[address(0xE0)]
    pub m_motions: *mut hknpMotion,

    /// The world's constraints.
    #[address(0x120)]
    pub m_constraintManager: hknpConstraintManager,

    /// The mapping between Havok space and the integer space the broad phase keeps the bodies'
    /// boxes in ([`hknpBody::m_aabb`]).
    #[address(0x180)]
    pub m_intSpaceUtil: hkIntSpaceUtil,
}
impl hknpWorld {
    /// Removes the bodies from the simulation, notifies the world's body-destroyed listeners,
    /// detaches their motions, releases their shape references, and schedules their slots for
    /// deletion. `activation_mode` is forwarded to the removal of the bodies.
    #[address(0x141_4EA_080)]
    pub fn destroyBodies(&mut self, ids: *const u32, count: i32, activation_mode: i32);

    /// Creates a constraint from `cinfo`, writes its id to `out`, and returns `out`. A constraint
    /// whose two bodies are the same, or whose data is of a type the world does not support, is
    /// created disabled; otherwise it is enabled at once. The constraint takes a reference of its
    /// own to the data (`hknpConstraint::init`, which the disassembler names
    /// `hknpWorldEx::handleConstraintActivationMode`), so the engine's callers, which allocate the
    /// data from the Havok heap, release their own reference once the constraint exists. The
    /// world's constraint collision filter keeps the two bodies of an enabled constraint from
    /// colliding. The engine's own users destroy their constraints before they replace or destroy
    /// the constrained bodies.
    #[address(0x141_4E7_200)]
    pub fn createConstraint(&mut self, out: *mut u32, cinfo: *const hknpConstraintCinfo) -> *mut u32;

    /// Destroys the `count` constraints whose ids are at `ids`, firing the world's
    /// constraint-disabled signal for those that were enabled and a second signal for each. Each
    /// constraint releases its reference to its data, which destroys data no one else holds, and
    /// its slot goes onto the manager's destroyed list with its first body set to
    /// [`hknpConstraint::INVALID_BODY_ID`]; the manager reuses destroyed ids once its free ones
    /// run out.
    #[address(0x141_4E7_370)]
    pub fn destroyConstraints(&mut self, ids: *const u32, count: i32);

    /// The solve half of a step (`*solver_data` from the collide half, `hknpSolverData`): it
    /// generates the solve's task graphs, runs a graph of one task on the calling thread and any
    /// other on `task_queue` (`hkTaskQueue`), joining it, and repeats until no task remains. The
    /// last graph is the post-solve phase alone, which dispatches the step's events, so the
    /// world's event listeners run on the calling thread, inside the step.
    /// [`PhysicsSystem::Update`] calls it on the game thread.
    #[address(0x141_4ED_B40)]
    pub fn stepSolve(&mut self, solver_data: *mut *mut void, task_queue: *mut void);

    /// Creates a dynamic body from `cinfo` with a new motion from `motion_cinfo`, writes the new
    /// body id to `out`, and returns `out`. The body takes its own reference to the shape. With
    /// [`DO_NOT_ADD`](hknpAdditionMode::DO_NOT_ADD) the body exists but is not in the simulation
    /// until it is added; any other `mode` adds it through the world's body addition with `flags`.
    /// The disassembler names the body creation it calls `hknpWorld::setBodyShape`.
    #[address(0x140_1E9_B20)]
    pub fn createDynamicBody(&mut self, out: *mut u32, cinfo: *const hknpBodyCinfo, motion_cinfo: *const hknpMotionCinfo, mode: hknpAdditionMode, flags: u8) -> *mut u32;

    /// Casts a ray query (`hknpRayCastQuery`) and reports hits to `collector`
    /// (`hknpCollisionQueryCollector`).
    #[address(0x141_500_BE0)]
    pub fn castRay(&self, query: *const void, collector: *mut void);

    /// Applies the linear impulse `impulse` to the body `body_id` at the Havok-space point
    /// `position` (the game-space point less [`PhysicsSystem::m_AccumulatedShift`]), changing both
    /// its linear and angular velocity, and wakes the body if it sleeps. It acts only on a dynamic
    /// body: a static or keyframed body is left alone. The linear velocity gains the impulse times
    /// the inverse mass; the angular velocity gains the impulse's moment about the centre of mass,
    /// turned into the motion's frame and scaled axis by axis by the inverse inertia
    /// ([`hknpMotion::m_inverseInertia`]).
    #[address(0x141_4CC_B30)]
    pub fn applyBodyImpulseAt(&mut self, body_id: u32, impulse: *const AlignedVector3, position: *const AlignedVector3);

    /// Sets the linear and angular velocity (world space, the angular one rotated into the
    /// motion's frame) of the dynamic body `body_id`'s motion, waking the body if it sleeps. A body
    /// that is not dynamic is left alone, and so is a call that changes neither velocity. The
    /// disassembler mislabels it `hknpWorld::getBodyVelocity`.
    #[address(0x141_4CC_540)]
    pub fn setBodyVelocity(&mut self, body_id: u32, linear: *const AlignedVector3, angular: *const AlignedVector3);

    /// Sets the linear velocity (world space) of the dynamic body `body_id`'s motion, waking the
    /// body if it sleeps; as [`setBodyVelocity`](Self::setBodyVelocity) for the linear part.
    #[address(0x141_4CC_710)]
    pub fn setBodyLinearVelocity(&mut self, body_id: u32, linear: *const AlignedVector3);

    /// Sets the angular velocity (world space) of the dynamic body `body_id`'s motion, waking the
    /// body if it sleeps; as [`setBodyVelocity`](Self::setBodyVelocity) for the angular part.
    #[address(0x141_4CC_7D0)]
    pub fn setBodyAngularVelocity(&mut self, body_id: u32, angular: *const AlignedVector3);

    /// Replaces the shape (`hknpShape*`) of the body `body_id` on the live world.
    #[address(0x141_4CF_370)]
    pub fn setBodyShape(&mut self, body_id: u32, shape: *const void);

