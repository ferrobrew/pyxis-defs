/// The engine's collision layers (`EPfxLayer`), the low field of a body's collision-filter word
/// ([`CustomGroupCollisionFilter`]). The physics system's constructor fills the filter's layer table
/// with the pairs of layers that collide; only the layers in it collide at all. The query layers
/// (the raycast and shape-query layers) are what a query passes as its own layer.
pub enum PfxLayer: u32 {
    /// Collides with everything.
    FULL_COLLISION = 0x0,
    /// Collides with nothing. [`PfxRigidBody::Construct`] gives a new wrapper's body this layer.
    NO_COLLISION = 0x1,
    STATIC = 0x2,
    TERRAIN = 0x3,
    DYNAMIC = 0x4,
    DESTRUCTION = 0x5,
    /// The character proxies, the player's included.
    CHARACTER_COLLISION = 0x6,
    CHARACTER_GHOST_MODE = 0x7,
    CHARACTER_RAGDOLL = 0x8,
    CHARACTER_RAGDOLL_KEYFRAMED = 0x9,
    CHARACTER_ATTACHED_DYNAMIC_RB = 0xA,
    CHARACTER_RAGDOLL_PROXIES = 0xB,
    PARTICLE = 0xC,
    EXPLOSIVE = 0xD,
    PROJECTILE = 0xE,
    /// Weapons. It collides with the static, terrain, dynamic, destruction, character collision,
    /// character ragdoll, and character-attached dynamic layers, the vehicle collision layers, the
    /// vehicle raycast layer, and the listener-effects layer, and with nothing else: not with
    /// itself, and not with the raycast or shape-query layers.
    WEAPONS = 0xF,
    VEHICLE_COLLISION_WHEEL = 0x10,
    VEHICLE_COLLISION_DYNAMIC_ONLY = 0x11,
    VEHICLE_COLLISION = 0x12,
    VEHICLE_RAYCAST = 0x13,
    RAYCAST_DEFAULT = 0x14,
    /// The layer of [`PhysicsSystem::QUERY_LAYER`].
    RAYCAST_EVERYTHING_PHYSICAL = 0x15,
    RAYCAST_WHEELS = 0x16,
    SHAPEQUERY_DEFAULT = 0x17,
    SHAPEQUERY_TRIGGER = 0x18,
    SHAPEQUERY_EXPLOSION = 0x19,
    SHAPEQUERY_VEHICLES = 0x1A,
    STATIC_AND_DESTRUCTION = 0x1B,
    ALL_DYNAMIC_OBJECTS = 0x1C,
    LISTENER_EFFECTS = 0x1D,
}

/// The world's collision filter (`CCustomGroupCollisionFilter`), behind the constraint collision
/// filter that also keeps constrained bodies apart. It reads each body's collision-filter word
/// ([`hknpBody::m_collisionFilterInfo`]), whose fields are the layer
/// ([`LAYER_MASK`](Self::LAYER_MASK), a [`PfxLayer`]), the subsystem id and the no-collide id (each
/// [`FIELD_MASK`](Self::FIELD_MASK) wide, from [`SUBSYSTEM_SHIFT`](Self::SUBSYSTEM_SHIFT) and
/// [`NO_COLLIDE_SHIFT`](Self::NO_COLLIDE_SHIFT)), and the system group (from
/// [`SYSTEM_GROUP_SHIFT`](Self::SYSTEM_GROUP_SHIFT)). Two bodies in different system groups, or in
/// system group zero, collide when the layer table says their layers do. Two bodies in the same
/// non-zero system group collide only when their layers are equal, at least one has a non-zero
/// subsystem id, and neither's subsystem id is the other's no-collide id. Only the word's layout is
/// bound.
pub type CustomGroupCollisionFilter {
    /// The layer field of a collision-filter word.
    pub const LAYER_MASK: u32 = 0x1F,
    /// The width of the subsystem-id and no-collide-id fields.
    pub const FIELD_MASK: u32 = 0x1F,
    /// Where the subsystem-id field begins.
    pub const SUBSYSTEM_SHIFT: u32 = 5,
    /// Where the no-collide-id field begins.
    pub const NO_COLLIDE_SHIFT: u32 = 10,
    /// Where the system-group field, the word's high half, begins.
    pub const SYSTEM_GROUP_SHIFT: u32 = 16,
}

/// `hknpWorld::AdditionMode`: whether [`hknpWorld::createDynamicBody`] adds the new body to the
/// simulation. Only the value that leaves it out is bound.
pub enum hknpAdditionMode: i32 {
    /// The body is created but not added; it is added later, as [`PfxRigidBody::AddToWorld`]
    /// does.
    DO_NOT_ADD = 0x0,
}

/// A pre-simulation callback (`CPfxPreSimulationCallback`), an object the physics system calls
/// before each step ([`PhysicsSystem::AddPreSimulationCallback`]). The engine never deletes one;
/// its owner removes it ([`PhysicsSystem::RemovePreSimulationCallback`]) and frees it.
pub type PfxPreSimulationCallback {
    vftable {
        /// The destructor.
        #[index(0)]
        pub fn Destructor(&mut self, flags: u8);

        /// Called by [`PhysicsSystem::Update`] before each step, on the thread that runs it, with
        /// the world and the time the update was given (not the step it takes, which is pinned to
        /// [`PhysicsSystem::STEP_SECONDS`] after the callbacks), outside the step: the world may be changed
        /// here, and the step that follows integrates the velocities set here. The callbacks fire
        /// in the order they were added.
        #[index(1)]
        pub fn preSimulationCallback(&mut self, world: *mut hknpWorld, dt: f32);

        /// Called when the world's origin moves (`CPhysicsSystem::RecenterWorld`), after every
        /// body has been moved, with the shift added to every Havok-space position. A callback
        /// that keeps Havok-space positions of its own moves them here.
        #[index(2)]
        pub fn onWorldShiftCallback(&mut self, shift: *const AlignedVector3);
    },
}

/// `SweptSphereCast`: a free-function sphere sweep that fills `result` (`CCastResult`). The
/// meaning of its scalar parameters is not established.
#[address(0x140_738_670)]
pub fn SweptSphereCast(p0: f32, p1: f32, p2: f32, p3: f32, p4: f32, p5: f32, v0: *const Vector3, v1: *const Vector3, p8: f32, p9: bool, result: *mut void);

/// Rotates `from` toward `to` by the fraction `t` of the angle between them (about the axis of the
/// shortest-arc rotation), writing the result to `out`. When the two directions are within the
/// `0.99` dot-product threshold it writes `to` unchanged. The swim movement cores call it.
#[address(0x140_775_620)]
pub fn SlerpAroundAxis(from: *const Vector3, to: *const Vector3, t: f32, out: *mut Vector3);

/// Rotates `from` toward `to` along the shortest arc, writing the result to `out`. It takes the
/// rotation from `from` to `to` as an angle-axis pair and applies
/// `min(angle / 0.2617994, 1) * rate` of it, so the step eases out as the two directions converge.
/// Note that the step is **not** clamped to the remaining angle: a `rate` above 0.2617994 radians
/// (15 degrees) overshoots the target, and one above twice that diverges. It logs `"UHOH!"` when
/// the two directions are more than about 162 degrees apart, where the rotation axis is
/// ill-conditioned.
///
/// The swim locomotion family calls it from two places per frame, for two different quantities:
///
/// - [`UpdateSurfaceMovement`](input::swim::UpdateSurfaceMovement) and
///   [`UpdateUnderwaterMovement`](input::swim::UpdateUnderwaterMovement) rotate the character's
///   current forward toward the desired direction (the world move direction from
///   [`ControllerUtility::TransformInputDirToWorldDir`](input::controller_utility::ControllerUtility::TransformInputDirToWorldDir)
///   while moving, the aim-target direction while aiming, the grapple target while reeling, or the
///   current forward when the stick is neutral). The result is the `direction` argument to
///   `CMatrix4f::CreateOrientation`, so **this call is what turns the body**.
/// - [`ProcessMotion`] slerps the character's current velocity direction toward the wanted one.
#[address(0x140_775_4F0)]
pub fn DoRotate(from: *const Vector3, to: *const Vector3, rate: f32, out: *mut Vector3);

/// Turns a wanted velocity into the velocity actually applied this frame: it slerps the direction
/// of `current_vel` toward the direction of `wanted_vel` through [`DoRotate`], limited to
/// `slerp_delta_angle` radians, then rescales the result to the horizontal magnitude of
/// `wanted_vel`. Either direction falls back to the character's world-matrix forward when it is
/// degenerate, and `xz_only` flattens both onto the ground plane first. `dt` is unused: the
/// magnitude comes from `wanted_vel`, not from integration. The surface swim movement core uses it
/// to keep a swimmer's motion from snapping direction when the stick swings.
#[address(0x140_775_760)]
pub fn ProcessMotion(character: *mut Character, dt: f32, current_vel: *const Vector3, wanted_vel: *const Vector3, slerp_delta_angle: f32, xz_only: bool, vel_out: *mut Vector3);
