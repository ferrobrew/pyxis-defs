pub enum ProxyState: i32 {
    STANDING = 0x0,
    CROUCHING = 0x1,
    SWIMMING = 0x2,
    ROTATED_AND_OFFSETTED = 0x3,
    ROTATING_CROUCHING = 0x4,
    QUADRUPED_LARGE = 0x5,
    QUADRUPED_SMALL = 0x6,
    QUADRUPED_TINY = 0x7,
    PLAYER_STANDING = 0x8,
    WINGSUITING = 0x9,
}

/// The character proxy's shared shape settings (`CPfxCharacterSettings`): a shape for each
