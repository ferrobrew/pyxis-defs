use types::math::Matrix4;
use types::shared_ptr::WeakPtrGameObject;

#[singleton(0x142_E22_E68), min_size(0x2C0)]
pub type Game {
    /// The intra-`Update` site at which the game's per-frame render bookkeeping starts: the
    /// [`E_GUF_RENDER`](GameUpdateFlags::E_GUF_RENDER) check (the `jz`) that normally gates `UpdateRender` (and everything
    /// after it) on the frame-pacing mode sits here.
    pub const UPDATE_RENDER_GATE_OFFSET: u64 = 0x787,
    /// The intra-`Update` site at which the render bookkeeping ends: `++m_RenderCount`, the last
    /// step of the `UpdateRender` tail.
    pub const UPDATE_RENDER_LENGTH_OFFSET: u64 = 0x7A2,
    /// The [`m_InterpolationOverride`](Self::m_InterpolationOverride) value meaning no override:
    /// the method chosen each frame stands.
    pub const INTERPOLATION_OVERRIDE_NONE: i32 = -1,
    /// The [`m_PrevInterpolationMethod`](Self::m_PrevInterpolationMethod) value written when the
    /// frame takes the paused path; it matches no method, so the next unpaused frame resets the
    /// accumulators.
    pub const INTERPOLATION_METHOD_PAUSED: u32 = 0xFFFFFFFF,
    /// The [`m_InterpolationMethod`](Self::m_InterpolationMethod) chosen during gameplay: the
    /// fractional sim step accumulates in `m_RunningFrameFraction` and [`UpdateGame`](Self::UpdateGame)
    /// runs at most once per render frame. The method names are descriptive; the engine uses bare
    /// integers.
    pub const INTERPOLATION_METHOD_SINGLE_STEP: u32 = 1,
    /// The [`m_InterpolationMethod`](Self::m_InterpolationMethod) chosen while a cutscene plays:
    /// the same accumulator, but [`UpdateGame`](Self::UpdateGame) runs once per whole step
    /// accumulated, subtracting one per update, up to [`Game_MaxGameUpdatesPerRender`] a frame;
    /// the frame's contribution to the accumulator is capped at the same count, so a frame that
    /// would need more ticks loses the time. A filtered-timer guard drops the frame to one tick
    /// when the recent ticks took longer than a step.
    pub const INTERPOLATION_METHOD_ACCUMULATED: u32 = 2,
    /// The [`m_InterpolationMethod`](Self::m_InterpolationMethod) that derives the number of sim
    /// steps from `QueryPerformanceCounter` wall-clock time since the method was entered, running
    /// several [`UpdateGame`](Self::UpdateGame) calls per frame when rendering falls behind. Only
    /// reachable through [`m_InterpolationOverride`](Self::m_InterpolationOverride).
    pub const INTERPOLATION_METHOD_TIME_BASED: u32 = 3,

    #[address(0x10)]
    pub m_CountAccumulator: u64,
    /// The sim tick rate, ticks per second. The constructor writes 30 here and into
    /// [`m_DefaultUpdateFrequency`](Self::m_DefaultUpdateFrequency). [`Update`](Self::Update)
    /// reads it every frame (raising it to 1 when it is not positive): the step it derives,
    /// one over this rate, is each tick's `m_Dt` and `m_OriginalDt` in the update context, and the
    /// rate the clock is forced to for the duration of the sim. Writing it changes the tick from
    /// the next frame on. [`PhysicsSystem::Update`](physics::PhysicsSystem::Update) does not
    /// follow it: it steps the world by its own fixed step.
    pub m_UpdateFrequency: u32,
    /// The tick rate the constructor sets, kept beside [`m_UpdateFrequency`](Self::m_UpdateFrequency).
    pub m_DefaultUpdateFrequency: u32,

    #[address(0x34)]
    pub m_Exit: u8,

    #[address(0x80)]
    pub m_FilteredDrawTime: u64,

    #[address(0x94)]
    pub m_RenderCount: u32,
    /// The frame-pacing method [`Update`](Self::Update) uses this frame, rechosen every frame:
    /// [`INTERPOLATION_METHOD_ACCUMULATED`](Self::INTERPOLATION_METHOD_ACCUMULATED) while a cutscene
    /// plays, [`INTERPOLATION_METHOD_SINGLE_STEP`](Self::INTERPOLATION_METHOD_SINGLE_STEP) otherwise,
    /// or [`m_InterpolationOverride`](Self::m_InterpolationOverride) when that is non-negative.
    pub m_InterpolationMethod: u32,
    /// The method used on the previous frame; a change resets the accumulators. Set to
    /// [`INTERPOLATION_METHOD_PAUSED`](Self::INTERPOLATION_METHOD_PAUSED) when the frame takes the
    /// paused path.
    pub m_PrevInterpolationMethod: u32,
    /// A console override for [`m_InterpolationMethod`](Self::m_InterpolationMethod);
    /// [`INTERPOLATION_OVERRIDE_NONE`](Self::INTERPOLATION_OVERRIDE_NONE) when unset.
    pub m_InterpolationOverride: i32,

    /// The simulation dispatch counter, incremented by [`UpdateGame`](Self::UpdateGame) before
    /// the active state's update. Render-only updates do not advance it.
    #[address(0x1D0)]
    pub m_FrameCounter: u64,

    #[address(0x260)]
    pub m_DecoupleEnabled: bool,

    /// The [`GameUpdateFlags`] bit set gating the phases of [`Update`](Self::Update): the sim
    /// step, the render-bookkeeping step, and the tools step.
    #[address(0x2B8)]
    pub m_UpdateFlags: u32,
}
impl Game {
    /// `CGame::~CGame`: tears down the message-box manager, the game resource cache and handler,
    /// the profiler utility, and the version display.
    #[address(0x140_967_600)]
    pub fn Destructor(&mut self);

    #[address(0x140_952_390)]
    pub fn Draw(&self, dt: f32);

    /// The top-level per-frame update: advances the sim and drives rendering. Returns false on exit.
    ///
    /// Each frame it derives the sim step as one over [`m_UpdateFrequency`](Self::m_UpdateFrequency),
    /// builds the update contexts with that step as their `m_Dt`, and, while
    /// [`E_GUF_UPDATE`](GameUpdateFlags::E_GUF_UPDATE) is set, forces the clock to that rate
    /// (`CClock::EnableForceToFPS`), so that [`Clock::GetSPF`](clock::Clock::GetSPF) returns the
    /// step during the sim; it undoes the forcing before [`UpdateRender`](Self::UpdateRender).
    /// The frame's seconds per frame, capped at half a second, are converted into ticks by
    /// the chosen [`m_InterpolationMethod`](Self::m_InterpolationMethod), each tick one
    /// [`UpdateGame`](Self::UpdateGame) call, and the fraction left over is the render context's
    /// `m_Dtf`. While the clock is paused, or [`m_DecoupleEnabled`](Self::m_DecoupleEnabled) is
    /// clear, it instead runs one [`UpdateGame`](Self::UpdateGame) with the frame's time as the
    /// step.
    #[address(0x140_960_4E0)]
    pub fn Update(&mut self) -> bool;

    /// Builds the per-frame update contexts and drives rendering.
    #[address(0x140_95A_4E0)]
    pub fn UpdateRender(&mut self, update_contexts: *mut UpdateContexts);

    /// One sim tick: advances the game clock, updates the FPS counter, and dispatches to the
    /// active game state's update (install, init, frontend, load, or run). Called zero or more
    /// times per [`Update`](Self::Update) according to the frame-pacing mode.
    #[address(0x140_952_1F0)]
    pub fn UpdateGame(&mut self, update_contexts: *mut UpdateContexts);
}

/// `g_MaxGameUpdatesPerRender`: the most [`Game::UpdateGame`] calls one [`Game::Update`] makes
/// under [`INTERPOLATION_METHOD_ACCUMULATED`](Game::INTERPOLATION_METHOD_ACCUMULATED) and
/// [`INTERPOLATION_METHOD_TIME_BASED`](Game::INTERPOLATION_METHOD_TIME_BASED). The image
/// initializes it to 2.
#[address(0x142_D6E_A50)]
pub extern Game_MaxGameUpdatesPerRender: u32;

/// `CGame::EGameUpdateFlags`: the phases of [`Game::Update`] enabled by
/// [`Game::m_UpdateFlags`].
#[copyable]
pub bitflags GameUpdateFlags: u32 {
    /// Runs the tools hooks at the end of the frame.
    E_GUF_TOOLS = 0x1,
    /// Runs the sim step: the frame-pacing switch that calls [`Game::UpdateGame`].
    E_GUF_UPDATE = 0x2,
    /// Runs [`Game::UpdateRender`] after the sim step.
    E_GUF_RENDER = 0x4,
}

/// `CGameStateRun`: the in-game state's static update functions.
pub type GameStateRun;
impl GameStateRun {
    /// The render-side update the run state performs while the game is paused: drives the
    /// landscape, UI prerender, video, water simulation, and resource streaming, and waits for the
    /// CPU draw, without running the camera update.
    #[address(0x140_9AE_200)]
    pub fn UpdateRenderPaused(update_contexts: *mut UpdateContexts);
}

/// The game's load state (`CGameStateLoad`), entered for a load, a continue, a new game, a world
/// reload, and every teleport with the load state
/// ([`GameWorld::TeleportPlayer`](game_world::GameWorld::TeleportPlayer)). Its layout is unmapped.
pub type GameStateLoad;
impl GameStateLoad {
    /// The load state's entry. It runs [`ResetSystems`](Self::ResetSystems), so every entry to
    /// the load state resets the spawn system.
    #[address(0x140_9FE_C80)]
    pub fn OnEnter();

    /// The load state's reset step, called only by [`OnEnter`](Self::OnEnter): aborts an active
    /// challenge unless the no-unload flag is set, gives back a challenge's loadout its
    /// destruction left to the reset
    /// ([`ROMObject::RestoreWeaponsAndAmmo`](mission::ROMObject::RestoreWeaponsAndAmmo)), resets the
    /// dialogue, resets the spawn system
    /// ([`SpawnSystem::ResetSystem`](spawn_system::SpawnSystem::ResetSystem)), and resets the heat.
    /// The disassembler mislabels it `IConsole::GetLoadingLock`.
    #[address(0x140_9BA_BB0)]
    pub fn ResetSystems();
}

/// The game's frontend state (`CGameStateFrontend`), the main menu. Its layout is unmapped.
pub type GameStateFrontend;
impl GameStateFrontend {
    /// The frontend's reset of the game systems on the quit to the menu, which resets the spawn
    /// system ([`SpawnSystem::ResetSystem`](spawn_system::SpawnSystem::ResetSystem)).
    #[address(0x140_9AC_700)]
    pub fn ResetSystems();
}

// Opaque engine context types carried by the per-frame update contexts.
pub type ResourceCache;

pub type ProjectContext;

#[size(0x20), copyable]
pub type GameObjectInitContext {
    pub m_Dt: f32,
    pub m_DtIgnorePause: f32,
    pub m_RealDt: f32,

    #[address(0x10)]
    pub m_ResourceCache: *const ResourceCache,
    pub m_ProjectContext: *const ProjectContext,
}

#[size(0x20), copyable]
pub type GameObjectUpdateContext {
    pub m_Dt: f32,
    pub m_OriginalDt: f32,
    pub m_DtIgnorePause: f32,
    pub m_RealDt: f32,
    pub m_SkippedDt: f32,
    pub m_Paused: bool,

    #[address(0x18)]
    pub m_ProjectContext: *const ProjectContext,
}

#[size(0x20), copyable]
pub type GameObjectRenderContext {
    pub m_Dt: f32,
    pub m_Dtf: f32,
    pub m_OriginalDt: f32,
    pub m_DtIgnorePause: f32,
    pub m_RealDt: f32,

    #[address(0x18)]
    pub m_ProjectContext: *const ProjectContext,
}

#[size(0x60), copyable]
pub type UpdateContexts {
    pub m_InitContext: GameObjectInitContext,
    pub m_UpdateContext: GameObjectUpdateContext,
    pub m_RenderContext: GameObjectRenderContext,
}

#[singleton(0x142_F34_04C), copyable]
pub enum GameState: u32 {
    E_GAME_INSTALL = 0x0,
    E_GAME_INIT = 0x1,
    E_GAME_FRONTEND = 0x2,
    E_GAME_LOAD = 0x3,
    E_GAME_RUN = 0x4,
    E_GAME_STARTUP = 0x5,
    NOF_GAME_STATES = 0x6,
}
impl GameState {
    #[address(0x140_A00_E90)]
    pub fn PostUpdateRender(update_contexts: *const UpdateContexts);

    /// `CGameState::UpdatePhysics`: the run state's physics phase, between the game world's
    /// pre-simulation and post-simulation queues ([`GameWorld::UpdatePreSim`](game_world::GameWorld::UpdatePreSim)
    /// and [`GameWorld::UpdatePostSim`](game_world::GameWorld::UpdatePostSim)). Unless the clock's
    /// update speed is below a tenth (deep slow motion, which skips the step), it calls
    /// [`PhysicsSystem::Update`](physics::PhysicsSystem::Update) with `dt`, the update context's
    /// `m_Dt`. It then dispatches the queued collisions, clears the collision array, runs the
    /// vehicles' post-collision update, processes the damage listeners' events, and updates the
    /// shape sensors.
    #[address(0x140_9AC_2A0)]
    pub fn UpdatePhysics(dt: f32);

    /// `CGameState::UpdateDeletionOfObjects`: deletes the queued background objects and the
    /// locator's queued resources within `budget_us` microseconds. The run state's update calls
    /// it once per tick, after [`StreamerUpdate`] and [`GameLocationSystemUpdate`], with what is
    /// left of the tick's streaming budget.
    #[address(0x140_9BA_410)]
    pub fn UpdateDeletionOfObjects(budget_us: u32);
}

/// The resource streamer's update: polls the file system and the decompressors, creates the
/// loaded resources, and starts the pending requests, within `budget_us` microseconds. The run
/// state's update calls it once per tick after the physics phase, with a budget of at least
/// a fixed minimum taken from a reservoir it refills every tick, so the streaming time per second
/// grows with the tick rate when there is work. Returns the streamer's result code.
#[address(0x141_18A_180)]
pub fn StreamerUpdate(budget_us: u32) -> u32;

/// The game location system's update: checks which locations to load and advances their loading
/// and the landmarks' visibility, within `budget_us` microseconds. The run state's update calls it
/// once per tick, after [`StreamerUpdate`].
#[address(0x140_4BC_110)]
pub fn GameLocationSystemUpdate(budget_us: u32);

/// `RunLightThread`: queues the light manager's update on a CPU fragment, with `dt` the tick's
/// step, and clears the signal the run state's update later waits on. The run state's update calls
/// it once per tick after the effects' post-simulation update.
#[address(0x140_9AE_070)]
pub fn RunLightThread(dt: f32);

/// `RunAIThread1`: queues [`RunAIThread1_Proxy`] on a CPU fragment with `dt` the tick's step, and
/// clears its completion signal. The run state's update calls it once per tick after the awareness
/// events' dispatch, and waits for the signal near the end of the same tick.
#[address(0x140_9F0_D40)]
pub fn RunAIThread1(dt: f32);

/// The first AI thread's body, run on a CPU fragment worker (or by a thread that runs queued
/// fragments while it waits): the per-character AI update, the road graph, traffic, and action
/// token managers, and the pathfinder's instant-rotation switch. `dt` points at the tick's step.
/// Returns 1.
#[address(0x140_9F0_B30)]
pub fn RunAIThread1_Proxy(dt: *mut f32) -> i32;

/// `RunAIThread2`: caches the game camera's position for the AI pathfinder, then queues
/// [`RunAIThread2_Proxy`] on a CPU fragment with `dt` the tick's step, and clears its completion
/// signal. The run state's update calls it last in the tick, so the thread runs alongside the rest
/// of the frame: the run state's render update waits for the signal before its raycast threads,
/// and the next tick's update waits for it before its input.
#[address(0x140_9F0_DE0)]
pub fn RunAIThread2(dt: f32);

/// The second AI thread's body, run on a CPU fragment worker: the pathfinders' work, the navmesh
/// pathfinder, the behavior trees, the AI system's update, and the terrain pathfinder; it queues a
/// further fragment of its own. `dt` points at the tick's step. Returns 1.
#[address(0x140_9F0_BC0)]
pub fn RunAIThread2_Proxy(dt: *mut f32) -> i32;

/// A game object's `CGameObject` subobject, through which the engine's run-time type tests go. A
/// [`PhysicsGameObject`](physics::PhysicsGameObject) carries it at
/// [`GAME_OBJECT_BASE_OFFSET`](physics::PhysicsGameObject::GAME_OBJECT_BASE_OFFSET). Only some
/// virtuals are bound.
pub type GameObject {
    vftable {
        /// `CRtti::IsType`: whether the object is of the class `type_id` names or derives from it.
        /// `type_id` points at the class's run-time type id, as a class's `TYPE_ID` function
        /// returns it (such as [`Character::TYPE_ID`](character::character::Character::TYPE_ID)).
        #[index(2)]
        pub fn IsType(&self, type_id: *const u32) -> bool;

        /// Copies the object's current world transform into `out` and reports whether a transform
        /// is available. The skeletal animated object's implementation copies its current world
        /// matrix without changing the object. The adjacent mutable overload forwards to this
        /// const overload.
        #[index(21)]
        pub fn GetTransform(&self, out: *mut Matrix4) -> bool;

        /// Enables or disables the object. A rigid object's override
        /// ([`RigidObject`](physics::RigidObject)) records the state and, when it changes, adds its
        /// body to the physics world on enabling and removes it on disabling. A gun's spare
        /// magazine prop ([`WeaponData::m_MagazineObject`](equipment::weapon::WeaponData::m_MagazineObject))
        /// is disabled from its spawn until
        /// [`ThrowAwayMagazineObject`](equipment::weapon::WeaponData::ThrowAwayMagazineObject)
        /// enables it.
        #[index(38)]
        pub fn Enable(&mut self, enable: bool);
    },

    /// A weak reference to the object itself (`m_WeakThis`), from which the engine hands out
    /// references to the object: the player aim's direct hit takes the slot's game object from it
    /// ([`PlayerAimControl::CheckDirectTargets`](aim::aim::PlayerAimControl::CheckDirectTargets)),
    /// and a grapple target info its target object
    /// ([`HookTargetInfo::SetupTargetFromGameObject`](equipment::wire_end::HookTargetInfo::SetupTargetFromGameObject)).
    #[address(0x60)]
    pub m_WeakThis: WeakPtrGameObject,
}
impl GameObject {
    /// The object's spawn tag index (`CGameObject::GetUniqueSpawnTagIndex`): the index of the
    /// spawn tag the spawn system spawned it from, which identifies its type. The spawn system
    /// converts it to the tag's hash, the persistent form, with
    /// [`GetTagHashFromTagIndex`](spawn_system::SpawnSystem::GetTagHashFromTagIndex). The player
    /// save data stores each inventory weapon's type this way, and the inventory's respawn table
    /// ([`Inventory::m_WeaponToSpawn`](character::inventory::Inventory::m_WeaponToSpawn)) holds it.
    #[address(0x140_4CC_F60)]
    pub fn GetUniqueSpawnTagIndex(&self) -> i32;
}
