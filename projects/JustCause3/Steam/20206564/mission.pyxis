use graph_script::WeaponCacheEntry;
use types::std_vector::Vector;

/// The mission manager (`NMissionSystem::CMissionManager`): the active mission, its restart
/// points, and the checkpoint cache of the player's weapons. Only some members are bound.
#[min_size(0x360)]
pub type MissionManager {
    /// The player's slots as of the last mission checkpoint, one [`WeaponCacheEntry`] per slot,
    /// written by [`CacheWeapons`](Self::CacheWeapons) and replayed by
    /// [`RestoreCachedWeapons`](Self::RestoreCachedWeapons).
    #[address(0x340)]
    pub m_CachedWeapons: Vector<WeaponCacheEntry>,
}
impl MissionManager {
    /// Snapshots the player's eight slots into [`m_CachedWeapons`](Self::m_CachedWeapons): each
    /// slot's spawn tag index, the reserve of its ammunition type, and its magazine, a mounted
    /// weapon counting as empty. It removes nothing. Its one caller is
    /// [`SaveRestartPointToMap`](Self::SaveRestartPointToMap), while a mission is active.
    #[address(0x140_AC7_DD0)]
    pub fn CacheWeapons(&mut self);

    /// Replays [`m_CachedWeapons`](Self::m_CachedWeapons) onto the player's inventory, with the
    /// same per-slot rules as the graph script's cache
    /// ([`NodeWeaponCache::RestoreWeapons`](graph_script::NodeWeaponCache::RestoreWeapons)), but for
    /// every slot: the reserve of each occupied slot's type is zeroed, a weapon of the cached type
    /// gets the cached reserve and magazine, another type or an empty slot gets a give
    /// ([`Inventory::GivePlayerWeapon`](character::inventory::Inventory::GivePlayerWeapon)), and a
    /// cached empty slot with a weapon is marked for removal
    /// ([`Inventory::ForceRemoveWeapon`](character::inventory::Inventory::ForceRemoveWeapon)). Its
    /// one caller is [`GoToRestartPoint`](Self::GoToRestartPoint), after the player's respawn,
    /// while a mission is active.
    #[address(0x140_AC7_FE0)]
    pub fn RestoreCachedWeapons(&mut self);

    /// Saves a restart point `id` into the variable map `map`; while a mission is active it also
    /// snapshots the player's weapons ([`CacheWeapons`](Self::CacheWeapons)). Every mission
    /// checkpoint passes through it.
    #[address(0x140_ACE_700)]
    pub fn SaveRestartPointToMap(&mut self, id: u64, map: *mut void);

    /// Restarts from the restart point `restart_point`: respawns the player there
    /// ([`Player::ReInit`](character::player::Player::ReInit), which teleports with the load state)
    /// and, while a mission is active, replays the checkpoint's weapons
    /// ([`RestoreCachedWeapons`](Self::RestoreCachedWeapons)). The player's death, a mission's
    /// reset and failure, the teleport to a mission's start, and the return to a challenge's
    /// start call it.
    #[address(0x140_ACE_FE0)]
    pub fn GoToRestartPoint(&mut self, restart_point: *const void);
}

/// The challenge manager (`CROMManager`), which starts, retries, restarts, and aborts the
/// challenges (ROMs). Its layout is unmapped.
pub type ROMManager;
impl ROMManager {
    /// Starts the challenge `id`. When the challenge's spawn point overrides the loadout it records
    /// each slot's type and total ammunition, marks every slot for removal
    /// ([`Inventory::ForceRemoveAllWeapons`](character::inventory::Inventory::ForceRemoveAllWeapons)),
    /// and gives the spawn point's weapons
    /// ([`Inventory::GivePlayerWeapon`](character::inventory::Inventory::GivePlayerWeapon), equipped
    /// for the dual-wield and two-handed slots, dropping the occupants). It returns whether the
    /// challenge started. Starting teleports with the load state, so it passes through the spawn
    /// reset.
    #[address(0x140_AC9_DE0)]
    pub fn StartROM(&mut self, id: u64) -> bool;

    /// Aborts the running challenge: with a recorded loadout it marks every slot for removal and
    /// gives the recorded weapons back the way [`StartROM`](Self::StartROM) gave the challenge's.
    #[address(0x140_A8D_F40)]
    pub fn AbortROM(&mut self);
}

/// A challenge object (`CROMObject`). Its layout is unmapped.
pub type ROMObject;
impl ROMObject {
    /// The challenge object's post-initialisation (a virtual override). Unless restarting or
    /// retrying, it records every slot's type and magazine and every reserve; then it despawns at
    /// once ([`Inventory::DespawnWeapon`](character::inventory::Inventory::DespawnWeapon)) each slot
    /// the challenge's loadout permission does not allow (the grenade and planted-explosive slots,
    /// and each of the dual-wield, two-handed, and special slots whose profile item fails the
    /// mask), and gives the weapons the player picked in the challenge's loadout menu.
    #[address(0x140_ACA_E10)]
    pub fn PostInit(&mut self);

    /// Restores the loadout recorded by [`PostInit`](Self::PostInit) onto the local player. Every
    /// slot is emptied first: with `despawn` set its weapon is despawned at once
    /// ([`Inventory::DespawnWeapon`](character::inventory::Inventory::DespawnWeapon)), and without
    /// it the weapon is only taken out ([`Inventory::RemoveWeapon`](character::inventory::Inventory::RemoveWeapon)).
    /// Each slot recorded with a weapon then gets its recorded type and magazine: a give
    /// ([`Inventory::GivePlayerWeapon`](character::inventory::Inventory::GivePlayerWeapon)) with
    /// `despawn` set, and without it only the respawn table's entry, which the spawn reset that
    /// follows spawns. Then every reserve but the beacons' and flares' is restored, and an autosave
    /// is requested. The challenge object's destruction calls it with `despawn` set; for one kind
    /// of challenge the destruction instead marks the challenge manager, and the load state's reset
    /// step ([`GameStateLoad::ResetSystems`](game::GameStateLoad::ResetSystems)) calls it with
    /// `despawn` clear.
    #[address(0x140_AC8_840)]
    pub fn RestoreWeaponsAndAmmo(despawn: bool);
}
