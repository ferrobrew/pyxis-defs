use animation::rule_system::AnimationRuleSystem;
use animation::skeleton::{HkArray, HkaPose};
use character::character::Joint;
use types::shared_ptr::SharedPtr;
use types::std_vector::Vector;
use types::vector_math::{AlignedQuat, AlignedVector3};

/// A pose producer (`CPoseProducer`): owns an animated model's blenders and the `T0`/`T1` poses the skinning palette is built from.
///
/// [`UpdateBlendersPoseInRange`](Self::UpdateBlendersPoseInRange) builds the local-space pose layer by layer. The first blender samples over the skeleton's reference pose. Each later blender that has samplers runs [`Blender::UpdatePose`] with the previous blender's output as its reference pose, so a partial layer overlays the pose below it by its clips' per-bone weights, and an additive layer adds onto it. A later blender without samplers is skipped, leaving the pose below it unchanged. The blenders are added in the order of the animation controller's body parts ([`AnimationController::m_BodyParts`](character::character::AnimationController::m_BodyParts)), one per layer.
///
/// The poses are reused buffers. [`Update`](Self::Update) exchanges their pointers before synchronously evaluating [`m_PoseT1`](Self::m_PoseT1). The asynchronous pose-job path (`CPoseProducer::KickUpdateJob`) also exchanges them before queuing `PoseUpdate_fragment` on a CPU fragment worker. [`m_PoseT0`](Self::m_PoseT0) receives the previously current pose, including changes made before the exchange, such as HumanIK results and joint writes. The skinning job blends `T0` to `T1`.
#[min_size(0x30)]
pub type PoseProducer {
    /// The ordered animation layers evaluated by [`Update`](Self::Update). The first layer samples over the skeleton's reference pose.
    #[address(0x8)]
    pub m_Blenders: HkArray<SharedPtr<Blender>>,

    /// The previously current pose after the latest buffer exchange. [`Update`](Self::Update) exchanges this pointer with [`m_PoseT1`](Self::m_PoseT1) before evaluating the new current output.
    #[address(0x20)]
    pub m_PoseT0: *mut HkaPose,

    /// The current pose buffer. [`UpdateBlendersPoseInRange`](Self::UpdateBlendersPoseInRange) writes its selected local transforms and float slots. The animation controller's joint accessors ([`AnimationController::GetJoint`](character::character::AnimationController::GetJoint) and [`SetJoint`](character::character::AnimationController::SetJoint)) read and write it in model space.
    #[address(0x28)]
    pub m_PoseT1: *mut HkaPose,
}
impl PoseProducer {
    /// Exchanges the pose buffers and queues `PoseUpdate_fragment` with the selected layer and bone counts. The worker evaluates the pose after this call returns; returning from dispatch does not establish completed pose output.
    #[address(0x141_E69_2C0)]
    pub fn KickUpdateJob(&mut self, dt: f32, num_animation_layers: i32, num_bones: i32);

    /// Exchanges [`m_PoseT0`](Self::m_PoseT0) and [`m_PoseT1`](Self::m_PoseT1), advances each blender's time by `dt`, and synchronously evaluates all blenders through [`UpdateBlendersPoseInRange`](Self::UpdateBlendersPoseInRange) for `num_bones`. The selected local transforms and float slots are copied into the current pose before this call returns. The blender range is captured before the time updates.
    #[address(0x141_E6A_9A0)]
    pub fn Update(&mut self, dt: f32, num_bones: i32);

    /// Synchronously evaluates a blender range for `num_bones` local transforms and the skeleton's float slots. Clamps `to_blender` to the current blender count and returns without producing output when `from_blender` exceeds that end. A start at the first blender samples it over the skeleton's reference pose before the later-layer loop. A later start initializes the temporary output from the current [`m_PoseT1`](Self::m_PoseT1). The loop applies blenders below the clamped end. Copies the selected local transforms and float slots into the current pose, then frees the temporaries before returning. This operation does not exchange the pose pointers.
    #[address(0x141_E6A_090)]
    pub fn UpdateBlendersPoseInRange(&mut self, from_blender: i32, to_blender: i32, num_bones: i32);

    /// Copies bone `index` from the current [`m_PoseT1`](Self::m_PoseT1) into `result` in model space and returns `result`. A dirty model-space transform is calculated lazily before the complete joint is copied.
    ///
    /// The current pose must be live, `index` must be nonnegative and valid for its bone flags and model-space transforms, and `result` must point to writable aligned joint storage. There are no null or range guards. The lazy calculation can modify the pose caches, so the call requires serialized access to the current pose. It does not read [`m_PoseT0`](Self::m_PoseT0).
    ///
    /// IDA labels this address `TResourceCachePtr<CSkeleton>::operator->`; the body is the pose producer's joint accessor.
    #[address(0x141_E69_3D0)]
    pub fn GetJoint(&mut self, result: *mut Joint, index: i32) -> *mut Joint;

    /// Queues a skinning-palette job for this producer: advances the time of any time-updatable
    /// blender, then records the skeleton's bone count, `dtf`, and the two poses into the next slot
    /// of the global skinning job table (up to 0x1000 jobs per frame) together with the output
    /// `palette` buffer. The skinning job later blends the `T0` and `T1` poses by `dtf` into the
    /// palette. Reached from
    /// [`AnimationController::UpdateSkinning`](character::character::AnimationController::UpdateSkinning)
    /// in the render phase.
    #[address(0x141_E69_600)]
    pub fn MakeSkinningPalette(&mut self, dtf: f32, palette: *mut void);
}

/// One bone's local-space transform in a Havok pose (`hkQsTransformf`): translation, rotation, and
/// scale, each a 16-byte vector.
#[copyable, defaultable, align(16), size(0x30)]
pub type QsTransform {
    pub m_Translation: AlignedVector3,
    pub m_Rotation: AlignedQuat,
    pub m_Scale: AlignedVector3,
}

/// One animation layer's sampler set (`CBlender`): wraps a Havok animated skeleton whose animation
/// controls are the layer driver's playing clips.
#[min_size(0x18)]
pub type Blender {
    /// Animation instances whose controls are registered with the blender's animated skeleton.
    #[address(0x8)]
    pub m_Samplers: HkArray<SharedPtr<AnimationInstance>>,
}
impl Blender {
    /// Samples the blender's clips and blends them over `reference_pose` into `pose_out`, both `num_bones` local-space transforms, and likewise the float slots from `reference_floats` into `float_slots_out` (`num_float_slots` each). Where the clips' total weight on a bone is below the skeleton's reference-pose threshold, the reference fills in. `normal_blend_pose_out` is non-null only for the first layer, which also copies its result there (the pose producer's pre-additive pose). It writes nothing but its outputs. [`PoseProducer::UpdateBlendersPoseInRange`] calls it during synchronous updates and pose-job execution.
    #[address(0x141_E6B_E10)]
    pub fn UpdatePose(&mut self, pose_out: *mut QsTransform, reference_pose: *mut QsTransform, normal_blend_pose_out: *mut QsTransform, num_bones: u32, float_slots_out: *mut f32, reference_floats: *mut f32, num_float_slots: u32);

    /// Whether the blender has any animation controls. [`PoseProducer::UpdateBlendersPoseInRange`] skips a later layer's blender without them.
    #[address(0x141_E6B_1C0)]
    pub fn HasSamplers(&mut self) -> bool;

    /// Adds `instance` to the blender's samplers: registers its Havok animation control with the
    /// blender's animated skeleton and keeps a reference to it.
    #[address(0x141_E6B_930)]
    pub fn AddSampler(&mut self, instance: *mut SharedPtr<AnimationInstance>);

    /// Removes every sampler's animation control from the animated skeleton and releases the
    /// samplers.
    #[address(0x141_E6B_9B0)]
    pub fn ClearSamplers(&mut self);
}

/// One animation layer of an animation controller (`CAnimatedBodyPart`): the layer's rule system and
/// its animation driver. Created by `CAnimationControl::AddAnimatedBodyPart`, which also adds the
/// driver's [`Blender`] to the controller's [`PoseProducer`].
pub type AnimatedBodyPart {
    /// The driver that selects and plays the layer's clips from its rule system's state.
    #[address(0x18)]
    pub m_AnimationDriver: *mut AnimationDriverTransition,
}

/// An animation layer's clip driver (`CAnimationDriverTransition`): follows the layer's rule system,
/// starts and blends the clips of its current state, and owns the layer's [`Blender`]. The clips it
/// plays send the layer's track messages and answer its segment queries whether or not the blender's
/// pose reaches the skeleton.
pub type AnimationDriverTransition {
    /// The layer's animation rule system, which supplies the current state and transition choices.
    #[address(0x30)]
    pub m_RuleSystem: SharedPtr<AnimationRuleSystem>,

    /// Animation instances selected by the driver for playback.
    #[address(0x40)]
    pub m_PlayingAnimInstances: Vector<SharedPtr<AnimationInstance>>,

    /// The layer's blender, added to the pose producer when the body part is created.
    #[address(0xD8)]
    pub m_Blender: SharedPtr<Blender>,
}
impl AnimationDriverTransition {
    /// Starts `instance`, a clip chosen by code rather than by the layer's rule system, on the
    /// layer, blending it in over `blend` seconds.
    /// [`AnimationController::PlayCustomAnimation`](character::character::AnimationController::PlayCustomAnimation)
    /// calls it.
    #[address(0x140_474_AB0)]
    pub fn PlayCustomAnimation(&mut self, instance: *mut SharedPtr<AnimationInstance>, blend: f32);
}

/// One playing clip (`CAnimationInstance`): a clip resource bound to a skeleton, with its
/// playback time, weight, easing, and loop mode. A [`Blender`] samples its instances into a pose.
#[size(0x120)]
pub type AnimationInstance {
    /// The animation resource handle retained by this instance.
    #[address(0x10)]
    pub m_Animation: *mut void,

    /// The playback mode selected when this instance is constructed.
    #[address(0x20)]
    pub m_LoopMode: AnimLoopMode,

    /// Per-transform-track weights used when the control contributes to a blended pose.
    #[address(0x48)]
    pub m_TransformTrackWeights: HkArray<u8>,

    /// The mapping from this animation's transform tracks to skeleton bones.
    #[address(0x68)]
    pub m_Binding: *mut AnimationBinding,

    /// The number of positive playback-time wraps recorded by the embedded animation control.
    #[address(0x90)]
    pub m_OverflowCount: u32,

    /// The number of negative playback-time wraps recorded by the embedded animation control.
    #[address(0x94)]
    pub m_UnderflowCount: u32,
}
impl AnimationInstance {
    /// Constructs an instance of the clip resource `animation` (a `TResourceCachePtr<CAnimation>`,
    /// one resource handle) over the skeleton resource `skeleton`, configured by `context` (a
    /// `CAnimationInstance::SCreationContext`: its easing, start and finish trims, speed, mirror
    /// flag, and loop mode). A context with the mirror flag set binds the clip mirrored.
    #[address(0x141_E68_BD0)]
    pub fn Construct(&mut self, animation: *const *mut void, skeleton: *const *mut void, context: *const void) -> *mut AnimationInstance;

    /// Returns the embedded animation control's current local playback time.
    #[address(0x141_E66_EA0)]
    pub fn GetTime(&self) -> f32;

    /// Returns the embedded animation control's total playback weight.
    #[address(0x141_E66_F00)]
    pub fn GetTotalWeight(&self) -> f32;

    /// Returns the duration of the animation resource retained by this instance.
    #[address(0x141_E67_B10)]
    pub fn GetDuration(&self) -> f32;
}

/// How an animation instance treats playback at the end of its duration.
#[copyable]
pub enum AnimLoopMode: u32 {
    /// Playback repeats when it reaches the end.
    Loop = 0,
    /// Playback stops when it reaches the end.
    PlayOnce = 1,
}

/// The binding between an animation's transform tracks and the skeleton's bones.
#[min_size(0x30)]
pub type AnimationBinding {
    /// Maps each animation transform track to its corresponding skeleton bone index.
    #[address(0x20)]
    pub m_TransformTrackToBoneIndices: HkArray<i16>,
}

/// `IAnimationManager::AquireAnimation`: the clip resource for the clip path `path` (transformed
/// to its compiled name and hashed with `HashString`), from the global resource cache. It writes
/// the resource handle (a `TResourceCachePtr<CAnimation>`) into `result` and returns it.
#[address(0x140_3EB_FD0)]
pub fn AquireAnimation(result: *mut *mut void, path: *const u8) -> *mut *mut void;

/// `IAnimationManager::AquireAnimation` with an explicit resource cache: like [`AquireAnimation`]
/// but from `cache`, and writing a null handle for a null or empty `path`.
#[address(0x140_482_3D0)]
pub fn AquireAnimationFromCache(result: *mut *mut void, path: *const u8, cache: *mut void) -> *mut *mut void;
