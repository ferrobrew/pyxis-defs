/// The animation-system event-id (act) symbol table: maps act names (`ACT_*`) to the sequential
/// runtime ids that the animation state machines and [`Character::QueueAct`](character::character::Character::QueueAct)
/// use. Ids are assigned in registration order as names are first encountered (by loaded animation
/// data or the `NCharacter` id globals), so an act's id is only resolvable at runtime.
#[singleton(0x142_F16_308)]
pub type EventIdSymbolTable {
    /// The on-foot / land-vehicle reversing act: drives the `S_REVERSE_*` states in
    /// `rico_base.afsmb`, where Rico turns to look over his shoulder while backing up.
    pub const ACT_REVERSE: cstr = c"ACT_REVERSE",
    /// The motorbike variant of [`ACT_REVERSE`](Self::ACT_REVERSE).
    pub const ACT_REVERSE_MOTORBIKE: cstr = c"ACT_REVERSE_MOTORBIKE",
    /// The one-off idle-variation act: transitions the on-foot idle from `S_IDLE` to
    /// `S_IDLE_ONE_OFF` in `rico_base.afsmb`, playing a single idle-break animation (a weight shift,
    /// a look-around, a fidget) before returning to `S_IDLE`. `NStateTask_InputLocoIdleTask::Update`
    /// queues it via [`Character::QueueAct`](character::character::Character::QueueAct) once a
    /// per-character idle countdown (reset to a random ~8.5-12 s each time the character moves)
    /// elapses while the character is standing still, calm, and not attached to a vehicle.
    pub const ACT_TO_IDLE_ONE_OFF: cstr = c"ACT_TO_IDLE_ONE_OFF",
    /// The automatic holster queued by `CPlayer::UpdateMentalState`
    /// ([`Player_UpdateMentalState`](character::player::Player_UpdateMentalState)) when the
    /// player's mental state decays to relaxed with a weapon wielded. It drives a state chain in
    /// `rico_base.afsmb` whose `NWeaponUnequipTask` queues [`UB_ACT_HOLSTER`](Self::UB_ACT_HOLSTER).
    pub const ACT_ON_UNEQUIP_WEAPON_SLOW: cstr = c"ACT_ON_UNEQUIP_WEAPON_SLOW",
    /// The upper-body holster act. Queued by
    /// [`Inventory::UpdateWeaponHandling`](character::inventory::Inventory::UpdateWeaponHandling)'s
    /// relaxed branch for the player, by
    /// [`Character::HolsterWeapon`](character::character::Character::HolsterWeapon) for other
    /// characters, and by `NWeaponUnequipTask` on entering its state.
    pub const UB_ACT_HOLSTER: cstr = c"UB_ACT_HOLSTER",
    /// The gun-side pump act: the pump shotgun's (`w151`) own state machine plays the pump on
    /// the gun's model for it. The shotgun's gun-facing do-act component
    /// ([`DoActWeaponComponent`](equipment::weapon::DoActWeaponComponent)) sends it to the gun
    /// ([`WeaponData::DoAct`](equipment::weapon::WeaponData::DoAct)) at each shot, alongside the
    /// holder's `UB_ACT_SHOTGUN_PUMP`.
    pub const ACT_SHOTGUN_PUMP: cstr = c"ACT_SHOTGUN_PUMP",
    /// The gun-side bolt act, handled by the state machines of the bolt-action rifles that cycle a
    /// bolt on the gun's own model (`w162` and `w163`). The holder's counterpart is
    /// `UB_ACT_SNIPER_BOLT_ACTION`, which the rifle's per-tick update queues
    /// ([`SniperWeapon::UpdateFromUserPostSim_Parallel`](equipment::weapon::SniperWeapon::UpdateFromUserPostSim_Parallel)).
    pub const ACT_SNIPER_BOLT_ACTION: cstr = c"ACT_SNIPER_BOLT_ACTION",
    /// The left melee stumble, for a character struck from the front. The
    /// player's melee input task
    /// ([`NStateTask_InputMeleeTask::Update`](input::locomotion::NStateTask_InputMeleeTask::Update))
    /// queues one of the four melee stumbles (or its `_DEATH` variant, for a blow that will kill)
    /// on the target character, after testing it with
    /// [`AnimatedModel::TryAct`](character::character::AnimatedModel::TryAct). The `_0` acts are
    /// for a target that faces the attacker (its yaw within a quarter turn of the yaw that points
    /// back along the attack direction), the `_180` acts for one struck from behind, and the side
    /// (`LEFT` or `RIGHT`) follows the angle of the attacker's swing.
    pub const ACT_HITREACT_MELEE_STUMBLE_LEFT_0: cstr = c"ACT_HITREACT_MELEE_STUMBLE_LEFT_0",
    /// The right melee stumble, for a character struck from the front; see
    /// [`ACT_HITREACT_MELEE_STUMBLE_LEFT_0`](Self::ACT_HITREACT_MELEE_STUMBLE_LEFT_0).
    pub const ACT_HITREACT_MELEE_STUMBLE_RIGHT_0: cstr = c"ACT_HITREACT_MELEE_STUMBLE_RIGHT_0",
    /// The left melee stumble, for a character struck from behind; see
    /// [`ACT_HITREACT_MELEE_STUMBLE_LEFT_0`](Self::ACT_HITREACT_MELEE_STUMBLE_LEFT_0).
    pub const ACT_HITREACT_MELEE_STUMBLE_LEFT_180: cstr = c"ACT_HITREACT_MELEE_STUMBLE_LEFT_180",
    /// The right melee stumble, for a character struck from behind; see
    /// [`ACT_HITREACT_MELEE_STUMBLE_LEFT_0`](Self::ACT_HITREACT_MELEE_STUMBLE_LEFT_0).
    pub const ACT_HITREACT_MELEE_STUMBLE_RIGHT_180: cstr = c"ACT_HITREACT_MELEE_STUMBLE_RIGHT_180",
    /// The stumble a hit's impulse knocks a player into, past the character's stumble threshold
    /// and short of its ragdoll threshold. [`Character::HitReaction`](character::character::Character::HitReaction)
    /// queues it, or [`ACT_HITREACT_STUMBLE_BULLET`](Self::ACT_HITREACT_STUMBLE_BULLET) for a bullet
    /// or [`ACT_HITREACT_STUMBLE_MELEE`](Self::ACT_HITREACT_STUMBLE_MELEE) for a melee blow, on the
    /// character's [`AnimatedModel`](character::character::AnimatedModel) when the state machine
    /// accepts it, and the flinch otherwise. In `rico_base.afsmb` the stumbles lead to the
    /// `S_JC_HITREACT_STUMBLE_*` states.
    pub const ACT_HITREACT_STUMBLE: cstr = c"ACT_HITREACT_STUMBLE",
    /// The bullet variant of [`ACT_HITREACT_STUMBLE`](Self::ACT_HITREACT_STUMBLE).
    pub const ACT_HITREACT_STUMBLE_BULLET: cstr = c"ACT_HITREACT_STUMBLE_BULLET",
    /// The melee variant of [`ACT_HITREACT_STUMBLE`](Self::ACT_HITREACT_STUMBLE).
    pub const ACT_HITREACT_STUMBLE_MELEE: cstr = c"ACT_HITREACT_STUMBLE_MELEE",
    /// The knock-back a player takes from an explosion's impulse:
    /// [`Character::HitReaction`](character::character::Character::HitReaction) queues it when
    /// the state machine accepts it, and the full ragdoll otherwise. In `rico_base.afsmb` it leads
    /// to the `S_JC_HITREACT_FLY_*` states.
    pub const ACT_HITREACT_FLY: cstr = c"ACT_HITREACT_FLY",
    /// The forward run start, out of the idle: one of the directional run-start (wind-up) acts that
    /// [`QueueStarts`](input::locomotion::NStateTask_LocoUtil::QueueStarts) chooses by the angle from
    /// the body's forward to the move direction. Its clip starts straight ahead.
    pub const ACT_IDLE_TO_START_0: cstr = c"ACT_IDLE_TO_START_0",
    /// The run start that turns a quarter to the right on the way out of the idle; see
    /// [`ACT_IDLE_TO_START_0`](Self::ACT_IDLE_TO_START_0).
    pub const ACT_IDLE_TO_START_90R: cstr = c"ACT_IDLE_TO_START_90R",
    /// The run start that turns a quarter to the left; see
    /// [`ACT_IDLE_TO_START_0`](Self::ACT_IDLE_TO_START_0).
    pub const ACT_IDLE_TO_START_90L: cstr = c"ACT_IDLE_TO_START_90L",
    /// The run start that turns a third to the right; see
    /// [`ACT_IDLE_TO_START_0`](Self::ACT_IDLE_TO_START_0).
    pub const ACT_IDLE_TO_START_120R: cstr = c"ACT_IDLE_TO_START_120R",
    /// The run start that turns a third to the left; see
    /// [`ACT_IDLE_TO_START_0`](Self::ACT_IDLE_TO_START_0).
    pub const ACT_IDLE_TO_START_120L: cstr = c"ACT_IDLE_TO_START_120L",
    /// The run start that turns around to the right; see
    /// [`ACT_IDLE_TO_START_0`](Self::ACT_IDLE_TO_START_0).
    pub const ACT_IDLE_TO_START_180R: cstr = c"ACT_IDLE_TO_START_180R",
    /// The run start that turns around to the left; see
    /// [`ACT_IDLE_TO_START_0`](Self::ACT_IDLE_TO_START_0).
    pub const ACT_IDLE_TO_START_180L: cstr = c"ACT_IDLE_TO_START_180L",
    /// The forward walk start: the walk flavor of
    /// [`ACT_IDLE_TO_START_0`](Self::ACT_IDLE_TO_START_0), which
    /// [`QueueStarts`](input::locomotion::NStateTask_LocoUtil::QueueStarts) picks when the speed is
    /// below the movement settings' threshold.
    pub const ACT_IDLE_TO_WALK_START_0: cstr = c"ACT_IDLE_TO_WALK_START_0",
    /// The walk start that turns a quarter to the right; see
    /// [`ACT_IDLE_TO_WALK_START_0`](Self::ACT_IDLE_TO_WALK_START_0).
    pub const ACT_IDLE_TO_WALK_START_90R: cstr = c"ACT_IDLE_TO_WALK_START_90R",
    /// The walk start that turns a quarter to the left; see
    /// [`ACT_IDLE_TO_WALK_START_0`](Self::ACT_IDLE_TO_WALK_START_0).
    pub const ACT_IDLE_TO_WALK_START_90L: cstr = c"ACT_IDLE_TO_WALK_START_90L",
    /// The walk start that turns a third to the right; see
    /// [`ACT_IDLE_TO_WALK_START_0`](Self::ACT_IDLE_TO_WALK_START_0).
    pub const ACT_IDLE_TO_WALK_START_120R: cstr = c"ACT_IDLE_TO_WALK_START_120R",
    /// The walk start that turns a third to the left; see
    /// [`ACT_IDLE_TO_WALK_START_0`](Self::ACT_IDLE_TO_WALK_START_0).
    pub const ACT_IDLE_TO_WALK_START_120L: cstr = c"ACT_IDLE_TO_WALK_START_120L",
    /// The walk start that turns around to the right; see
    /// [`ACT_IDLE_TO_WALK_START_0`](Self::ACT_IDLE_TO_WALK_START_0).
    pub const ACT_IDLE_TO_WALK_START_180R: cstr = c"ACT_IDLE_TO_WALK_START_180R",
    /// The walk start that turns around to the left; see
    /// [`ACT_IDLE_TO_WALK_START_0`](Self::ACT_IDLE_TO_WALK_START_0).
    pub const ACT_IDLE_TO_WALK_START_180L: cstr = c"ACT_IDLE_TO_WALK_START_180L",
    /// The straight stop: one of the stop-and-turn acts that
    /// [`QueueStopTurns`](input::locomotion::NStateTask_LocoUtil::QueueStopTurns) chooses by the angle
    /// from the body's forward to the aim, here none.
    pub const ACT_STOP_TURN_0: cstr = c"ACT_STOP_TURN_0",
    /// The stop that turns a quarter to the right; see
    /// [`ACT_STOP_TURN_0`](Self::ACT_STOP_TURN_0).
    pub const ACT_STOP_TURN_90R: cstr = c"ACT_STOP_TURN_90R",
    /// The stop that turns a quarter to the left; see [`ACT_STOP_TURN_0`](Self::ACT_STOP_TURN_0).
    pub const ACT_STOP_TURN_90L: cstr = c"ACT_STOP_TURN_90L",
    /// The stop that turns a third to the right; see [`ACT_STOP_TURN_0`](Self::ACT_STOP_TURN_0).
    pub const ACT_STOP_TURN_120R: cstr = c"ACT_STOP_TURN_120R",
    /// The stop that turns a third to the left; see [`ACT_STOP_TURN_0`](Self::ACT_STOP_TURN_0).
    pub const ACT_STOP_TURN_120L: cstr = c"ACT_STOP_TURN_120L",
    /// The stop that turns around to the right; see [`ACT_STOP_TURN_0`](Self::ACT_STOP_TURN_0).
    pub const ACT_STOP_TURN_180R: cstr = c"ACT_STOP_TURN_180R",
    /// The stop that turns around to the left; see [`ACT_STOP_TURN_0`](Self::ACT_STOP_TURN_0).
    pub const ACT_STOP_TURN_180L: cstr = c"ACT_STOP_TURN_180L",
    /// The warp flavor of the straight stop; the `_WARP` stop turns below are its turning
    /// variants.
    pub const ACT_STOP_TURN_0_WARP: cstr = c"ACT_STOP_TURN_0_WARP",
    /// See [`ACT_STOP_TURN_0_WARP`](Self::ACT_STOP_TURN_0_WARP).
    pub const ACT_STOP_TURN_90R_WARP: cstr = c"ACT_STOP_TURN_90R_WARP",
    /// See [`ACT_STOP_TURN_0_WARP`](Self::ACT_STOP_TURN_0_WARP).
    pub const ACT_STOP_TURN_90L_WARP: cstr = c"ACT_STOP_TURN_90L_WARP",
    /// See [`ACT_STOP_TURN_0_WARP`](Self::ACT_STOP_TURN_0_WARP).
    pub const ACT_STOP_TURN_180R_WARP: cstr = c"ACT_STOP_TURN_180R_WARP",
    /// See [`ACT_STOP_TURN_0_WARP`](Self::ACT_STOP_TURN_0_WARP).
    pub const ACT_STOP_TURN_180L_WARP: cstr = c"ACT_STOP_TURN_180L_WARP",
    /// The rotate-on-spot acts: a standing turn in place by an eighth, a quarter, or half a turn,
    /// left or right, queued by the on-foot input tasks' on-spot turn queuers when the body's
    /// facing and the wanted facing differ while the character stands still.
    pub const ACT_ROTATE_45L: cstr = c"ACT_ROTATE_45L",
    /// See [`ACT_ROTATE_45L`](Self::ACT_ROTATE_45L).
    pub const ACT_ROTATE_45R: cstr = c"ACT_ROTATE_45R",
    /// See [`ACT_ROTATE_45L`](Self::ACT_ROTATE_45L).
    pub const ACT_ROTATE_90L: cstr = c"ACT_ROTATE_90L",
    /// See [`ACT_ROTATE_45L`](Self::ACT_ROTATE_45L).
    pub const ACT_ROTATE_90R: cstr = c"ACT_ROTATE_90R",
    /// See [`ACT_ROTATE_45L`](Self::ACT_ROTATE_45L).
    pub const ACT_ROTATE_180L: cstr = c"ACT_ROTATE_180L",
    /// See [`ACT_ROTATE_45L`](Self::ACT_ROTATE_45L).
    pub const ACT_ROTATE_180R: cstr = c"ACT_ROTATE_180R",
    /// The warp flavors of the rotate-on-spot acts; see [`ACT_ROTATE_45L`](Self::ACT_ROTATE_45L).
    pub const ACT_ROTATE_90L_WARP: cstr = c"ACT_ROTATE_90L_WARP",
    /// See [`ACT_ROTATE_90L_WARP`](Self::ACT_ROTATE_90L_WARP).
    pub const ACT_ROTATE_90R_WARP: cstr = c"ACT_ROTATE_90R_WARP",
    /// See [`ACT_ROTATE_90L_WARP`](Self::ACT_ROTATE_90L_WARP).
    pub const ACT_ROTATE_180L_WARP: cstr = c"ACT_ROTATE_180L_WARP",
    /// See [`ACT_ROTATE_90L_WARP`](Self::ACT_ROTATE_90L_WARP).
    pub const ACT_ROTATE_180R_WARP: cstr = c"ACT_ROTATE_180R_WARP",
    /// Starts the standing rotation to the left; see [`ACT_ROTATE_END`](Self::ACT_ROTATE_END).
    pub const ACT_ROTATE_LEFT_START: cstr = c"ACT_ROTATE_LEFT_START",
    /// Starts the standing rotation to the right; see [`ACT_ROTATE_END`](Self::ACT_ROTATE_END).
    pub const ACT_ROTATE_RIGHT_START: cstr = c"ACT_ROTATE_RIGHT_START",
    /// Ends a standing rotation that [`ACT_ROTATE_LEFT_START`](Self::ACT_ROTATE_LEFT_START) or
    /// [`ACT_ROTATE_RIGHT_START`](Self::ACT_ROTATE_RIGHT_START) started.
    pub const ACT_ROTATE_END: cstr = c"ACT_ROTATE_END",
    /// The quarter and half turns to either side. The locomotion utilities and the grapple-fire move
    /// task also queue the half turns.
    pub const ACT_TURN_90L: cstr = c"ACT_TURN_90L",
    /// See [`ACT_TURN_90L`](Self::ACT_TURN_90L).
    pub const ACT_TURN_90R: cstr = c"ACT_TURN_90R",
    /// See [`ACT_TURN_90L`](Self::ACT_TURN_90L).
    pub const ACT_TURN_180L: cstr = c"ACT_TURN_180L",
    /// See [`ACT_TURN_90L`](Self::ACT_TURN_90L).
    pub const ACT_TURN_180R: cstr = c"ACT_TURN_180R",
    /// The forward flick: one of the flick acts that
    /// [`QueueFlickStick`](input::locomotion::NStateTask_LocoUtil::QueueFlickStick) chooses by the
    /// angle from the body's forward to the move direction, for a move direction within a sixth of
    /// a turn of the body's forward. The starts task queues the flicks in place of the stops when a
    /// stop is called for inside the start clip's `FLICK_STICK_TURN_VALID_SEG` segment. Like the
    /// starts, the flick writes the residual angle correction that turns the root toward the move
    /// direction.
    pub const ACT_FLICK_0: cstr = c"ACT_FLICK_0",
    /// The flick that turns a third to the right; see [`ACT_FLICK_0`](Self::ACT_FLICK_0).
    pub const ACT_FLICK_120R: cstr = c"ACT_FLICK_120R",
    /// The flick that turns a third to the left; see [`ACT_FLICK_0`](Self::ACT_FLICK_0).
    pub const ACT_FLICK_120L: cstr = c"ACT_FLICK_120L",
    /// The forward aiming flick: one of the flick acts that
    /// [`QueueAimFlickStick`](input::locomotion::NStateTask_LocoUtil::QueueAimFlickStick) chooses
    /// by the angle from the body's forward to the move direction, for a move direction within an
    /// eighth of a turn of the body's forward. Unlike the running flicks, the aiming flicks write
    /// no angle correction.
    pub const ACT_FLICK_0_AIM: cstr = c"ACT_FLICK_0_AIM",
    /// The aiming flick that turns a quarter to the right; see
    /// [`ACT_FLICK_0_AIM`](Self::ACT_FLICK_0_AIM).
    pub const ACT_FLICK_90R_AIM: cstr = c"ACT_FLICK_90R_AIM",
    /// The aiming flick that turns a quarter to the left; see
    /// [`ACT_FLICK_0_AIM`](Self::ACT_FLICK_0_AIM).
    pub const ACT_FLICK_90L_AIM: cstr = c"ACT_FLICK_90L_AIM",
    /// The aiming flick that turns around; see [`ACT_FLICK_0_AIM`](Self::ACT_FLICK_0_AIM).
    pub const ACT_FLICK_180_AIM: cstr = c"ACT_FLICK_180_AIM",
    /// The heavy weapon's standing turn a quarter to the left: one of the on-spot acts
    /// [`QueueAimRelativeOnSpotActions`](input::locomotion::NStateTask_LocoUtil::QueueAimRelativeOnSpotActions)
    /// queues for a player wielding a heavy weapon when the aim is more than a sixth of a turn from
    /// the body's forward.
    pub const ACT_AIM_FOCUS_ROTATE_90L: cstr = c"ACT_AIM_FOCUS_ROTATE_90L",
    /// The heavy weapon's standing turn a quarter to the right; see
    /// [`ACT_AIM_FOCUS_ROTATE_90L`](Self::ACT_AIM_FOCUS_ROTATE_90L).
    pub const ACT_AIM_FOCUS_ROTATE_90R: cstr = c"ACT_AIM_FOCUS_ROTATE_90R",
    /// The stunt turn toward a move direction a little off the body's forward: one of the stunt
    /// turns that [`QueueStuntTurns`](input::locomotion::NStateTask_LocoUtil::QueueStuntTurns)
    /// chooses by the angle from the body's forward to the move direction, for a character standing
    /// in a vehicle's stunt area. Each writes the residual angle correction that turns the root.
    pub const ACT_STUNT_TURN_0: cstr = c"ACT_STUNT_TURN_0",
    /// The stunt turn a third to the right; see [`ACT_STUNT_TURN_0`](Self::ACT_STUNT_TURN_0).
    pub const ACT_STUNT_TURN_120R: cstr = c"ACT_STUNT_TURN_120R",
    /// The stunt turn a third to the left; see [`ACT_STUNT_TURN_0`](Self::ACT_STUNT_TURN_0).
    pub const ACT_STUNT_TURN_120L: cstr = c"ACT_STUNT_TURN_120L",
    /// The wingsuit's evade, a barrel roll. The air physics
    /// ([`NAirMovement_UpdateAirPhysics`](input::parachute::NAirMovement_UpdateAirPhysics)) queues
    /// it straight on the character's [`AnimatedModel`](character::character::AnimatedModel), not
    /// through [`Character::QueueAct`](character::character::Character::QueueAct), when the
    /// `WINGSUIT_EVADE` action fires with the move stick out of its rest. It is the only evade act:
    /// the roll's directions (`SEG_IN_BARREL_ROLL_EVADE_MOVEMENT` and its `_LEFT`, `_RIGHT`, `_UP`,
    /// and `_DOWN` variants) and its recovery are segments of the clip it plays, not acts of their
    /// own.
    pub const ACT_BOOST_WINGSUIT_BARREL_ROLL: cstr = c"ACT_BOOST_WINGSUIT_BARREL_ROLL",
}
impl EventIdSymbolTable {
    /// Resolves an act name to its runtime id. Registers the name with a fresh id when it is not
    /// yet present (asserting if the table has been locked), so resolving a name that no loaded
    /// animation data uses yields an id that no queued act will ever carry.
    #[address(0x140_413_020)]
    pub fn string_to_id(&mut self, name: *const u8) -> i32;
}

/// A ragdoll rigid-body group id (`ava::idstring<NAnimationSystem::SRagdollRBGroupIdTag>`), which
/// names the part of a character's body a hit struck. Every live value holds a use of the group
/// symbol table: [`init_ptr`](Self::init_ptr) takes one, creating the table on first use, and the
/// value's destructor gives it back, destroying the table when the last use goes. A function that
/// takes an id by value destroys it, so its caller copies the id and takes a use for the copy
/// first.
#[copyable, size(0x4), align(4)]
pub type RagdollRBGroupId {
    /// The id a character's damage handler gives a hit it finds no group for, as it gives every
    /// melee hit.
    pub const NONE: u32 = 0,

    /// The id.
    pub m_id: u32,
}
impl RagdollRBGroupId {
    /// Takes a use of the group symbol table for this value.
    #[address(0x140_416_A70)]
    pub fn init_ptr(&mut self);
}
