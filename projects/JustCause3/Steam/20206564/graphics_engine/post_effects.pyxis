use graphics_engine::graphics_engine::{HContext_t, HRenderSetup_t, HTexture_t, RenderContext};
use graphics_engine::render_pass::RBIInfo;
use types::math::Matrix4;

/// Anti-aliasing resolve mode.
#[copyable]
pub enum AAMode: i32 {
    AA_NONE = 0x0,
    AA_FXAA_COMPUTE = 0x1,
    AA_SMAA = 0x2,
    AA_SMAA_T2X = 0x3,
    AA_FXAA = 0x4,
}

/// The tone-mapping operator applied by the HDR-to-LDR composite in
/// [`DepthOfFieldEffect::Apply`].
#[copyable]
pub enum ToneMappingTechnique: i32 {
    Reinhard = 0x0,
    U2Filmic = 0x1,
    Photographic = 0x2,
}

pub type PostEffectContext {
    pub m_RenderContext: *mut RenderContext,

    /// The smoothed bright point of the exposure-weighted histogram, published alongside
    /// [`m_Exposure`](Self::m_Exposure) each post-effects block draw.
    #[address(0x38)]
    pub m_HistogramBrightPointAfterExposure: f32,

    /// The applied auto-exposure multiplier. Published each post-effects block draw from the
    /// tone-mapping effect's smoothed exposure, and uploaded by [`DepthOfFieldEffect::Apply`] as
    /// the composite's exposure fragment constant (c2.x).
    #[address(0x3C)]
    pub m_Exposure: f32,

    /// When the post-effects manager is disabled, selects the tonemap-only composite shader instead
    /// of the raw passthrough.
    #[address(0x52)]
    pub m_TonemapWhenDisabled: bool,

    /// Selects the tone-mapping operator family for the composite shaders.
    #[address(0x54)]
    pub m_ToneMappingTechnique: ToneMappingTechnique,

    /// The auto-exposure target numerator. [`ToneMappingEffect::Update`] sets the exposure target to
    /// this divided by the raw-brightness histogram mid-point.
    #[address(0x9C)]
    pub m_AutoExposureKey: f32,
}

#[min_size(0x210)]
pub type PostEffectsManager {
    /// The slot-base the slot-returning effects' result textures live at in the manager's texture
    /// array: a stage's current result is `CTX[slot + 83]`, where `CTX` is the manager argument the
    /// post block passes to the effect chain and `slot` is the effect's declared slot index.
    pub const RESULT_TEXTURE_SLOT_BASE: u64 = 83,

    /// Master enable for the post-effects chain. When clear, [`DepthOfFieldEffect::Apply`] swaps the
    /// full composite (exposure, grading, depth of field) for the tonemap-only or passthrough
    /// shader, and the manager skips the sun halo, fade, and global-pass enqueue.
    #[address(0x20E)]
    pub m_Enabled: bool,
}
impl PostEffectsManager {
    /// Enqueues the world post-effect block, then steps the world fade accumulator
    /// ([`ApplyWorldFadeFilter`](Self::ApplyWorldFadeFilter)). `dt` flows only into
    /// that accumulator; the texture arguments are the scene inputs.
    #[address(0x140_14B_FE0)]
    pub fn ApplyWorldFilters(&mut self, dt: f32, setup: *mut HRenderSetup_t, a4: *mut HTexture_t, a5: *mut HTexture_t, a6: *mut HTexture_t, a7: *mut HTexture_t, a8: *mut HTexture_t);

    /// Enqueues the global post-effect block and advances its `dt`-driven accumulators: the screen
    /// fade alpha and the sun-direction / heat-haze accumulator.
    #[address(0x140_14C_0C0)]
    pub fn ApplyGlobalFilters(&mut self, dt: f32, ctx: *mut HContext_t);

    /// Steps the world fade accumulator.
    #[address(0x140_0F9_BD0)]
    pub fn ApplyWorldFadeFilter(&mut self, dt: f32);

    /// Whether the bokeh depth-of-field path is active, selecting the downscale plus bokeh blur over
    /// the plain [`BlurEffect`].
    #[address(0x140_0A0_270)]
    pub fn IsBokehActive(&self) -> bool;

    /// Whether motion blur is active.
    #[address(0x140_0FA_3E0)]
    pub fn IsMotionBlurActive(&self) -> bool;

    /// Post-multiplies the temporal sub-pixel jitter onto `proj`. Effective only when the resolve mode
    /// is [`AAMode::AA_SMAA_T2X`].
    #[address(0x140_0FA_050)]
    pub fn ApplySubsampleJitter(&self, proj: *mut Matrix4, width: i32, height: i32);
}

/// The render block for the post-effects pass. Its [`Draw`](Self::Draw) runs the
/// HDR post chain in order: histogram generation, sun-halo pre-apply, blur (bokeh or plain), glare,
/// depth of field, motion blur, the HDR-to-LDR tonemap, the player-damage vignette, anti-aliasing,
/// sun halo, and the final fade.
///
/// It threads a single result-texture slot index through the slot-returning effects
/// ([`DepthOfFieldEffect`], [`MotionBlurEffect`], [`PlayerDamageEffect`], [`AntiAliasingEffect`]),
/// hopping between the three fullscreen temp textures.
pub type RenderBlockPostEffects;
impl RenderBlockPostEffects {
    #[address(0x140_16A_260)]
    pub fn Draw(&mut self, ctx: *mut RenderContext, info: *const RBIInfo) -> u64;
}

/// The bokeh depth-of-field downscale prepass: a 2x2 pack plus focus.
#[min_size(0xC8)]
pub type DownScale2x2PackFocus {
    /// The effect's own working resolution, at a quarter of the scene's.
    #[address(0xC0)]
    pub m_Width: u32,

    #[address(0xC4)]
    pub m_Height: u32,
}
impl DownScale2x2PackFocus {
    /// Runs the prepass: a near-field circle-of-confusion prologue built entirely out of compute
    /// dispatches, then the packing draw.
    ///
    /// The prologue works on a quarter-resolution pair of single-channel textures (the effect's own
    /// [`m_Width`](Self::m_Width)/[`m_Height`](Self::m_Height) divided by four in each dimension),
    /// and every
    /// [`Dispatch`](graphics_engine::draw::Dispatch) in it is sized `ceil(width / 4 / 32)` by
    /// `ceil(height / 4 / 8)` groups of 32x8 threads, covering that whole texture:
    ///
    /// 1. `bokehextractneardof` reads the depth texture and the manager's focal parameters and writes
    ///    the near-field coverage into the first of the two textures. It takes no view or projection
    ///    matrix -- only the depth-to-linear terms and the focal tuning -- so its result does not
    ///    depend on the camera's projection shape.
    /// 2. `bokehblurneardof` runs four times, two horizontal-then-vertical rounds ping-ponging the two
    ///    textures, so the blurred coverage ends up back in the first. Compute constant 0's `xy` is the
    ///    integer step direction for the round ((1, 0) or (0, 1)) and is the program's only input
    ///    besides the source texture. The kernel is a fixed 7-tap Gaussian, `-3..+3` texels along the
    ///    step, so two rounds reach 6 texels along each axis. Like the extract, the program addresses
    ///    its source and destination directly by `SV_DispatchThreadID`, with no origin or offset term
    ///    and no bounds clamp -- taps outside the texture read zero.
    ///
    /// The packing draw then downsamples the scene into the effect's own render setup with the blurred
    /// near-field coverage bound as a texture, colouring it with the time-of-day haze terms. That draw
    /// is the sole consumer of [`GetViewProjInverse`], which it uploads as vertex constants 1..4; no
    /// part of the compute prologue reads it.
    #[address(0x140_0C8_2E0)]
    pub fn Apply(&mut self, ctx: *mut HContext_t, pec: *mut PostEffectContext, mgr: *mut PostEffectsManager);
}

/// The Gaussian blur, used on the non-bokeh path.
pub type BlurEffect;
impl BlurEffect {
    #[address(0x140_0BC_B10)]
    pub fn Apply(&mut self, ctx: *mut HContext_t, pec: *mut PostEffectContext, mgr: *mut PostEffectsManager) -> bool;
}

/// The bokeh blur, used when [`PostEffectsManager::IsBokehActive`]; runs after
/// [`DownScale2x2PackFocus`].
pub type BlurEffectBokeh;
impl BlurEffectBokeh {
    #[address(0x140_0A7_870)]
    pub fn Apply(&mut self, ctx: *mut HContext_t, pec: *mut PostEffectContext, mgr: *mut PostEffectsManager);
}

pub type MotionBlurEffect;
impl MotionBlurEffect {
    #[address(0x140_0C8_E20)]
    pub fn Apply(&mut self, ctx: *mut HContext_t, pec: *mut PostEffectContext, mgr: *mut PostEffectsManager, input: u32, blur: f32, flag0: bool, flag1: bool) -> u32;
}

pub type DepthOfFieldEffect;
impl DepthOfFieldEffect {
    #[address(0x140_0C7_890)]
    pub fn Apply(&mut self, ctx: *mut HContext_t, pec: *mut PostEffectContext, mgr: *mut PostEffectsManager, input: u32) -> u32;
}

/// The alpha-blended fade quad over the scene.
pub type FadeEffect;
impl FadeEffect {
    #[address(0x140_0A9_570)]
    pub fn Apply(&mut self, ctx: *mut HContext_t, a3: *mut void) -> u64;
}

/// The bloom / glare generator. Writes its own scratch targets, composited later.
pub type GlareEffect;
impl GlareEffect {
    #[address(0x140_0AA_510)]
    pub fn Apply(&mut self, ctx: *mut HContext_t, pec: *mut PostEffectContext, a4: *mut void, a5: *mut void) -> u64;
}

/// The red damage vignette. Returns the input slot index unchanged.
pub type PlayerDamageEffect;
impl PlayerDamageEffect {
    #[address(0x140_0F7_6E0)]
    pub fn Apply(&mut self, ctx: *mut HContext_t, pec: *mut PostEffectContext, a4: *mut void, input: u32) -> u32;
}

/// The sun halo. [`PreApply`](Self::PreApply) prepares it and sets the ready flag;
/// [`Apply`](Self::Apply) composites it.
#[min_size(0x118)]
pub type SunHaloEffect {
    /// The ready flag: [`PreApply`](Self::PreApply) sets it when the halo is prepared, and
    /// [`Apply`](Self::Apply) early-outs when it is clear.
    #[address(0x114)]
    pub m_Ready: bool,
}
impl SunHaloEffect {
    #[address(0x140_118_450)]
    pub fn PreApply(&mut self, ctx: *mut HContext_t, a3: *mut void, mgr: *mut PostEffectsManager) -> u64;

    #[address(0x140_0F8_030)]
    pub fn Apply(&mut self, ctx: *mut HContext_t) -> u64;
}

/// The anti-aliasing resolve. [`AAMode::AA_SMAA_T2X`] additionally reprojects against a previous-frame
/// history texture.
#[min_size(0x308)]
pub type AntiAliasingEffect {
    #[address(0x300)]
    pub m_Mode: AAMode,
}
impl AntiAliasingEffect {
    /// `slot` is the in/out post-effect result-slot index.
    #[address(0x140_0BC_9A0)]
    pub fn Apply(&mut self, ctx: *mut HContext_t, pec: *mut PostEffectContext, mgr: *mut PostEffectsManager, slot: *mut u32) -> u64;

    /// Post-multiplies the sub-pixel clip-space jitter translation onto `proj`, only when the resolve
    /// mode is [`AAMode::AA_SMAA_T2X`]. The phase comes from the previous-frame counter parity.
    #[address(0x140_0C7_700)]
    pub fn ApplySubsampleJitter(&self, proj: *mut Matrix4, width: i32, height: i32);

    /// Allocates the temporal history ping-pong textures and their render setups, sized `width` by
    /// `height`.
    #[address(0x140_0A5_E30)]
    pub fn CreateRenderTargetResources(&mut self, mgr: *const PostEffectsManager, width: i32, height: i32);
}

/// Builds the depth-of-field chain's clip-to-world basis into `out`, which is also returned.
///
/// It rebuilds the clip-to-view inverse from the post-effect render context's vertical field of view,
/// aspect ratio, and far/near planes via [`Matrix4::PerspectiveFovInverse`](types::math::Matrix4), then
/// multiplies that by the context's camera transform with the translation row replaced by
/// `(0, 0, 0, 1)`, so the result maps clip space to a camera-relative world direction. Being rebuilt
/// from a field of view and an aspect ratio, it can only describe a symmetric frustum, whatever
/// projection the context actually carries.
///
/// Its one caller is [`DownScale2x2PackFocus::Apply`], which uploads the result as vertex constants
/// 1..4 of the packing draw that ends the bokeh downscale prepass.
#[address(0x140_0C7_7E0)]
pub fn GetViewProjInverse(out: *mut Matrix4, ctx: *mut PostEffectContext) -> *mut Matrix4;
