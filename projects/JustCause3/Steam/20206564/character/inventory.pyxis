use character::character::Character;
use equipment::grappling_hook::GrapplingHook;
use equipment::weapon::{AmmunitionType, WeaponBase};
use types::math::Vector3;
use types::shared_ptr::SharedPtr;

/// An inventory weapon slot (`CInventory::EWeaponSlot`). Mounted guns a character picks up occupy
/// [`E_SLOT_HEAVY`](Self::E_SLOT_HEAVY): `CCharacter::IsInMountedGunState` tests the weapon in that
/// slot.
#[copyable]
pub enum WeaponSlot: i32 {
    E_SLOT_DUAL_WIELD = 0x0,
    E_SLOT_TWO_HANDED = 0x1,
    E_SLOT_HEAVY = 0x2,
    E_SLOT_HAND_GRENADE = 0x3,
    E_SLOT_PLANTED_EXPLOSIVE = 0x4,
    E_SLOT_FOW = 0x5,
    E_SLOT_TWO_HANDED_SPECIAL = 0x6,
    E_SLOT_BEACON = 0x7,
    E_NUM_WEAPON_SLOTS = 0x8,
    E_NONE = 0x9,
}

/// The character's equipment inventory (`CInventory`), embedded in `CCharacter`
/// ([`Character::m_Inventory`](character::character::Character::m_Inventory)). Only some members
/// are mapped.
#[min_size(0x3E8)]
pub type Inventory {
    /// The weapon in each slot, indexed by [`WeaponSlot`] (up to
    /// [`E_NUM_WEAPON_SLOTS`](WeaponSlot::E_NUM_WEAPON_SLOTS)); a null pointer for an empty slot.
    /// `CCharacter::GetWeaponInInventory` returns a reference to an entry.
    #[address(0x20)]
    pub m_Weapons: [SharedPtr<WeaponBase>; 8],

    /// The character's grappling hook, or null before the inventory is populated.
    /// `CCharacter::GetGrapplingHook` returns a reference to this field.
    #[address(0xC0)]
    pub m_GrapplingHook: SharedPtr<GrapplingHook>,

    /// Whether the current animation permits shooting; one half of
    /// [`GetAnimationAllowsShooting`](Self::GetAnimationAllowsShooting).
    #[address(0x184)]
    pub m_DoesAnimationAllowShooting: bool,
    /// Whether the character may reload: recomputed by
    /// [`UpdateInventoryPermissions`](Self::UpdateInventoryPermissions), and cleared by the
    /// [`SB_DISABLE_RELOAD`](state::StateBitFlag::SB_DISABLE_RELOAD) state bit.
    pub m_DoesAnimationAllowReloading: bool,
    /// Whether the character may use grenades: recomputed by
    /// [`UpdateInventoryPermissions`](Self::UpdateInventoryPermissions) (off while planting an
    /// explosive, while a camera hint of the wielded weapon is active, while the grapple is busy, and
    /// without the grenade ability), and cleared by the
    /// [`SB_DISABLE_USE_GRENADES`](state::StateBitFlag::SB_DISABLE_USE_GRENADES) state bit.
    /// [`UpdateWeapons_Parallel`](Self::UpdateWeapons_Parallel) zeroes the grenade input while it
    /// is clear.
    pub m_DoesAnimationAllowGrenades: bool,

    /// Whether the current animation permits picking up a weapon; one half of
    /// [`GetAnimationAllowsPickup`](Self::GetAnimationAllowsPickup).
    /// [`UpdateWeaponHandling`](Self::UpdateWeaponHandling) acts on the use-item input only while
    /// it is set.
    #[address(0x188)]
    pub m_DoesAnimationAllowPickup: bool,

    /// Whether the current animation permits switching weapons: recomputed by
    /// [`UpdateInventoryPermissions`](Self::UpdateInventoryPermissions). A deferred switch, a
    /// committed slot selection (`CCharacter::SwitchWeapon`), and
    /// [`TryToSwitchToValidWeapon`](Self::TryToSwitchToValidWeapon) all wait on it.
    #[address(0x189)]
    pub m_DoesAnimationAllowSwitchingWeapons: bool,
    /// Whether the character may plant explosives: recomputed by
    /// [`UpdateInventoryPermissions`](Self::UpdateInventoryPermissions), and off for the player
    /// without the planted-explosives ability. One half of
    /// [`GetAnimationAllowsPlantingExplosives`](Self::GetAnimationAllowsPlantingExplosives).
    pub m_DoesAnimationAllowPlantingExplosives: bool,
    /// Whether the character may detonate its placed explosives: recomputed by
    /// [`UpdateInventoryPermissions`](Self::UpdateInventoryPermissions), and off for the player
    /// without the planted-explosives ability. One half of
    /// [`GetAnimationAllowsTriggeringExplosives`](Self::GetAnimationAllowsTriggeringExplosives).
    pub m_DoesAnimationAllowTriggeringExplosives: bool,

    /// The character's reserve of each kind of ammunition, indexed by [`AmmunitionType`] (up to
    /// [`NOF_AMMO_TYPES`](AmmunitionType::NOF_AMMO_TYPES)). A weapon's magazine
    /// ([`WeaponBase::m_MagazineAmmo`](equipment::weapon::WeaponBase::m_MagazineAmmo)) is separate;
    /// a reload moves rounds from here into it. Read it through
    /// [`GetAmmoCount`](Self::GetAmmoCount) and write it through
    /// [`SetAmmoCount`](Self::SetAmmoCount), which keeps the HUD current.
    #[address(0x1B0)]
    pub m_Ammunition: [i32; 17],

    /// The cap on each entry of [`m_Ammunition`](Self::m_Ammunition), indexed the same way; the
    /// ammunition upgrades raise it.
    #[address(0x1F4)]
    pub m_MaxAmmunition: [i32; 17],

    /// The character that owns the inventory.
    #[address(0x3E0)]
    pub m_Character: *mut Character,
}
impl Inventory {
    /// The reserve of `ammo_type`: its entry of [`m_Ammunition`](Self::m_Ammunition).
    #[address(0x140_8BB_460)]
    pub fn GetAmmoCount(&self, ammo_type: AmmunitionType) -> i32;

    /// Sets the reserve of `ammo_type` to `count`, capped at its
    /// [`m_MaxAmmunition`](Self::m_MaxAmmunition) entry. For the locally controlled owner it pushes
    /// the new reserve to the HUD (`CHUDUI::OnSetSelectedInventoryAmmo`) when it is the selected
    /// weapon's kind, or refreshes the grenade count for
    /// [`AMMO_HAND_GRENADE`](AmmunitionType::AMMO_HAND_GRENADE); for
    /// [`AMMO_BEACON`](AmmunitionType::AMMO_BEACON) and [`AMMO_FLARE`](AmmunitionType::AMMO_FLARE)
    /// it sends the resupply-point refresh event and, when the count changed and `save_game` is
    /// set, autosaves.
    ///
    /// A refill from empty (the old reserve zero, `count` positive) reloads: when the wielded
    /// weapon uses `ammo_type` and its magazine is empty it calls
    /// [`Character::StartReloadingWieldingWeapon`](character::character::Character::StartReloadingWieldingWeapon),
    /// and for [`AMMO_HAND_GRENADE`](AmmunitionType::AMMO_HAND_GRENADE) it calls the hand-grenade
    /// weapon's [`Reload`](equipment::weapon::WeaponBase::Reload) directly when that weapon's
    /// magazine is empty. [`WeaponBase::Reload`](equipment::weapon::WeaponBase::Reload) writes the
    /// reserve back through it.
    #[address(0x140_8C6_670)]
    pub fn SetAmmoCount(&mut self, ammo_type: AmmunitionType, count: i32, save_game: bool);

    /// Fills every reserve to its [`m_MaxAmmunition`](Self::m_MaxAmmunition) entry, with the same
    /// HUD updates, events, autosave, and refill-from-empty reloads as
    /// [`SetAmmoCount`](Self::SetAmmoCount) for each kind.
    #[address(0x140_8D5_ED0)]
    pub fn GiveMaxAmmo(&mut self);

    /// Whether the character may reload:
    /// [`m_DoesAnimationAllowReloading`](Self::m_DoesAnimationAllowReloading) is set and the
    /// owner's [`SB_DISABLE_RELOAD`](state::StateBitFlag::SB_DISABLE_RELOAD) state bit is clear.
    /// [`Character::StartReloadingWieldingWeapon`](character::character::Character::StartReloadingWieldingWeapon)
    /// and the ammunition check require it.
    #[address(0x140_8BB_660)]
    pub fn GetAnimationAllowsReloading(&self) -> bool;

    /// The inventory's parallel per-frame update. `muzzle_target` and `grenade_target` point at
    /// by-value `CVector3f` copies of the owner's weapon and grenade aim targets.
    #[address(0x140_942_920)]
    pub fn Update_Parallel(&mut self, dt: f32, muzzle_target: *const Vector3, grenade_target: *const Vector3);

    /// The inventory's parallel weapon update, called from [`Update_Parallel`](Self::Update_Parallel)
    /// with the same aim targets. It calls each active weapon's
    /// [`UpdateFromUserPostSim_Parallel`](equipment::weapon::WeaponBase::UpdateFromUserPostSim_Parallel):
    /// the mounted gun in [`E_SLOT_HEAVY`](WeaponSlot::E_SLOT_HEAVY) while the owner is in a
    /// mounted-gun state, otherwise the boost wingsuit's guns while wingsuiting or else the wielding
    /// weapon, all with `muzzle_target`, and then the selected grenade with `grenade_target`. The
    /// fire inputs passed down come from the owner's
    /// [`m_WeaponInputs`](character::character::Character::m_WeaponInputs), zeroed while shooting
    /// (or throwing) is not allowed. The disassembler mislabels it `CGrapplingHook::GetFireInputEnabled`.
    #[address(0x140_8C6_9A0)]
    pub fn UpdateWeapons_Parallel(&mut self, dt: f32, muzzle_target: *const Vector3, grenade_target: *const Vector3);

    /// The serial counterpart of [`UpdateWeapons_Parallel`](Self::UpdateWeapons_Parallel): the same
    /// weapons with the same targets and inputs, through
    /// [`UpdateFromUserPostSim_Serial`](equipment::weapon::WeaponBase::UpdateFromUserPostSim_Serial),
    /// and additionally the planted-explosive slot's weapon.
    #[address(0x140_91B_BB0)]
    pub fn UpdateWeapons_Serial(&mut self, dt: f32, muzzle_target: *const Vector3, grenade_target: *const Vector3);

    /// Whether the character may shoot: [`m_DoesAnimationAllowShooting`](Self::m_DoesAnimationAllowShooting)
    /// is set and the owner's
    /// [`SB_DISABLE_SHOOT`](state::StateBitFlag::SB_DISABLE_SHOOT) state
    /// bit is clear.
    #[address(0x140_8BB_630)]
    pub fn GetAnimationAllowsShooting(&self) -> bool;

    /// Whether the character may plant explosives:
    /// [`m_DoesAnimationAllowPlantingExplosives`](Self::m_DoesAnimationAllowPlantingExplosives) is
    /// set and the owner's
    /// [`SB_DISABLE_PLANT_EXPLOSIVES`](state::StateBitFlag::SB_DISABLE_PLANT_EXPLOSIVES) state bit
    /// is clear.
    #[address(0x140_8BB_7B0)]
    pub fn GetAnimationAllowsPlantingExplosives(&self) -> bool;

    /// Whether the character may detonate its placed explosives:
    /// [`m_DoesAnimationAllowTriggeringExplosives`](Self::m_DoesAnimationAllowTriggeringExplosives)
    /// is set and the owner's
    /// [`SB_DISABLE_TRIGGER_EXPLOSIVES`](state::StateBitFlag::SB_DISABLE_TRIGGER_EXPLOSIVES) state
    /// bit is clear.
    #[address(0x140_8BB_7E0)]
    pub fn GetAnimationAllowsTriggeringExplosives(&self) -> bool;

    /// Recomputes the inventory's per-frame permissions from the owner's state (it consults the
    /// grapple reel-in predicates among others).
    #[address(0x140_91B_3E0)]
    pub fn UpdateInventoryPermissions(&mut self);

    /// The inventory's per-frame weapon-handling update (`CInventory::UpdateWeaponHandling`), run
    /// from [`Update_Parallel`](Self::Update_Parallel) after
    /// [`UpdateInventoryPermissions`](Self::UpdateInventoryPermissions). It handles the holster
    /// input ([`Character::HolsterWeapon`](character::character::Character::HolsterWeapon), or a
    /// deferred holster while the animation does not allow one), draws a weapon when weapon input
    /// arrives with nothing wielded, the precision-aim and grenade inputs, and the weapon-selection
    /// HUD. The input draws are two: with nothing wielded
    /// ([`Character::GetWieldingWeapon`](character::character::Character::GetWieldingWeapon)) or a
    /// holster playing, a positive fire input
    /// ([`E_INPUT_MAIN_WEAPON`](character::character::WeaponInput::E_INPUT_MAIN_WEAPON)) calls
    /// [`Character::DrawWeapon`](character::character::Character::DrawWeapon); and for the player,
    /// with nothing wielded, a positive precision-aim input
    /// ([`E_INPUT_PRECISION_AIM`](character::character::WeaponInput::E_INPUT_PRECISION_AIM)) that
    /// precision aim is possible for draws the selected weapon too, entering precision aim when
    /// that weapon supports it. Both read the inputs from
    /// [`Character::m_WeaponInputs`](character::character::Character::m_WeaponInputs). For the player, with no weapon input and no draw or holster playing, it acts on the
    /// avatar's mental state: in [`E_COMBAT`](character::avatar::MentalState::E_COMBAT) with
    /// nothing wielded it draws the selected weapon when the animation allows it (the latched
    /// permission and a clear
    /// [`SB_DISABLE_MENTAL_STATE_DRAW_WEAPON`](state::StateBitFlag::SB_DISABLE_MENTAL_STATE_DRAW_WEAPON));
    /// in [`E_RELAXED`](character::avatar::MentalState::E_RELAXED) with a weapon wielded, while
    /// holstering is allowed and the weapon has no deferred unequip pending, it leaves precision
    /// aim, clears the grenade and mortar permissions, and queues `UB_ACT_HOLSTER` through
    /// [`Character::QueueAct`](character::character::Character::QueueAct). The relaxed branch
    /// fires every tick its conditions hold, and it is how the player's holster input takes
    /// effect, since the player's `HolsterWeapon` only forces the relaxed state.
    ///
    /// It is also where a weapon in the world is picked up. While
    /// [`GetAnimationAllowsPickup`](Self::GetAnimationAllowsPickup) holds and the use-item input
    /// ([`E_INPUT_USE_ITEM`](character::character::WeaponInput::E_INPUT_USE_ITEM)) is positive, a
    /// character on land queues `ACT_PICKUP_WEAPON`, the full-body pickup animation. The weapon's
    /// pickup interaction starts the pickup when it executes
    /// ([`WeaponBase::PickupStart`](equipment::weapon::WeaponBase::PickupStart)), and the weapon's
    /// pickup track message completes it
    /// ([`WeaponBase::PickupItem`](equipment::weapon::WeaponBase::PickupItem)).
    /// A swimming character instead takes the first weapon among its interaction user proxy's
    /// valid entries (or the weapon of a weapon placement rule among them), picks it up at once
    /// with `PickupItem`, and queues `ACT_PICKUP_WEAPON_PARTIAL`.
    #[address(0x140_932_F10)]
    pub fn UpdateWeaponHandling(&mut self, dt: f32);

    /// Whether the character may pick up a weapon now:
    /// [`m_DoesAnimationAllowPickup`](Self::m_DoesAnimationAllowPickup) is set and the owner's
    /// [`SB_DISABLE_PICKUP`](state::StateBitFlag::SB_DISABLE_PICKUP) state bit is clear. The weapon
    /// pickup interaction tests it before it starts a pickup.
    #[address(0x140_8BB_6F0)]
    pub fn GetAnimationAllowsPickup(&self) -> bool;

    /// Switches to the first weapon that still has ammunition, in a fixed order: the
    /// [`E_SLOT_TWO_HANDED`](WeaponSlot::E_SLOT_TWO_HANDED) weapon, then the
    /// [`E_SLOT_DUAL_WIELD`](WeaponSlot::E_SLOT_DUAL_WIELD) weapon, then the
    /// [`E_SLOT_TWO_HANDED_SPECIAL`](WeaponSlot::E_SLOT_TWO_HANDED_SPECIAL) weapon. A weapon
    /// qualifies when its magazine is not empty or the inventory holds ammunition of its type; the
    /// order does not depend on the wielded slot, which is skipped only because it is empty. The
    /// first that qualifies is switched to through `CCharacter::SelectWeapon`, and the function
    /// returns true. It does nothing and returns false while
    /// [`m_DoesAnimationAllowSwitchingWeapons`](Self::m_DoesAnimationAllowSwitchingWeapons) is
    /// clear, while the owner's
    /// [`SB_DISABLE_SWITCH_WEAPONS`](state::StateBitFlag::SB_DISABLE_SWITCH_WEAPONS) state bit is
    /// set, or when no weapon qualifies.
    ///
    /// It has two callers. [`WeaponBase::CheckIfReloadShouldBeTriggeredBase`](equipment::weapon::WeaponBase::CheckIfReloadShouldBeTriggeredBase)
    /// calls it when the player pulls the trigger of a weapon that is empty and cannot reload,
    /// which is the game's automatic switch away from an empty weapon. The `NWeaponEquipTask`
    /// state task calls it on entry when its character wields nothing and the task is not
    /// configured to equip a fixed slot.
    #[address(0x140_8D6_1F0)]
    pub fn TryToSwitchToValidWeapon(&mut self) -> bool;

    /// Places the inventory's weapons on the character
    /// (`CInventory::UpdateAttachmentTransforms`): calls each slot weapon's attachment-transform
    /// virtual, which sets every gun's current world matrix
    /// ([`WeaponData::m_WorldMatrixT1`](equipment::weapon::WeaponData::m_WorldMatrixT1)) from the
    /// bone its attach-bone table
    /// ([`WeaponData::m_lBoneAttachementPerWeaponState`](equipment::weapon::WeaponData::m_lBoneAttachementPerWeaponState))
    /// names for the weapon's state, then places the hand-held hijacking props, the boost
    /// wingsuit's guns while wingsuiting, and the hijacking explosive. The character's pose-finalization pass
    /// ([`Character::UpdatePassFinalizePose_Parallel`](character::character::Character::UpdatePassFinalizePose_Parallel))
    /// calls it after its state tasks and again after the `MAIN` IK solve;
    /// [`Character::UpdateSecondaryHandIKPass`](character::character::Character::UpdateSecondaryHandIKPass)
    /// and the character's prop-transform update call it too. The `p3` and `p4` floats are
    /// passed through to the weapons unchanged.
    #[address(0x140_8E4_6A0)]
    pub fn UpdateAttachmentTransforms(&mut self, character: *const Character, p3: f32, p4: f32, transform_type: u32);

    /// Runs each slot weapon's
    /// [`UpdatePostFinalizePose`](equipment::weapon::WeaponBase::UpdatePostFinalizePose), which
    /// rewrites every gun's attach-bone table from the weapon's slot. The character's
    /// pose-finalization pass calls it after the attachment placement and the IK passes, so a
    /// table entry written by the character's state tasks or by any other writer lasts until this
    /// call.
    #[address(0x140_8C6_960)]
    pub fn UpdateInventoryPostFinalizePose(&mut self);

    /// Updates the inventory's attached effect container (the wielded weapon's muzzle flash,
    /// casings, and sounds), when it has one.
    #[address(0x140_8C6_D30)]
    pub fn UpdateAttachmentEffects(&mut self, dt: f32);
}
