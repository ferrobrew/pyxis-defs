/// The character's packed aiming and presentation bit-flags (one byte of `CCharacter` bitfields).
/// [`HandleAimingInputPlayer`](Character::HandleAimingInputPlayer) writes the weapon-aim bit each
/// tick for the player and [`PreSimUpdateGrapple`](Character::PreSimUpdateGrapple) the grapple-aim
/// bit; the locomotion state machine reads them to choose aim-relative (strafe) movement over
/// run/steer: `m_AimingWeapon` (or `m_AimingGrapple`) is the switch that makes the body face the aim
/// direction and turns the directional keys into strafes. `m_WasAiming` reflects the state as of the
/// start of this frame. The other bits are unrelated flags that share the byte.
#[copyable]
pub bitflags AimState: u8 {
    /// `m_WasVisible`: the previous frame's visibility, cleared and re-latched by
    /// `CCharacter::UpdateModelVisibility`.
    m_WasVisible = 0b0000_0001,
    /// `m_UseFinalTransparency`: whether the character's models render with the final-transparency
    /// setting. Written by `CCharacter::SetUseFinalTransparency`.
    m_UseFinalTransparency = 0b0000_0010,
    m_AimingEnabled = 0b0000_0100,
    /// `m_WeaponAimActive`.
    m_AimingWeapon = 0b0000_1000,
    /// `m_GrappleAimActive`.
    m_AimingGrapple = 0b0001_0000,
    m_WasAiming = 0b0010_0000,
    /// `m_GodModeSequence`: the sequence-scoped god mode. `CCharacter::SetupForSequence` sets it
    /// for the player when [`GOD_MODE`](DamageStateFlags::GOD_MODE) is off, and
    /// [`SetGodMode`](Character::SetGodMode) clears it.
    m_GodModeSequence = 0b0100_0000,
    /// `m_InCargoBay`: the character is riding in a vehicle's cargo bay. Read by
    /// [`IsInCargoBay`](Character::IsInCargoBay).
    m_InCargoBay = 0b1000_0000,
}

/// A byte of `CCharacter` bitfields holding the visibility, invulnerability, and weapons-enabled
/// flags. Not every bit is mapped: three of the remaining bits are, in ascending order, `Enabled`,
/// `m_GhostMode`, and `m_PermanentGhostMode`, and these names are unconfirmed.
#[copyable]
pub bitflags DamageStateFlags: u8 {
    /// `Visible`: whether the character's models are shown. Read by `CCharacter::IsVisible`.
    VISIBLE = 0b0000_0001,
    /// God mode: the character takes no damage. Written by [`SetGodMode`](Character::SetGodMode);
    /// the player object re-applies its own god-mode flag through that setter whenever the two
    /// disagree.
    GOD_MODE = 0b0000_0010,
    /// `m_JesusMode`: the damage-immune variant written by `CCharacter::SetJesusMode`, which, when
    /// enabling it on a living character, also restores health and forces the neutral state.
    JESUS_MODE = 0b0000_0100,
    /// `m_WeaponsEnabled`: whether the character may use its weapons. Written by
    /// [`SetWeaponsEnabled`](Character::SetWeaponsEnabled); both aim-input updates
    /// ([`HandleAimingInputPlayer`](Character::HandleAimingInputPlayer) and
    /// [`HandleAimingInputNPC`](Character::HandleAimingInputNPC)) only let an aiming weapon
    /// refresh the aim timer while it is set.
    WEAPONS_ENABLED = 0b0100_0000,
}

/// Per-character LOD/update-gating flags. Checked before the SIM-phase animation and IK work:
/// [`UpdatePassFinalizePose_Parallel`](Character::UpdatePassFinalizePose_Parallel) skips the
/// HumanIK solve when [`REDUCED_LOD`](Self::REDUCED_LOD) is set. Only that bit is mapped.
#[copyable]
pub bitflags CharacterLodFlags: u8 {
    REDUCED_LOD = 0b0000_0010,
}

/// A byte of `CCharacter` bitfields that enable traversal abilities, each written by its own
/// setter. `CGameWorld::TeleportPlayerInstant` sets
/// [`m_IsStuntAutoExitEnabled`](Self::m_IsStuntAutoExitEnabled) on the player character as part of
/// the teleport.
#[copyable]
pub bitflags AbilityFlags: u8 {
    /// Whether the character may deploy the parachute. Written by
    /// [`SetParachuteEnabled`](Character::SetParachuteEnabled).
    m_IsParachuteEnabled = 0b0000_0001,
    /// Whether the character may use the wingsuit. Written by
    /// [`SetWingsuitEnabled`](Character::SetWingsuitEnabled).
    m_IsWingsuitEnabled = 0b0000_0010,
    /// Whether the character automatically leaves stunt positions. Written by
    /// [`SetStuntAutoExitEnabled`](Character::SetStuntAutoExitEnabled).
    m_IsStuntAutoExitEnabled = 0b0000_0100,
}

#[size(0x3540)]
pub type Character {
    /// `m_CurrentMotionState` while swimming, written by both swim movement cores every frame.
    pub const MOTION_STATE_SWIMMING: u32 = 0x18,
    /// `m_CurrentMotionState` while ragdolling.
    pub const MOTION_STATE_RAGDOLL: u32 = 0x14,
    /// `m_CurrentMotionState` while a movement task drives the proxy velocity itself. The on-foot
    /// locomotion task (`NStateTask_MovementLocomotionTask::Update`) sets it on every update in
    /// which it writes the proxy's wanted velocity, and leaves the value alone when it returns
    /// early because the character is attached to a vehicle.
    pub const MOTION_STATE_TASK_DEFINED: u32 = 0x19,
    /// The offset of the character's `CGameObject` base subobject. RTTI tests (`IsType`) and the
    /// `CGameObject` virtuals go through the vtable at this offset rather than the primary one,
    /// and state tasks recover the character from that subobject by subtracting this offset.
    pub const GAME_OBJECT_BASE_OFFSET: u64 = 0x8,
    /// The state-task range that
    /// [`UpdatePassFinalizePose_Parallel`](Self::UpdatePassFinalizePose_Parallel) runs at its start,
    /// before the IK solve: the range the aim IK, look-at IK, grapple-fire arm IK, and weapon
    /// off-hand IK tasks are registered in.
    pub const FINALIZE_POSE_STATE_TASK_RANGE: u32 = 0x9B810CE7,
    /// The slot, in the vtable of the [`GAME_OBJECT_BASE_OFFSET`](Self::GAME_OBJECT_BASE_OFFSET)
    /// subobject, of `CGameObject::InitTransform(const CMatrix4f*)`: it re-bases the object's world
    /// transform directly. `CGameWorld::TeleportPlayerInstant` moves the player character through it.
    pub const GAME_OBJECT_INIT_TRANSFORM_SLOT: u64 = 18,

    vftable {
        /// The character's current health (`CDamageable::GetHealth`, returning `m_CurHealth`).
        /// [`HUDUI::UpdateHealth`](ui::hud_ui::HUDUI::UpdateHealth) reads it every frame.
        #[index(27)]
        pub fn GetHealth(&self) -> i16;

        /// Attaches the character to a parent (`CCharacter::AttachTo`): `target` is the parent's
        /// attach frame, `object` the parent object, `attach_type` a `CCharacter::AttachType`, and
        /// `offset` the character's transform relative to the parent frame. While attached, the
        /// character's world transform follows the parent instead of the physics proxy.
        /// [`SetYAlignedAttachTo`](Self::SetYAlignedAttachTo) is the yaw-aligned wrapper.
        #[index(40)]
        pub fn AttachTo(&mut self, target: *const Matrix4, object: *mut void, attach_type: u32, offset: *const Matrix4, flags: u32);
    },

    /// A weak reference to the character itself (`m_WeakThis`), from which the engine takes the
    /// references it hands out to the character, such as a damage message's
    /// [`m_Damager`](damage::DamageMsg::m_Damager).
    #[address(0x68)]
    pub m_WeakThis: WeakPtrGameObject,

    /// The character's maximum health (`CDamageable::m_MaxHealth`), the scale of
    /// [`GetHealth`](Self::GetHealth). [`HUDUI::InitHealth`](ui::hud_ui::HUDUI::InitHealth) passes
    /// the local player character's to the movie.
    #[address(0x1B0)]
    pub m_MaxHealth: i16,

    /// The hit reaction's per-type impulse scales: [`HitReaction`](Self::HitReaction) scales a
    /// hit's impulse by the entry of the lowest [`DamageFlags`](damage::DamageFlags) type bit set
    /// (the first when none is). Per-character tuning read from data, as are the thresholds below.
    #[address(0x45C)]
    pub m_HitReaction_DamageImpulseScale: [f32; 20],
    /// The further impulse scale of a headshot.
    pub m_HitReaction_HeadshotImpulseScale: f32,
    /// The most a scaled impulse moves the character's ragdoll: the impulse
    /// [`HitReaction`](Self::HitReaction) queues on the ragdoll is the hit's direction times the
    /// smaller of this and the scaled impulse.
    pub m_HitReaction_DamageImpulseMax: f32,
    /// The scaled impulse at or above which a hit knocks a non-player character into its ragdoll.
    pub m_HitReaction_ImpulseRagdollThreshold: f32,
    pub m_HitReaction_StuntFallOffImpactWeight: f32,
    /// The scaled impulse above which a hit staggers the character: it becomes the character's
    /// current reaction force, which the hit-reaction animation reads.
    pub m_HitReaction_ImpulseStumbleThreshold: f32,
    /// The impulse, accumulated over hits in quick succession, at which a hit too weak to stagger
    /// the character alone counts as staggering.
    pub m_HitReaction_AccumalatedImpulseStumbleThreshold: f32,

    /// The character's aiming-settings resource (`TResourceCachePtr<SCharacterAimingSettings>`, a
    /// resource handle resolved through the resource cache). Both aim-input updates read the
    /// aim-timer refill value from the resolved settings.
    #[address(0x938)]
    pub m_AimingSettings: *mut u8,

    /// The character's embedded equipment inventory.
    #[address(0x980)]
    pub m_Inventory: Inventory,

    /// The character's embedded HumanIK solver. Driven each frame in
    /// [`UpdatePassFinalizePose_Parallel`](Self::UpdatePassFinalizePose_Parallel), after the
    /// animation graph finalizes the local pose and before the model-space pose is computed. See
    /// [`HumanIK`] for the per-pass lifecycle.
    #[address(0x1_0E0)]
    pub m_HIK: HumanIK,

    #[address(0x1_780)]
    pub m_AnimatedModel: AnimatedModel,

    /// The character's physics-side body instance. The movement actuators drive the character
    /// through it: they write the wanted velocity into its input and its orientation through
    /// [`SetOrientation`](physics::PfxCharacterInstance::SetOrientation).
    #[address(0x2_050)]
    pub m_PfxCharacter: SharedPtr<PfxCharacterInstance>,

    /// The character's embedded [`ObjectBlackboard`]. The loco tasks' blackboard call sites address
    /// it in place on the character.
    #[address(0x2_060)]
    pub m_Blackboard: ObjectBlackboard,

    /// Packed damage-state bit-flags; see [`DamageStateFlags`].
    #[address(0x2_0E9)]
    pub m_DamageFlags: DamageStateFlags,

    /// Whether the character's weapons draw ammunition without consuming it. Read by
    /// `CWeaponBase::HasUnlimitedAmmo` together with the non-player and challenge-island rules.
    /// Set through [`SetUnlimitedAmmo`](Self::SetUnlimitedAmmo), which also refreshes the HUD's
    /// weapon readout for the player.
    #[address(0x2_0F0)]
    pub m_UnlimitedAmmo: bool,

    /// Packed aiming-state bit-flags; see [`AimState`].
    #[address(0x2_0F1)]
    pub m_AimFlags: AimState,

    /// The proxy state requested for the character, a [`ProxyState`] value.
    /// [`SetProxyState`](Self::SetProxyState) writes it, and
    /// [`UpdateProxyState`](Self::UpdateProxyState) applies it to the physics proxy on the
    /// simulation thread. The animation graph's proxy-state task requests states on its state's
    /// entry and exit.
    #[address(0x2_134)]
    pub m_PendingProxyState: i32,
    /// The proxy state the character returns to, a [`ProxyState`] value. The graph's proxy-state
    /// restores and the paratrooper logic request it. The player's is
    /// [`PLAYER_STANDING`](ProxyState::PLAYER_STANDING), set at player initialization through
    /// [`SetDefaultProxyState`](Self::SetDefaultProxyState).
    pub m_DefaultProxyState: i32,

    /// How the character's motion is integrated this frame (`CCharacter::EMotionState`), read by
    /// the dispatch in `CCharacter::UpdateIntegratingPhysics`. Each movement actuator sets it as
    /// part of its per-frame update. Left as a raw integer because only a few of its ~25 values have
    /// been confirmed: `MOTION_STATE_SWIMMING`, `MOTION_STATE_RAGDOLL`, and
    /// `MOTION_STATE_TASK_DEFINED` on this type.
    #[address(0x2_494)]
    pub m_CurrentMotionState: u32,

    #[address(0x2_62A)]
    pub m_IsLocalCharacter: bool,

    /// The world-space point the character's weapons aim at, written each frame by
    /// [`UpdateWeaponAiming`](Self::UpdateWeaponAiming) (for the player, from the aim control's
    /// weapon aim point). The weapons read it as their fire target.
    #[address(0x2_6BC)]
    pub m_AimTargetPositionWeapons: Vector3,
    /// The world-space point thrown grenades aim at, written by
    /// [`UpdateGrenadeAiming`](Self::UpdateGrenadeAiming).
    pub m_AimTargetPositionGrenade: Vector3,
    /// The per-frame weapon input values (fire, precision aim, plant, and the rest), indexed by
    /// [`WeaponInput`], cleared by [`UpdateWeapons_Parallel`](Self::UpdateWeapons_Parallel) after
    /// the inventory consumes them.
    pub m_WeaponInputs: [f32; 16],
    /// Set by [`UpdateWeaponAiming`](Self::UpdateWeaponAiming) and cleared by
    /// [`UpdateWeapons_Parallel`](Self::UpdateWeapons_Parallel): whether the weapon aim target was
    /// supplied this frame.
    pub m_AimTargetPositionWeaponWasSetThisFrame: bool,

    /// The character's animation control parameters, which own the character state-bitflag words
    /// ([`ControlParameters::m_UserVM`]). Almost every one-bit "what is the character doing"
    /// predicate on this type reads through this pointer.
    #[address(0x2_718)]
    pub m_ControlParameters: *mut ControlParameters,

    /// Per-character LOD/update-gating flags; see [`CharacterLodFlags`].
    #[address(0x2_78C)]
    pub m_LodFlags: CharacterLodFlags,

    /// The inventory slot of the weapon the character has selected.
    #[address(0x2_7A8)]
    pub m_SelectedWeaponSlot: WeaponSlot,

    #[address(0x2_7F0)]
    pub m_WorldMatrixT0: Matrix4,
    pub m_WorldMatrixT1: Matrix4,

    /// The orientation the character is turning toward (`CQuaternion`, `x, y, z, w`).
    /// [`SetOrientation`](Self::SetOrientation) writes the rotation into
    /// [`m_WorldMatrixT1`](Self::m_WorldMatrixT1) and stores the same quaternion here.
    #[address(0x2_934)]
    pub m_RotationGoal: [f32; 4],

    /// The character's measured world velocity, metres per second.
    /// [`PlantedExplosiveWeapon::Fire_Projectile`](equipment::weapon::PlantedExplosiveWeapon::Fire_Projectile)
    /// drops a charge with it under a parachute.
    #[address(0x2_968)]
    pub m_MeasuredWorldVelocity: Vector3,

    /// The character's avatar (`CAvatar`), the controller that drives it. For the player it is the
    /// [`Avatar`] base of the `CPlayer`. Holds the mental state written by
    /// [`SetMentalState`](Self::SetMentalState).
    #[address(0x2_9B0)]
    pub m_Avatar: *mut Avatar,

    /// Whether a scripted sequence (`CSequenceObject2`) drives the character. Set by
    /// [`SetupForSequence`](Self::SetupForSequence) when a sequence takes the character over and
    /// cleared by [`ResetAfterSequence3`](Self::ResetAfterSequence3) when it hands it back; while
    /// it is set, the sequence's transform tracks place the character and its animation layers run
    /// the sequence's own state machines.
    #[address(0x2_9C8)]
    pub m_InSequence: bool,

    /// Whether this character is a player character (local or remote). Gates the player-only
    /// side effects of setters such as [`SetUnlimitedAmmo`](Self::SetUnlimitedAmmo).
    #[address(0x2_9D0)]
    pub m_IsPlayer: bool,

    /// The weapon-aim countdown timer, in seconds. It is refreshed while an aim input is held and
    /// decremented by the frame delta otherwise; a positive value keeps
    /// [`m_AimingWeapon`](AimState::m_AimingWeapon) set in [`m_AimFlags`](Self::m_AimFlags),
    /// so the character stays in aim/strafe locomotion for a short tail after the aim button is
    /// released.
    #[address(0x2_A00)]
    pub m_AimTimer: f32,

    /// The traversal-ability enable bits; see [`AbilityFlags`].
    #[address(0x2_B08)]
    pub m_AbilityFlags: AbilityFlags,

    /// The idle-variation countdown, in seconds, driven by
    /// [`NStateTask_InputLocoIdleTask::Update`](input::locomotion::NStateTask_InputLocoIdleTask::Update):
    /// while the character stands idle it is decremented by the frame delta, and once it goes
    /// negative the task queues
    /// [`ACT_TO_IDLE_ONE_OFF`](animation::symbol_table::EventIdSymbolTable::ACT_TO_IDLE_ONE_OFF) to
    /// play a one-off idle break, then resets it to a random ~8.5-12 s the next time the character's
    /// aim reference moves.
    #[address(0x2_BB0)]
    pub m_IdleFidgetTimer: f32,

    /// The swim locomotion family's per-character state; see [`SwimActionParams`].
    #[address(0x3_004)]
    pub m_SwimActionParams: SwimActionParams,
}
impl Character {
    #[address(0x140_7D5_B00)]
    pub fn GetLocalPlayerCharacter() -> *mut Character;

    /// `CCharacter::TYPE_ID`: the run-time type id of `CCharacter`, for
    /// [`GameObject::IsType`](game::GameObject::IsType). Registers it on first use.
    #[address(0x140_60F_370)]
    pub fn TYPE_ID() -> *const u32;

    /// The character's faction: its avatar's when it has one ([`m_Avatar`](Self::m_Avatar)),
    /// otherwise the character's own.
    #[address(0x140_75F_BF0)]
    pub fn GetFaction(&self) -> i32;

    /// What the character is doing, as a damage message's
    /// [`m_DamagerSourceStateInfo`](damage::DamageMsg::m_DamagerSourceStateInfo) records it: in a
    /// stunt, under the parachute, flying, aiming down the sights, near death, in a vehicle of each
    /// class, reeled in, swimming, or hanging from the grapple.
    #[address(0x140_7F5_7D0)]
    pub fn GetCurrentDamageSourceStateInfo(&self) -> i32;

    /// Handles a message from the character's animation tracks (`data`, an
    /// `NAnimationSystem::SAnimationMessageData`), dispatching on its id. The melee hit message
    /// deals the player's melee: with a character as the link target, it sends that character a
    /// [`DMG_TYPE_MELEE`](damage::DamageFlags::DMG_TYPE_MELEE) [`DamageMsg`](damage::DamageMsg) of
    /// [`Player::m_MeleeDamage`](character::player::Player::m_MeleeDamage) and no impulse, and
    /// clears the link target; with none, it finds the objects in a box in front of the chest
    /// ([`PhysicsSystem::CollideBox`](physics::PhysicsSystem::CollideBox)), damages each (a
    /// vehicle once), and pushes each body forward by
    /// [`Player::m_MeleeImpulse`](character::player::Player::m_MeleeImpulse)
    /// ([`hknpWorld::applyBodyImpulseAt`](physics::hknpWorld::applyBodyImpulseAt)). Both paths
    /// spawn a rumble and the hit effect.
    #[address(0x140_7FA_DD0)]
    pub fn HandleTrackMessage(&mut self, data: *mut void);

    /// Whether the character is attached to a vehicle (riding, or in the mount/dismount
    /// transitions), read from the animation rule system's current state. The state machine
    /// pointers it walks are game-thread data, so the call is only safe on the game update thread.
    #[address(0x140_77F_080)]
    pub fn IsInVehicleAttachState(&self) -> bool;

    #[address(0x140_7AF_550)]
    pub fn GetHeadPosition(&self, position: *mut Vector3) -> *mut Vector3;

    /// Sets [`m_UnlimitedAmmo`](Self::m_UnlimitedAmmo). For the locally controlled player, a
    /// change also re-selects the current weapon on the HUD so its ammo readout updates.
    #[address(0x140_7B1_4B0)]
    pub fn SetUnlimitedAmmo(&mut self, unlimited: bool);

    /// Sets the [`GOD_MODE`](DamageStateFlags::GOD_MODE) damage flag and the damageable's
    /// invulnerability. Enabling it on a living character also restores full health, forces the
    /// neutral animation state, and notifies the network component.
    #[address(0x140_7FD_7C0)]
    pub fn SetGodMode(&mut self, enabled: bool);

    /// Returns a reference to the character's grappling-hook slot
    /// ([`Inventory::m_GrapplingHook`](character::inventory::Inventory::m_GrapplingHook)).
    #[address(0x140_760_830)]
    pub fn GetGrapplingHook(&self) -> *const SharedPtr<GrapplingHook>;

    #[address(0x140_79A_B30)]
    pub fn GetSafeIndex(&self, safe_index: SafeBoneIndex) -> u32;

    #[address(0x140_79A_C30)]
    pub fn GetSafeBoneMatrix(&self, safe_index: SafeBoneIndex, matrix: *mut Matrix4);

    /// Writes the world matrix of the safe bone `safe_index` through `matrix`: the bone's
    /// model-space matrix from the animation controller's current pose
    /// ([`AnimationController::GetBoneMatrix`]) composed with the character's
    /// [`m_WorldMatrixT1`](Self::m_WorldMatrixT1). A gun's attachment placement
    /// ([`WeaponData::UpdateAttachmentTransforms`](equipment::weapon::WeaponData::UpdateAttachmentTransforms))
    /// takes a hand-held gun's world matrix from it.
    #[address(0x140_79A_EB0)]
    pub fn GetWorldMatrixForBone(&self, safe_index: SafeBoneIndex, matrix: *mut Matrix4);

    /// The character's SIM-phase pose-finalization pass. After the animation graph has finalized the
    /// local pose, this first runs the current states' tasks registered in the
    /// [`FINALIZE_POSE_STATE_TASK_RANGE`](Self::FINALIZE_POSE_STATE_TASK_RANGE) through
    /// [`UpdateStateTasksInRange`](Self::UpdateStateTasksInRange) (the aim, look-at, grapple-fire
    /// arm, and weapon off-hand IK tasks among them), then drives the [`HumanIK`](Self::m_HIK) solve
    /// (the `MAIN` body pass, gated on [`HumanIK::HasTargets`] and run through
    /// [`UpdateIKForTargets`](Self::UpdateIKForTargets), followed by
    /// [`UpdateSecondaryHandIKPass`](Self::UpdateSecondaryHandIKPass)), then computes the
    /// model-space pose (`CalculateModelSpacePose`), and finally calls
    /// [`UpdatePropEffects`](Self::UpdatePropEffects). Effector targets queued before this runs
    /// are solved into the pose the same frame; blackboard keys those tasks write are written after
    /// its entry.
    #[address(0x140_7F9_B10)]
    pub fn UpdatePassFinalizePose_Parallel(&mut self, context: *mut void);

    /// The `MAIN`-pass HumanIK solve, run from
    /// [`UpdatePassFinalizePose_Parallel`](Self::UpdatePassFinalizePose_Parallel) once
    /// [`HumanIK::HasTargets`] reports a queued target. Copies the current pose into the solver
    /// ([`HumanIK::CharacterToIKState`]), pushes the queued targets and control values
    /// ([`HumanIK::UpdateEffectorsFromTargets`]), runs the solve ([`HumanIK::Solve`]), and writes the
    /// solved state back into the pose ([`HumanIK::IKToCharacterState`]). The IDB mislabels this
    /// function `CAnimationRuleSystem::GetState`; its body and call site (the sole caller is
    /// `UpdatePassFinalizePose_Parallel`) identify it as the character's own IK-for-targets solve.
    #[address(0x140_77E_040)]
    pub fn UpdateIKForTargets(&mut self, dt: f32);

    /// The `SECONDARY`-pass HumanIK solve, run from
    /// [`UpdateSecondaryHandIKPass`](Self::UpdateSecondaryHandIKPass) once that pass has queued a
    /// target. Runs the same four-step sequence as [`UpdateIKForTargets`](Self::UpdateIKForTargets),
    /// except that it skips [`HumanIK::CharacterToIKState`] when `ik_has_run` is already set:
    /// `UpdateSecondaryHandIKPass` passes through the same flag the `MAIN` pass's gate set this
    /// frame, so the pose copied into the solver by that earlier solve is reused instead of being
    /// refetched.
    #[address(0x140_77E_0C0)]
    pub fn UpdateSecondaryHandIKForTargets(&mut self, dt: f32, ik_has_run: *mut bool);

    /// Runs the update of every task of each rule system's current state that is registered in the
    /// state-task range `range_id` (`CAnimatedModel::StateTaskUpdate`), with `dt` as the step. Each
    /// update pass of the character runs its own range.
    #[address(0x140_75E_710)]
    pub fn UpdateStateTasksInRange(&mut self, dt: f32, range_id: u32);

    /// Places the character's weapons and props on its current pose: calls
    /// [`Inventory::UpdateAttachmentTransforms`](character::inventory::Inventory::UpdateAttachmentTransforms)
    /// with the character's snow and water factors and `transform_type`, unless a character flag
    /// beside [`m_LodFlags`](Self::m_LodFlags) (unmapped) switches the placement off.
    /// [`UpdatePassFinalizePose_Parallel`](Self::UpdatePassFinalizePose_Parallel) makes the same
    /// call inline twice: with the advancing placement (`transform_type` 2) after the finalize
    /// state tasks, and with `transform_type` 1 after the `MAIN` HumanIK solve, which runs only
    /// when [`HumanIK::HasTargets`] reports a queued target.
    #[address(0x140_75E_AA0)]
    pub fn UpdatePropTransforms(&mut self, transform_type: u32);

    /// Whether the on-foot input should stop the character short of a drop ahead
    /// (`CCharacter::ShouldPreventFall`): false when `predicted_fall_height` is below the
    /// movement settings' [`m_PredictedFallHeightTolerance`](input::locomotion::CharacterOnFootSettings::m_PredictedFallHeightTolerance),
    /// and otherwise true unless the player holds a player action (unmapped), read as an analog
    /// value or a digital state by a game setting.
