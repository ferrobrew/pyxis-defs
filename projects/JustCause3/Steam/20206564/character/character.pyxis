    /// [`E_WS_MOUNTED`](equipment::weapon::WeaponState::E_WS_MOUNTED), and otherwise a shared
    /// empty pointer. While the character plants an explosive it is the planted explosive slot's
    /// weapon, or the empty pointer with `ignore_planting`. The result points into the inventory or
    /// at a static, so it outlives the call.
    /// [`Inventory::UpdateWeaponHandling`](character::inventory::Inventory::UpdateWeaponHandling)
    /// reads it to decide whether a weapon input draws a weapon.
    #[address(0x140_7D8_520)]
    pub fn GetWieldingWeapon(&self, ignore_planting: bool) -> *const SharedPtr<WeaponBase>;

    /// Whether any weapon input is active this frame.
    #[address(0x140_7F2_D10)]
    pub fn HasAnyWeaponInput(&self) -> bool;

    /// Sets the character's mental state on its [`m_Avatar`](Self::m_Avatar) with a hold `timer`.
    /// Unless `force` is set, the write happens only once the avatar's current timer has run out.
    #[address(0x140_760_BE0)]
    pub fn SetMentalState(&mut self, state: MentalState, force: bool, timer: f32);

    /// Draws the selected weapon when the inventory's animation state allows it: selects a valid
    /// weapon, queues the draw act, and blocks drawing and grenades until the animation re-enables
    /// them.
    #[address(0x140_760_8A0)]
    pub fn DrawWeapon(&mut self, p1: bool, p2: bool);

    /// Holsters the selected weapon (the planted explosive while planting). For a character with
    /// [`m_IsPlayer`](Self::m_IsPlayer) set it queues nothing itself: it forces the avatar's
    /// [`m_MentalState`](character::avatar::Avatar::m_MentalState) to
    /// [`E_RELAXED`](character::avatar::MentalState::E_RELAXED) with a zero hold timer, and
    /// [`Inventory::UpdateWeaponHandling`](character::inventory::Inventory::UpdateWeaponHandling)'s
    /// relaxed branch then queues `UB_ACT_HOLSTER`. Other characters queue `UB_ACT_HOLSTER` on the
    /// animated model directly when the inventory's animation state allows holstering.
    #[address(0x140_7F2_D80)]
    pub fn HolsterWeapon(&mut self);

    /// Starts a reload of the wielded weapon: queues the upper-body reload act (`UB_ACT_RELOAD`)
    /// and blocks grenades, when the inventory allows reloading
    /// ([`Inventory::GetAnimationAllowsReloading`](character::inventory::Inventory::GetAnimationAllowsReloading)),
    /// the detonate input
    /// ([`E_INPUT_DETONATE_EXPLOSIVES`](WeaponInput::E_INPUT_DETONATE_EXPLOSIVES)) is zero, a
    /// weapon is wielded ([`GetWieldingWeapon`](Self::GetWieldingWeapon)), and that weapon
    /// [`CanReload`](equipment::weapon::WeaponBase::CanReload). Otherwise it does nothing. The
    /// act's callback runs the weapon's
    /// [`StartReloadSequence`](equipment::weapon::WeaponBase::StartReloadSequence) once the act
    /// is accepted; the ammunition itself moves later, when the reload clip's track message calls
    /// [`Reload`](equipment::weapon::WeaponBase::Reload). The reload state raises
    /// [`SB_IS_RELOADING`](state::StateBitFlag::SB_IS_RELOADING).
    ///
    /// Every animated reload starts here. Its callers are:
    ///
    /// - [`Inventory::UpdateWeaponHandling`](character::inventory::Inventory::UpdateWeaponHandling),
    ///   on a positive reload input ([`E_INPUT_RELOAD`](WeaponInput::E_INPUT_RELOAD)) while the
    ///   inventory allows reloading;
    /// - [`WeaponBase::CheckIfReloadShouldBeTriggeredBase`](equipment::weapon::WeaponBase::CheckIfReloadShouldBeTriggeredBase),
    ///   for the automatic reload of a player's empty magazine, on every tick while the magazine
    ///   is out ([`m_WeaponIsWithoutMagazine`](equipment::weapon::WeaponBase::m_WeaponIsWithoutMagazine)),
    ///   and for the predicted reload of the local player's idle weapon;
    /// - [`Inventory::SetAmmoCount`](character::inventory::Inventory::SetAmmoCount),
    ///   [`Inventory::GiveMaxAmmo`](character::inventory::Inventory::GiveMaxAmmo),
    ///   `CInventory::GiveMaxAmmoToAllWeaponInInventory`, `CInventory::SetMaxBeaconsByLevel`, and
    ///   `CInventory::SetMaxFlaresByLevel`, when a reserve is refilled from empty while the
    ///   wielded weapon of that kind has an empty magazine;
    /// - [`WeaponBase::HandleTrackMessage`](equipment::weapon::WeaponBase::HandleTrackMessage),
    ///   for the [`TRACK_MESSAGE_START_RELOAD`](equipment::weapon::WeaponBase::TRACK_MESSAGE_START_RELOAD)
    ///   and [`TRACK_MESSAGE_START_RELOAD_IF_EMPTY`](equipment::weapon::WeaponBase::TRACK_MESSAGE_START_RELOAD_IF_EMPTY)
    ///   messages;
    /// - the rocket launcher's [`Fire_Start`](equipment::weapon::RPGWeapon::Fire_Start), firing an
    ///   unloaded launcher, and its
    ///   [`CheckIfReloadShouldBeTriggered`](equipment::weapon::RPGWeapon::CheckIfReloadShouldBeTriggered),
    ///   for a holder that is not a player;
    /// - the sniper rifle's per-tick update, after a shot that emptied the magazine with a
    ///   reserve left.
    #[address(0x140_7D8_F50)]
    pub fn StartReloadingWieldingWeapon(&mut self);

    /// Cancels a running reload: while
    /// [`SB_IS_RELOADING`](state::StateBitFlag::SB_IS_RELOADING) is set, queues the cancel act
    /// (`UB_ACT_CANCEL_RELOAD`) and clears the inventory's reload permission
    /// ([`Inventory::m_DoesAnimationAllowReloading`](character::inventory::Inventory::m_DoesAnimationAllowReloading)).
    /// The ammunition check calls it for a weapon that does not reload by magazine once
    /// [`m_KeepReloading`](equipment::weapon::WeaponBase::m_KeepReloading) is clear, and the
    /// planted explosive's detonation calls it when the detonate act cannot be taken.
    #[address(0x140_760_850)]
    pub fn CancelReload(&mut self);

    /// Whether the character is reloading: the
    /// [`SB_IS_RELOADING`](state::StateBitFlag::SB_IS_RELOADING) state bit, which the reload
    /// state of the animation graph raises.
    #[address(0x140_75F_3A0)]
    pub fn IsReloading(&self) -> bool;

    /// Whether the character may start a melee attack: the melee block bit that dropping a heavy
    /// weapon sets is clear, the inventory's animation permission allows melee, the character is not
    /// squeezing valid dual tethers while the gamepad is the active input device, and it is on the
    /// ground or in a stunt position. `NStateTask_InputMeleeTask` tests it before the melee input
    /// and the hammer ability ([`hash_ability_hammer`](character::player::hash_ability_hammer)).
    #[address(0x140_7FA_D40)]
    pub fn CanUseMelee(&self) -> bool;

    /// Forces the character's animation and control state back to neutral (on foot, idle).
    #[address(0x140_7FD_120)]
    pub fn ForceNeutralState(&mut self);

    /// Hands the character to a scripted sequence: forces the neutral state
    /// ([`ForceNeutralState`](Self::ForceNeutralState)), pauses a behaviour-tree avatar, sets
    /// [`m_InSequence`](Self::m_InSequence), and makes a player invulnerable for the sequence unless
    /// the god mode already holds. Called from `CSequenceObject2::UpdateSequencePreSim` for each
    /// character the sequence drives.
    #[address(0x140_7FD_730)]
    pub fn SetupForSequence(&mut self);

    /// Hands the character back from a scripted sequence: lifts the sequence's invulnerability,
    /// restores each default animation layer's state machine and animation set, unpauses a
    /// behaviour-tree avatar, and clears [`m_InSequence`](Self::m_InSequence). Called by
    /// `CSequenceObject2::ResetGameObject`, by [`ForceNeutralState`](Self::ForceNeutralState), and
    /// on entering the cinematic mode.
    #[address(0x140_7D6_590)]
    pub fn ResetAfterSequence3(&mut self);

    /// Reacts to a hit's impulse along `direction`, scaled per damage type and capped. Accumulates
    /// the impulse, and from the character's thresholds picks the reaction: a ragdoll, a knock-back
    /// ([`ACT_HITREACT_FLY`](animation::symbol_table::EventIdSymbolTable::ACT_HITREACT_FLY), from
    /// an explosion), a stumble
    /// ([`ACT_HITREACT_STUMBLE`](animation::symbol_table::EventIdSymbolTable::ACT_HITREACT_STUMBLE)
    /// and its bullet and melee variants), or a flinch, queued on
    /// [`m_AnimatedModel`](Self::m_AnimatedModel) with [`AnimatedModel::QueueAct`]. A player and
    /// other characters take different branches. `zone` is the hit body-part group's `idstring`,
    /// passed by address and released by the callee, so the caller passes a copy that holds its own
    /// use of the group symbol table
    /// ([`RagdollRBGroupId::init_ptr`](animation::symbol_table::RagdollRBGroupId::init_ptr)). The
    /// impulse is scaled by the type's entry of
    /// [`m_HitReaction_DamageImpulseScale`](Self::m_HitReaction_DamageImpulseScale) and compared
    /// against [`m_HitReaction_ImpulseRagdollThreshold`](Self::m_HitReaction_ImpulseRagdollThreshold)
    /// and [`m_HitReaction_ImpulseStumbleThreshold`](Self::m_HitReaction_ImpulseStumbleThreshold);
    /// a ragdoll takes the impulse, along `direction` and capped by
    /// [`m_HitReaction_DamageImpulseMax`](Self::m_HitReaction_DamageImpulseMax). The character's
    /// damage virtual runs it at the end of every damage message; it takes no health itself.
    #[address(0x140_7D7_980)]
    pub fn HitReaction(&mut self, hit_position: *const Vector3, direction: *const Vector3, impulse: f32, killing_blow: bool, zone: *mut u32, damage_flags: u32, damaged_by_vehicle: bool);

    /// Sets the character's orientation from a quaternion (`CQuaternion`, `x, y, z, w`): writes
    /// the rotation into [`m_WorldMatrixT1`](Self::m_WorldMatrixT1), keeping its translation, and
    /// stores the quaternion in [`m_RotationGoal`](Self::m_RotationGoal). A direct world-matrix
    /// write; it does not go through the physics proxy.
    #[address(0x140_75F_D90)]
    pub fn SetOrientation(&mut self, orientation: *const [f32; 4]);

    /// Attaches the character to `target` with a yaw-only alignment: computes the yaw between the
    /// character's and the target's forward directions and calls the
    /// [`AttachTo`](Self::AttachTo) virtual with that rotation as the offset.
    #[address(0x140_79D_540)]
    pub fn SetYAlignedAttachTo(&mut self, target: *mut Matrix4, object: *mut void, attach_type: u32, flags: u32);

    /// Whether the character rides in a vehicle's cargo bay
    /// ([`m_InCargoBay`](AimState::m_InCargoBay)).
    #[address(0x140_75A_EB0)]
    pub fn IsInCargoBay(&self) -> bool;

    /// Sets [`WEAPONS_ENABLED`](DamageStateFlags::WEAPONS_ENABLED).
    #[address(0x140_818_810)]
    pub fn SetWeaponsEnabled(&mut self, enable: bool);

    /// Sets [`m_IsParachuteEnabled`](AbilityFlags::m_IsParachuteEnabled).
    #[address(0x140_818_830)]
    pub fn SetParachuteEnabled(&mut self, enabled: bool);

    /// Sets [`m_IsWingsuitEnabled`](AbilityFlags::m_IsWingsuitEnabled).
    #[address(0x140_8B8_440)]
    pub fn SetWingsuitEnabled(&mut self, enabled: bool);

    /// Sets [`m_IsStuntAutoExitEnabled`](AbilityFlags::m_IsStuntAutoExitEnabled).
    #[address(0x140_9AA_6E0)]
    pub fn SetStuntAutoExitEnabled(&mut self, enabled: bool);
}

/// `CCharacter::GetRenderTransform`, a `CGameObject` virtual reached through the
/// [`GAME_OBJECT_BASE_OFFSET`](Character::GAME_OBJECT_BASE_OFFSET) subobject (`game_object` is the
/// character plus that offset): writes the render transform, the lerp of
/// [`m_WorldMatrixT0`](Character::m_WorldMatrixT0) to [`m_WorldMatrixT1`](Character::m_WorldMatrixT1)
/// by `dtf`, into `out`, and returns true.
#[address(0x140_75D_E50)]
pub fn Character_GetRenderTransform(game_object: *mut u8, out: *mut Matrix4, dtf: f32) -> bool;

/// An index into [`Character::m_WeaponInputs`] (`CCharacter::EWeaponInput`). The player's weapon
/// input state task writes the fire, grenade, detonate, plant, reload, precision-aim, and use-item
/// entries from the action map each frame, and the global input update the weapon-select entries.
#[copyable]
pub enum WeaponInput: i32 {
    E_INPUT_MAIN_WEAPON = 0x0,
    E_INPUT_GRENADE = 0x1,
    /// Detonate the placed charges. Under the gamepad rules
    /// ([`EPCUseGamepad`](settings_manager::SettingType::EPCUseGamepad)) the weapon input task sets
    /// it while `DETONATE_EXPLOSIVE` has been held past the hold threshold; otherwise a press of
    /// `DETONATE_EXPLOSIVE_TAP` sets it too.
    E_INPUT_DETONATE_EXPLOSIVES = 0x2,
    E_INPUT_PLANT_EXPLOSIVES = 0x3,
    E_INPUT_RELOAD = 0x4,
    E_INPUT_PRECISION_AIM = 0x5,
    /// Use an item: the weapon input task sets it on a click of the `USE_ITEM` action.
    /// [`Inventory::UpdateWeaponHandling`](character::inventory::Inventory::UpdateWeaponHandling)
    /// picks up a weapon in the world on it.
    E_INPUT_USE_ITEM = 0x6,
    E_INPUT_PICKUP_ITEM = 0x7,
    E_INPUT_SELECT_DUEL_WIELD = 0x8,
    E_INPUT_SELECT_TWO_HANDED = 0x9,
    E_INPUT_SELECT_TWO_HANDED_SPECIAL = 0xA,
    E_INPUT_SELECT_PLANT_EXPLOSIVES = 0xB,
    E_INPUT_SELECT_PREVIOUS_WEAPON = 0xC,
    E_INPUT_SELECT_NEXT_WEAPON = 0xD,
    E_INPUT_BAVARIUM_WINGSUIT_MAIN = 0xE,
    E_INPUT_BAVARIUM_WINGSUIT_SECONDARY = 0xF,
    /// The number of weapon inputs, and so the length of [`Character::m_WeaponInputs`].
    E_INPUT_COUNT = 0x10,
}

/// A character's animation layers (`CCharacter::s_LayerNames`). `CCharacter::InitAnimationModel`
/// creates layer *i* from the *i*-th state-machine file of the character's construction info, named
/// by this enum, and stops at the first missing file; the layer's rule system, body part, and
/// blender all sit at index *i*. The engine's level of detail (`CCharacter::UpdateLOD`) switches
/// the partial and additive layers' body parts off by these indices for distant characters.
#[copyable]
pub enum AnimationLayer: u32 {
    /// The full-body base graph (the locomotion, the stunts, and the weapon-modifier clip variants
    /// of both).
    MAINBODY = 0,
    /// The upper-body partial graph synchronised to the base graph's locomotion.
    SYNCED_PARTIAL = 1,
    /// The upper-body partial graph for one-off actions: draw, holster, switch, reload, pump, bolt,
    /// pickup, and throws.
    GLOBAL_PARTIAL = 2,
    /// The additive graph synchronised to the base graph.
    SYNCED_ADDITIVE = 3,
    GLOBAL_ADDITIVE = 4,
    VOCALS = 5,
}

#[size(0x240)]
pub type AnimatedModel {
    /// The number of [`m_ModelInstances`](Self::m_ModelInstances) slots. Keep in sync
    /// with that array's length.
    pub const MODEL_INSTANCE_SLOTS: u64 = 8,
    /// The [`m_ModelInstances`](Self::m_ModelInstances) slot holding the character's
    /// *body* model -- the one whose skeleton the character's bone indices belong to. The other
    /// slots are attachments with their own skeletons (the parachute among them), where the same
    /// numeric indices land on arbitrary bones.
    pub const BODY_MODEL_SLOT: u64 = 0,
    /// The offset of a model instance's embedded render-block-instance info (`CRBIInfo`) within
    /// `NModelSystem::CModelInstance` (`CModelInstance::AddToPass` passes this offset to
    /// `ForEachRb`); that pointer is the `info` every one of its block draws receives. A constant
    /// rather than a field because the instance type itself is unmapped.
    pub const MODEL_INSTANCE_RBI_INFO_OFFSET: u64 = 0x50,

    #[address(0x98)]
    pub m_RuleSystems: Vector<SharedPtr<AnimationRuleSystem>>,

    #[address(0x178)]
    pub m_AnimationController: *mut AnimationController,

    /// The model's animation instance data (`SAnimatedModelInstanceData*`), null until the animation
    /// instance is created (the first frames after spawn or stream-in). Some character-state
    /// predicates, [`Character::IsUsingWingsuit`] among them, report false while it is null.
    #[address(0x1D8)]
    pub m_InstanceData: *mut u8,

    /// The model-instance slots (`NModelSystem::CModelInstance*`, null when unused): the base
    /// body model plus attachments and variants. `CAnimatedModel::GetModel`/`SetModel` index this
    /// array directly. Each instance embeds its render-block-instance info (`CRBIInfo`) at
    /// [`MODEL_INSTANCE_RBI_INFO_OFFSET`](Self::MODEL_INSTANCE_RBI_INFO_OFFSET), which is the
    /// `info` pointer its render blocks are drawn with.
    #[address(0x200)]
    pub m_ModelInstances: [u64; 8],
}
impl AnimatedModel {
    /// Tests whether the animation state machine would accept the act from its current state,
    /// without queuing it. A `CCharacter` virtual forwards to this on
    /// [`Character::m_AnimatedModel`]; the game's act dispatchers call it before
    /// [`Character::QueueAct`] to pick a supported act.
    #[address(0x140_4B2_E00)]
    pub fn TryAct(&mut self, act: *const u32) -> bool;

    /// Queues an act (`act` points at the runtime `idstring` value) on the model's state machines,
    /// appending it to the model's act queue, which holds at most 32 acts; an act queued with the
    /// queue full is dropped. [`Character::QueueAct`] forwards here for
    /// [`Character::m_AnimatedModel`], and engine code that holds the model, such as
    /// [`Character::HitReaction`], calls it directly.
    #[address(0x140_4C8_DA0)]
    pub fn QueueAct(&mut self, act: *const u32);
}

/// A character's animation controller (`NCharacterSystem::CAnimationControl`): the skeleton, the
/// pose producer, and one body part per animation layer.
pub type AnimationController {
    /// The skeleton resource, through which [`GetBoneIndex`](Self::GetBoneIndex) resolves a bone by
    /// the hash of its name.
    #[address(0xA0)]
    pub m_Skeleton: *mut Skeleton,

    /// The pose producer, whose [`m_PoseT1`](animation::pose_producer::PoseProducer::m_PoseT1) the
    /// joint accessors ([`GetJoint`](Self::GetJoint) and [`SetJoint`](Self::SetJoint)) read and
    /// write.
    #[address(0xB8)]
    pub m_PoseProducer: *mut PoseProducer,

    /// The animation layers' body parts, in layer order: index *i* belongs to the layer named by
    /// [`AnimationLayer`] *i*, alongside the rule system at the same index of
    /// [`AnimatedModel::m_RuleSystems`].
    #[address(0xC8)]
    pub m_BodyParts: Vector<SharedPtr<AnimatedBodyPart>>,
}
impl AnimationController {
    #[address(0x140_434_E30)]
    pub fn GetBoneIndex(&self, hash: u32) -> u32;

    /// The current animation's unfiltered root velocity, in the character's local frame. The
    /// movement actuators take its horizontal magnitude as the character's speed for the frame, so
    /// the shipped clips are what set how fast a given locomotion state travels -- both swim
    /// movement cores scale their wanted velocity by it.
    #[address(0x140_434_F20)]
    pub fn GetRawRootVelocity(&self) -> *const Vector3;

    #[address(0x140_43F_E70)]
    pub fn GetBoneMatrix(&self, index: u32, matrix: *mut Matrix4);

    #[address(0x140_43F_F90)]
    pub fn GetJoint(&self, index: u32, joint: *mut Joint);

    #[address(0x140_43F_FF0)]
    pub fn SetJoint(&mut self, index: u32, joint: *mut Joint);

    /// Writes the model-space matrix of bone `index` in the skeleton's bind pose through `matrix`
    /// (`CAnimationControl::GetBindPoseBoneMatrix`, through `CSkeleton::GetJoint`). The bind pose
    /// belongs to the skeleton resource and does not change with the animation, so two bones' bind
    /// matrices give their rest-pose relation.
    #[address(0x140_440_000)]
    pub fn GetBindPoseBoneMatrix(&self, index: u32, matrix: *mut Matrix4);

    /// Advances the playback clocks of the controller's time-updatable blenders by `dt` (via
    /// `CPoseProducer::UpdateBlendersTimeInRange`) without recomputing the pose. Runs each SIM frame
    /// in the character's animation pass, before [`UpdateAnimations`](Self::UpdateAnimations).
    #[address(0x140_479_4D0)]
    pub fn UpdateAnimationsTime(&mut self, dt: f32);

    /// Recomputes the controller's pose from its pose producers: advances each blender's clock by
    /// `dt` (`CPoseProducer::Update` -> `CBlender::UpdateTime`) and samples and blends the active
    /// clips into the model-space pose over `num_of_bones` bones. Runs each SIM frame in the
    /// character's animation pass. A `dt` of `0` holds the animation clocks, producing a static pose.
    #[address(0x140_77E_200)]
    pub fn UpdateAnimations(&mut self, dt: f32, num_of_bones: i32);

    /// The render-phase skinning update (`CAnimationControl::UpdateSkinning`): hands the pose
    /// producer's skinning job to
    /// [`PoseProducer::MakeSkinningPalette`](animation::pose_producer::PoseProducer::MakeSkinningPalette)
    /// with `dtf` and the current frame's palette buffer (the control double-buffers its palettes by
    /// frame parity). `world_matrix` is unused in this build. `CCharacter::UpdateRender` calls it
    /// (the character-level `UpdateSkinning` is inlined there).
    #[address(0x140_43F_CA0)]
    pub fn UpdateSkinning(&mut self, dtf: f32, world_matrix: *mut Matrix4);
}

#[copyable, defaultable, align(16), size(0x30)]
pub type Joint {
    pub m_Translation: AlignedVector3,
    pub m_Orientation: AlignedQuat,
    pub m_Scale: AlignedVector3,
}

