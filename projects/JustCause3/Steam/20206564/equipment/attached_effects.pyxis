use physics::GameMaterialId;
use types::math::Matrix4;
use types::math::Vector3;
use types::shared_ptr::SharedPtr;

/// What an [`EffectTransformInfo`] transform drives (`SEffectTransformInfo::ETransformType`).
#[copyable]
pub enum TransformType: i32 {
    /// A 3D world transform.
    ETransformType_Transform3D = 0x0,
    ETransformType_AudioSpatialization = 0x1,
    ETransformType_ReverbSpatialization = 0x2,
    ETransformType_EchoSpatialization = 0x3,
    ETransformType_Invalid = 0x4,
}

/// How an attached instance's rotation follows its attachment
/// (`CAttachedEffectContainer::ERotationMode`).
#[copyable]
pub enum RotationMode: i32 {
    ERotationMode_ATTACHED = 0x0,
    ERotationMode_FIRST_FRAME = 0x1,
    ERotationMode_ATTACHED_RANDOM_ROLL = 0x2,
    ERotationMode_FIRST_FRAME_RANDOM_ROLL = 0x3,
    ERotationMode_WORLD_UP_RANDOM = 0x4,
    ERotationMode_RANDOM = 0x5,
    ERotationMode_WORLD_UP = 0x6,
    ERotationMode_COUNT = 0x7,
}

/// How an attached instance's translation follows its attachment
/// (`CAttachedEffectContainer::ETranslationMode`).
#[copyable]
pub enum TranslationMode: i32 {
    ETranslationMode_ATTACHED = 0x0,
    ETranslationMode_FIRST_FRAME = 0x1,
    ETranslationMode_COUNT = 0x2,
}

/// The world placement handed to a playing attached effect (`SEffectTransformInfo`): a transform,
/// the velocity of the attachment, and what the transform is used for. Resolved per instance each
/// update by the instance's transform function and copied whole into
/// [`AttachedInstance::m_TransformInfo`].
#[size(0x60), align(16)]
pub type EffectTransformInfo {
    /// The world transform (in a union with a custom speaker mix for audio spatialization).
    pub m_Transform: Matrix4,

    /// The attachment's velocity.
    #[address(0x40)]
    pub m_Velocity: Vector3,

    /// What the transform drives.
    #[address(0x50)]
    pub m_Type: TransformType,
}

/// One playing attached effect or sound (`NAttachedEffectContainer::SAttachedInstance`): an offset
/// and a transform function that resolves where it is attached (typically a bone or socket on the
/// owner's model, such as a weapon muzzle), the effect and sound instances, and the resolved
/// placement. The container links its playing instances through
/// [`m_NextPlaying`](Self::m_NextPlaying).
#[min_size(0x170), align(16)]
pub type AttachedInstance {
    /// The instance's offset from its attachment point.
    pub m_Offset: Matrix4,

    /// Resolves the attachment's world placement: called with the result buffer, the owning
    /// container, this instance, and [`m_TransformExtraData`](Self::m_TransformExtraData).
    #[address(0x40)]
    pub m_TransformFunc: *mut void,

    /// How the instance's rotation follows the attachment.
    #[address(0x4C)]
    pub m_RotationMode: RotationMode,

    /// How the instance's translation follows the attachment.
    #[address(0x50)]
    pub m_TranslationMode: TranslationMode,

    /// The next playing instance in the owning container's list, or null.
    #[address(0x98)]
    pub m_NextPlaying: *mut AttachedInstance,

    /// The resolved placement, refreshed by [`UpdateTransform`](Self::UpdateTransform).
    #[address(0xF0)]
    pub m_TransformInfo: EffectTransformInfo,

    /// The per-update velocity of the placement's translation: the position delta multiplied by
    /// 1/30, or zero for a transform that is not
    /// [`ETransformType_Transform3D`](TransformType::ETransformType_Transform3D).
    #[address(0x150)]
    pub m_MeasuredVelocity: Vector3,

    /// The opaque argument passed to [`m_TransformFunc`](Self::m_TransformFunc).
    #[address(0x160)]
    pub m_TransformExtraData: u64,
}
impl AttachedInstance {
    /// Re-resolves the instance's placement for `container`. When the rotation mode is
    /// [`ERotationMode_ATTACHED`](RotationMode::ERotationMode_ATTACHED) or
    /// [`ERotationMode_ATTACHED_RANDOM_ROLL`](RotationMode::ERotationMode_ATTACHED_RANDOM_ROLL), or
    /// the translation mode is
    /// [`ETranslationMode_ATTACHED`](TranslationMode::ETranslationMode_ATTACHED), it calls [`m_TransformFunc`](Self::m_TransformFunc) and copies
    /// the [`EffectTransformInfo`] it returns into
    /// [`m_TransformInfo`](Self::m_TransformInfo); it then applies the transform modes and derives
    /// [`m_MeasuredVelocity`](Self::m_MeasuredVelocity) from the translation delta.
    #[address(0x140_453_D00)]
    pub fn UpdateTransform(&mut self, container: *mut AttachedEffectContainer);
}

/// A game object's set of attached effects and sounds (`CAttachedEffectContainer`, a base of weapons,
/// the grappling hook, and other game objects), with the effect parameter sources that feed them.
#[min_size(0x90)]
pub type AttachedEffectContainer {
    /// The usage hash of a character's melee impact effects (`hashlittle("MeleeImpact")`): the
    /// effect and sound a character's melee hit plays where it lands, picked by the struck
    /// surface's material. The melee hit track message in `CCharacter::HandleTrackMessage` looks
    /// it up on the attacking character's own container with
    /// [`GetDynamicAttachedEffects`](Self::GetDynamicAttachedEffects), against
    /// [`EGameMaterialId_Flesh`](GameMaterialId::EGameMaterialId_Flesh) for a character and the
    /// hit shape's material for anything else, and plays the result with
    /// [`EffectAndSoundPair::PlayOneOffs`] at a [`CreateCollisionMatrix`] facing back along the
    /// hit.
    pub const MELEE_IMPACT_USAGE: u32 = 0xD2F7574C,

    /// The head of the parameter-source list.
    #[address(0x28)]
    pub m_ParameterSources: *mut void,

    /// The head of the playing-instance list.
    #[address(0x30)]
    pub m_PlayingInstances: *mut AttachedInstance,

    /// The container's accumulated time, advanced by [`UpdateAttachedEffects`](Self::UpdateAttachedEffects).
    #[address(0x88)]
    pub m_CurrentTime: f32,
}
impl AttachedEffectContainer {
    /// Advances the container by `dt`: for each playing instance, runs
    /// [`AttachedInstance::UpdateTransform`] and the instance update, and frees instances whose
    /// effects and sounds have all finished; then re-evaluates the parameter sources and pushes
    /// changed values to their sound and effect outputs.
    #[address(0x140_466_F30)]
    pub fn UpdateAttachedEffects(&mut self, dt: f32);

    /// The one-off effect and sound the container's dynamic usage `usage_hash` plays against
    /// `target_material` (an `EGameMaterialId`), for the usage's variant whose source material is
    /// `source_material`, falling back to its
    /// [`EGameMaterialId_Default`](GameMaterialId::EGameMaterialId_Default) variant. Writes the
    /// variant's retrigger time to `retrigger_time` when it is not null. A usage the container has
    /// not loaded returns a shared empty pair, both of whose pointers are null.
    #[address(0x140_453_900)]
    pub fn GetDynamicAttachedEffects(&mut self, usage_hash: u32, source_material: GameMaterialId, target_material: u32, retrigger_time: *mut f32) -> *const EffectAndSoundPair;
}

/// A one-off effect and sound (`SEffectAndSoundPair`): a particle effect resource and an FMOD
/// sound resource, either of which may be null. Material effect tables and dynamic attached
/// effect usages resolve to these.
#[size(0x20)]
pub type EffectAndSoundPair {
    /// The particle effect (`boost::shared_ptr<SEffectResourceDataWrapper>`).
    pub m_Effect: SharedPtr<void>,
    /// The sound (`boost::shared_ptr<CSoundResource>`).
    pub m_Sound: SharedPtr<void>,
}
impl EffectAndSoundPair {
    /// Fires the pair once at `transform`, without keeping a handle to either instance: with
    /// [`EffectCull::m_PlayEffect`], plays the effect there (projecting decals onto
    /// `decal_models` along `decal_normal`, both of which may be null) and sets its velocity
    /// parameter from `velocity`; with [`EffectCull::m_PlaySound`], starts the sound as a 3D
    /// event at `transform` moving at `velocity` and releases it to play out. Bullet impacts,
    /// melee hits, ricochets, explosions, and the grapple's impacts play their material effects
    /// through it.
    #[address(0x140_4B0_740)]
    pub fn PlayOneOffs(&self, transform: *const Matrix4, velocity: *const Vector3, cull: *const EffectCull, decal_models: *const void, decal_normal: *const Vector3);
}

/// Which halves of an [`EffectAndSoundPair`] [`PlayOneOffs`](EffectAndSoundPair::PlayOneOffs)
/// plays (`SEffectCull`). `SEffectCull::ALWAYS_PLAY` sets both.
#[copyable, defaultable, size(0x2), align(1)]
pub type EffectCull {
    pub m_PlayEffect: bool,
    pub m_PlaySound: bool,
}

/// A transform for an effect at a collision (`CreateCollisionMatrix`): translated to `position`,
/// its up axis along `normal`, rolled about it by a random angle from the effect system's own
/// random sequence. Writes it to `result` and returns `result`.
#[address(0x140_48B_390)]
pub fn CreateCollisionMatrix(result: *mut Matrix4, position: *const Vector3, normal: *const Vector3) -> *mut Matrix4;
