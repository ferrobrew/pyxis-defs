use aim::aim::AimMode;
use animation::message::AnimationMessageData;
use character::character::{AnimatedModel, Character};
use character::inventory::WeaponSlot;
use game::{GameObject, GameObjectRenderContext};
use graphics_engine::model_instance::ModelInstance;
use physics::{PfxRigidBody, RigidObject};
use types::math::Matrix4;
use types::math::Vector3;
use types::shared_ptr::{SharedPtr, WeakPtrGameObject};
use types::std_vector::Vector;

/// The hand a weapon grip-table entry is for (`EWeaponGripHand`), as
/// [`WeaponBase::GetGripPosition`] takes it.
#[copyable]
pub enum WeaponGripHand: i32 {
    E_WEAPON_GRIP_HAND_LEFT = 0x0,
    E_WEAPON_GRIP_HAND_RIGHT = 0x1,
}

/// The situation a weapon is in (`CWeaponData::EWeaponState`), stored on the weapon as
/// [`WeaponBase::m_State`]. It selects the weapon's attach bone
/// ([`WeaponData::m_lBoneAttachementPerWeaponState`] is indexed by it) and, when holstered, the
/// holstered scale applied to the weapon's world matrix.
#[copyable]
pub enum WeaponState: i32 {
    E_WS_DROPPED = 0x0,
    E_WS_WIELDING = 0x1,
    E_WS_DUAL_WIELDING = 0x2,
    /// Holstered on the body. `CWeaponData::GetWorldMatrixT1` and the render update scale the
    /// weapon's matrix by [`WeaponData::m_HolsteredScaleValue`] in this state.
    E_WS_HOLSTERED = 0x3,
    E_WS_HOLSTERED_INVISIBLE = 0x4,
    E_WS_MOUNTED = 0x5,
    E_WS_TURRET = 0x6,
    E_WS_VEHICLE = 0x7,
    E_WS_PICKING_UP = 0x8,
    E_WS_WEAPON_RACK = 0x9,
    E_WS_WINGSUIT_WEAPON = 0xA,
    /// The number of weapon states, and so the length of
    /// [`WeaponData::m_lBoneAttachementPerWeaponState`].
    E_WS_NUM = 0xB,
}

/// A weapon's class (`CWeaponBase::EWeaponClass`), stored on the weapon as [`WeaponBase::m_Class`].
/// Type-specific code compares it, for example the character's level-of-detail update, which keeps
/// full detail for a character wielding a rocket launcher or a sniper rifle.
#[copyable]
pub enum WeaponClass: i32 {
    E_WEAPON_CLASS_NONE = 0x3E8,
    E_WEAPON_CLASS_PISTOL = 0x3E9,
    E_WEAPON_CLASS_SMG = 0x3EA,
    E_WEAPON_CLASS_ASSAULT_RIFLE = 0x3EB,
    E_WEAPON_CLASS_SHOTGUN = 0x3EC,
    /// A scoped rifle ([`SniperWeapon`]).
    E_WEAPON_CLASS_SNIPER = 0x3ED,
    E_WEAPON_CLASS_GRENADE_LAUNCHER = 0x3EE,
    E_WEAPON_CLASS_RPG = 0x3EF,
    E_WEAPON_CLASS_MINIGUN = 0x3F0,
    E_WEAPON_CLASS_AA_GUN = 0x3F1,
    E_WEAPON_CLASS_MORTAR = 0x3F2,
    E_WEAPON_CLASS_50CAL = 0x3F3,
    E_WEAPON_CLASS_SPECIAL = 0x3F4,
    E_WEAPON_CLASS_REVOLVER = 0x3F5,
}

/// How a weapon orients its projectiles (`CWeaponBase::EProjectileFireDirectionMode`), read by
/// [`WeaponBase::GetShotMatrix`] from [`WeaponBase::m_ProjectileTempFireDirection`], falling back to
/// [`WeaponBase::m_ProjectileFireDirection`] while the temporary mode is unset.
#[copyable]
pub enum ProjectileFireDirectionMode: i32 {
    /// No mode set; the reader falls back to the other mode field.
    E_PROJECTILE_FIRE_DIRECTION_UNSET = -1,
    /// Fire from the muzzle toward the weapon's aim target.
    E_PROJECTILE_FIRE_DIRECTION_AIM_POS = 0x0,
    /// Fire along the weapon's own barrel, ignoring the aim target.
    E_PROJECTILE_FIRE_DIRECTION_BARREL = 0x1,
}

/// A kind of ammunition (`CAmmunition::EAmmunitionType`). A weapon's kind is
/// [`WeaponBase::m_AmmunitionType`], set from the weapon's properties, and the holder's reserve of
/// each kind is an entry of
/// [`Inventory::m_Ammunition`](character::inventory::Inventory::m_Ammunition), so every weapon of
/// a kind draws on the same reserve.
#[copyable]
pub enum AmmunitionType: i32 {
    AMMO_PISTOL = 0x0,
    AMMO_SHOTGUN = 0x1,
    AMMO_SMG = 0x2,
    AMMO_ASSAULT_RIFLE = 0x3,
    AMMO_SNIPER = 0x4,
    AMMO_ROCKETS = 0x5,
    AMMO_EXPLOSIVES = 0x6,
    /// Hand grenades. A refill of this kind from empty also reloads the hand grenade weapon
    /// ([`Inventory::SetAmmoCount`](character::inventory::Inventory::SetAmmoCount)).
    AMMO_HAND_GRENADE = 0x7,
    AMMO_GRENADE_LAUNCHER = 0x8,
    AMMO_SUNGUN = 0x9,
    AMMO_MISSILE_STRIKE = 0xA,
    /// Unlimited ammunition: a weapon of this kind never reloads.
    /// [`WeaponBase::Reload`] and [`WeaponBase::CanReload`] refuse it, and the ammunition check
    /// ([`WeaponBase::CheckIfReloadShouldBeTriggeredBase`]) never counts its magazine as empty.
    AMMO_UNLIMITED = 0xB,
    AMMO_BEACON = 0xC,
    AMMO_NO_AMMO = 0xD,
    AMMO_FLARE = 0xE,
    AMMO_EMP = 0xF,
    AMMO_POWERCORE = 0x10,
    /// The number of ammunition kinds, and so the length of the inventory's per-kind arrays.
    NOF_AMMO_TYPES = 0x11,
    AMMO_INVALID = 0x12,
}

/// How a weapon reloads (`CWeaponBase::EReloadType`), stored on the weapon as
/// [`WeaponBase::m_ReloadType`] and set from the weapon's `reload_type` property.
#[copyable]
pub enum ReloadType: i32 {
    /// A whole magazine per reload: the reload act plays the weapon's reload clip, whose reload
    /// track message ([`TRACK_MESSAGE_RELOAD`](WeaponBase::TRACK_MESSAGE_RELOAD)) calls
    /// [`WeaponBase::Reload`] once and refills the magazine as far as the reserve allows. Nearly
    /// every weapon uses it.
    E_RELOAD_MAGAZINE = 0x0,
    /// One round per refill: each [`WeaponBase::Reload`] adds a single round and, while the
    /// magazine is still short of full, sets [`WeaponBase::m_KeepReloading`], which keeps the
    /// reload going for the next round. The ammunition check cancels the reload act
    /// ([`Character::CancelReload`](character::character::Character::CancelReload)) once the
    /// flag is clear. The pump shotgun (the U-Rys 96) uses it.
    E_RELOAD_BULLET = 0x1,
    /// A timed reload with no act: the ammunition check sets [`WeaponBase::m_IsReloading`] and
    /// [`WeaponBase::m_ReloadTimeLeft`] (from [`WeaponTuning::m_reload_time_scale`]), blocks the
    /// shot while the timer runs, and calls [`WeaponBase::Reload`] when it runs out. Among the
    /// hand-held weapons, the guitar-case launcher, the missile strike, and the EMP use it.
    E_RELOAD_NO_ANIMATION = 0x2,
}

/// The kind of a weapon component (`CWeaponBase::EWeaponComponentType`), stored on the component
/// as [`WeaponComponentBase::m_Type`]. A component of a derived class carries the derived kind:
/// the barrel recoil and barrel spin components derive from the model-attachment component but
/// carry their own kinds.
#[copyable]
pub enum WeaponComponentType: i32 {
    E_WEAPON_COMPONENT_LASER_BEAM = 0x0,
    E_WEAPON_COMPONENT_TURRET = 0x1,
    E_WEAPON_COMPONENT_BARREL_SPIN = 0x2,
    E_WEAPON_COMPONENT_BARREL_RECOIL = 0x3,
    E_WEAPON_COMPONENT_DO_ACT = 0x4,
    /// A [`ModelAttachementWeaponComponent`] of the base class.
    E_WEAPON_COMPONENT_MODEL_ATTACHEMENT = 0x5,
    E_WEAPON_COMPONENT_FOW_CONTROLLER = 0x6,
    E_WEAPON_COMPONENT_MAGNET = 0x7,
    E_WEAPON_COMPONENT_WALL_PENETRATION = 0x8,
    E_WEAPON_COMPONENT_SPOTLIGHT = 0x9,
    E_WEAPON_COMPONENT_LIGHT = 0xA,
    E_WEAPON_COMPONENT_VEHICLE_PART_REMOVER = 0xB,
    E_WEAPON_COMPONENT_AIM_POI = 0xC,
    E_WEAPON_COMPONENT_AIRPLANE_FLYBY = 0xD,
    E_WEAPON_COMPONENT_INVALID = 0xE,
}

/// The fire inputs a weapon's user hands its per-tick update (`SWeaponInputs`), each `0..=1`. The
/// base update ([`WeaponBase::UpdateFromUserPostSim_ParallelBase`]) copies them before passing them
/// on to [`WeaponBase::UpdateWeapon_Parallel`].
#[size(0x8), copyable]
pub type WeaponInputs {
    /// The primary trigger, compared against the tuning's
    /// [`m_trigger_sensitivity`](WeaponTuning::m_trigger_sensitivity).
    pub m_PrimaryFireInput: f32,
    /// The secondary trigger, for weapons with a secondary action.
    pub m_SecondaryFireInput: f32,
}

/// A weapon's tuning record (`SWeaponTuning`), an ADF resource shared by every instance of a weapon
/// type and reached through [`WeaponBase::m_Tuning`]. Only the fields read by the mapped functions
/// are bound.
#[min_size(0x88)]
pub type WeaponTuning {
    /// The magazine capacity. Negative means the weapon has no magazine limit: it never reloads,
    /// and [`WeaponBase::Reload`] and [`WeaponBase::CanReload`] refuse it.
    #[address(0x40)]
    pub m_magazine_size: i32,

    /// The weapon's maximum aim range in metres. The player's aim control takes the largest of
    /// these over the wielded, wingsuit, and vehicle weapons as the weapon slot's maximum aim
    /// distance.
    #[address(0x44)]
    pub m_max_range: f32,

    /// The reload timing. For an
    /// [`E_RELOAD_NO_ANIMATION`](ReloadType::E_RELOAD_NO_ANIMATION) weapon the ammunition check
    /// loads it into [`WeaponBase::m_ReloadTimeLeft`] as the reload's duration in seconds.
    #[address(0x48)]
    pub m_reload_time_scale: f32,

    /// The seconds between shots: [`WeaponBase::UpdateWeapon_Parallel`] starts a shot only once
    /// [`WeaponBase::m_TimeSinceLastFire`] has reached it. The interval is weapon-wide, so the guns
    /// of a multi-gun weapon share it.
    #[address(0x50)]
    pub m_fire_rate: f32,
    /// The replacement for [`m_fire_rate`](Self::m_fire_rate) once the player owns the weapon's
    /// fire-rate upgrade.
    pub m_fire_rate_level_2: f32,

    /// Whether a held trigger keeps firing. Otherwise a local player's weapon fires once per pull
    /// ([`WeaponBase::m_FiredThisInput`]); other users always fire while the trigger is pulled.
    #[address(0x60)]
    pub m_fully_automatic: bool,

    /// The trigger thresholds: index 0 is the value a released trigger must exceed to count as
    /// pulled, index 1 the lower value a pulled trigger must stay above.
    #[address(0x64)]
    pub m_trigger_sensitivity: [f32; 2],

    /// A per-weapon replacement for the character's aim-timer refill value; non-negative values
    /// override the character's aim settings (see [`WeaponBase::GetAimTimerOverride`]).
    #[address(0x6C)]
    pub m_aim_timer_override: f32,

    /// Whether the weapon type has unlimited ammunition: one of the conditions of
    /// [`WeaponBase::HasUnlimitedAmmo`].
    #[address(0x84)]
    pub m_unlimited_ammo: bool,
}

/// One muzzle fire point of a weapon model (`CWeaponData::SInternalFireInformation`): the muzzle
/// transform relative to the weapon, the muzzle-flash effect bound to it, and the time since it
/// last fired.
#[size(0x50)]
pub type InternalFireInformation {
    /// The fire point's transform in weapon space. The shot origin is this matrix composed with
    /// the weapon's world matrix.
    pub m_Position: Matrix4,

    /// The attached fire effect played at this fire point.
    #[address(0x40)]
    pub m_FireEffect: *mut void,

    /// Seconds since this fire point last fired; reset to zero when the fire point is used.
    #[address(0x48)]
    pub m_TimeSinceLastFire: f32,
}

/// The weapon's list of [`WeaponData`] entries (an engine `TArray<CWeaponData*>`): begin, end, and
/// capacity-end pointers followed by a user-allocated flag.
#[min_size(0x20)]
pub type WeaponDataArray {
    /// The first entry.
    pub m_Begin: *mut *mut WeaponData,

    /// One past the last live entry.
    #[address(0x8)]
    pub m_End: *mut *mut WeaponData,

    /// One past the allocated capacity.
    #[address(0x10)]
    pub m_Last: *mut *mut WeaponData,
}

/// One physical gun of a weapon (`CWeaponData`, a `CCombinedAttachedEffectContainer`): its model,
/// attach bones, muzzle fire points, cached world matrices, and fire effects. A weapon holds one per
/// gun in [`WeaponBase::m_lWeaponData`]; a dual-wield weapon holds two.
#[min_size(0x2E8)]
pub type WeaponData {
    /// The `model_name_hash` (the hash of `no_magazine_model`) that makes
    /// [`ThrowAwayMagazineObject`](Self::ThrowAwayMagazineObject) drop the spare magazine from the
    /// gun's own transform without looking for a model part.
    pub const NO_MAGAZINE_MODEL_NAME_HASH: u32 = 0x193737A9,
    /// The [`m_MagazineUniqueTag`](Self::m_MagazineUniqueTag) of a gun without a magazine prop.
    pub const NO_MAGAZINE_UNIQUE_TAG: i32 = -1,
    /// The name hash (`hashlittle` of `Pump`) of the pump bone in a pump-action gun's own skeleton,
    /// the U-Rys 96's: the skeleton's one bone besides its `Reference` root, which carries the pump
    /// and which the gun's pump clip moves. Resolved to an index through the gun's animation
    /// controller ([`AnimationController::GetBoneIndex`](character::character::AnimationController::GetBoneIndex)).
    pub const PUMP_BONE_HASH: u32 = 0x964E9E67,
    /// The name hash (`hashlittle` of `Slider`) of the bolt bone in a bolt-action rifle's own
    /// skeleton, the CS111 Archangel's and the Final Argument's: the skeleton's one bone besides its
    /// `Reference` root, which carries the bolt and which the rifle's bolt-action clip moves.
    pub const SLIDER_BONE_HASH: u32 = 0x7B1541DB,

    /// The weapon this gun belongs to.
    #[address(0xC0)]
    pub m_Owner: *mut WeaponBase,

    /// The attach bone (an `NBone::ESafeBoneIndex`) this gun rides for each [`WeaponState`],
    /// indexed by [`WeaponBase::m_State`].
    #[address(0xD0)]
    pub m_lBoneAttachementPerWeaponState: [u32; 11],

    /// The gun's muzzle fire points, one per barrel.
    #[address(0x100)]
    pub m_InternalFirePositions: Vector<InternalFireInformation>,

    /// The fire-point cursor: the index into
    /// [`m_InternalFirePositions`](Self::m_InternalFirePositions) that
    /// [`WeaponBase::GetFireFromPosition`] uses as the muzzle. The tail of
    /// [`WeaponBase::Fire_Projectile`] advances it modulo the fire-point count after each shot.
    #[address(0x120)]
    pub m_InternalFirePositionCurrentIndex: i32,

    /// The gun's animated model, when it has one; its pose is computed in
    /// [`UpdatePreSim`](Self::UpdatePreSim) and its skinning is updated in the render phase.
    #[address(0x128)]
    pub m_AnimatedModel: *mut AnimatedModel,

    /// The gun's base model instance. The render update pushes the interpolated world matrix to
    /// it ([`ModelInstance::UpdateMatrix`]), scaled by the holstered scale while holstered, so the
    /// model's own space ([`ModelInstance::GetModelSpaceBoundingBox`]) is the frame of
    /// [`m_WorldMatrixT1`](Self::m_WorldMatrixT1).
    #[address(0x130)]
    pub m_BaseModelInstance: *mut ModelInstance,

    /// The gun's own rigid body. It is in the physics world only while the weapon's state keeps
    /// the weapon's bodies there (dropped, mounted, or turret; see [`WeaponState`]), and its id
    /// ([`PfxRigidBody::m_BodyId`](physics::PfxRigidBody::m_BodyId)) stays the same while it is out.
    /// The weapon's drop virtual ([`OnDrop`](WeaponBase::OnDrop)) sets the first gun's velocity on
    /// it, and gives every gun's a fresh collision system group when the holder was a vehicle.
    #[address(0x138)]
    pub m_PfxInstance: *mut PfxRigidBody,

    /// The gun's spare magazine: a disabled [`RigidObject`] that
    /// [`ThrowAwayMagazineObject`](Self::ThrowAwayMagazineObject) turns into the dropped magazine,
    /// or null. [`SpawnMagazineObject`](Self::SpawnMagazineObject) requests it from the spawn
    /// system, which fills it in asynchronously and disables it on arrival, so it stays null for a
    /// while after each request and for good on a gun without a magazine prop.
    #[address(0x148)]
    pub m_MagazineObject: SharedPtr<RigidObject>,

    /// The gun's world matrix as of the previous simulation tick.
    #[address(0x158)]
    pub m_WorldMatrixT0: Matrix4,

    /// The gun's world matrix as of the current simulation tick, refreshed from the attach bone by
    /// the model-instance attachment update. Sim-side readers such as the fire origin read it
    /// through [`GetWorldMatrixT1`](Self::GetWorldMatrixT1); the render update interpolates from
    /// [`m_WorldMatrixT0`](Self::m_WorldMatrixT0) toward it.
    #[address(0x198)]
    pub m_WorldMatrixT1: Matrix4,

    /// The gun's measured world velocity, metres per second.
    /// [`ThrowAwayMagazineObject`](Self::ThrowAwayMagazineObject) gives it to the dropped magazine.
    #[address(0x270)]
    pub m_MeasuredWorldVelocity: Vector3,
    /// The gun's measured angular velocity, which
    /// [`ThrowAwayMagazineObject`](Self::ThrowAwayMagazineObject) gives to the dropped magazine.
    pub m_MeasuredAngularVelocity: Vector3,

    /// The spawn tag of the gun's magazine prop, from the weapon's properties, or
    /// [`NO_MAGAZINE_UNIQUE_TAG`](Self::NO_MAGAZINE_UNIQUE_TAG) for a gun without one, for which
    /// [`SpawnMagazineObject`](Self::SpawnMagazineObject) does nothing.
    #[address(0x2A4)]
    pub m_MagazineUniqueTag: i32,

    /// Seconds since this gun last fired; reset by [`WeaponBase::Fire_Projectile`].
    #[address(0x2A8)]
    pub m_TimeSinceLastFire: f32,

    /// The gun's shot counter for tracers: the bullet weapons' shot
    /// ([`BulletWeaponBase::Fire_Projectile`]) increments it per bullet and draws a tracer every
    /// tuning-set number of bullets. [`WeaponBase::Fire_StartBase`] resets it at the first shot of
    /// a pull, and [`WeaponBase::UpdateWeapon_Parallel`] resets it after a long enough pause in
    /// fire.
    #[address(0x2AC)]
    pub m_TracerCounter: u16,

    /// The gun's counter of tracers, which the bullet weapons' shot increments per tracer to give
    /// every tuning-set number of tracers a smoke trail. Reset with
    /// [`m_TracerCounter`](Self::m_TracerCounter).
    #[address(0x2AE)]
    pub m_SmokeTrailCounter: u16,

    /// Shots of the gun's current burst still to fire. [`WeaponBase::Fire_StartBase`] loads it
    /// from the tuning at the first shot of a pull, and while it is non-zero
    /// [`WeaponBase::UpdateWeapon_Parallel`] tries to fire this gun whatever the trigger input.
    #[address(0x2B0)]
    pub m_BurstShotsLeft: u32,

    /// The uniform scale applied to the gun's world matrix while holstered.
    #[address(0x2DC)]
    pub m_HolsteredScaleValue: f32,

    /// Whether the gun's next placement skips the render interpolation: when set, the gun's
    /// attachment placement copies the new world matrix into
    /// [`m_WorldMatrixT0`](Self::m_WorldMatrixT0) as well, so the render update draws the gun
    /// at its new place without blending from the old. Set by
    /// [`WeaponBase::SkipRenderInterpolationForOneFrame`] and cleared by
    /// [`WeaponBase::UpdatePostFinalizePose`].
    #[address(0x2E5)]
    pub m_SkipRenderInterpolation: bool,

    /// Whether this gun leads a multi-gun first shot: [`WeaponBase::Fire_Projectile`] clears it on
    /// every gun and sets it on the firing one.
    #[address(0x2E6)]
    pub m_IsLeadingWeaponFire: bool,
}
impl WeaponData {
    /// Puts the gun's own body ([`m_PfxInstance`](Self::m_PfxInstance)) into the physics world
    /// (`CWeaponData::AddToWorld`, which the disassembler names `CPfxVehicle::OnStoppedTrailing`).
    /// It keeps the body's collision system group, or takes a fresh one when the group is zero,
    /// sets its collision layer for the owning weapon's state, makes it dynamic, and places it at
    /// the gun's world matrix ([`m_WorldMatrixT1`](Self::m_WorldMatrixT1)), so the body's frame is
    /// the gun's model frame and its shape is in that frame. The weapon's own world addition
    /// calls it for each gun but a dual-wielded weapon's second (`CWeaponBase::AddToWorld`, which
    /// the disassembler names `CWeaponBase::RemoveFromWorld`; the disassembler's
    /// `CWeaponBase::AddToWorld` is the removal).
    #[address(0x140_959_570)]
    pub fn AddToWorld(&mut self);

    /// Returns [`m_WorldMatrixT1`](Self::m_WorldMatrixT1), scaled by
    /// [`m_HolsteredScaleValue`](Self::m_HolsteredScaleValue) when the owning weapon is
    /// [`E_WS_HOLSTERED`](WeaponState::E_WS_HOLSTERED). The result is written through `result`
    /// and returned.
    #[address(0x140_960_1E0)]
    pub fn GetWorldMatrixT1(&self, result: *mut Matrix4) -> *mut Matrix4;

    /// The gun's pre-simulation update (`CWeaponData::UpdatePreSim`), run for each gun by the
    /// weapon's own pre-simulation update (`CWeaponBase::UpdatePreSim`). When the gun has an
    /// animated model ([`m_AnimatedModel`](Self::m_AnimatedModel)) and the weapon's LOD does not
    /// switch its animation off, it advances the model's clips, track messages, rule systems, and
    /// state tasks by the context's step, then computes the model-space pose
    /// (`CPoseProducer::CalculateModelSpacePose`), which the joint accessors of the model's
    /// animation controller
    /// ([`AnimationController::GetJoint`](character::character::AnimationController::GetJoint) and
    /// [`SetJoint`](character::character::AnimationController::SetJoint)) read and write and which
    /// the render phase skins. It then measures the gun's velocities from its two cached world
    /// matrices ([`m_MeasuredWorldVelocity`](Self::m_MeasuredWorldVelocity) and
    /// [`m_MeasuredAngularVelocity`](Self::m_MeasuredAngularVelocity)). Returns whether the
    /// animated model was updated. `context` is the game object update context, whose first field
    /// is the step in seconds.
    #[address(0x140_959_160)]
    pub fn UpdatePreSim(&mut self, context: *mut void) -> bool;

    /// Places the gun for `state` (`CWeaponData::UpdateAttachmentTransforms`), writing
    /// [`m_WorldMatrixT1`](Self::m_WorldMatrixT1). With `update_type` 2 (advance) it first copies
    /// the current matrix into [`m_WorldMatrixT0`](Self::m_WorldMatrixT0). Held by a vehicle, the
    /// gun follows its anchor or part; while wingsuiting it is built from the holder's reference
    /// and head bones and its flight direction; dropped, mounted, or on a turret it follows its own
    /// rigid body when that is in the world; on a weapon rack it follows its placement rule.
    /// Otherwise, held by a character, it takes the world matrix of the bone its attach-bone table
    /// ([`m_lBoneAttachementPerWeaponState`](Self::m_lBoneAttachementPerWeaponState)) names for
    /// `state`
    /// ([`Character::GetWorldMatrixForBone`](character::character::Character::GetWorldMatrixForBone)):
    /// a hand attach bone's matrix as it is, and a holster or back bone's composed with the gun's
    /// attach offset when the weapon's attach tuning asks for it. So a hand-held gun's pose in the
    /// hand is the attach bone's pose relative to the wrist, which the animation sets. While
    /// [`m_SkipRenderInterpolation`](Self::m_SkipRenderInterpolation) or
    /// `skip_render_interpolation` is set, and for the initial placement (`update_type` 0), it
    /// copies the new matrix into [`m_WorldMatrixT0`](Self::m_WorldMatrixT0) too. Each weapon's
    /// placement calls it for every gun; the character's pose-finalization pass places the weapons
    /// through
    /// [`Inventory::UpdateAttachmentTransforms`](character::inventory::Inventory::UpdateAttachmentTransforms).
    #[address(0x140_986_F80)]
    pub fn UpdateAttachmentTransforms(&mut self, holder: *mut GameObject, snow_factor: f32, water_factor: f32, state: WeaponState, skip_render_interpolation: bool, update_type: u32);

    /// Drops the gun's spare magazine ([`m_MagazineObject`](Self::m_MagazineObject)) as a physics
    /// prop, for `character` holding the gun. `model_name_hash` picks where the magazine leaves
    /// from:
    ///
    /// - zero, or [`NO_MAGAZINE_MODEL_NAME_HASH`](Self::NO_MAGAZINE_MODEL_NAME_HASH): from the gun's
    ///   own [`m_WorldMatrixT1`](Self::m_WorldMatrixT1), touching no model part;
    /// - any other hash: from the world matrix
    ///   ([`ModelAttachementWeaponComponent::m_WorldMatrix`]) of the owner's model-attachment
    ///   component whose [`m_NameHash`](ModelAttachementWeaponComponent::m_NameHash) matches. It
    ///   walks a copy of the owner's [`m_WeaponComponents`](WeaponBase::m_WeaponComponents),
    ///   taking only a component whose [`m_Type`](WeaponComponentBase::m_Type) is
    ///   [`E_WEAPON_COMPONENT_MODEL_ATTACHEMENT`](WeaponComponentType::E_WEAPON_COMPONENT_MODEL_ATTACHEMENT)
    ///   and that passes [`IsType`](WeaponComponentBase::IsType) for
    ///   [`ModelAttachementWeaponComponent::TYPE_ID`], and hides that part with
    ///   [`Enable`](WeaponComponentBase::Enable)`(false)`. With no matching part nothing is
    ///   dropped or hidden, and it returns false.
    ///
    /// When there is a spare magazine and a place to drop it from, it makes the prop dynamic,
    /// places it there, gives its body the character's collision system group (so it does not
    /// collide with the character), the gun's
    /// [`m_MeasuredWorldVelocity`](Self::m_MeasuredWorldVelocity) with any upward component
    /// removed, and the gun's [`m_MeasuredAngularVelocity`](Self::m_MeasuredAngularVelocity), and
    /// a body material, then enables it, adds it to the update, and releases the gun's reference,
    /// so [`m_MagazineObject`](Self::m_MagazineObject) is null afterwards. It returns true when it
    /// found a place to drop from, whether or not a spare magazine was there to drop.
    ///
    /// It writes physics-body state (velocities and the body material through the world), which
    /// the physics system allows only on the thread holding the physics world's write mark. Its
    /// only caller is the throw-away-magazine track message
    /// ([`TRACK_MESSAGE_THROW_AWAY_MAGAZINE`](WeaponBase::TRACK_MESSAGE_THROW_AWAY_MAGAZINE)), which
    /// runs in the holder's serial post-physics pass on the game update thread.
    #[address(0x140_986_B60)]
    pub fn ThrowAwayMagazineObject(&mut self, character: *mut Character, model_name_hash: u32) -> bool;

    /// Requests the gun's next spare magazine: releases [`m_MagazineObject`](Self::m_MagazineObject)
    /// and asks the spawn system to spawn the prop tagged
    /// [`m_MagazineUniqueTag`](Self::m_MagazineUniqueTag) at the gun's
    /// [`m_WorldMatrixT1`](Self::m_WorldMatrixT1). The spawn completes later; its callback stores
    /// the prop in `m_MagazineObject` and disables it until it is thrown. Does nothing for a gun
    /// without a magazine prop. The weapon's post-initialization calls it for the first spare, and
    /// the throw-away-magazine track message after each throw.
    #[address(0x140_97B_1D0)]
    pub fn SpawnMagazineObject(&mut self);

    /// Runs `act` (an event id, as [`Character::QueueAct`](character::character::Character::QueueAct)
    /// takes) on the gun's own animated model ([`m_AnimatedModel`](Self::m_AnimatedModel)), on
    /// its first layer, and returns whether the model took it; false for a gun without an
    /// animated model. The do-act component ([`DoActWeaponComponent`]) plays a gun's own clips,
    /// such as a pump, through it.
    #[address(0x140_951_2F0)]
    pub fn DoAct(&mut self, act: *const u32) -> bool;
}

/// The base class of every weapon (`CWeaponBase`, a `CPhysicsGameObject`): fire input and timing,
/// ammunition, recoil, heat, aim target, tuning, and the list of physical guns
/// ([`WeaponData`]) it drives. The weapon embeds a `CGameObject` subobject after its vtable
/// pointer.
pub type WeaponBase {
    /// The seconds a blocked trigger pull stays buffered in
    /// [`m_InputBufferTimer`](Self::m_InputBufferTimer).
    pub const INPUT_BUFFER_TIME: f32 = 0.5,
    /// The offset of the embedded `CGameObject` subobject, which the `CGameObject` overrides
    /// ([`GetTransform`](Self::GetTransform), [`UpdateRender`](Self::UpdateRender)) receive as
    /// their `game_object` in place of the weapon.
    pub const GAME_OBJECT_BASE_OFFSET: u64 = 0x8,
    /// The track message ([`HandleTrackMessage`](Self::HandleTrackMessage)) that drops the
    /// magazine. Its arguments are the part name hash for
    /// [`WeaponData::ThrowAwayMagazineObject`], the index of the gun in
    /// [`m_lWeaponData`](Self::m_lWeaponData), and a flag that, when set, leaves
    /// [`m_WeaponIsWithoutMagazine`](Self::m_WeaponIsWithoutMagazine) clear. It does nothing for a
    /// gun index out of range or while the magazine is already out. When the throw succeeds it
    /// requests the gun's next spare ([`WeaponData::SpawnMagazineObject`]) and, unless the flag is
    /// set, sets [`m_WeaponIsWithoutMagazine`](Self::m_WeaponIsWithoutMagazine).
    pub const TRACK_MESSAGE_THROW_AWAY_MAGAZINE: u32 = 0xA6E4C80,
    /// The track message that refills the magazine: calls the [`Reload`](Self::Reload) virtual.
    pub const TRACK_MESSAGE_RELOAD: u32 = 0xE3911080,
    /// The track message that shows or hides a model part: for every one of
    /// [`m_WeaponComponents`](Self::m_WeaponComponents) that passes
    /// [`IsType`](WeaponComponentBase::IsType) for [`ModelAttachementWeaponComponent::TYPE_ID`]
    /// and whose [`m_NameHash`](ModelAttachementWeaponComponent::m_NameHash) is the message's
    /// first argument, it calls [`Enable`](WeaponComponentBase::Enable) with whether the second
    /// argument is non-zero. Reload clips use it to show the magazine part again.
    pub const TRACK_MESSAGE_ENABLE_MODEL_ATTACHEMENT: u32 = 0xA950A983,
    /// The track message that asks the holder to start a reload
    /// ([`Character::StartReloadingWieldingWeapon`](character::character::Character::StartReloadingWieldingWeapon)).
    pub const TRACK_MESSAGE_START_RELOAD: u32 = 0xC650067B,
    /// The track message that asks the holder to start a reload only while the magazine
    /// ([`m_MagazineAmmo`](Self::m_MagazineAmmo)) is empty.
    pub const TRACK_MESSAGE_START_RELOAD_IF_EMPTY: u32 = 0xC8E9497E,

    vftable {
        /// Writes the muzzle position for `weapon_data`: the gun's world matrix composed with its
        /// current fire point ([`WeaponData::m_InternalFirePositionCurrentIndex`]). The base
        /// implementation is [`GetFireFromPositionBase`](Self::GetFireFromPositionBase).
        #[index(25)]
        pub fn GetFireFromPosition(&self, result: *mut Vector3, weapon_data: *mut WeaponData) -> *mut Vector3;

        /// Starts fire on one gun, `weapon_data`. The base implementation is
        /// [`Fire_StartBase`](Self::Fire_StartBase).
        #[index(26)]
        pub fn Fire_Start(&mut self, weapon_data: *mut WeaponData);

        /// Stops fire. The base implementation is [`Fire_StopBase`](Self::Fire_StopBase).
        #[index(27)]
        pub fn Fire_Stop(&mut self, weapon_data: *mut WeaponData);

        /// Fires one shot from `weapon_data`. The base implementation is
        /// [`Fire_ProjectileBase`](Self::Fire_ProjectileBase); subclasses such as
        /// `CBulletWeaponBase` spawn their projectile and then call it.
        #[index(28)]
        pub fn Fire_Projectile(&mut self, weapon_data: *mut WeaponData);

        /// Takes the weapon into `holder`'s keeping (a character's or vehicle's `CGameObject`
        /// subobject): sets the holder, and for a weapon outside the heavy slot sets the holstered
        /// state (holstered-invisible for the hand grenade, the planted explosive, and the beacon),
        /// which takes its bodies out of the physics world. Unless
        /// [`m_InfinitePickup`](Self::m_InfinitePickup) is set it disables the weapon's pickup
        /// interaction and its pickup hint, and for the locally controlled character it sets the
        /// avatar's mental state to
        /// [`E_READY_FOR_COMBAT`](character::avatar::MentalState::E_READY_FOR_COMBAT) and shows
        /// the pickup on the HUD. The inventory's add
        /// calls it when the weapon goes into a slot.
        #[index(32)]
        pub fn OnPickup(&mut self, holder: *mut GameObject);

        /// Equips the weapon for `character`, which must hold it: shows it, runs its components'
        /// equip, selects its slot, starts using it (the user becomes `character`), puts the
        /// locally controlled character's avatar into
        /// [`E_COMBAT`](character::avatar::MentalState::E_COMBAT) and shows the weapon on the HUD, and
        /// sets the wielding state, or dual-wielding for the dual-wield slot of a player. It plays
        /// no act: the draw animation comes from the character's draw, not from here. It does
        /// nothing for a dead character. The inventory's add calls it with the equipping mode.
        #[index(33)]
        pub fn OnEquip(&mut self, character: *mut Character);

        /// Unequips the weapon from its user: cancels the user's reload, sets the holstered state
        /// (which takes its bodies out of the physics world) unless it is mounted, drops it through
        /// the user's inventory instead when it is in the heavy slot, and then stops using it
        /// ([`StopUsing`](Self::StopUsing)). It does nothing without a user.
        #[index(34)]
        pub fn OnUnequip(&mut self);

        /// Drops the weapon into the world, run by the deferred drop on the weapon's next
        /// pre-simulation update and directly by a swimming character's pickup on the occupant of
        /// the slot it picks into. A weapon still wielded or dual-wielded is unequipped first
        /// ([`OnUnequip`](Self::OnUnequip)), leaving the player's precision aim. It then sets the
        /// dropped state, adds the bodies to the physics world and wakes them, and sets the first
        /// gun's body velocity ([`WeaponData::m_PfxInstance`]) from the state the weapon was in by
        /// then: from holstered, with a character holder, the holder's velocity plus its forward
        /// direction scaled by the slot (forward for the two-handed slot, backward for the special
        /// slot, none for the others); from wielding or dual-wielding, the first gun's
        /// [`m_MeasuredWorldVelocity`](WeaponData::m_MeasuredWorldVelocity) and
        /// [`m_MeasuredAngularVelocity`](WeaponData::m_MeasuredAngularVelocity). A non-player
        /// holder's weapon first gets stored ammunition from the holder's dropped-magazine range.
        /// It clears the holder and enables the weapon's pickup interaction.
        #[index(35)]
        pub fn OnDrop(&mut self);

        /// Stops the user using the weapon: stops its fire, its effects, and its components, clears
        /// the user, and, when the weapon is wielding or dual-wielding outside the heavy slot, sets
        /// the holstered state. A mounted gun also leaves its user's inventory, which then selects
        /// another weapon.
        #[index(36)]
        pub fn StopUsing(&mut self);

        /// The ammunition the weapon can still use: its magazine plus the holder's inventory stock
        /// of its ammunition type. The thrown grenade weapon adds one while it holds a primed
        /// grenade ([`ThrownGrenadeWeapon::m_PrimedGrenade`]).
        #[index(38)]
        pub fn GetTotalAmmo(&self) -> i32;

        /// Sets [`m_MagazineAmmo`](Self::m_MagazineAmmo) to `ammo`. For the local player's
        /// selected weapon outside the planted-explosive slot it also pushes the count to the HUD
        /// (`CHUDUI::OnSetSelectedMagazineAmmo`), flagging an empty magazine; the HUD keeps no
        /// other view of the count, so a write that bypasses this leaves the HUD stale. The base
        /// implementation is [`SetMagazineAmmoBase`](Self::SetMagazineAmmoBase).
        #[index(39)]
        pub fn SetMagazineAmmo(&mut self, ammo: i32);

        /// Starts the weapon side of a reload once the holder's reload act is accepted (the act's
        /// callback calls it): resets the fire-input timers, plays each gun's reload effect,
        /// clears the guns' bursts, sets [`m_KeepReloading`](Self::m_KeepReloading) for an
        /// [`E_RELOAD_BULLET`](ReloadType::E_RELOAD_BULLET) weapon, and registers the weapon for
        /// pre-simulation updates. It moves no ammunition.
        #[index(40)]
        pub fn StartReloadSequence(&mut self);

        /// Whether the weapon can start a reload: its ammunition type is not
        /// [`AMMO_UNLIMITED`](AmmunitionType::AMMO_UNLIMITED), it has a magazine limit, the
        /// magazine is below it, and either [`HasUnlimitedAmmo`](Self::HasUnlimitedAmmo) holds or
        /// its living holder has a reserve of its type (a holder in god mode,
        /// [`GOD_MODE`](character::character::DamageStateFlags::GOD_MODE), always counts as
        /// having one). A weapon whose magazine and reserve are both empty cannot.
        /// [`Character::StartReloadingWieldingWeapon`](character::character::Character::StartReloadingWieldingWeapon)
        /// queues the reload act only when it holds.
        #[index(41)]
        pub fn CanReload(&self) -> bool;

        /// Refills the magazine from the holder's reserve and returns whether it did. The base
        /// implementation ([`ReloadBase`](Self::ReloadBase)) does nothing and returns false
        /// without a holder, for an [`AMMO_UNLIMITED`](AmmunitionType::AMMO_UNLIMITED) weapon, or
        /// for one without a magazine limit. Otherwise it first clears
        /// [`m_WeaponIsWithoutMagazine`](Self::m_WeaponIsWithoutMagazine), even when it then
        /// refills nothing. With the magazine already full, or with no reserve
        /// ([`Inventory::GetAmmoCount`](character::inventory::Inventory::GetAmmoCount)) and no
        /// [`HasUnlimitedAmmo`](Self::HasUnlimitedAmmo), it clears
        /// [`m_KeepReloading`](Self::m_KeepReloading) and returns false. Otherwise:
        ///
        /// - the new count is the magazine size, or the old count plus the reserve when that is
        ///   less; with unlimited ammunition the reserve counts as a full magazine;
        /// - for an [`E_RELOAD_BULLET`](ReloadType::E_RELOAD_BULLET) weapon the new count is the
        ///   old count plus one instead, and [`m_KeepReloading`](Self::m_KeepReloading) is set
        ///   while that is still short of full;
        /// - it writes the count through [`SetMagazineAmmo`](Self::SetMagazineAmmo) (which pushes
        ///   the HUD), records the reload statistic for the local player, resets the scatter
        ///   balancer, and tells the HUD (`CHUDUI::OnReloadSelectedWeapon`) for the local player's
        ///   selected weapon;
        /// - it clears [`m_KeepReloading`](Self::m_KeepReloading) once the magazine is full;
        /// - without unlimited ammunition it writes the reserve back as the old count plus the
        ///   reserve minus the new count
        ///   ([`Inventory::SetAmmoCount`](character::inventory::Inventory::SetAmmoCount), allowing
        ///   an autosave), so the rounds left in the old magazine return to the reserve and nothing
        ///   is lost;
        /// - it clears [`m_IsReloading`](Self::m_IsReloading) and returns true.
        ///
        /// It never touches the weapon's model parts: a part hidden by the throw-away-magazine
        /// message stays hidden until the
        /// [`TRACK_MESSAGE_ENABLE_MODEL_ATTACHEMENT`](Self::TRACK_MESSAGE_ENABLE_MODEL_ATTACHEMENT)
        /// message shows it. The rocket launcher's override ([`RPGWeapon::Reload`]) handles its
        /// rocket model. It runs from the reload track message
        /// ([`TRACK_MESSAGE_RELOAD`](Self::TRACK_MESSAGE_RELOAD)), in the holder's serial
        /// post-physics pass, and for an
        /// [`E_RELOAD_NO_ANIMATION`](ReloadType::E_RELOAD_NO_ANIMATION) weapon from the ammunition
        /// check in the weapon's parallel update; a refill of the hand-grenade reserve from empty
        /// also calls it on the hand-grenade weapon.
        #[index(42)]
        pub fn Reload(&mut self) -> bool;

        /// The per-gun ammunition check, called by
        /// [`UpdateWeapon_Parallel`](Self::UpdateWeapon_Parallel) for `weapon_data` with the
        /// tick's fire decision in `should_try_to_fire` and whether the trigger was already pulled
        /// before this tick. The base implementation is
        /// [`CheckIfReloadShouldBeTriggeredBase`](Self::CheckIfReloadShouldBeTriggeredBase).
        #[index(43)]
        pub fn CheckIfReloadShouldBeTriggered(&mut self, weapon_data: *mut WeaponData, should_try_to_fire: *mut bool, was_trigger_pulled: bool);

        /// Ends a reload: clears [`m_KeepReloading`](Self::m_KeepReloading) and
        /// [`m_IsReloading`](Self::m_IsReloading). The reload state machine's
        /// `NWeaponReloadFinishedTask` calls it on the wielded weapon when its state exits.
        #[index(44)]
        pub fn ReloadAnimationFinished(&mut self);

        /// Deducts `count` rounds of ammunition for `weapon_data`.
        #[index(45)]
        pub fn ConsumeAmmo(&mut self, weapon_data: *mut WeaponData, count: i32);

        /// Whether the weapon is being aimed: the base implementation
        /// ([`IsWeaponAimingBase`](Self::IsWeaponAimingBase)) returns
        /// [`m_IsTryingToFire`](Self::m_IsTryingToFire) or
        /// [`m_IsFeatheringTrigger`](Self::m_IsFeatheringTrigger). The character's aim-input
        /// handling refills its aim timer while this holds.
        #[index(47)]
        pub fn IsWeaponAiming(&self) -> bool;

        /// Applies the holder's aim mode: normal or precision aim. `CPlayer::SetAimMode` calls it
        /// after changing the player's aim mode.
        #[index(48)]
        pub fn SetAimMode(&mut self, aim_mode: AimMode);

        /// The per-tick weapon update from its user after simulation: validates `aim_position` and
        /// stores it as [`m_AimTargetPosition`](Self::m_AimTargetPosition), then processes the
        /// fire inputs. The base implementation is
        /// [`UpdateFromUserPostSim_ParallelBase`](Self::UpdateFromUserPostSim_ParallelBase).
        #[index(54)]
        pub fn UpdateFromUserPostSim_Parallel(&mut self, dt: f32, aim_position: *const Vector3, input: *const WeaponInputs);

        /// The serial counterpart of
        /// [`UpdateFromUserPostSim_Parallel`](Self::UpdateFromUserPostSim_Parallel), called with the
        /// same arguments by
        /// [`Inventory::UpdateWeapons_Serial`](character::inventory::Inventory::UpdateWeapons_Serial).
        /// It does not write
        /// [`m_AimTargetPosition`](Self::m_AimTargetPosition).
        #[index(55)]
        pub fn UpdateFromUserPostSim_Serial(&mut self, dt: f32, aim_position: *const Vector3, input: *const WeaponInputs);

        /// Returns the weapon type's tuning block (`SWeaponTuningBase`), from which the fire code
        /// reads recoil, scatter, and spread ranges.
        #[index(57)]
        pub fn GetTuningBase(&self) -> *const void;

        /// Shows or hides the weapon's guns and their components. Showing with `fade` fades the
        /// guns' models in. A weapon in the
        /// [`E_WS_HOLSTERED_INVISIBLE`](WeaponState::E_WS_HOLSTERED_INVISIBLE) state is shown only
        /// with `force`. Hiding takes effect at once. A hand grenade picked up hides itself this
        /// way before it despawns, and a placement rule hides a weapon it places invisible.
        #[index(59)]
        pub fn SetVisible(&mut self, visible: bool, fade: bool, force: bool);

        /// Places the weapon's guns for its state: the base implementation
        /// (`CWeaponBase::UpdateAttachmentTransforms`) locks the holder
        /// ([`m_Holder`](Self::m_Holder)) and runs
        /// [`WeaponData::UpdateAttachmentTransforms`] for every gun with it, then places the
        /// weapon's components. `p2` and `p3` are the snow and water factors the gun placement
        /// takes, and `transform_type` its update type. The inventory's placement
        /// ([`Inventory::UpdateAttachmentTransforms`](character::inventory::Inventory::UpdateAttachmentTransforms))
        /// calls it for each slot's weapon.
        #[index(61)]
        pub fn UpdateAttachmentTransforms(&mut self, p2: f32, p3: f32, transform_type: u32);
    },

    /// A weak reference to the weapon itself (`m_WeakThis` of its `CGameObject` subobject),
    /// referring to that subobject. The spawn system's per-frame despawn ranking
    /// ([`SpawnSystem::Update`](spawn_system::SpawnSystem::Update)) reads the strong count of its
    /// control block, and the weapon hands out references to itself from it (the HUD's pickup
    /// display, the pickup hint).
    #[address(0x68)]
    pub m_WeakThis: WeakPtrGameObject,

    /// Whether the current shot is the first of a trigger pull; first shots use the tuning's
    /// first-shot recoil scale.
    #[address(0x158)]
    pub m_IsFirstShot: bool,

    /// Whether the weapon is firing.
    #[address(0x159)]
    pub m_IsFiring: bool,

    /// Whether the fire input currently requests a shot, after trigger sensitivity, semi-automatic
    /// gating, and forced fire.
    #[address(0x15A)]
    pub m_IsTryingToFire: bool,

    /// Whether the trigger input is past the tuning's pull threshold (with hysteresis once pulled).
    #[address(0x15B)]
    pub m_IsTriggerPulled: bool,

    /// Whether firing is cancelled until the trigger is released.
    #[address(0x15C)]
    pub m_IsFiringCancelled: bool,

    /// Whether the trigger input is above zero.
    #[address(0x15D)]
    pub m_IsFeatheringTrigger: bool,

    /// Whether the current trigger pull has already fired; semi-automatic weapons fire once per
    /// pull.
    #[address(0x15E)]
    pub m_FiredThisInput: bool,

    /// The index into [`m_lWeaponData`](Self::m_lWeaponData) of the gun that fires next, which
    /// [`GetFireFromPositionBase`](Self::GetFireFromPositionBase) reads to pick the muzzle. The
    /// tail of [`Fire_ProjectileBase`](Self::Fire_ProjectileBase) (`MarkNextWeaponComponentForFire`,
    /// inlined in this build) advances it modulo the gun count after each shot.
    #[address(0x160)]
    pub m_NextWeaponToFire: u8,

    /// The index of the gun that fired last, recorded before
    /// [`m_NextWeaponToFire`](Self::m_NextWeaponToFire) advances.
    #[address(0x161)]
    pub m_LastWeaponToFire: u8,

    /// Whether firing this weapon adds no heat (wanted level) to the user.
    #[address(0x163)]
    pub m_NoHeatOnFiring: bool,

    /// The weapon's persistent projectile direction mode.
    #[address(0x168)]
    pub m_ProjectileFireDirection: ProjectileFireDirectionMode,

    /// A temporary override of [`m_ProjectileFireDirection`](Self::m_ProjectileFireDirection);
    /// [`E_PROJECTILE_FIRE_DIRECTION_UNSET`](ProjectileFireDirectionMode::E_PROJECTILE_FIRE_DIRECTION_UNSET)
    /// defers to it.
    #[address(0x16C)]
    pub m_ProjectileTempFireDirection: ProjectileFireDirectionMode,

    /// A one-shot fire request: while set, the next
    /// [`UpdateWeapon_Parallel`](Self::UpdateWeapon_Parallel) clears it and calls
    /// [`Fire_Projectile`](Self::Fire_Projectile) once for each gun, whatever the fire input and the
    /// aim angle. Animation track messages raise it at the release point of a throw.
    #[address(0x178)]
    pub m_ForceFireProjectile: bool,

    /// Seconds of forced fire remaining; the weapon fires regardless of input while positive.
    #[address(0x17C)]
    pub m_ForceFireTimer: f32,

    /// Shots of forced fire remaining; decremented once per
    /// [`Fire_ProjectileBase`](Self::Fire_ProjectileBase) call.
    #[address(0x180)]
    pub m_ForceFireCount: i32,

    /// Seconds a blocked trigger pull stays buffered. A pull blocked by wall penetration or by the
    /// aim-angle check sets it to [`INPUT_BUFFER_TIME`](Self::INPUT_BUFFER_TIME), so the shot fires
    /// if the block clears within that window; a shot resets it to zero.
    #[address(0x184)]
    pub m_InputBufferTimer: f32,

    /// Seconds since the weapon last fired.
    #[address(0x198)]
    pub m_TimeSinceLastFire: f32,

    /// The radius of the spread ring [`GetShotMatrix`](Self::GetShotMatrix) offsets the aim point
    /// by, while [`m_ProjectileOffsetFireCount`](Self::m_ProjectileOffsetFireCount) shots remain.
    #[address(0x1A4)]
    pub m_ProjectileOffsetFromAimPos: f32,

    /// Shots remaining that use the spread ring; decremented once per shot.
    #[address(0x1AC)]
    pub m_ProjectileOffsetFireCount: i32,

    /// Whether picking the weapon up gives the character a copy rather than the weapon itself.
    /// [`PickupStart`](Self::PickupStart) then calls `CInventory::GivePlayerWeapon` with the
    /// weapon's spawn tag, and [`PickupItem`](Self::PickupItem) puts nothing into the inventory:
    /// it only plays the pickup vocal and clears
    /// [`m_StoredNonMagazineAmmo`](Self::m_StoredNonMagazineAmmo). The weapon's pickup handling
    /// leaves its pickup interaction enabled while it is set.
    #[address(0x217)]
    pub m_InfinitePickup: bool,

    /// Whether the magazine is out of the weapon. Only the throw-away-magazine track message
    /// ([`TRACK_MESSAGE_THROW_AWAY_MAGAZINE`](Self::TRACK_MESSAGE_THROW_AWAY_MAGAZINE)) sets it,
    /// and only [`Reload`](Self::Reload) clears it. While it is set the ammunition check
    /// ([`CheckIfReloadShouldBeTriggeredBase`](Self::CheckIfReloadShouldBeTriggeredBase)) clears
    /// the shot and calls
    /// [`Character::StartReloadingWieldingWeapon`](character::character::Character::StartReloadingWieldingWeapon)
    /// on every tick, the throw message does nothing, and the animation condition
    /// `CWeaponHasMagazineInsertedCondition` (through `CWeaponBase::WeaponHasMagazineInserted`)
    /// reads false.
    #[address(0x221)]
    pub m_WeaponIsWithoutMagazine: bool,

    /// The weapon's kind of ammunition, set from the weapon's properties; it selects the reserve
    /// in the holder's [`Inventory::m_Ammunition`](character::inventory::Inventory::m_Ammunition).
    #[address(0x224)]
    pub m_AmmunitionType: AmmunitionType,

    /// The rounds in the magazine. A shot consumes from it; a reload refills it from the holder's
    /// inventory stock of the weapon's ammunition type. The guns of a multi-gun weapon share it.
    /// Write it through [`SetMagazineAmmo`](Self::SetMagazineAmmo), which also updates the HUD.
    #[address(0x228)]
    pub m_MagazineAmmo: i32,
    /// The weapon's stored rounds outside the magazine (`CWeaponBase::GetStoredNonMagazineAmmo`).
    pub m_StoredNonMagazineAmmo: i32,

    /// How the weapon reloads, set from the weapon's `reload_type` property.
    #[address(0x230)]
    pub m_ReloadType: ReloadType,

    /// Whether an [`E_RELOAD_BULLET`](ReloadType::E_RELOAD_BULLET) reload is to insert another
    /// round. [`StartReloadSequence`](Self::StartReloadSequence) and each
    /// [`Reload`](Self::Reload) that leaves the magazine short of full set it; `Reload` clears it
    /// once the magazine is full or the reserve is empty, and
    /// [`ReloadAnimationFinished`](Self::ReloadAnimationFinished) clears it. While it is clear,
    /// the ammunition check cancels the holder's reload act for a weapon that does not reload by
    /// magazine.
    #[address(0x234)]
    pub m_KeepReloading: bool,

    /// Whether an [`E_RELOAD_NO_ANIMATION`](ReloadType::E_RELOAD_NO_ANIMATION) reload is timing:
    /// set by the ammunition check when it starts one, and cleared by [`Reload`](Self::Reload) and
    /// [`ReloadAnimationFinished`](Self::ReloadAnimationFinished). The ammunition check treats it
    /// like the holder's reloading state.
    #[address(0x235)]
    pub m_IsReloading: bool,

    /// The magazine count below which the local player's idle weapon reloads on its own (the
    /// predicted reload of the ammunition check), set from the weapon's properties.
    #[address(0x238)]
    pub m_PredictedReloadAmmunitionLimit: i32,

    /// The seconds without fire input after which the predicted reload may start; a negative
    /// value lets it start even where the holder does not allow predicted reloads.
    #[address(0x23C)]
    pub m_PredictedReloadTime: f32,

