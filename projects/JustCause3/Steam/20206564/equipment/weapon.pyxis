    /// set.
    #[address(0x519)]
    pub m_IsUserLocalPlayer: bool,

    /// Whether the weapon blocks firing while its barrel penetrates a wall in aim.
    #[address(0x560)]
    pub m_IsWeaponPenetratingWallIfInAim: bool,

    /// Whether the weapon's barrel penetrates a character in aim;
    /// [`GetShotMatrix`](Self::GetShotMatrix) skips the near-muzzle barrel fallback while set.
    #[address(0x561)]
    pub m_IsWeaponPenetratingCharacterIfInAim: bool,

    /// Whether the holder can lean over an obstruction to fire, which lifts the wall-penetration
    /// block.
    #[address(0x562)]
    pub m_IsLeanOverFirePossible: bool,

    /// The weapon's physical guns, one [`WeaponData`] per gun.
    #[address(0x568)]
    pub m_lWeaponData: WeaponDataArray,
}
impl WeaponBase {
    /// Writes the world transform of the weapon's grip point for `hand` into `matrix`: the
    /// weapon's grip-table entry for that hand (the entry for the mounted state while
    /// [`m_State`](Self::m_State) is [`E_WS_MOUNTED`](WeaponState::E_WS_MOUNTED)), a translation in
    /// the first gun's frame, composed with that gun's current world matrix. Returns false, writing
    /// nothing, when the weapon has no entry for that hand. The secondary hand IK pass and the hand
    /// IK tasks place a hand on a held weapon through it.
    #[address(0x140_966_840)]
    pub fn GetGripPosition(&self, hand: WeaponGripHand, matrix: *mut Matrix4) -> bool;

    /// Builds the launch transform for a shot from `weapon_data` into `shot_matrix`. The origin is
    /// the muzzle ([`GetFireFromPosition`](Self::GetFireFromPosition)); the direction points at
    /// [`m_AimTargetPosition`](Self::m_AimTargetPosition) (for a remote player, the network
    /// component's aim point). It falls back to 10 m along the barrel when the aim point is within
    /// about 0.3 m of the muzzle, in barrel fire-direction mode, or with `force_barrel_direction`.
    /// While projectile-offset shots remain it offsets the aim point by
    /// [`m_ProjectileOffsetFromAimPos`](Self::m_ProjectileOffsetFromAimPos) on a random ring, and
    /// it layers the scatter rotation on top unless `ignore_scatter`.
    #[address(0x140_985_AA0)]
    pub fn GetShotMatrix(&mut self, weapon_data: *mut WeaponData, shot_matrix: *mut Matrix4, ignore_scatter: bool, force_barrel_direction: bool) -> bool;

    /// The base implementation of the [`GetFireFromPosition`](Self::GetFireFromPosition) virtual.
    #[address(0x140_966_940)]
    pub fn GetFireFromPositionBase(&self, result: *mut Vector3, weapon_data: *mut WeaponData) -> *mut Vector3;

    /// The base implementation of the [`Fire_Projectile`](Self::Fire_Projectile) virtual: consumes
    /// ammunition, resets the fire timers, applies recoil, scatter, and heat, plays the fire effect
    /// on `weapon_data`, decrements the forced-fire and projectile-offset counts, and then advances
    /// the fire-point cursor of the gun at [`m_NextWeaponToFire`](Self::m_NextWeaponToFire) and the
    /// gun index itself.
    #[address(0x140_991_FF0)]
    pub fn Fire_ProjectileBase(&mut self, weapon_data: *mut WeaponData);

    /// Spawns the fire rumble for a shot through [`RumbleManager::SpawnRumble`](rumble_manager::RumbleManager::SpawnRumble),
    /// named `"WeaponFire"`, with the tuning's rumble strength and time, when the user is the local
    /// player ([`m_IsUserLocalPlayer`](Self::m_IsUserLocalPlayer)) and the strength is positive. On
    /// the dual-wield slot the gun about to fire ([`m_NextWeaponToFire`](Self::m_NextWeaponToFire))
    /// picks the motor: gun 1 drives the left motor only, and any other gun the right motor only.
    /// Called only from [`Fire_ProjectileBase`](Self::Fire_ProjectileBase), after the shot's recoil
    /// is added to [`m_RecoilPitch`](Self::m_RecoilPitch) and [`m_RecoilYaw`](Self::m_RecoilYaw)
    /// and before the gun index advances.
    #[address(0x140_951_0C0)]
    pub fn RumbleFire(&mut self);

    /// The base implementation of the
    /// [`CheckIfReloadShouldBeTriggered`](Self::CheckIfReloadShouldBeTriggered) virtual; the
    /// rocket launcher's and the sniper rifle's overrides call it. It clears `should_try_to_fire`
    /// while the holder reloads, draws, or holsters. For a player's weapon with limited
    /// ammunition and an empty magazine ([`m_MagazineAmmo`](Self::m_MagazineAmmo); a weapon whose
    /// tuning sets no magazine size counts as empty only while the holder has no stock of its
    /// ammunition), while no reload is running, it starts a reload when
    /// [`CanReload`](Self::CanReload) holds and the animation allows one, whether or not the
    /// trigger is pulled. When the weapon cannot reload and the shot was requested, it:
    ///
    /// - except for the hand grenade and the planted explosive, calls
    ///   [`Inventory::TryToSwitchToValidWeapon`](character::inventory::Inventory::TryToSwitchToValidWeapon),
    ///   the automatic switch to a weapon with ammunition;
    /// - at the pull's press edge (`was_trigger_pulled` clear) only, for the local player's weapon
    ///   and when no switch happened, calls
    ///   [`HUDUI::OnOutOfAmmoFire`](ui::hud_ui::HUDUI::OnOutOfAmmoFire) (or the grenade
    ///   counterpart for the hand grenade), and, whether or not a switch happened, activates the
    ///   gun's `OutOfAmmoFire` attached-effect usage on `weapon_data`;
    ///
    /// and in either case it clears `should_try_to_fire`, so an empty weapon never fires. The
    /// switch is tried on every tick the shot is requested, while the out-of-ammo feedback plays
    /// once per pull. It goes on to cancel a reload that should not continue, clear
    /// `should_try_to_fire` while the holder may not fire, and start a predicted reload of a
    /// partly empty magazine.
    #[address(0x140_965_CF0)]
    pub fn CheckIfReloadShouldBeTriggeredBase(&mut self, weapon_data: *mut WeaponData, should_try_to_fire: *mut bool, was_trigger_pulled: bool);

    /// The base implementation of the [`IsWeaponAiming`](Self::IsWeaponAiming) virtual.
    #[address(0x140_950_F90)]
    pub fn IsWeaponAimingBase(&self) -> bool;

    /// The base implementation of the
    /// [`UpdateFromUserPostSim_Parallel`](Self::UpdateFromUserPostSim_Parallel) virtual. It returns
    /// early, processing no input, when any gun's muzzle is within about 0.1 m of `aim_position`.
    /// After the aim target, the recoil recovery, and the fire timer, it reads
    /// [`m_NextWeaponToFire`](Self::m_NextWeaponToFire) once and walks
    /// [`m_lWeaponData`](Self::m_lWeaponData): only the gun at that index gets
    /// [`UpdateWeapon_Parallel`](Self::UpdateWeapon_Parallel), and so only that gun can start a
    /// shot this tick, while every gun gets its attached-effect update. A weapon owned by a remote
    /// peer skips the per-gun update and fires from its network component's fire flags instead.
    #[address(0x140_9A3_C50)]
    pub fn UpdateFromUserPostSim_ParallelBase(&mut self, dt: f32, aim_position: *const Vector3, input: *const WeaponInputs);

    /// The per-gun fire-input update: cools heat, reads the trigger against the tuning's
    /// sensitivities, applies semi-automatic, forced-fire, wall-penetration, and aim-angle gating,
    /// and starts or stops fire on `weapon_data`. The trigger, semi-automatic, cancel, and buffer
    /// state it keeps ([`m_IsTriggerPulled`](Self::m_IsTriggerPulled),
    /// [`m_FiredThisInput`](Self::m_FiredThisInput),
    /// [`m_IsFiringCancelled`](Self::m_IsFiringCancelled), and
    /// [`m_InputBufferTimer`](Self::m_InputBufferTimer)) and the fire interval
    /// ([`m_TimeSinceLastFire`](Self::m_TimeSinceLastFire)) are the weapon's, shared by its guns;
    /// only the burst counter ([`WeaponData::m_BurstShotsLeft`]) is the gun's. A shot it allows
    /// calls [`Fire_Start`](Self::Fire_Start) once, on `weapon_data` alone; with no shot while
    /// firing, it calls [`Fire_Stop`](Self::Fire_Stop) on every gun.
    #[address(0x140_992_B00)]
    pub fn UpdateWeapon_Parallel(&mut self, dt: f32, weapon_data: *mut WeaponData, input: *const WeaponInputs) -> bool;

    /// The base implementation of the [`Fire_Start`](Self::Fire_Start) virtual. At the first shot
    /// of a pull (the weapon not yet [`m_IsFiring`](Self::m_IsFiring)) it sets
    /// [`m_IsFirstShot`](Self::m_IsFirstShot), resets the gun's tracer counters
    /// ([`WeaponData::m_TracerCounter`]), and loads its burst
    /// ([`WeaponData::m_BurstShotsLeft`]) from the tuning. It then sets `m_IsFiring`, runs the
    /// enabled weapon components' fire start on `weapon_data`, and fires one shot from it through
    /// [`Fire_Projectile`](Self::Fire_Projectile). The mech's magnet and machine-gun weapons skip
    /// all of it under conditions on game-wide state.
    #[address(0x140_965_620)]
    pub fn Fire_StartBase(&mut self, weapon_data: *mut WeaponData);

    /// The base implementation of the [`Fire_Stop`](Self::Fire_Stop) virtual: clears
    /// [`m_IsFiring`](Self::m_IsFiring) and runs the enabled weapon components' fire stop on
    /// `weapon_data`. The disassembler mislabels it `CEffectInstance::Release`.
    #[address(0x140_965_820)]
    pub fn Fire_StopBase(&mut self, weapon_data: *mut WeaponData);

    /// The base implementation of the
    /// [`UpdateFromUserPostSim_Serial`](Self::UpdateFromUserPostSim_Serial) virtual. Like the
    /// parallel base, it reads [`m_NextWeaponToFire`](Self::m_NextWeaponToFire) once and calls
    /// [`UpdateWeapon_Serial`](Self::UpdateWeapon_Serial) only for the gun at that index, and only
    /// for a weapon owned locally.
    #[address(0x140_96E_3B0)]
    pub fn UpdateFromUserPostSim_SerialBase(&mut self, dt: f32, aim_position: *const Vector3, input: *const WeaponInputs);

    /// The serial per-gun update: runs the enabled weapon components' serial update on
    /// `weapon_data` and, for the local player's weapon, refreshes a readiness flag. It never
    /// starts or stops fire.
    #[address(0x140_965_BF0)]
    pub fn UpdateWeapon_Serial(&mut self, dt: f32, weapon_data: *mut WeaponData, input: *const WeaponInputs);

    /// Writes the start point of a projectile fired from `weapon_data` into `result` and returns
    /// it: the gun's fire point at its current fire-point cursor
    /// ([`WeaponData::m_InternalFirePositionCurrentIndex`]), composed with the gun's world matrix
    /// of the previous simulation tick ([`WeaponData::m_WorldMatrixT0`]). In the
    /// [`E_WS_WINGSUIT_WEAPON`](WeaponState::E_WS_WINGSUIT_WEAPON) state it is the translation of
    /// the gun's current world matrix instead. The projectile weapons' shots read it after
    /// [`Fire_ProjectileBase`](Self::Fire_ProjectileBase) has advanced the gun index and the
    /// cursor.
    #[address(0x140_966_B50)]
    pub fn GetLastFireFromPosition(&self, result: *mut Vector3, weapon_data: *mut WeaponData) -> *mut Vector3;

    /// The scatter a shot is given: [`m_CurrentScatterValue`](Self::m_CurrentScatterValue),
    /// multiplied by a tuning factor while the player holding the weapon is in precision aim and
    /// by another while the holder moves faster than a metre per second; zero without a holder.
    /// [`GetShotMatrix`](Self::GetShotMatrix) multiplies the tuning's yaw and pitch scatter ranges
    /// by it, unless asked to ignore the scatter.
    #[address(0x140_981_EC0)]
    pub fn GetCurrentScatterValue(&self) -> f32;

    /// Returns the tuning's aim-timer override
    /// ([`WeaponTuning::m_aim_timer_override`]), or zero without tuning.
    #[address(0x140_958_F70)]
    pub fn GetAimTimerOverride(&self) -> f32;

    /// Returns the tuning's magazine size ([`WeaponTuning::m_magazine_size`]), or zero without
    /// tuning.
    #[address(0x140_958_690)]
    pub fn GetMagazineSize(&self) -> i32;

    /// Sets every weapon-state attach bone of gun `weapon_index` to `bone` (an
    /// `NBone::ESafeBoneIndex`).
    #[address(0x140_958_AF0)]
    pub fn ChangeBoneAttachement(&mut self, bone: u32, weapon_index: i32);

    /// Sets [`WeaponData::m_SkipRenderInterpolation`] on gun `weapon_data_index`, and makes the
    /// weapon's model-attachment components for that gun skip theirs, so the gun's next
    /// attachment placement is drawn without interpolation. `-1` does so for every gun and every
    /// model-attachment component. The flag lasts until
