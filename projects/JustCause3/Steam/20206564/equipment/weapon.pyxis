    /// cursor.
    #[address(0x140_966_B50)]
    pub fn GetLastFireFromPosition(&self, result: *mut Vector3, weapon_data: *mut WeaponData) -> *mut Vector3;

    /// The scatter a shot is given: [`m_CurrentScatterValue`](Self::m_CurrentScatterValue),
    /// multiplied by a tuning factor while the player holding the weapon is in precision aim and
    /// by another while the holder moves faster than a metre per second; zero without a holder.
    /// [`GetShotMatrix`](Self::GetShotMatrix) multiplies the tuning's yaw and pitch scatter ranges
    /// by it, unless asked to ignore the scatter.
    #[address(0x140_981_EC0)]
    pub fn GetCurrentScatterValue(&self) -> f32;

    /// Returns the tuning's aim-timer override
    /// ([`WeaponTuning::m_aim_timer_override`]), or zero without tuning.
    #[address(0x140_958_F70)]
    pub fn GetAimTimerOverride(&self) -> f32;

    /// Returns the tuning's magazine size ([`WeaponTuning::m_magazine_size`]), or zero without
    /// tuning.
    #[address(0x140_958_690)]
    pub fn GetMagazineSize(&self) -> i32;

    /// Sets every weapon-state attach bone of gun `weapon_index` to `bone` (an
    /// `NBone::ESafeBoneIndex`).
    #[address(0x140_958_AF0)]
    pub fn ChangeBoneAttachement(&mut self, bone: u32, weapon_index: i32);

    /// Sets [`WeaponData::m_SkipRenderInterpolation`] on gun `weapon_data_index`, and makes the
    /// weapon's model-attachment components for that gun skip theirs, so the gun's next
    /// attachment placement is drawn without interpolation. `-1` does so for every gun and every
    /// model-attachment component. The flag lasts until
    /// [`UpdatePostFinalizePose`](Self::UpdatePostFinalizePose), so it acts on placements made
    /// before the end of the holder's pose-finalization pass. The holster and predefined-bone
    /// state tasks call it when they move a gun between bones.
    #[address(0x140_982_240)]
    pub fn SkipRenderInterpolationForOneFrame(&mut self, weapon_data_index: i32);

    /// The weapon's post-pose-finalization update, run for every inventory weapon by
    /// [`Inventory::UpdateInventoryPostFinalizePose`](character::inventory::Inventory::UpdateInventoryPostFinalizePose)
    /// at the end of the holder's pose-finalization pass. It clears every gun's
    /// [`WeaponData::m_SkipRenderInterpolation`], rewrites every gun's
    /// [`WeaponData::m_lBoneAttachementPerWeaponState`] entries for the
    /// [`E_WS_WIELDING`](WeaponState::E_WS_WIELDING) to
    /// [`E_WS_HOLSTERED_INVISIBLE`](WeaponState::E_WS_HOLSTERED_INVISIBLE) states from
    /// [`m_EquipSlot`](Self::m_EquipSlot) (the `SetupWeaponAttachementBones` table, inlined), and
    /// runs the enabled weapon components' post-finalization hook. For the
    /// [`E_SLOT_DUAL_WIELD`](WeaponSlot::E_SLOT_DUAL_WIELD) slot the table puts the first gun on
    /// [`ATTACH_HAND_RIGHT`](character::character::SafeBoneIndex::ATTACH_HAND_RIGHT) when wielding
    /// or dual-wielding and on
    /// [`RIGHT_HOLSTER`](character::character::SafeBoneIndex::RIGHT_HOLSTER) when holstered, and
    /// the second gun on
    /// [`LEFT_HOLSTER`](character::character::SafeBoneIndex::LEFT_HOLSTER) except when
    /// dual-wielding, where it rides
    /// [`ATTACH_HAND_LEFT`](character::character::SafeBoneIndex::ATTACH_HAND_LEFT); with a single
    /// gun wielded the second waits on its holster. A bone a state task moves a gun to lasts only
    /// until the end of the pass it was written in. The
    /// disassembler mislabels it `CWeaponBase::CalculateAttachOffsets`.
    #[address(0x140_9A5_010)]
    pub fn UpdatePostFinalizePose(&mut self);

    /// Returns the attach bone of gun `weapon_index` for the weapon's current
    /// [`m_State`](Self::m_State), or an invalid-bone value when the index is out of range.
    #[address(0x140_958_B30)]
    pub fn GetCurrentBoneAttachement(&self, weapon_index: i32) -> u32;

    /// The `CGameObject::GetTransform` override: copies the first gun's
    /// [`WeaponData::GetWorldMatrixT1`] into `transform`. `game_object` is the weapon's
    /// `CGameObject` subobject, not the start of the weapon.
    #[address(0x140_964_E50)]
    pub fn GetTransform(game_object: *const void, transform: *mut Matrix4) -> bool;

    /// The render-phase `CGameObject::UpdateRender` override. For each gun it interpolates
    /// [`WeaponData::m_WorldMatrixT0`] toward [`WeaponData::m_WorldMatrixT1`] by the render
    /// context's interpolation factor, applies the holstered scale when holstered, pushes the
    /// result to [`WeaponData::m_BaseModelInstance`], and updates the gun's animated-model
    /// skinning; it then renders the weapon's components, among them the separate model parts of
    /// its guns ([`ModelAttachementWeaponComponent::UpdateRender`]), which interpolate their own
    /// cached matrices. `game_object` is the weapon's `CGameObject` subobject, not the start of
    /// the weapon.
    #[address(0x140_966_380)]
    pub fn UpdateRender(game_object: *mut void, context: *const GameObjectRenderContext);
}

/// `CBulletWeaponBase`: the base of the fast-projectile weapons. Its layout is unmapped.
pub type BulletWeaponBase;
impl BulletWeaponBase {
    /// The bullet weapons' [`WeaponBase::Fire_Projectile`] override: spawns the bullet projectile
    /// and then calls [`WeaponBase::Fire_ProjectileBase`]. It is the only caller of
    /// [`NWeaponUtil::Trajectory_GetAngleToHitPosition`].
    #[address(0x140_927_550)]
    pub fn Fire_Projectile(&mut self, weapon_data: *mut WeaponData);

    /// Returns the bullet weapon's tuning (`SBulletWeaponTunings`), which selects explosive and
    /// water behaviour for its projectiles.
    #[address(0x140_914_7D0)]
    pub fn GetTuning(&self) -> *const void;
}

/// `CSniperWeapon`: a precision-aim rifle, a bullet weapon. A bolt-action rifle
/// ([`m_BoltAction`](Self::m_BoltAction)) locks after each shot
/// ([`m_HasFiredThisInput`](Self::m_HasFiredThisInput)) until the holder has cycled the bolt: the
/// rifle's per-tick update ([`UpdateFromUserPostSim_Parallel`](Self::UpdateFromUserPostSim_Parallel))
/// queues the bolt act once the trigger is released, the bolt state of the animation graph raises
/// [`SB_IS_RELOADING`](state::StateBitFlag::SB_IS_RELOADING), and the update clears the lock while
/// the holder reloads. Only some members are mapped, at their offsets from the start of the
/// weapon.
#[min_size(0x670)]
pub type SniperWeapon {
    /// Whether the rifle is a bolt action, from the weapon's `BoltAction` property.
    #[address(0x668)]
    pub m_BoltAction: bool,
    /// Whether the bolt cycle takes the local player out of precision aim and back, from the
    /// weapon's properties.
    pub m_BoltActionAutoZoomOut: bool,
    /// The bolt lock: set by [`Fire_Projectile`](Self::Fire_Projectile) after each shot of a bolt
    /// action for a player user ([`WeaponBase::m_IsUserPlayer`]), and cleared only by
    /// [`UpdateFromUserPostSim_Parallel`](Self::UpdateFromUserPostSim_Parallel) while the holder
    /// reloads ([`Character::IsReloading`](character::character::Character::IsReloading)) or has
    /// no ammunition left at all. While it is set, [`Fire_Start`](Self::Fire_Start) and
    /// [`CheckIfReloadShouldBeTriggered`](Self::CheckIfReloadShouldBeTriggered) do nothing, so
    /// the rifle neither fires nor reloads on its own.
    pub m_HasFiredThisInput: bool,
    /// Whether the bolt cycle or a reload took the local player out of precision aim, to be
    /// restored once it ends.
    pub m_ShouldgoBackToPrecisionAim: bool,
    /// The delay before the bolt cycle while the holder stays in precision aim: loaded by
    /// [`Fire_Projectile`](Self::Fire_Projectile) at each shot and counted down by the per-tick
    /// update.
    pub m_BoltActionDelayer: f32,
}
impl SniperWeapon {
    /// The [`WeaponBase::Fire_Projectile`] override: fires the bullet
    /// ([`BulletWeaponBase::Fire_Projectile`]) and then, for a bolt action with a player user,
    /// sets the bolt lock ([`m_HasFiredThisInput`](Self::m_HasFiredThisInput)) and loads
    /// [`m_BoltActionDelayer`](Self::m_BoltActionDelayer).
    #[address(0x140_950_950)]
    pub fn Fire_Projectile(&mut self, weapon_data: *mut WeaponData);

    /// The [`WeaponBase::Fire_Start`] override: does nothing while the bolt lock
    /// ([`m_HasFiredThisInput`](Self::m_HasFiredThisInput)) is set, and otherwise runs the base
    /// fire start.
    #[address(0x140_96D_490)]
    pub fn Fire_Start(&mut self, weapon_data: *mut WeaponData);

    /// The [`WeaponBase::CheckIfReloadShouldBeTriggered`] override: does nothing while the bolt
    /// lock ([`m_HasFiredThisInput`](Self::m_HasFiredThisInput)) is set, and otherwise runs
    /// [`WeaponBase::CheckIfReloadShouldBeTriggeredBase`].
    #[address(0x140_96D_4B0)]
    pub fn CheckIfReloadShouldBeTriggered(&mut self, weapon_data: *mut WeaponData, should_try_to_fire: *mut bool, was_trigger_pulled: bool);

    /// The [`WeaponBase::StartReloadSequence`] override: runs the base, and for the local player
    /// in precision aim leaves precision aim and sets
    /// [`m_ShouldgoBackToPrecisionAim`](Self::m_ShouldgoBackToPrecisionAim).
    #[address(0x140_97F_030)]
    pub fn StartReloadSequence(&mut self);

    /// The rifle's per-tick update from its user (its override of
    /// [`WeaponBase::UpdateFromUserPostSim_Parallel`]). After the base update, while the holder is
    /// not reloading and has rounds in the magazine or the reserve, a set bolt lock on a bolt
    /// action waits for the trigger to be released and, in precision aim, for
    /// [`m_BoltActionDelayer`](Self::m_BoltActionDelayer) to run out. Then, with rounds left in the
    /// magazine, it optionally leaves precision aim
    /// ([`m_BoltActionAutoZoomOut`](Self::m_BoltActionAutoZoomOut)), plays each gun's bolt-action
    /// effect, and queues the bolt act (`UB_ACT_SNIPER_BOLT_ACTION`) through
    /// [`Character::QueueAct`](character::character::Character::QueueAct), on every tick until the
    /// bolt state's [`SB_IS_RELOADING`](state::StateBitFlag::SB_IS_RELOADING) rises; with an empty
    /// magazine it calls
    /// [`Character::StartReloadingWieldingWeapon`](character::character::Character::StartReloadingWieldingWeapon)
    /// instead. With no lock it returns the player to precision aim when
    /// [`m_ShouldgoBackToPrecisionAim`](Self::m_ShouldgoBackToPrecisionAim) asks. While the holder
    /// reloads or has no ammunition at all it clears the lock.
    #[address(0x140_9A6_F20)]
    pub fn UpdateFromUserPostSim_Parallel(&mut self, dt: f32, aim_position: *const Vector3, input: *const WeaponInputs);

    /// Reads the rifle's properties after the bullet weapon's: the bolt-action and auto-zoom-out
    /// flags. `game_object` is the weapon's `CGameObject` subobject
    /// ([`WeaponBase::GAME_OBJECT_BASE_OFFSET`]), not the start of the weapon. The disassembler
    /// mislabels it `CAntiAirWeapon::SetProperties`.
    #[address(0x140_957_650)]
    pub fn SetProperties(game_object: *mut void, properties: *const void, context: *mut void);

    /// The [`WeaponBase::SetAimMode`] override: in [`AIM_PRECISION`](AimMode::AIM_PRECISION) it
    /// shows the HUD sniper overlay and hides the holder, and in
    /// [`AIM_NORMAL`](AimMode::AIM_NORMAL) it reverses both.
    #[address(0x140_97F_120)]
    pub fn SetAimMode(&mut self, aim_mode: AimMode);
}

/// Where a rocket launcher's rocket model is (`CRPGWeapon::ERocketAttachState`), stored as
/// [`RPGWeapon::m_AttachedState`].
#[copyable]
pub enum RocketAttachState: i32 {
    /// Nowhere: the launcher is empty and the rocket model hidden.
    E_ATTACHED_TO_NONE = 0x0,
    /// In the holder's hand, during a reload.
    E_ATTACHED_TO_HAND = 0x1,
    /// Loaded in the launcher. The launcher fires only in this state.
    E_ATTACHED_TO_WEAPON = 0x2,
}

/// `CRPGWeapon`: a rocket launcher, also the base of the mortar. Its loaded rocket is a model part
/// ([`m_RPGModel`](Self::m_RPGModel)) that the reload and the per-tick update show and hide by
/// [`m_AttachedState`](Self::m_AttachedState). Only some members are mapped, at their offsets
/// from the start of the weapon.
#[min_size(0x764)]
pub type RPGWeapon {
    /// The rocket model part, or null.
    #[address(0x750)]
    pub m_RPGModel: *mut ModelAttachementWeaponComponent,

    /// Whether the rocket model hides once the launcher is empty: the per-tick update hides a
    /// loaded rocket while the magazine is empty.
    #[address(0x75D)]
    pub m_RPGHideModelWhenOutOfAmmo: bool,

    /// Where the rocket model is.
    #[address(0x760)]
    pub m_AttachedState: RocketAttachState,
}
impl RPGWeapon {
    /// The [`WeaponBase::Reload`] override: runs [`WeaponBase::ReloadBase`] and, when it reloaded,
    /// puts the rocket in the launcher
    /// ([`E_ATTACHED_TO_WEAPON`](RocketAttachState::E_ATTACHED_TO_WEAPON)) when the magazine is
    /// not empty, or otherwise hides and disables the rocket model and leaves it
    /// [`E_ATTACHED_TO_NONE`](RocketAttachState::E_ATTACHED_TO_NONE).
    #[address(0x140_976_AB0)]
    pub fn Reload(&mut self) -> bool;

    /// The [`WeaponBase::Fire_Start`] override: fires through the missile weapon's fire start
    /// while the rocket is loaded, and otherwise asks the holder to reload
    /// ([`Character::StartReloadingWieldingWeapon`](character::character::Character::StartReloadingWieldingWeapon)).
    #[address(0x140_99C_B20)]
    pub fn Fire_Start(&mut self, weapon_data: *mut WeaponData);

    /// The [`WeaponBase::CheckIfReloadShouldBeTriggered`] override: for a holder that is not a
    /// player, with the launcher wielded or dual-wielded and the rocket not loaded, it asks the
    /// holder to reload; otherwise it runs
    /// [`WeaponBase::CheckIfReloadShouldBeTriggeredBase`].
    #[address(0x140_96D_3F0)]
    pub fn CheckIfReloadShouldBeTriggered(&mut self, weapon_data: *mut WeaponData, should_try_to_fire: *mut bool, was_trigger_pulled: bool);

    /// The [`WeaponBase::UpdateFromUserPostSim_Parallel`] override. After the missile weapon's
    /// update, a launcher with rounds in the magazine and the rocket not loaded shows and enables
    /// the rocket model and marks it loaded, so the rocket reappears on any refill; an empty
    /// launcher with [`m_RPGHideModelWhenOutOfAmmo`](Self::m_RPGHideModelWhenOutOfAmmo) hides
    /// its loaded rocket. A player's power-core launcher (`w210_powercore`) that runs out of
    /// ammunition without unlimited ammunition is dropped from the inventory.
    #[address(0x140_9A8_410)]
    pub fn UpdateFromUserPostSim_Parallel(&mut self, dt: f32, aim_position: *const Vector3, input: *const WeaponInputs);
}

/// `CThrownGrenadeWeapon`: the hand grenade weapon, a [`WeaponBase`] held in the grenade slot. A
/// throw primes a grenade (spawning it live and consuming one grenade), keeps it at the weapon's
/// attachment while held, and releases it through [`WeaponBase::Fire_Projectile`], which launches
/// it with [`Grenade::PropelToward`](equipment::explosive::Grenade::PropelToward). The throw
/// animation's track messages drive both steps: one raises [`m_PrimeGrenade`](Self::m_PrimeGrenade)
/// and a later one raises [`WeaponBase::m_ForceFireProjectile`]. Only some members are mapped, at
/// their offsets from the start of the weapon.
#[min_size(0x7CA)]
pub type ThrownGrenadeWeapon {
    /// The primed grenade: the live [`Grenade`](equipment::explosive::Grenade) spawned by
    /// [`PrimeGrenade`](Self::PrimeGrenade) and not yet thrown, or null. `px` is the grenade's
    /// `CGameObject` subobject
    /// ([`Explosive::GAME_OBJECT_BASE_OFFSET`](equipment::explosive::Explosive::GAME_OBJECT_BASE_OFFSET)).
    /// [`Fire_Projectile`](WeaponBase::Fire_Projectile) clears it when it launches the grenade.
    #[address(0x708)]
    pub m_PrimedGrenade: WeakPtrGameObject,

    /// A pending prime request: [`UpdateFromUserPostSim_Parallel`](Self::UpdateFromUserPostSim_Parallel)
    /// calls [`PrimeGrenade`](Self::PrimeGrenade) after the base weapon update when it is set, and
    /// clears it.
    #[address(0x7C9)]
    pub m_PrimeGrenade: bool,
}
impl ThrownGrenadeWeapon {
    /// The weapon's per-tick update from its user (its override of
    /// [`WeaponBase::UpdateFromUserPostSim_Parallel`]): runs
    /// [`UpdateFromUserPostSim_ParallelBase`](WeaponBase::UpdateFromUserPostSim_ParallelBase),
    /// which consumes [`WeaponBase::m_ForceFireProjectile`] among the fire inputs, and then services
    /// [`m_PrimeGrenade`](Self::m_PrimeGrenade). A throw released and a prime requested in the same
    /// call therefore release nothing and prime afterwards.
    #[address(0x140_9A7_770)]
    pub fn UpdateFromUserPostSim_Parallel(&mut self, dt: f32, aim_position: *const Vector3, input: *const WeaponInputs);

    /// Primes a grenade (`CreatePrimed<CGrenade>`): consumes one grenade, allocates a
    /// [`Grenade`](equipment::explosive::Grenade) from the ammunition pool at the weapon's world
    /// matrix (returning null when the pool is full), plays the priming effect, stores it in
    /// [`m_PrimedGrenade`](Self::m_PrimedGrenade), and adds it to the update. The grenade's
    /// detonation timer runs from this point
    /// ([`Explosive::m_DetonationTimer`](equipment::explosive::Explosive::m_DetonationTimer)), so a
    /// grenade held for longer than its fuse explodes before it is thrown.
    #[address(0x140_989_470)]
    pub fn PrimeGrenade(&mut self, weapon_data: *mut WeaponData) -> *mut void;

    /// Removes the primed grenade, if any, clears [`m_PrimedGrenade`](Self::m_PrimedGrenade), and
    /// returns one grenade to the user's inventory. The disassembler mislabels it
    /// `rtti_cast<CThrownGrenadeWeapon,CWeaponBase>`; the function it labels
    /// `CThrownGrenadeWeapon::CancelPrimedGrenade` clears a hash table.
    #[address(0x140_97F_A50)]
    pub fn CancelPrimedGrenade(&mut self);

    /// Places the weapon's attachments (its override of the `UpdateAttachmentTransforms` virtual):
    /// after the base placement it sets the primed grenade's transform to the weapon's world
    /// matrix, so a held grenade rides the weapon's attach bone.
    #[address(0x140_99E_B70)]
    pub fn UpdateAttachmentTransforms(&mut self, p2: f32, p3: f32, transform_type: u32);
}

/// `CPlantedExplosiveWeapon`: the C4 weapon, a [`WeaponBase`] held in the
/// [`E_SLOT_PLANTED_EXPLOSIVE`](character::inventory::WeaponSlot::E_SLOT_PLANTED_EXPLOSIVE) slot.
/// It owns the charges the character has placed and their remote detonation.
///
/// Placing a charge runs through the planting mode, which equipping the weapon enters
/// ([`m_IsInPlantingMode`](Self::m_IsInPlantingMode)): an animation track message primes a charge
/// into [`m_PrimedExplosive`](Self::m_PrimedExplosive) with
/// [`PrimeExplosive`](Self::PrimeExplosive), the fire input places it at the aimed surface
/// (`CPlantedExplosive::PlaceExplosiveAtPosition`, outside a parachute) and queues the throw act,
/// and a later track message calls [`Fire_Projectile`](Self::Fire_Projectile), which makes the
/// charge live. The weapon refuses to place a charge once
/// [`NumActiveExplosives`](Self::NumActiveExplosives) reaches
/// [`MaxActiveExplosives`](Self::MaxActiveExplosives); placed charges do not consume an inventory
/// stock.
///
/// Detonation does not need the planting mode: the inventory runs the weapon's
/// [`UpdateFromUserPostSim_Serial`](Self::UpdateFromUserPostSim_Serial) every frame whatever is
/// wielded, and it starts a detonation from the character's detonate input. Only some members
/// are mapped, at their offsets from the start of the weapon.
#[min_size(0x80D)]
pub type PlantedExplosiveWeapon {
    /// The primed charge: the live [`PlantedExplosive`](equipment::explosive::PlantedExplosive)
    /// spawned by [`PrimeExplosive`](Self::PrimeExplosive) and not yet placed, or null. `px` is
    /// the charge's `CGameObject` subobject
    /// ([`Explosive::GAME_OBJECT_BASE_OFFSET`](equipment::explosive::Explosive::GAME_OBJECT_BASE_OFFSET)).
    /// [`Fire_Projectile`](Self::Fire_Projectile) moves it to
    /// [`m_LastPlantedExplosive`](Self::m_LastPlantedExplosive) and clears it;
    /// [`DespawnPrimedExplosive`](Self::DespawnPrimedExplosive) removes the charge and clears it.
    #[address(0x738)]
    pub m_PrimedExplosive: WeakPtrGameObject,

    /// The charge [`Fire_Projectile`](Self::Fire_Projectile) made live most recently.
    #[address(0x748)]
    pub m_LastPlantedExplosive: WeakPtrGameObject,

    /// The most charges that may be live at once, at each explosives-capacity upgrade level;
    /// [`MaxActiveExplosives`](Self::MaxActiveExplosives) picks the entry for the player's
    /// upgrades.
    #[address(0x758)]
    pub m_MaxActiveExplosivesAtLevel: [i32; 3],

    /// Whether the weapon is in the planting mode: set when the weapon is equipped, and cleared by
    /// the weapon's `StopUsing`, which also despawns a primed charge.
    #[address(0x808)]
    pub m_IsInPlantingMode: bool,

    /// Set when [`UpdateFromUserPostSim_Serial`](Self::UpdateFromUserPostSim_Serial) starts a
    /// detonation, and cleared by it once the character's detonate input
    /// ([`E_INPUT_DETONATE_EXPLOSIVES`](character::character::WeaponInput::E_INPUT_DETONATE_EXPLOSIVES))
    /// is zero, so a held input detonates once.
    #[address(0x80B)]
    pub m_AlreadyDetonatedOnThisInput: bool,
}
impl PlantedExplosiveWeapon {
    /// The weapon's serial per-frame update from its user (its override of
    /// [`WeaponBase::UpdateFromUserPostSim_Serial`]). The inventory runs it for the planted
    /// explosive slot's weapon every frame, wielded or not
    /// ([`Inventory::UpdateWeapons_Serial`](character::inventory::Inventory::UpdateWeapons_Serial)).
    ///
    /// Among the rest, it reads the holder's detonate input
    /// ([`Character::m_WeaponInputs`](character::character::Character::m_WeaponInputs) at
    /// [`E_INPUT_DETONATE_EXPLOSIVES`](character::character::WeaponInput::E_INPUT_DETONATE_EXPLOSIVES))
    /// directly rather than through `input`. While the input is positive, the inventory allows
    /// triggering explosives
    /// ([`Inventory::GetAnimationAllowsTriggeringExplosives`](character::inventory::Inventory::GetAnimationAllowsTriggeringExplosives)),
    /// the character is not already detonating
    /// ([`Character::IsDetonatingExplosives`](character::character::Character::IsDetonatingExplosives)),
    /// and [`m_AlreadyDetonatedOnThisInput`](Self::m_AlreadyDetonatedOnThisInput) is clear, it
    /// queues the upper-body detonate act when the character can take it (cancelling a reload when
    /// it cannot), adds heat when charges are live, and sets
    /// [`m_AlreadyDetonatedOnThisInput`](Self::m_AlreadyDetonatedOnThisInput). The act's animation
    /// sends the track message that schedules the live charges for detonation. Outside the
    /// planting mode it neither primes nor despawns a charge.
    #[address(0x140_98E_BE0)]
    pub fn UpdateFromUserPostSim_Serial(&mut self, dt: f32, aim_position: *const Vector3, input: *const WeaponInputs);

    /// Primes a charge: puts the weapon in the
    /// [`E_WS_WIELDING`](WeaponState::E_WS_WIELDING) state when it is not (adding its models to
    /// the world) and hides it, then allocates a
    /// [`PlantedExplosive`](equipment::explosive::PlantedExplosive) from the ammunition pool at
    /// the weapon's shot matrix ([`WeaponBase::GetShotMatrix`]), sets up its trail effect, adds it
    /// to the update, and stores it in [`m_PrimedExplosive`](Self::m_PrimedExplosive). Nothing is
    /// spawned when the shot matrix is unavailable or the pool is full. It consumes nothing and
    /// does not check the planting mode; the planting mode's track message is its caller.
    #[address(0x140_990_A40)]
    pub fn PrimeExplosive(&mut self, weapon_data: *mut WeaponData);

    /// Makes the primed charge live (its override of [`WeaponBase::Fire_Projectile`]). A charge
    /// whose parent is a vehicle with an active bavarium shield is removed instead. Otherwise it
    /// calls [`PlantedExplosive::Activate`](equipment::explosive::PlantedExplosive::Activate); under
    /// a deployed parachute ([`Character::IsUsingParachute`](character::character::Character::IsUsingParachute))
    /// it also moves the charge to the right-hand bone (the transform setter and
    /// [`Explosive::SetPhysicsTransform`](equipment::explosive::Explosive::SetPhysicsTransform)),
    /// drops it ([`PlantedExplosive::DropExplosive`](equipment::explosive::PlantedExplosive::DropExplosive)),
    /// gives it the character's
    /// [`m_MeasuredWorldVelocity`](character::character::Character::m_MeasuredWorldVelocity) with
    /// one metre per second downward ([`PlantedExplosive::SetVelocity`](equipment::explosive::PlantedExplosive::SetVelocity)),
    /// and plays its trail ([`Explosive::PlayTrailEffect`](equipment::explosive::Explosive::PlayTrailEffect)).
    /// It then adds heat, runs [`Fire_ProjectileBase`](WeaponBase::Fire_ProjectileBase), adds the
    /// charge to the live list (which the charge's detonation timer and HUD hint come from, and
    /// which ignores a charge beyond [`MaxActiveExplosives`](Self::MaxActiveExplosives)), adds it
    /// to the update, and moves [`m_PrimedExplosive`](Self::m_PrimedExplosive) to
    /// [`m_LastPlantedExplosive`](Self::m_LastPlantedExplosive).
    #[address(0x140_9A0_1E0)]
    pub fn Fire_Projectile(&mut self, weapon_data: *mut WeaponData);

    /// Removes the primed charge, if any, and clears
    /// [`m_PrimedExplosive`](Self::m_PrimedExplosive).
    #[address(0x140_980_EA0)]
    pub fn DespawnPrimedExplosive(&mut self);

    /// Places the weapon's attachments (its override of the `UpdateAttachmentTransforms` virtual):
    /// after the base placement, while the weapon has a user, it puts the primed charge's
    /// in-hand model on the user's right-hand bone
    /// ([`PlantedExplosive::SetInactiveModelMatrix`](equipment::explosive::PlantedExplosive::SetInactiveModelMatrix)).
    /// The inventory's attachment pass calls it for every slot weapon
    /// ([`Inventory::UpdateAttachmentTransforms`](character::inventory::Inventory::UpdateAttachmentTransforms)).
    #[address(0x140_99F_F80)]
    pub fn UpdateAttachmentTransforms(&mut self, p2: f32, p3: f32, transform_type: u32);

    /// How many placed charges are live.
    #[address(0x140_957_F10)]
    pub fn NumActiveExplosives(&self) -> i32;

    /// The most charges that may be live at once: for the player, the entry of
    /// [`m_MaxActiveExplosivesAtLevel`](Self::m_MaxActiveExplosivesAtLevel) for the highest
    /// explosives-capacity upgrade bought and enabled; for any other holder, the first entry.
    #[address(0x140_980_F70)]
    pub fn MaxActiveExplosives(&self) -> i32;

    /// Whether another charge may be placed:
    /// [`NumActiveExplosives`](Self::NumActiveExplosives) is below
    /// [`MaxActiveExplosives`](Self::MaxActiveExplosives).
    #[address(0x140_990_2D0)]
    pub fn CanPlantExplosive(&self) -> bool;
}

/// The weapon ballistics helpers (`NWeaponUtil`).
pub type NWeaponUtil;
impl NWeaponUtil {
    /// Solves the launch pitch that carries a projectile of speed `velocity` from `start_pos` to
    /// `end_pos` under `gravity_factor` times world gravity, writing the high and low solutions.
    /// Returns whether a solution exists. Only the bullet weapons' fire path calls it.
    #[address(0x140_959_D70)]
    pub fn Trajectory_GetAngleToHitPosition(start_pos: *const Vector3, end_pos: *const Vector3, velocity: f32, high_angle: *mut f32, low_angle: *mut f32, gravity_factor: f32) -> bool;

    /// Solves the launch velocity that carries a projectile from `start_pos` to `end_pos` in
    /// `time` seconds under `gravity_factor` times world gravity.
    #[address(0x140_959_E90)]
    pub fn Trajectory_GetVelocityToHitPosition(result: *mut Vector3, start_pos: *const Vector3, end_pos: *const Vector3, time: f32, gravity_factor: f32) -> *mut Vector3;
}

/// The animation-graph condition `C_IS_TRYING_TO_FIRE` (`CWeapoIsTryingToFireCondition`, the name
/// is misspelt in the game). Its layout is unmapped.
pub type WeapoIsTryingToFireCondition;
impl WeapoIsTryingToFireCondition {
    /// Evaluates the condition for the character owning `instance` (a
    /// `NAnimationSystem::CStateMachineInstance`). True when the character holds a selected weapon
    /// in a wielding, dual-wielding, or mounted state (or is planting an explosive) and a fire input
    /// is present that the animation allows: the fire input with shooting allowed, the
    /// precision-aim input with precision aim possible and allowed, or the plant input while
    /// planting.
    #[address(0x140_7F3_FF0)]
    pub fn Evaluate(&self, instance: *const void) -> bool;
}

/// `CWallPenetrationWeaponComponent`: the weapon component that detects a held weapon's barrel
/// penetrating a wall or a character. Only the owner is bound.
#[min_size(0xD8)]
pub type WallPenetrationWeaponComponent {
    /// The weapon the component belongs to (`CWeaponComponentBase::m_Owner`).
    #[address(0xD0)]
    pub m_Owner: *mut WeaponBase,
}
impl WallPenetrationWeaponComponent {
    /// The component's serial weapon update. It acts only while the owner's
    /// [`m_State`](WeaponBase::m_State) is [`E_WS_WIELDING`](WeaponState::E_WS_WIELDING) or
    /// [`E_WS_DUAL_WIELDING`](WeaponState::E_WS_DUAL_WIELDING) and the owner is used by a player,
    /// and it is the only writer of the owner's
    /// [`m_IsWeaponPenetratingWallIfInAim`](WeaponBase::m_IsWeaponPenetratingWallIfInAim),
    /// [`m_IsWeaponPenetratingCharacterIfInAim`](WeaponBase::m_IsWeaponPenetratingCharacterIfInAim),
    /// and [`m_IsLeanOverFirePossible`](WeaponBase::m_IsLeanOverFirePossible). While the holder
    /// is reeled in, drawing, holstering, or switching weapons, or is in a full-body pickup, it
    /// clears both penetration flags and sets the lean-over and
    /// [`m_AimingWeaponIsPossible`](WeaponBase::m_AimingWeaponIsPossible) flags. Otherwise it
    /// collides a box, built from the holder's shoulders or hips toward the barrel, against the
    /// world. A character hit sets the character flag and clears the wall flag. A world hit sets
    /// the wall flag, clears lean-over, and clears `m_AimingWeaponIsPossible` unless the component
    /// allows aiming while penetrating (`m_CanAimWhenPenetrating`). A clear result lasting long
    /// enough clears both penetration flags and sets lean-over and `m_AimingWeaponIsPossible`
    /// again. The box follows the holder's animated pose, not the weapon's own transform.
    #[address(0x140_92F_930)]
    pub fn UpdateWeapon_Serial(&mut self, dt: f32, weapon_data: *mut WeaponData, p3: f32);
}

/// `CWeaponComponentBase`: the base of a weapon's components, the entries of
/// [`WeaponBase::m_WeaponComponents`]. A component is a `CGameObject` of its own, so its run-time
/// type test is the game object's. Only some members are mapped, at their offsets from the start
/// of the component; the derived component types repeat the ones they use.
#[min_size(0xF8)]
pub type WeaponComponentBase {
    vftable {
        /// `CRtti::IsType`: whether the component is of the class `type_id` names or derives from
        /// it, as for [`GameObject::IsType`](game::GameObject::IsType). The weapon code tests a
        /// component against [`ModelAttachementWeaponComponent::TYPE_ID`] before treating it as a
        /// model part, and that test also accepts the barrel recoil and barrel spin parts.
        #[index(2)]
        pub fn IsType(&self, type_id: *const u32) -> bool;

        /// Enables or disables the component, storing [`m_Enabled`](Self::m_Enabled). The
        /// model-attachment component's override also shows or hides its model part through
        /// [`SetVisible`](Self::SetVisible) when the value changes, so on a model part it is the
        /// show and hide.
        #[index(38)]
        pub fn Enable(&mut self, enable: bool);

        /// Shows or hides the component's models.
        #[index(55)]
        pub fn SetVisible(&mut self, visible: bool, p2: bool);
    },

    /// The weapon the component belongs to.
    #[address(0xD0)]
    pub m_Owner: *mut WeaponBase,

    /// The component's kind.
    #[address(0xD8)]
    pub m_Type: WeaponComponentType,

    /// Whether the component is enabled, written by [`Enable`](Self::Enable). The weapon runs the
    /// per-shot, per-update, and post-finalization hooks of enabled components only.
    #[address(0xF0)]
    pub m_Enabled: bool,
}

/// `CModelAttachementWeaponComponent`: a weapon component that draws a separate model part of a
/// gun, such as a magazine, at a fixed offset from the gun or on one of the holder's bones. The
/// barrel recoil and barrel spin components (`CBarrelRecoilWeaponComponent`,
/// `CBarrelSpinWeaponComponent`) derive from it: their attachment placement runs this one's and
/// then moves the part, and their vtables share its render update.
///
/// The part keeps its own pair of cached world matrices, like a gun's
/// ([`WeaponData::m_WorldMatrixT0`] and [`WeaponData::m_WorldMatrixT1`]):
/// [`UpdateAttachmentTransforms`](Self::UpdateAttachmentTransforms) places it in the simulation,
/// and [`UpdateRender`](Self::UpdateRender) interpolates between the two and pushes the result to
/// its own model instance. Only some members are mapped, at their offsets from the start of the
/// component.
#[min_size(0x1D8)]
pub type ModelAttachementWeaponComponent {
    /// The value of [`m_CharacterBone`](Self::m_CharacterBone) while the part rides its gun rather
    /// than a bone of the holder.
    pub const NO_CHARACTER_BONE: u32 = 0xFFFFFFFF,
    /// The [`m_NameHash`](Self::m_NameHash) of the `model.magazine` part, a gun's separate
    /// magazine model: the hash of the name. The reload clips' throw-away-magazine and
    /// enable-model messages carry it; the weapon code does not.
    pub const MAGAZINE_NAME_HASH: u32 = 0x7E812228,
    /// The [`m_NameHash`](Self::m_NameHash) of the `model.rpg` part, the rocket model of a rocket
    /// launcher and the shell of the mortar: the hash of the name.
    pub const RPG_NAME_HASH: u32 = 0xCF24E6D7,
    /// The [`m_NameHash`](Self::m_NameHash) of the `model.rocket_pod` part, the Hydra's rocket
    /// pod: the hash of the name.
    pub const ROCKET_POD_NAME_HASH: u32 = 0xEE450BB2,
    /// The [`m_NameHash`](Self::m_NameHash) of the UPU-210's `model.cartridge_full` part: the
    /// hash of the name.
    pub const CARTRIDGE_FULL_NAME_HASH: u32 = 0xB6BDC1C1,
    /// The [`m_NameHash`](Self::m_NameHash) of the UPU-210's `model.cartridge_empty` part: the
    /// hash of the name.
    pub const CARTRIDGE_EMPTY_NAME_HASH: u32 = 0x32F0D47D,
    /// The class's vtable, the value of the vtable pointer of a component of exactly this class.
    /// A barrel recoil part carries [`BarrelRecoilWeaponComponent::VFTABLE`] and a barrel spin
    /// part [`BarrelSpinWeaponComponent::VFTABLE`] instead.
    pub const VFTABLE: u64 = 0x1423E20E8,

    vftable {
        /// The component base's [`IsType`](WeaponComponentBase::IsType).
        #[index(2)]
        pub fn IsType(&self, type_id: *const u32) -> bool;

        /// Enables or disables the part: stores [`m_Enabled`](Self::m_Enabled) and, when the
        /// value changes, shows or hides the part's model through
        /// [`SetVisible`](Self::SetVisible). [`WeaponData::ThrowAwayMagazineObject`] hides the
        /// magazine part with it, and the
        /// [`TRACK_MESSAGE_ENABLE_MODEL_ATTACHEMENT`](WeaponBase::TRACK_MESSAGE_ENABLE_MODEL_ATTACHEMENT)
        /// message shows it again.
        #[index(38)]
        pub fn Enable(&mut self, enable: bool);

        /// Shows or hides the part's model.
        #[index(55)]
        pub fn SetVisible(&mut self, visible: bool, p2: bool);
    },

    /// The weapon the component belongs to (`CWeaponComponentBase::m_Owner`).
    #[address(0xD0)]
    pub m_Owner: *mut WeaponBase,

    /// The component's kind (`CWeaponComponentBase::m_Type`):
    /// [`E_WEAPON_COMPONENT_MODEL_ATTACHEMENT`](WeaponComponentType::E_WEAPON_COMPONENT_MODEL_ATTACHEMENT)
    /// for this class, and the derived kind for the barrel recoil and barrel spin parts.
    #[address(0xD8)]
    pub m_Type: WeaponComponentType,

    /// Whether the part is enabled (`CWeaponComponentBase::m_Enabled`), and so shown; written by
    /// [`Enable`](Self::Enable).
    #[address(0xF0)]
    pub m_Enabled: bool,

    /// The index into the owner's [`m_lWeaponData`](WeaponBase::m_lWeaponData) of the gun the part
    /// belongs to.
    #[address(0xF8)]
    pub m_WeaponDataIndex: u32,

    /// The hash of the part's name (such as [`MAGAZINE_NAME_HASH`](Self::MAGAZINE_NAME_HASH)),
    /// from the component's properties. The magazine drop and the enable-model message find a
    /// part by it.
    #[address(0xFC)]
    pub m_NameHash: u32,

    /// Whether the next placement skips the render interpolation: when set,
    /// [`UpdateAttachmentTransforms`](Self::UpdateAttachmentTransforms) copies
    /// [`m_WorldMatrix`](Self::m_WorldMatrix) into
    /// [`m_WorldMatrixSaved`](Self::m_WorldMatrixSaved) as well. Set through
    /// [`WeaponBase::SkipRenderInterpolationForOneFrame`] and cleared by
    /// [`UpdatePostFinalizePose`](Self::UpdatePostFinalizePose).
    #[address(0x100)]
    pub m_SkipRenderInterpolation: bool,

    /// The snow cover written by the attachment placement, which the render update hands the
    /// model's environmental metadata.
    #[address(0x104)]
    pub m_SnowFactor: f32,
    /// The wetness written by the attachment placement, which the render update hands the model's
    /// environmental metadata while the snow cover is zero.
    pub m_WaterFactor: f32,

    /// The holder's bone (an `NBone::ESafeBoneIndex`) the part rides instead of its gun, or
    /// [`NO_CHARACTER_BONE`](Self::NO_CHARACTER_BONE). Set by
    /// [`AttachToCharacterBone`](Self::AttachToCharacterBone), which the animation's
    /// model-attachment bone task (`NWeaponModelAttachementSetBoneTask`) calls inside the holder's
    /// pose-finalization pass, and reset by
    /// [`UpdatePostFinalizePose`](Self::UpdatePostFinalizePose) at the end of that pass, so it is
    /// set only between the task and the end of the pass that placed the part.
    #[address(0x10C)]
    pub m_CharacterBone: u32,

    /// The part's transform relative to its gun.
    #[address(0x110)]
    pub m_Offset: Matrix4,

    /// The part's world matrix as of the current placement:
    /// [`m_Offset`](Self::m_Offset) composed with the gun's
    /// [`GetWorldMatrixT1`](WeaponData::GetWorldMatrixT1) and orthonormalized, or the holder's bone
    /// while [`m_CharacterBone`](Self::m_CharacterBone) names one.
    #[address(0x150)]
    pub m_WorldMatrix: Matrix4,

    /// The part's world matrix as of the previous placement, which the render update interpolates
    /// from toward [`m_WorldMatrix`](Self::m_WorldMatrix).
    #[address(0x190)]
    pub m_WorldMatrixSaved: Matrix4,

    /// The part's model instance, or null.
    #[address(0x1D0)]
    pub m_BaseModelInstance: *mut ModelInstance,
}
impl ModelAttachementWeaponComponent {
    /// `CModelAttachementWeaponComponent::TYPE_ID`: the run-time type id of the class, for
    /// [`IsType`](WeaponComponentBase::IsType). Registers it on first use.
    #[address(0x140_851_310)]
    pub fn TYPE_ID() -> *const u32;

    /// Places the part (the component's override of the `UpdateAttachmentTransforms` weapon
    /// component virtual, which the weapon's attachment placement calls for each component). It
    /// stores `snow_factor` and `water_factor`; for the advancing placement (`transform_type` 2)
    /// it first copies [`m_WorldMatrix`](Self::m_WorldMatrix) into
    /// [`m_WorldMatrixSaved`](Self::m_WorldMatrixSaved). It then writes
    /// [`m_WorldMatrix`](Self::m_WorldMatrix) from the gun's world matrix and
    /// [`m_Offset`](Self::m_Offset), or from the holder's bone while
    /// [`m_CharacterBone`](Self::m_CharacterBone) names one. While
    /// [`m_SkipRenderInterpolation`](Self::m_SkipRenderInterpolation) is set, and for the initial
    /// placement (`transform_type` 0), it copies the new matrix into
    /// [`m_WorldMatrixSaved`](Self::m_WorldMatrixSaved) as well.
    #[address(0x140_92E_B80)]
    pub fn UpdateAttachmentTransforms(&mut self, snow_factor: f32, water_factor: f32, transform_type: u32);

    /// The render-phase update (the `CGameObject::UpdateRender` virtual), called for each of a
    /// weapon's components from the weapon's render update ([`WeaponBase::UpdateRender`]). It
    /// interpolates [`m_WorldMatrixSaved`](Self::m_WorldMatrixSaved) toward
    /// [`m_WorldMatrix`](Self::m_WorldMatrix) by the render context's interpolation factor (the
    /// engine's `CTransform::Lerp`), scales the result by the gun's holstered scale while the
    /// owner is [`E_WS_HOLSTERED`](WeaponState::E_WS_HOLSTERED), pushes it to
    /// [`m_BaseModelInstance`](Self::m_BaseModelInstance) with
    /// [`ModelInstance::UpdateMatrix`](graphics_engine::model_instance::ModelInstance::UpdateMatrix),
    /// and hands the model the snow and wetness. The disassembler mislabels it
    /// `NInteractionGraphExitTasks::NAnimationDrivenOnlyMotion::Update`, and puts this function's
    /// name on a function that reads a gun's ([`WeaponData`]) fields instead.
    #[address(0x140_8E0_9F0)]
    pub fn UpdateRender(&mut self, context: *const GameObjectRenderContext);

    /// Rides the part on the holder's bone `bone` (an `NBone::ESafeBoneIndex`) for the rest of the
    /// pose-finalization pass: sets [`m_CharacterBone`](Self::m_CharacterBone).
    #[address(0x140_8BF_DA0)]
    pub fn AttachToCharacterBone(&mut self, bone: u32);

    /// The component's post-pose-finalization hook, run from [`WeaponBase::UpdatePostFinalizePose`]
    /// for an enabled component: clears [`m_SkipRenderInterpolation`](Self::m_SkipRenderInterpolation)
    /// and resets [`m_CharacterBone`](Self::m_CharacterBone) to
    /// [`NO_CHARACTER_BONE`](Self::NO_CHARACTER_BONE). The disassembler leaves it unnamed.
    #[address(0x140_8BF_D80)]
    pub fn UpdatePostFinalizePose(&mut self);
}

/// `CBarrelRecoilWeaponComponent`: a model part that recoils with each shot, such as a pistol's
/// slide or a rifle's ejection port. It is a [`ModelAttachementWeaponComponent`] (its kind is
/// [`E_WEAPON_COMPONENT_BARREL_RECOIL`](WeaponComponentType::E_WEAPON_COMPONENT_BARREL_RECOIL)
/// and it passes the model-attachment type test), so the same pointer reads as one; only the
/// members it adds are mapped here, at their offsets from the start of the component.
#[min_size(0x1E9)]
pub type BarrelRecoilWeaponComponent {
    /// The class's vtable, the value of the vtable pointer of a barrel recoil part. A consumer
    /// holding a model part can tell a barrel recoil part by it, or by
    /// [`m_Type`](ModelAttachementWeaponComponent::m_Type).
    pub const VFTABLE: u64 = 0x1423E5C08,

    /// The fire point of the gun ([`WeaponData::m_InternalFirePositions`]) whose time since its
    /// last shot drives the recoil.
    #[address(0x1D8)]
    pub m_InternalFirePositionIndex: i32,
    /// The recoil travel, in metres, along the part's own forward axis.
    pub m_RecoilMaxLength: f32,
    /// The seconds the part takes to travel back after a shot.
    pub m_RecoilFireTime: f32,
    /// The seconds the part takes to return after travelling back.
    pub m_RecoilRecoverTime: f32,
    /// Whether the part stays fully back while the magazine is empty (a slide that locks back),
    /// for a player's wielded or dual-wielded weapon.
    pub m_MaxRecoilOnEmptyAmmo: bool,
}
impl BarrelRecoilWeaponComponent {
    /// `CBarrelRecoilWeaponComponent::TYPE_ID`: the run-time type id of the class, for
    /// [`IsType`](WeaponComponentBase::IsType). Registers it on first use.
    #[address(0x140_913_270)]
    pub fn TYPE_ID() -> *const u32;

    /// Places the part (its override of the weapon component's attachment placement): runs
    /// [`ModelAttachementWeaponComponent::UpdateAttachmentTransforms`], then moves
    /// [`m_WorldMatrix`](ModelAttachementWeaponComponent::m_WorldMatrix) along the part's own
    /// forward axis by a fraction of [`m_RecoilMaxLength`](Self::m_RecoilMaxLength). The fraction
    /// comes from the time since the fire point
    /// [`m_InternalFirePositionIndex`](Self::m_InternalFirePositionIndex) last fired: it rises to
    /// full over [`m_RecoilFireTime`](Self::m_RecoilFireTime) and falls back over
    /// [`m_RecoilRecoverTime`](Self::m_RecoilRecoverTime). With
    /// [`m_MaxRecoilOnEmptyAmmo`](Self::m_MaxRecoilOnEmptyAmmo), for a player's wielded or
    /// dual-wielded weapon, it is full while the magazine is empty, and on a multi-gun weapon also
    /// on the gun that will not fire the last round. It refreshes the saved matrix as the base
    /// does.
    #[address(0x140_93E_060)]
    pub fn UpdateAttachmentTransforms(&mut self, snow_factor: f32, water_factor: f32, transform_type: u32);
}

/// `CBarrelSpinWeaponComponent`: a model part that spins while the weapon fires, such as a
/// machine gun's barrel or ammunition belt. It is a [`ModelAttachementWeaponComponent`] (its
/// kind is [`E_WEAPON_COMPONENT_BARREL_SPIN`](WeaponComponentType::E_WEAPON_COMPONENT_BARREL_SPIN)
/// and it passes the model-attachment type test). Its own members are unmapped.
pub type BarrelSpinWeaponComponent {
    /// The class's vtable, the value of the vtable pointer of a barrel spin part.
    pub const VFTABLE: u64 = 0x1423E5E38,
}
impl BarrelSpinWeaponComponent {
    /// `CBarrelSpinWeaponComponent::TYPE_ID`: the run-time type id of the class, for
    /// [`IsType`](WeaponComponentBase::IsType). Registers it on first use.
    #[address(0x140_913_350)]
    pub fn TYPE_ID() -> *const u32;
}

/// `CDoActWeaponComponent`: a weapon component that plays an act when its weapon starts or stops
/// firing or is equipped, such as the pump shotgun's pump. Each act goes to the component's
/// skeletal object when it has one; otherwise, with
/// [`m_SendActToWeapon`](Self::m_SendActToWeapon), to every gun's own animated model
/// ([`WeaponData::DoAct`]); otherwise to the holder
/// ([`Character::QueueAct`](character::character::Character::QueueAct)). The acts are queued and
/// gate nothing: no state of the act blocks the weapon's next shot. Only some members are mapped,
/// at their offsets from the start of the component.
#[min_size(0x10C)]
pub type DoActWeaponComponent {
    /// The [`m_WeaponDataIndex`](Self::m_WeaponDataIndex) that matches every gun.
    pub const ANY_WEAPON_DATA_INDEX: i32 = -1,

    /// The weapon the component belongs to (`CWeaponComponentBase::m_Owner`).
    #[address(0xD0)]
    pub m_Owner: *mut WeaponBase,

    /// Whether the component is enabled (`CWeaponComponentBase::m_Enabled`). The weapon calls the
    /// fire hooks of enabled components only.
    #[address(0xF0)]
    pub m_Enabled: bool,

    /// The act (an event id) played at fire start, from the component's properties.
    #[address(0xF8)]
    pub m_FireStartAct: u32,
    /// The act played at fire stop.
    pub m_FireStopAct: u32,
    /// The act played when the weapon is equipped.
    pub m_EquipAct: u32,
    /// The gun whose fire plays the acts, or
    /// [`ANY_WEAPON_DATA_INDEX`](Self::ANY_WEAPON_DATA_INDEX).
    pub m_WeaponDataIndex: i32,
    /// Whether the fire acts play only when the gun's fire-point cursor
    /// ([`WeaponData::m_InternalFirePositionCurrentIndex`]) is even.
    pub m_ActivateOnEvenInternalFirePoint: bool,
    /// Whether the fire acts play only when the gun's fire-point cursor is odd.
    pub m_ActivateOnOddInternalFirePoint: bool,
    /// Whether the acts go to the guns' own animated models rather than the holder.
    pub m_SendActToWeapon: bool,
    /// Whether the fire acts play only while the owner's magazine holds more than the round being
    /// fired.
    pub m_OnlyIfAmmoLeft: bool,
}
impl DoActWeaponComponent {
    /// `CDoActWeaponComponent::TYPE_ID`: the run-time type id of the class, for
    /// [`IsType`](WeaponComponentBase::IsType). Registers it on first use.
    #[address(0x140_913_620)]
    pub fn TYPE_ID() -> *const u32;

    /// Plays [`m_FireStartAct`](Self::m_FireStartAct) when
    /// [`ShouldActActivate`](Self::ShouldActActivate) allows it for `weapon_data` (the component's
    /// fire-start virtual, which [`WeaponBase::Fire_StartBase`] calls for each shot).
    #[address(0x140_928_A30)]
    pub fn Fire_Start(&mut self, weapon_data: *mut WeaponData);

    /// Plays [`m_FireStopAct`](Self::m_FireStopAct) when
    /// [`ShouldActActivate`](Self::ShouldActActivate) allows it for `weapon_data` (the component's
    /// fire-stop virtual).
    #[address(0x140_928_BF0)]
    pub fn Fire_Stop(&mut self, weapon_data: *mut WeaponData);

    /// Plays [`m_EquipAct`](Self::m_EquipAct) when the weapon is equipped by `character`.
    #[address(0x140_928_DB0)]
    pub fn OnEquip(&mut self, character: *mut Character);

    /// Whether a fire act plays for `weapon_data`: false under
    /// [`m_OnlyIfAmmoLeft`](Self::m_OnlyIfAmmoLeft) with the owner's magazine at one round or
    /// fewer; otherwise, with a [`m_WeaponDataIndex`](Self::m_WeaponDataIndex), whether the gun is
    /// that one; otherwise the fire-point parity filters, and true without them.
    #[address(0x140_8BF_200)]
    pub fn ShouldActActivate(&self, weapon_data: *mut WeaponData) -> bool;

    /// Reads the component's properties: the three acts (resolved through the event-id symbol
