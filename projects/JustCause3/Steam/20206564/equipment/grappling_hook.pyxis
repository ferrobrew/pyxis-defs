use aim::target::TargetType;
use character::character::Character;
use physics::PfxRigidBody;
use equipment::wire_end::{HookTargetInfo, WireEnd};
use state::StateContext;
use types::math::Vector3;
use types::shared_ptr::{SharedPtr, WeakPtrGameObject};
use types::std_vector::Vector;
use aim::target::Target;

/// The grappling hook's high-level state machine (`CGrapplingHook::m_State`). `SetState` is the
/// mutator; the reel tasks (`NStateTask_ReelIn`) and the reeled-in controller
/// (`NReeledInController`) drive the transitions. A reel-to-target starts in
/// [`GHS_REELING_IN`](Self::GHS_REELING_IN) -- during which
/// `NReeledInController::RotateToGrappleTarget` rotates the character's root toward the target as
/// the reel pulls them in -- and completes into one of the `GHS_REELED_*` attachment states
/// depending on the landing surface and pose.
/// [`GHS_CUSTOM_ACTIVE_WIRE`](Self::GHS_CUSTOM_ACTIVE_WIRE) is the state of a scripted wire fired
/// outside the reel flow (`CGrapplingHook::FireHookCustom`, which the vehicle grapple and the
/// stunt-position grapple use).
#[copyable]
pub enum GrapplingHookState: i32 {
    GHS_INITIALIZING = 0x0,
    GHS_INACTIVE = 0x1,
    GHS_REELING_IN = 0x2,
    GHS_REELED_ATTACHED = 0x3,
    GHS_REELED_HANG = 0x4,
    GHS_REELED_UPSIDEDOWN = 0x5,
    GHS_REELED_STUNT = 0x6,
    /// A scripted wire is out: `CGrapplingHook::FireHookCustom` sets it when it fires a wire from
    /// the inactive state, with no fire animation.
    GHS_CUSTOM_ACTIVE_WIRE = 0x7,
}

/// A grapple wire's state (`CGrapplingHookWire::EWireState`).
#[copyable]
pub enum WireState: i32 {
    /// Live, without a physics constraint yet: a wire flying or attached at its far end only.
    GHWS_ACTIVE_VIRTUAL = 0x0,
    /// Live, with its physics constraint between the two ends.
    GHWS_ACTIVE_PHYSICAL = 0x1,
    GHWS_BROKEN = 0x2,
    /// Dead: [`GrapplingHook::CancelActiveWire`] leaves it here.
    GHWS_INVALID = 0x3,
}

/// A single grapple wire (`CGrapplingHookWire`, a `CGameObject`): two [`WireEnd`]s, the physics
/// constraint, and the wire rendering. [`m_WireEnds[0]`](Self::m_WireEnds) is the hook (far) end
/// and `m_WireEnds[1]` the device end. Only some members are bound.
#[min_size(0xC2A), align(16)]
pub type GrapplingHookWire {
    /// The wire's state; see [`WireState`].
    #[address(0x82C)]
    pub m_WireState: WireState,

    /// The state before the last change.
    #[address(0x830)]
    pub m_PreviousWireState: WireState,

    /// The longest the wire may run, metres: the tuning's
    /// [`m_GrappleDistance`](GrappleTuning::m_GrappleDistance) when the hook fires it. An end
    /// flying past it retracts.
    #[address(0x834)]
    pub m_MaxLength: f32,

    /// The hook (far) end, then the device end.
    #[address(0x840)]
    pub m_WireEnds: [WireEnd; 2],

    #[address(0xC20)]
    pub m_WireId: u32,

    /// Whether the wire is the hook's [`m_ActiveWire`](GrapplingHook::m_ActiveWire).
    #[address(0xC28)]
    pub m_IsActiveWire: bool,

    /// Whether the wire is the hook's [`m_AttachmentWire`](GrapplingHook::m_AttachmentWire).
    #[address(0xC29)]
    pub m_IsAttachmentWire: bool,
}
impl GrapplingHookWire {
    /// Advances both ends, creates or updates a physical constraint when
    /// [`ShouldUseConstraint`](Self::ShouldUseConstraint) permits it, and updates the wire effects.
    #[address(0x140_94D_E00)]
    pub fn Update(&mut self, owner: *const SharedPtr<Character>, tuning: *const GrappleTuning, dt: f32);

    /// Whether both ends have live proxies, neither end is invalid, both proxies permit a
    /// constraint, and at least one requests a physical constraint. The disassembler mislabels
    /// this function as `CWireEnd::GetAttachmentObjectInfo`.
    #[address(0x140_8CC_640)]
    pub fn ShouldUseConstraint(&self) -> bool;

    /// Creates the spring and linear-motor constraint between distinct valid proxy bodies. A new
    /// attachment snapshots the current length into [`m_MaxLength`](Self::m_MaxLength); a wire
    /// that is neither active nor an attachment wire also receives a safety buffer. The spring's
    /// length is the maximum length less `tether_shorten_length`, bounded away from zero. The
    /// disassembler mislabels this function as `NPfxVehicle::SStaticWheelFrictionData::addFrictionConstraint`.
    #[address(0x140_8F3_DE0)]
    pub fn CreateConstraint(&mut self, tether_shorten_length: f32, reattaching: bool);

    /// Removes the wire's physics constraint and releases its data.
    #[address(0x140_8CC_6D0)]
    pub fn DestroyConstraint(&mut self);

    /// Updates the existing spring and motor, including their pivots and tension response.
    #[address(0x140_8F4_250)]
    pub fn UpdateConstraint(&mut self, tuning: *const GrappleTuning, dt: f32);

    /// Computes the wire tension and break state and sends tension to both attachment proxies.
    #[address(0x140_944_CB0)]
    pub fn UpdateWireTension(&mut self, tuning: *const GrappleTuning, dt: f32);

    /// Sets both ends' cast-filter ignore objects
    /// ([`WireEndCastFilter::m_IgnoreObject1`](equipment::wire_end::WireEndCastFilter::m_IgnoreObject1)
    /// and [`m_IgnoreObject2`](equipment::wire_end::WireEndCastFilter::m_IgnoreObject2)).
    #[address(0x140_8CC_5C0)]
    pub fn SetupHookCastFilters(&mut self, ignore1: *mut void, ignore2: *mut void);
}

/// The physics proxy a character hangs from under a grapple line (`CGrapplingHangPhysicsProxy`, a
/// `CGrapplePointProxy`): a rigid body the hang task swings, with the character attached to it.
/// Only some members are bound.
#[min_size(0x30)]
pub type GrapplingHangPhysicsProxy {
    vftable {
        /// Whether the proxy is set up and its body live. The hang task
        /// ([`NStateTask_GrapplingHangTask::Update`]) acts on the proxy only while it holds.
        #[index(3)]
        pub fn IsOk(&self) -> bool;
    },

    /// The proxy's rigid body, which the character hangs from. The hang task sets its angular
    /// velocity and applies its impulses to it.
    #[address(0x20)]
    pub m_PfxProxyBody: SharedPtr<PfxRigidBody>,
}

/// The grappling hook's tuning (`SGrappleTuning`), a resource the hook reads through its tuning
/// handle ([`GrapplingHook::GetTuning`]). The reel-in fields below are the ones the reel's
/// velocity update ([`NStateTask_ReelIn::UpdateReelVelocity`]) reads; the rest of the layout (the
/// tether spring and break settings, the wire's look, and the auto-aim, push, kick, and wire
/// settings) is unmapped.
#[copyable, min_size(0x70)]
pub type GrappleTuning {
    /// The grapple's range, metres: the aim's grapple slot range, and the length a fired wire may
    /// run ([`GrapplingHookWire::m_MaxLength`]).
    pub m_GrappleDistance: f32,

    /// How long the fire input must be held, seconds, for its release to fire a tether
    /// ([`GrapplingHook::m_CachedDualTetherFire`]) rather than reel in.
    #[address(0x4)]
    pub m_HoldTime: f32,

    /// The reel's top speed along the line (metres per second): a reel moving faster is slowed by
    /// [`m_ReelInClampAccel`](Self::m_ReelInClampAccel).
    #[address(0x28)]
    pub m_ReelInSpeedMax: f32,

    /// The reel's top speed while the reel boost applies (metres per second): the retract
    /// accelerates the reel ([`GrapplingHook::GetRetractAcceleratesReelIn`]) and the retract has
    /// been held ([`GrapplingHook::m_TimeHoldingRetract`]) for longer than a tenth of a second.
    #[address(0x2C)]
    pub m_RetractReelInSpeedMax: f32,

    /// The reel's least speed along the line (metres per second): a reel moving slower is sped up
    /// by [`m_ReelInClampAccel`](Self::m_ReelInClampAccel).
    #[address(0x30)]
    pub m_ReelInSpeedMin: f32,

    /// The acceleration (metres per second squared) that brings the reel's speed back between
    /// [`m_ReelInSpeedMin`](Self::m_ReelInSpeedMin) and the top speed.
    #[address(0x34)]
    pub m_ReelInClampAccel: f32,

    /// The reel's acceleration along the line (metres per second squared).
    #[address(0x38)]
    pub m_ReelInAccel: f32,

    /// The reel's acceleration along the line while the character's control parameters hold the
    /// retract context flag (metres per second squared). It replaces
    /// [`m_ReelInAccel`](Self::m_ReelInAccel) rather than adding to it, and applies only beyond
    /// [`m_ReelInDragMaxDistance`](Self::m_ReelInDragMaxDistance) from the target.
    #[address(0x3C)]
    pub m_RetractReelInAccel: f32,

    /// The drag on the reel's velocity across the line, per second.
    #[address(0x40)]
    pub m_ReelInPerpDrag: f32,

    /// The distance from the target (metres) within which the reel stops at the target rather
    /// than pass it in one step.
    #[address(0x44)]
    pub m_ReelInDragMaxDistance: f32,

    /// The distance from the target (metres) at which the reel counts as arrived and finishes.
    #[address(0x48)]
    pub m_ReelInArrivedDistance: f32,

    /// The hook's flight speed, metres per second, which every fire gives the far end
    /// ([`WireEnd::SetExtend`]).
    #[address(0x6C)]
    pub m_GrappleFireSpeed: f32,
}

/// The grappling-hook equipment item (`CGrapplingHook`, a `CGameObject`): owns the wires, the
/// reel/tether state machine, and the cached fire target. A character's hook is held by its
/// inventory ([`Inventory::m_GrapplingHook`](character::inventory::Inventory::m_GrapplingHook)).
pub type GrapplingHook {
    /// The character holding the hook (a `boost::weak_ptr<CCharacter>`).
    #[address(0x220)]
    pub m_Holder: WeakPtrGameObject,

    /// Whether the fire input has been held past [`GrappleTuning::m_HoldTime`] with an attached
    /// active wire, so that its release fires a tether rather than reel in.
    #[address(0x232)]
    pub m_CachedDualTetherFire: bool,

    /// The current state-machine state; see [`GrapplingHookState`]. The state records the *last*
    /// reel outcome as much as the current one: leaving a `GHS_REELED_*` attachment does not
    /// reliably return it to [`GHS_INACTIVE`](GrapplingHookState::GHS_INACTIVE) — readers such as
    /// `IsHookAimingState` and `ShouldShowAttachedUI` therefore combine it with
    /// [`m_ActiveWire`](Self::m_ActiveWire) rather than trusting it alone.
    #[address(0x234)]
    pub m_State: GrapplingHookState,

    /// The latched fire target, filled by [`SetUpTarget`](Self::SetUpTarget) when the hook fires.
    /// [`GetLastGrappleTargetPos`](Self::GetLastGrappleTargetPos) reads its current world position,
    /// so the fire and its arm IK follow the latched target rather than the live aim slot.
    #[address(0x238)]
    pub m_HookFireInfo: HookTargetInfo,

    /// The countdown (seconds) armed when a hook fire is committed, within which the fire
    /// animation must emit its release track message before the fire is abandoned. Set to `2.0`
    /// alongside [`m_WaitingForGrappleFire`](Self::m_WaitingForGrappleFire) by the fire
    /// dispatchers (`FireHookTowardsPos`, `TryFireHook`).
    #[address(0x270)]
    pub m_WaitForFireSignalTimeout: f32,

    /// Whether a grapple-hook fire is committed and awaiting the fire animation's release track
    /// message: set when the fire dispatches (before the fire act plays and the wire spawns),
    /// cleared when the hook releases or the fire times out. The fire act's directional alignment
    /// of the character runs within this window.
    #[address(0x274)]
    pub m_WaitingForGrappleFire: bool,

    /// The dual-tether counterpart of
    /// [`m_WaitingForGrappleFire`](Self::m_WaitingForGrappleFire); the two are cleared
    /// together as one word.
    #[address(0x275)]
    pub m_WaitingForTetherFire: bool,

    /// The cached reel-in target position in world space. The reel-in aim IK turns the chest
    /// toward it while a wire is active. The offset is confirmed; the name is
    /// unconfirmed.
    #[address(0x318)]
    pub m_CachedReelTargetPosition: Vector3,

    /// Whether the dual tethers were squeezed on the last update: set by
    /// [`SqueezeDualTethers`](Self::SqueezeDualTethers) when its squeeze value is above zero, and
    /// cleared when it is zero or no tether exists.
    #[address(0x38C)]
    pub m_IsSqueezingDualTethers: bool,

    /// How long the retract input (`RETRACT_GRAPPLE`) has been released, seconds: counted up by
    /// [`UpdateDualTetherHandling`](Self::UpdateDualTetherHandling) while the input's value is zero
    /// and reset to zero while it is above.
    #[address(0x390)]
    pub m_TimeSinceRetractHeld: f32,

    /// How long the retract input (`RETRACT_GRAPPLE`) has been held, seconds: counted up by
    /// [`UpdateDualTetherHandling`](Self::UpdateDualTetherHandling) while the input's value is above
    /// zero and reset to zero while it is zero. It ramps the tether squeeze in, and the reel's
    /// boosted top speed ([`GrappleTuning::m_RetractReelInSpeedMax`]) applies once it passes a
    /// tenth of a second.
    #[address(0x394)]
    pub m_TimeHoldingRetract: f32,

    /// The tethers: wires handed off from the active wire once their second end was fired, and
    /// the wires [`CancelActiveWire`](Self::CancelActiveWire) dropped.
    #[address(0x3A8)]
    pub m_Wires: Vector<SharedPtr<GrapplingHookWire>>,

    /// The wire currently driving the reel/attach flow, or null when none is live. The state
    /// readers null-check this before interpreting [`m_State`](Self::m_State).
    #[address(0x3C8)]
    pub m_ActiveWire: SharedPtr<GrapplingHookWire>,

    /// The wire the character hangs from or is attached by after a reel, or null.
    #[address(0x3D8)]
    pub m_AttachmentWire: SharedPtr<GrapplingHookWire>,

    /// The physics proxy the character hangs from while reeled into a hang
    /// ([`GHS_REELED_HANG`](GrapplingHookState::GHS_REELED_HANG)).
    #[address(0x3F0)]
    pub m_GrapplingHangProxy: GrapplingHangPhysicsProxy,
}
impl GrapplingHook {
    /// Latches the `player`'s (a `CPlayer`) aim slot `target_type` into `target_info`: reads the
    /// slot's [`m_AimPos`](aim::aim::PlayerAimControl::m_AimPos) and
    /// [`m_Target`](aim::aim::PlayerAimControl::m_Target) from the player's aim control, stores the
    /// position in the target object's space, and falls back to the aim control's current grapple
    /// game object only for [`TARGET_GRAPPLE`](TargetType::TARGET_GRAPPLE). Later changes to the
    /// aim slot do not move the latched target.
    #[address(0x140_939_CF0)]
    pub fn SetUpTarget(player: *mut void, target_info: *mut HookTargetInfo, target_type: TargetType);

    /// Writes the latched fire target's current world position
    /// ([`m_HookFireInfo`](Self::m_HookFireInfo)) and returns true.
    #[address(0x140_93A_4B0)]
    pub fn GetLastGrappleTargetPos(&self, position: *mut Vector3) -> bool;

    /// Computes the fire direction toward the latched target and hands it to
    /// [`DoActFire`](Self::DoActFire).
    #[address(0x140_943_2E0)]
    pub fn TryFireHook(&mut self, holder: *const SharedPtr<Character>, dual_tether_fire: bool, grapple_reel_fire: bool);

    /// Queues the directional fire act for `aim_direction` on `holder`: picks the
    /// `ACT_GRAPPLE_FIRE_*` sector (or `ACT_GRAPPLE_TETHER_FIRE_*` for a dual tether) from the
    /// angle between the direction and the character. No wire is created here; the hook spawns on
    /// the fire animation's release track message.
    #[address(0x140_8FE_D80)]
    pub fn DoActFire(aim_direction: *const Vector3, holder: *const SharedPtr<Character>, dual_tether_fire: bool, grapple_reel_fire: bool);

    /// The pre-simulation hook update: dispatches the grapple input (fire, reel, dual tether,
    /// retract, release) and advances the reel and tether state. While
    /// [`GHS_INACTIVE`](GrapplingHookState::GHS_INACTIVE) without an active wire, a press of the fire
    /// input latches the aim ([`SetUpTarget`](Self::SetUpTarget)) and queues the fire act at once,
    /// before a tap and a hold are told apart. While inactive with an active wire whose far end is
    /// attached, a held fire input sets
    /// [`m_CachedDualTetherFire`](Self::m_CachedDualTetherFire) past the hold time; on its release
    /// with that set it latches the aim again and fires the tether's second end, and otherwise, the
    /// input up, it enters [`GHS_REELING_IN`](GrapplingHookState::GHS_REELING_IN) and queues the
    /// pre-reel act: the reel runs whenever an attached active wire meets a released input, a quick
    /// tap that let go before the hook arrived included.
    #[address(0x140_949_F70)]
    pub fn OnPreSimUpdate(&mut self, dt: f32);

    /// The post-camera hook update. On the fire animation's release frame it creates the wire
    /// ([`CreateNewWire`](Self::CreateNewWire)), pins the near end to the device, and starts the
    /// far end extending toward the latched target
    /// ([`WireEnd::SetExtend`](equipment::wire_end::WireEnd::SetExtend)).
    #[address(0x140_94E_D60)]
    pub fn OnPostCamUpdate(&mut self, dt: f32);

    /// Spawns a new wire at `spawn_pos` and returns it through `result`.
    #[address(0x140_923_BC0)]
    pub fn CreateNewWire(&mut self, result: *mut SharedPtr<GrapplingHookWire>, spawn_pos: *const Vector3) -> *mut SharedPtr<GrapplingHookWire>;

    /// Fires a wire at `target_info` at once, with no fire act or animation, when the hook has no
    /// [`m_ActiveWire`](Self::m_ActiveWire) and is
    /// [`GHS_INACTIVE`](GrapplingHookState::GHS_INACTIVE); otherwise it does nothing. It creates the
    /// wire at the holder's left hand position, makes it the active wire with the tuning's
    /// [`m_GrappleDistance`](GrappleTuning::m_GrappleDistance) as its
    /// [`m_MaxLength`](GrapplingHookWire::m_MaxLength), attaches the device end
    /// ([`AttachLocalWireEndToDevice`](Self::AttachLocalWireEndToDevice)), sets the ends' cast
    /// filters to ignore `ignore_object` and the holder, starts the far end extending toward the
    /// target at [`m_GrappleFireSpeed`](GrappleTuning::m_GrappleFireSpeed) as a ghost wire when
    /// `ghost_wire`, and enters [`GHS_CUSTOM_ACTIVE_WIRE`](GrapplingHookState::GHS_CUSTOM_ACTIVE_WIRE),
    /// where the fire, reel, and tether input does nothing. It does not test
    /// [`m_WaitingForGrappleFire`](Self::m_WaitingForGrappleFire) or
    /// [`m_WaitingForTetherFire`](Self::m_WaitingForTetherFire). The vehicle grapple
    /// ([`VehicleGrappleHook::PreSimUpdate`]) and the stunt-position grapple fire through it.
    #[address(0x140_94C_B20)]
    pub fn FireHookCustom(&mut self, target_info: *mut HookTargetInfo, ignore_object: *mut void, ghost_wire: bool);

    /// Builds a target info on `target` at `local_position` in its space (in range, no bone),
    /// fires it as [`FireHookCustom`](Self::FireHookCustom), and releases the info.
    #[address(0x140_94D_D60)]
    pub fn FireHookCustomAtTarget(&mut self, target: *mut Target, local_position: *const Vector3, ignore_object: *mut void, ghost_wire: bool);

    /// Ends the active wire, when there is one: destroys its constraint, kills both ends, marks it
    /// [`GHWS_INVALID`](WireState::GHWS_INVALID), moves it to [`m_Wires`](Self::m_Wires), clears
    /// [`m_ActiveWire`](Self::m_ActiveWire), and notifies the HUD. It leaves
    /// [`m_State`](Self::m_State): [`OnPreSimUpdate`](Self::OnPreSimUpdate) returns
    /// [`GHS_CUSTOM_ACTIVE_WIRE`](GrapplingHookState::GHS_CUSTOM_ACTIVE_WIRE) to
    /// [`GHS_INACTIVE`](GrapplingHookState::GHS_INACTIVE) on its next run once neither an active nor
    /// an attachment wire is left.
    #[address(0x140_90B_200)]
    pub fn CancelActiveWire(&mut self);

    /// The hook's tuning resource, or null. The disassembler swaps the names of this function and
    /// [`GetActiveWireAttachmentObjectInfo`](Self::GetActiveWireAttachmentObjectInfo).
    #[address(0x140_839_F30)]
    pub fn GetTuning(&self) -> *const GrappleTuning;

    /// The attachment-object kind (`CGrapplePointProxy::EAttachmentObjectInfo`) of the active
    /// wire's far-end proxy, or zero without an attached active wire. The disassembler swaps the
    /// names of this function and [`GetTuning`](Self::GetTuning).
    #[address(0x140_8C9_170)]
    pub fn GetActiveWireAttachmentObjectInfo(&self) -> i32;

    /// Writes the unit direction from `holder`'s chest to the latched target of `target_info` and
    /// returns whether there is one. The disassembler mislabels it
    /// `CAIAirplaneSteering::TakeOffInDirection`.
    #[address(0x140_93A_090)]
    pub fn GetFireDirection(direction: *mut Vector3, holder: *const SharedPtr<Character>, target_info: *const HookTargetInfo) -> bool;

    /// Whether the fire input may fire a tether: the holder is the player, no control flag blocks
    /// it, and the player has the tether ability. The disassembler mislabels it
    /// `CIsParachuteEnabledCondition::Evaluate`.
    #[address(0x140_923_9E0)]
    pub fn GetDualTetherFireInputEnabled(&self) -> bool;

    /// Attaches `wire`'s device end (`m_WireEnds[1]`) to `holder`'s grapple device bone.
    #[address(0x140_94C_3D0)]
    pub fn AttachLocalWireEndToDevice(wire: *mut SharedPtr<GrapplingHookWire>, holder: *const SharedPtr<Character>);

    /// Retracts the active wire: destroys its physics constraint, detaches the near end, and
    /// notifies the HUD.
    #[address(0x140_8F7_A10)]
    pub fn RetractActiveWire(&mut self);

    /// Whether the hook is in its "aiming" state: an active wire that is not reeling in and not a
    /// custom wire; with the re-reel upgrade, reeling in also counts.
    #[address(0x140_8C8_EA0)]
    pub fn IsHookAimingState(&self) -> bool;

    /// Whether the HUD shows the attached-wire part of the grapple reticle: an active, attached
    /// wire while the hook is not in [`GHS_REELING_IN`](GrapplingHookState::GHS_REELING_IN),
    /// [`GHS_REELED_ATTACHED`](GrapplingHookState::GHS_REELED_ATTACHED),
    /// [`GHS_REELED_HANG`](GrapplingHookState::GHS_REELED_HANG), or
    /// [`GHS_REELED_UPSIDEDOWN`](GrapplingHookState::GHS_REELED_UPSIDEDOWN).
    #[address(0x140_8C9_4C0)]
    pub fn ShouldShowAttachedUI(&self) -> bool;

    /// Writes the interpolated graphics world position of the active wire's attached far end for
    /// the render interpolation factor `dtf`. Returns false without an attached active wire.
    #[address(0x140_8D7_B30)]
    pub fn GetActiveWireAttachmentGraphicsWorldPosition(&self, dtf: f32, gfx_pos_out: *mut Vector3) -> bool;

    /// Pushes the wires' tension and attach-type data to the HUD (`CHUDUI::UpdateWireData`).
    #[address(0x140_902_DC0)]
    pub fn PushWireDataToUI(&self);

    /// The number of dual tethers: the wires of the hook's tether list that are neither invalid
    /// nor broken and have neither end retracting. The tether release reads it.
    #[address(0x140_8E5_030)]
    pub fn GetNumDualTethers(&self) -> i32;

    /// The highest tension fraction among the dual tethers that
    /// [`GetNumDualTethers`](Self::GetNumDualTethers) counts, or zero without one. A wire's tension
    /// fraction is updated with its constraint (`CGrapplingHookWire::UpdateWireTension`). The
    /// player's camera shake and rumble (`CPlayer::UpdateCameraShakeRumble`) read it while the
    /// tethers are squeezed, with a stronger effect above four fifths.
    #[address(0x140_8E5_090)]
    pub fn GetHighestWireTension(&self) -> f32;

    /// Whether the hook's tether list holds a wire that is neither invalid nor broken and has both
    /// ends attached.
    #[address(0x140_8E5_100)]
    pub fn HasValidTethers(&self) -> bool;

    /// Whether the retract accelerates a reel: the hook's own retract-accelerates flag is set and
    /// the retract reel-in boost upgrade is purchased and enabled.
    #[address(0x140_8BD_090)]
    pub fn GetRetractAcceleratesReelIn(&self) -> bool;

    /// The per-tick tether input. It reads the retract input's value (`RETRACT_GRAPPLE`, `0..=1`)
    /// and the release input's click (`RELEASE_GRAPPLE`) from `action_map` (a `CActionMap`), and
    /// counts [`m_TimeHoldingRetract`](Self::m_TimeHoldingRetract) and
    /// [`m_TimeSinceRetractHeld`](Self::m_TimeSinceRetractHeld). A release click releases the
    /// tethers. Otherwise the squeeze value is the cube of the retract value, while the hook is
    /// neither initialising, reeling in, nor holding a custom wire, the character can retract the
    /// grapple, and the player has the tether retract ability, and zero otherwise. Unless a game
    /// setting selects otherwise, the squeeze is scaled by a ramp of the hold time, from a tenth of
    /// the squeeze to all of it over the three tenths of a second after the first three. The value
    /// goes to [`SqueezeDualTethers`](Self::SqueezeDualTethers).
    #[address(0x140_93A_290)]
    pub fn UpdateDualTetherHandling(&mut self, holder: *const SharedPtr<Character>, player: *mut void, tuning: *const GrappleTuning, action_map: *mut void, dt: f32);

    /// Squeezes every wire of the tether list by `squeeze_value` (`0..=1`): each wire rebuilds its
    /// constraint toward a shorter length and smooths its squeeze factor toward the value. It sets
    /// [`m_IsSqueezingDualTethers`](Self::m_IsSqueezingDualTethers).
    #[address(0x140_923_E00)]
    pub fn SqueezeDualTethers(&mut self, player: *mut void, tuning: *const GrappleTuning, squeeze_value: f32, dt: f32);
}

/// The reel-in state task (`NStateTask_ReelIn`): the character state task that carries the
/// character along the grapple line to its target while the hook is
/// [`GHS_REELING_IN`](GrapplingHookState::GHS_REELING_IN).
pub type NStateTask_ReelIn;
impl NStateTask_ReelIn {
    /// Advances the reel's velocity by `dt`. It accelerates `velocity` (in and out: the
    /// character's world velocity less the velocity it inherited) along `wanted_reel_direction` by
    /// [`GrappleTuning::m_ReelInAccel`], or [`GrappleTuning::m_RetractReelInAccel`] while the
    /// character's control parameters hold the retract context flag, adds the wind-up,
    /// collision-avoidance, and
    /// vehicle-entry pushes, drags the velocity across the line, clamps its speed along the line
    /// between [`GrappleTuning::m_ReelInSpeedMin`] and the top speed
    /// ([`GrappleTuning::m_ReelInSpeedMax`], or [`GrappleTuning::m_RetractReelInSpeedMax`] while the
    /// reel boost applies), stops at the target within [`GrappleTuning::m_ReelInDragMaxDistance`],
    /// and adds back the blended inherited velocity. `current_position` is the character's
    /// position and `distance_to_target` its distance from the target. The reel task's update
    /// calls it once per tick, and the trajectory prediction (`SimulateImmediateTrajectory`) calls
    /// it per predicted step with `is_simulating` set, which only suppresses its debug drawing. The
    /// disassembler mislabels it `NStateTask_ReelIn::DoPreReelBlockCheck`.
    #[address(0x140_83A_0D0)]
    pub fn UpdateReelVelocity(character: *mut Character, hook: *const SharedPtr<GrapplingHook>, velocity: *mut Vector3, instance_properties: *mut void, current_position: *const Vector3, wanted_reel_direction: *const Vector3, distance_to_target: f32, tuning: *const GrappleTuning, dt: f32, is_simulating: bool);
}

/// The in-air grapple fire motion state task (`NStateTask_InAirGrappleFireMotionTask`). Like the
/// other `NStateTask` functions, it runs against the character's state context.
pub type NStateTask_InAirGrappleFireMotionTask;
impl NStateTask_InAirGrappleFireMotionTask {
    /// Enters the task, orienting the fire motion from the camera matrix
    /// (`CGameCameraManager::GetCameraMatrix`, read directly rather than through the aim slot) and
    /// the latched target ([`GrapplingHook::GetLastGrappleTargetPos`]).
    #[address(0x140_810_B60)]
    pub fn OnEnter(ctx: *mut StateContext, p1: *mut void, p2: *mut void);
}

/// The reeled-in ledge climb's motion task (`NStateTask_ReeledInLedgeClimbMotionTask`): the
/// character state task that carries the character over a ledge it has reeled in to. The grapple's
/// climb (`ACT_GRPL_CLIMB` into `S_GRAPPLE_CLIMB_START` in `rico_base.afsmb`) is the only ledge
/// climb the player's state machine has: no state machine under `animations/jc_statemachine` uses
/// the vault or obstacle-climb acts.
pub type NStateTask_ReeledInLedgeClimbMotionTask;
impl NStateTask_ReeledInLedgeClimbMotionTask {
    /// Enters the task: records the character's upright orientation and its measured world
    /// velocity, and reads the climb's speed tuning from the character's blackboard.
    #[address(0x140_845_520)]
    pub fn OnEnter(ctx: *mut StateContext, p1: *mut void, p2: *mut void);

    /// The per-tick update. Runs the non-swimming movement update, then drives the character over
    /// the ledge with a code-controlled velocity: projected along the climb from the climb
    /// segment's local time (`NGrapplingMotionUtils::ProjectClimbOverVelocityAtTime`) while the
    /// segment plays, the animation's root velocity after it, plus the velocity the character
    /// entered with. It sets the motion state to
    /// [`MOTION_STATE_TASK_DEFINED`](character::character::Character::MOTION_STATE_TASK_DEFINED)
    /// and writes the proxy's wanted velocity. It runs on every tick its state is active.
    #[address(0x140_845_630)]
    pub fn Update(ctx: *mut StateContext, p1: *mut void, p2: *mut void);
}

/// The hang task (`NStateTask_GrapplingHangTask`): the character state task that runs while the
/// character hangs under a grapple line.
pub type NStateTask_GrapplingHangTask;
impl NStateTask_GrapplingHangTask {
    /// The per-tick update. While the hook's
    /// [`m_GrapplingHangProxy`](GrapplingHook::m_GrapplingHangProxy) is
    /// [`IsOk`](GrapplingHangPhysicsProxy::IsOk), it post-updates the proxy for the context's
    /// time step, reads the move stick (squared to a circle and turned into the world through the
    /// camera's input matrix), and blends the proxy body's angular velocity toward a yaw rate: toward
    /// the weapon aim point while the character aims a weapon or the grapple or throws a grenade,
    /// and toward zero otherwise. A gun held in a hand that fired within the last tenth of a second
    /// pushes the body back along the weapon's forward axis at that hand. Two stick-driven swings
    /// follow, each behind its own flag: a discrete swing impulse
    /// ([`GrapplingHangTask_EnableDiscreteSwing`]) and a continuous one scaled by the stick's
    /// magnitude ([`GrapplingHangTask_EnableSmallImpulseSwing`],
    /// [`GrapplingHangTask_SmallImpulseSwingMagnitude`]), both applied at the hips
    /// ([`Character::GetHipsPosition`](character::character::Character::GetHipsPosition)) with
    /// [`PfxRigidBody::ApplyImpulse`]. Nothing in this build sets either flag, so the stick does not
    /// swing a hanging character. Without a valid proxy it runs the drop-out alignment instead, or
    /// cancels the hang.
    #[address(0x140_815_1D0)]
    pub fn Update(ctx: *mut StateContext, p1: *mut void, p2: *mut void);
}

/// Enables the hang task's discrete stick swing (`NStateTask_GrapplingHangTask::s_enable_discrete_swing`).
/// Zero-initialised and written by no code in this build.
#[address(0x142_F30_E90)]
pub extern GrapplingHangTask_EnableDiscreteSwing: bool;
/// Enables the hang task's continuous stick swing
/// (`NStateTask_GrapplingHangTask::s_enable_small_impulse_swing`). Zero-initialised and written by
/// no code in this build.
#[address(0x142_F30_E84)]
pub extern GrapplingHangTask_EnableSmallImpulseSwing: bool;
/// The continuous stick swing's impulse at full stick deflection
/// ([`GrapplingHangTask_EnableSmallImpulseSwing`]), applied once per hang-task tick and scaled by
/// the stick's magnitude.
#[address(0x142_D65_A80)]
pub extern GrapplingHangTask_SmallImpulseSwingMagnitude: f32;

/// The vehicle grapple (`CVehicleGrappleHook`): a vehicle's grapple, which fires the holder's hook
/// at a stored target and tethers it to the vehicle.
pub type VehicleGrappleHook;
impl VehicleGrappleHook {
    /// The vehicle grapple's state machine: fires through
    /// [`GrapplingHook::FireHookCustom`], waits for the far end to attach (the active wire not
    /// [`GHWS_INVALID`](WireState::GHWS_INVALID) and its far end holding a proxy), tethers it to the
    /// vehicle's centre of mass, and ends the wire with [`GrapplingHook::CancelActiveWire`].
    #[address(0x140_94D_910)]
    pub fn PreSimUpdate(&mut self, holder: *const SharedPtr<Character>, player: *mut void, action_map: *mut void, tuning: *const GrappleTuning, p5: bool, dt: f32);
}
