use types::math::Matrix4;
use types::math::Vector3;

/// A thrown or placed explosive object (`CExplosive`, a `CGameObjectAmmunition<CDamageable>`): its
/// physics body, trail effect, detonation timers, and the deferred launch that
/// [`PropelToward`](Self::PropelToward) sets up for the physics body to apply later.
pub type Explosive {
    /// The offset of the embedded `CGameObject` subobject. Weak references to the explosive (such
    /// as [`ThrownGrenadeWeapon::m_PrimedGrenade`](equipment::weapon::ThrownGrenadeWeapon::m_PrimedGrenade))
    /// point there rather than at the start of the explosive.
    pub const GAME_OBJECT_BASE_OFFSET: u64 = 0x70,

    /// The explosive's physics body (`CPfxRigidBody`, the pointer of a shared pointer), or null
    /// until the first `UpdatePostSimFromManager` after the explosive spawns creates it.
    /// [`PropelToward`](Self::PropelToward) and [`SetPhysicsTransform`](Self::SetPhysicsTransform)
    /// do nothing without it.
    #[address(0x4B8)]
    pub m_PfxInstance: *mut void,

    /// The explosive's world matrix as of the current simulation tick. Its translation row is the
    /// launch start position [`PropelToward`](Self::PropelToward) solves from. The `CGameObject`
    /// transform setter writes it, and the post-simulation update moves a physics body that is not
    /// simulating to it.
    #[address(0x540)]
    pub m_WorldMatrixT1: Matrix4,

    /// Whether [`m_DeferredPhysicsTransform`](Self::m_DeferredPhysicsTransform) is pending: set by
    /// [`SetPhysicsTransform`](Self::SetPhysicsTransform) and applied to the physics body, then
    /// cleared, by the next `UpdatePostSimFromManager`, before a pending launch.
    #[address(0x580)]
    pub m_DeferredSetPhysicsTransform: bool,

    /// The transform awaiting application to the physics body.
    #[address(0x584)]
    pub m_DeferredPhysicsTransform: Matrix4,

    /// The velocity of the thrower when the explosive was launched, stored by
    /// [`PropelToward`](Self::PropelToward).
    #[address(0x5DC)]
    pub m_RelativeVelocity: Vector3,

    /// Whether a launch is pending: set by [`PropelToward`](Self::PropelToward) and applied to the
    /// physics body with [`m_DeferredInitialVelocity`](Self::m_DeferredInitialVelocity) on a later
    /// update.
    #[address(0x5E9)]
    pub m_DeferredPropelTowards: bool,

    /// The solved launch velocity awaiting application to the physics body, written by
    /// [`PropelToward`](Self::PropelToward) from the virtual `VelocityToHitTarget`.
    #[address(0x5EC)]
    pub m_DeferredInitialVelocity: Vector3,

    /// Seconds since the explosive was thrown; [`PropelToward`](Self::PropelToward) resets it.
    #[address(0x604)]
    pub m_TimeSinceThrow: f32,
    /// Seconds until the explosive detonates. The constructor sets it to the grenade weapon's
    /// detonation time; the post-simulation update counts it down by the tick delta while the
    /// virtual `ShouldTickDetonationTimer` holds (a hand grenade's does from the moment it spawns,
    /// primed or thrown) and calls the virtual `Detonate` once it reaches zero.
    pub m_DetonationTimer: f32,
    /// The detonation time [`m_DetonationTimer`](Self::m_DetonationTimer) started from.
    pub m_StartDetonationTimer: f32,
}
impl Explosive {
    /// Queues `transform` for the physics body: when the explosive has a
    /// [`m_PfxInstance`](Self::m_PfxInstance), copies it to
    /// [`m_DeferredPhysicsTransform`](Self::m_DeferredPhysicsTransform) and raises
    /// [`m_DeferredSetPhysicsTransform`](Self::m_DeferredSetPhysicsTransform). A later call before
    /// the body applies it replaces it.
    #[address(0x140_8C8_180)]
    pub fn SetPhysicsTransform(&mut self, transform: *const Matrix4);

    /// Launches the explosive toward `target_position`: when it has a physics body, stores
    /// `relative_velocity` in [`m_RelativeVelocity`](Self::m_RelativeVelocity), raises
    /// [`m_DeferredPropelTowards`](Self::m_DeferredPropelTowards), solves the launch velocity from
    /// its current position with the virtual `VelocityToHitTarget` into
    /// [`m_DeferredInitialVelocity`](Self::m_DeferredInitialVelocity), starts the trail effect,
    /// and resets [`m_TimeSinceThrow`](Self::m_TimeSinceThrow). The target point is the only aim
    /// input; the solver chooses the flight time.
    #[address(0x140_8E4_D50)]
    pub fn PropelToward(&mut self, target_position: *const Vector3, relative_velocity: *const Vector3, target_is_on_roof: bool, exact_target_aiming: bool);

    /// Solves the launch velocity from `start_pos` to `aim_pos`: clamps the target to
    /// `max_range`, chooses a flight time from the grenade weapon's arc tuning (flat, up, and down
    /// times blended by distance and elevation; roof targets use a height-based time), and solves
    /// with [`NWeaponUtil::Trajectory_GetVelocityToHitPosition`](equipment::weapon::NWeaponUtil::Trajectory_GetVelocityToHitPosition)
    /// under world gravity.
    #[address(0x140_91E_C50)]
    pub fn VelocityToHitTarget(&mut self, result: *mut Vector3, aim_pos: *const Vector3, start_pos: *const Vector3, max_range: f32, roof_target: bool, exact_target_aiming: bool) -> *mut Vector3;

    /// Plays the explosive's trail effect at [`m_WorldMatrixT1`](Self::m_WorldMatrixT1), when it
    /// has one.
    #[address(0x140_8D6_E20)]
    pub fn PlayTrailEffect(&mut self);
}

/// A C4 charge (`CPlantedExplosive`, a [`Explosive`]), spawned and owned by the
/// [`PlantedExplosiveWeapon`](equipment::weapon::PlantedExplosiveWeapon). It has two models: the
/// in-hand model, shown while the charge is primed and placed at
/// [`m_InactiveModelWorldMatrixT1`](Self::m_InactiveModelWorldMatrixT1), and the live model at
/// the explosive's own transform, which [`Activate`](Self::Activate) shows in its place.
///
/// The charge keeps the base explosive's collision handler (the grenade overrides it): on a
/// collision it moves the charge to the contact point, oriented by the
/// contact normal, and attaches itself to the object it hit (or plays its stick effect against the
/// world), so a charge that is dropped
/// ([`DropExplosive`](Self::DropExplosive)) sticks where it lands.
#[min_size(0x6B5)]
pub type PlantedExplosive {
    /// The in-hand model's world matrix, written by
    /// [`SetInactiveModelMatrix`](Self::SetInactiveModelMatrix). The pre-simulation update copies
    /// it to the previous frame's matrix, and the render update draws the in-hand model between
    /// the two.
    #[address(0x668)]
    pub m_InactiveModelWorldMatrixT1: Matrix4,

    /// Whether the charge is live, set by [`Activate`](Self::Activate).
    #[address(0x6B4)]
    pub m_ExplosiveIsPlanted: bool,
}
impl PlantedExplosive {
    /// Makes the charge live: sets [`m_ExplosiveIsPlanted`](Self::m_ExplosiveIsPlanted), plays the
    /// stick effect, shows the live model, and hides the in-hand model.
    #[address(0x140_922_BE0)]
    pub fn Activate(&mut self);

    /// Drops the charge into the simulation: makes its physics body dynamic in the world, disables
    /// collision between it and the thrower's character body, and, under a parachute, moves the body
    /// into the thrower's collision group. The body must exist
    /// ([`Explosive::m_PfxInstance`]).
    #[address(0x140_922_CD0)]
    pub fn DropExplosive(&mut self);

    /// Sets the physics body's linear velocity, world axes, metres per second. The body must exist
    /// ([`Explosive::m_PfxInstance`]); the call dereferences it unchecked. The velocity is a
    /// by-value `CVector3f`, which the calling convention passes by address.
    #[address(0x140_8C8_870)]
    pub fn SetVelocity(&mut self, velocity: *const Vector3);

    /// Copies `world_matrix` to [`m_InactiveModelWorldMatrixT1`](Self::m_InactiveModelWorldMatrixT1).
    #[address(0x140_8BC_C40)]
    pub fn SetInactiveModelMatrix(&mut self, world_matrix: *const Matrix4);
}

/// A hand grenade (`CGrenade`, a [`Explosive`]): adds bounce counting, homing and smart-fuse
/// targets, extra trail effects, and the landing position.
#[min_size(0x730)]
pub type Grenade {
    /// Whether the grenade applies the thrower's grenade upgrades (homing and similar).
    #[address(0x620)]
    pub m_CanUseUpgrades: bool,

    /// The target position the grenade was thrown at, recorded by
    /// [`PropelToward`](Self::PropelToward).
    #[address(0x720)]
    pub m_InitialLandingPos: Vector3,
}
impl Grenade {
    /// The [`Explosive::PropelToward`] override: calls it, records `target_position` in
    /// [`m_InitialLandingPos`](Self::m_InitialLandingPos), plays the extra trail effects, and, with
    /// upgrades enabled and the homing upgrade owned, starts the homing-target search.
    #[address(0x140_91F_5C0)]
    pub fn PropelToward(&mut self, target_position: *const Vector3, relative_velocity: *const Vector3, target_is_on_roof: bool, exact_target_aiming: bool);

    /// The [`Explosive::VelocityToHitTarget`] override: wraps it and adds the thrower's relative
    /// velocity unless the grenade has a homing target or `exact_target_aiming` is set.
    #[address(0x140_91F_780)]
    pub fn VelocityToHitTarget(&mut self, result: *mut Vector3, aim_pos: *const Vector3, start_pos: *const Vector3, max_range: f32, roof_target: bool, exact_target_aiming: bool) -> *mut Vector3;
}
