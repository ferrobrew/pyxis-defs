use hash::HashString;
use types::math::Matrix4;

/// The game world interface (`IGameWorld`), reached through the `Base::CSingle<IGameWorld>`
/// instance pointer. The concrete object is `CGameWorld`, which owns the object manager, the
/// world file, and the player-teleport state machine; the interface subobject is what every
/// caller (bookmarks, teleport triggers, mission starts) goes through. Only the vtable is mapped.
#[singleton(0x142_F17_CD0), min_size(0x8)]
pub type GameWorld {
    /// A teleport `flags` bit: keep the active mission running across the teleport.
    /// Without it the mission manager aborts the active mission as part of the teleport.
    pub const TELEPORT_FLAG_KEEP_MISSION: u32 = 0x1,
    /// A teleport `flags` bit (deferred teleports only): skip the fade-to-black even
    /// when `use_fade` is set.
    pub const TELEPORT_FLAG_NO_FADE: u32 = 0x2,
    /// A teleport `flags` bit that [`Teleport::Teleport`] adds when the teleport object's
    /// [`m_LeavePlayerDisabled`](TeleportFlags::m_LeavePlayerDisabled) flag is set. Its effect in
    /// the teleport has not been traced.
    pub const TELEPORT_FLAG_LEAVE_PLAYER_DISABLED: u32 = 0x4,

    vftable {
        /// Queues a deferred player teleport that `CGameWorld::UpdateTeleport` services over the
        /// following frames through its `TELEPORT_*` state machine. `world` is the destination
        /// transform (the translation row places the character; the rotation sets the facing and
        /// resets the camera behind it). `state` is an optional character state to enter on
        /// arrival (null keeps the neutral state). With `use_load_state` the game enters the load
        /// game state so the destination streams in first, with a load screen if
        /// `use_load_screen`; without it the world must already be resident (the engine logs a
        /// warning past 500 m from the active camera). `use_fade` fades the overlay UI to black for
        /// `fade_out_time` seconds and back in over `fade_in_time`. `flags` is a bit set of
        /// [`TELEPORT_FLAG_KEEP_MISSION`](Self::TELEPORT_FLAG_KEEP_MISSION) and
        /// [`TELEPORT_FLAG_NO_FADE`](Self::TELEPORT_FLAG_NO_FADE). `teleport_done_event`, when
        /// non-null, is sent once the arrival completes. Asserts when a teleport is already in
        /// flight ([`IsTeleporting`](Self::IsTeleporting)). Main thread only.
        #[index(19)]
        pub fn TeleportPlayer(&mut self, world: *const Matrix4, state: *const HashString, use_load_state: bool, use_fade: bool, fade_in_time: f32, fade_out_time: f32, flags: u32, teleport_done_event: *mut u8, use_load_screen: bool);

        /// Teleports the local player's character synchronously: initializes the character's
        /// transform to `world`, forces the neutral animation state, optionally enters `state`,
        /// resets the game camera behind the new transform, and re-enables the player and
        /// character. Fires `game_teleporting_initiated` and `game_teleporting_completed`, resets
        /// the current settlement, province, and region, and notifies the HUD. Aborts the active
        /// mission unless `flags` has
        /// [`TELEPORT_FLAG_KEEP_MISSION`](Self::TELEPORT_FLAG_KEEP_MISSION). No streaming: the
        /// destination must already be resident. Asserts when a deferred teleport is in flight.
        /// Main thread only.
        #[index(20)]
        pub fn TeleportPlayerInstant(&mut self, world: *const Matrix4, state: *const HashString, flags: u32);

        /// Whether a deferred [`TeleportPlayer`](Self::TeleportPlayer) is still being serviced.
        #[index(21)]
        pub fn IsTeleporting(&mut self) -> bool;
    },
}
impl GameWorld {
    /// `CGameWorld::TeleportPlayer`, the implementation behind the
    /// [`TeleportPlayer`](Self::TeleportPlayer) virtual: copies the request into
    /// the world's teleport state and arms the `TELEPORT_*` state machine
    /// [`UpdateTeleport`] services; starts the overlay fade-to-black when `use_fade` is set and
    /// [`TELEPORT_FLAG_NO_FADE`](Self::TELEPORT_FLAG_NO_FADE) is clear.
    #[address(0x140_9AF_820)]
    pub fn TeleportPlayerImpl(&mut self, world: *const Matrix4, state: *const HashString, use_load_state: bool, use_fade: bool, fade_in_time: f32, fade_out_time: f32, flags: u32, teleport_done_event: *mut u8, use_load_screen: bool);

    /// `CGameWorld::TeleportPlayerInstant`, the implementation behind the
    /// [`TeleportPlayerInstant`](Self::TeleportPlayerInstant) virtual. Writes the
    /// character's transform through its world-transform virtual, calls
    /// `CCharacter::ForceNeutralState`, sets the character's teleported flag bit, and resets the
    /// camera through [`GameCameraManager::ResetCamera`](camera::game_camera_manager::GameCameraManager::ResetCamera),
    /// bracketed by the `game_teleporting_initiated` and `game_teleporting_completed` posted
    /// events.
    #[address(0x140_A12_6C0)]
    pub fn TeleportPlayerInstantImpl(&mut self, world: *const Matrix4, state: *const HashString, flags: u32);

    /// `CGameWorld::IsTeleporting`, the implementation behind the
    /// [`IsTeleporting`](Self::IsTeleporting) virtual: whether the teleport state
    /// machine is not idle.
    #[address(0x140_9AF_810)]
    pub fn IsTeleportingImpl(&self) -> bool;
}

/// `CGameWorld::UpdateTeleport`: advances the deferred-teleport state machine a
/// [`GameWorld::TeleportPlayer`] request armed (fade, optional load state, character placement,
/// fade back in). Called from `CGameWorld::UpdatePostSim` each sim tick. `game_world` is the full
/// `CGameWorld` object, which embeds the [`GameWorld`] interface subobject (the singleton) after
/// its own leading members, so the singleton pointer is not the start of the object.
#[address(0x140_A12_8A0)]
pub fn UpdateTeleport(game_world: *mut u8, dt: f32);

/// The packed flag bits of [`Teleport::m_Flags`] (`CTeleport`'s bitfield members, from the low bit
/// upward).
#[copyable]
pub bitflags TeleportFlags: u8 {
    m_Enabled = 0b0000_0001,
    m_ForceInstant = 0b0000_0010,
    /// A teleport is pending; [`Teleport::Teleport`] clears it.
    m_Teleport = 0b0000_0100,
    /// Fade to black: passed as `use_fade` to [`GameWorld::TeleportPlayer`].
    m_UseFade = 0b0000_1000,
    /// Adds [`TELEPORT_FLAG_NO_FADE`](GameWorld::TELEPORT_FLAG_NO_FADE) to the teleport flags.
    m_IgnoreFade = 0b0001_0000,
    m_LeavePlayerDisabled = 0b0010_0000,
    /// Passed as `use_load_screen` to [`GameWorld::TeleportPlayer`].
    m_bUseLoadingScreen = 0b0100_0000,
}

/// `CTeleport`: a placed game object that teleports the player to its own transform when
/// triggered by its teleport event, through [`GameWorld::TeleportPlayer`]. Only the fields
/// [`Teleport`](Self::Teleport) reads are mapped.
#[min_size(0x160)]
pub type Teleport {
    /// The object's local transform.
    #[address(0xC8)]
    pub m_LocalTransform: Matrix4,
    /// The object's world transform: the teleport destination.
    pub m_WorldMatrix: Matrix4,

    /// The optional object whose arrival state is checked before teleporting.
    #[address(0x148)]
    pub m_TeleportObjectId: u64,
    pub m_FadeInTime: f32,
    pub m_FadeOutTime: f32,
    /// The character state to enter on arrival.
    pub m_State: HashString,
    /// The packed flags.
    pub m_Flags: TeleportFlags,
}
impl Teleport {
    /// `CTeleport::SetTransform`: copies `world_matrix` into
    /// [`m_WorldMatrix`](Self::m_WorldMatrix).
    #[address(0x140_4CE_CE0)]
    pub fn SetTransform(&mut self, world_matrix: *const Matrix4);

    /// `CTeleport::Teleport`: issues [`GameWorld::TeleportPlayer`] to
    /// [`m_WorldMatrix`](Self::m_WorldMatrix) with the object's state, fade times, and flags, posts
    /// the teleport message, and clears the pending-teleport bit
    /// ([`m_Teleport`](TeleportFlags::m_Teleport)). Called from
    /// `CTeleport::UpdatePreSim` when a teleport is pending.
    #[address(0x140_50E_360)]
    pub fn Teleport(&mut self);
}
