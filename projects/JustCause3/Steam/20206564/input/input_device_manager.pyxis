/// An input device class (`Input::EDeviceType`), as passed to the device manager's device lookup
/// and action mapping.
#[copyable]
pub enum DeviceType: i32 {
    Default = 0x0,
    Keyboard = 0x1,
    Mouse = 0x2,
    Joystick = 0x3,
    Gamepad = 0x4,
    Memorycard = 0x5,
    Microphone = 0x6,
    Headphone = 0x7,
    Unknown = 0x8,
    DeviceTypeCount = 0x10,
}

/// The ordering used by [`InputDeviceManager::GetDevice`]. Appearance order counts devices of the
/// requested class in the manager's device vector. Hardware-index order matches the index encoded in
/// [`InputDevice::ID`].
#[copyable]
pub enum DeviceOrder: i32 {
    Appearance = 0x0,
    HardwareIndex = 0x1,
}

/// The packed identifier stored by every input device. The low nibble is the [`DeviceType`], and the
/// hardware index occupies the bits used by the action-map device selector. The remaining bits are
/// device-specific identity data.
#[size(0x4), align(4), copyable]
pub type InputDeviceId {
    pub raw: u32,
}

/// The common input-device object (`Input::IInputDevice`). Only the identity field is modeled; the
/// concrete device state and object collections are intentionally left opaque.
#[min_size(0x38)]
pub type InputDevice {
    pub __vftable: u64,

    /// The packed device identity used by device lookup and action-effector selection.
    #[address(0x30)]
    pub ID: InputDeviceId,
}

#[cfg(backend = "rust")]
epilogue for InputDeviceId r#"
impl InputDeviceId {
    /// Returns the packed device identity exactly as stored by the engine.
    pub fn raw_value(&self) -> u32 {
        self.raw
    }

    /// Returns the device class encoded in the identity's low nibble.
    pub fn device_type(&self) -> DeviceType {
        match self.raw & 0xF {
            0x0 => DeviceType::Default,
            0x1 => DeviceType::Keyboard,
            0x2 => DeviceType::Mouse,
            0x3 => DeviceType::Joystick,
            0x4 => DeviceType::Gamepad,
            0x5 => DeviceType::Memorycard,
            0x6 => DeviceType::Microphone,
            0x7 => DeviceType::Headphone,
            0x8 => DeviceType::Unknown,
            _ => DeviceType::Unknown,
        }
    }

    /// Returns the signed hardware index used by the manager's hardware-index lookup. The engine
    /// compares this as `(ID * 4) >> 19`, which is an arithmetic `ID >> 17`.
    pub fn hardware_index(&self) -> i32 {
        ((self.raw << 2) as i32) >> 19
    }

    /// Returns the device selector passed to an action-map effector lookup. The high part identifies
    /// the device class, and the low part is the signed packed-ID component `(ID << 15) >> 19`.
    pub fn action_device_index(&self) -> i32 {
        ((self.raw & 0xF) << 16) as i32 | (((self.raw << 15) as i32) >> 19)
    }
}
"#;

#[singleton(0x142_E2B_6F8), size(0x78)]
pub type InputDeviceManager {
    vftable {
        pub fn Destructor(&mut self);
    },

    #[address(0xC)]
    pub m_Enabled: bool,
}
impl InputDeviceManager {
    /// Finds a device of `device_type`. With [`DeviceOrder::Appearance`], `index` selects the
    /// matching device's position among devices of that class. With [`DeviceOrder::HardwareIndex`],
    /// `index` selects the packed hardware index in [`InputDevice::ID`]. Returns null when no device
    /// matches.
    #[address(0x140_2F1_F00)]
    pub fn GetDevice(&mut self, device_type: DeviceType, index: i32, order: DeviceOrder) -> *mut InputDevice;

    /// The per-frame device poll: reads all devices and refreshes their effector states (see
    /// [`InputDeviceEffector`](input::input_action_map::InputDeviceEffector)). `CGameState::PreUpdate`
    /// calls it, then [`UpdateForceClicks`](Self::UpdateForceClicks), before the frame's world
    /// update. The poll overwrites effector values written before it runs, and skips the devices when
    /// the clock's real time is unchanged since the previous poll.
    #[address(0x140_2F2_0C0)]
    pub fn Update(&mut self, dt: f32);

    /// Applies the force-click flags latched on effectors so an injected click survives the poll.
    #[address(0x140_2F2_050)]
    pub fn UpdateForceClicks(&mut self);
}
