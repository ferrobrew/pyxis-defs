use hash::HashString;
use input::input_action_map::Action;

/// `CButtonMapping::EMapping`: a semantic button mapping, indexing
/// [`ButtonMapping::m_AllInfo`]. The `MAPPING_*` values are grouped into per-context sections
/// (generic, on foot, context-specific on foot, each vehicle class, UI, weaponized wingsuit, and
/// mech); each section ends with an `END_*` marker slot that stays at the constructor default, and
/// the `FIRST_*` / `LAST_*` constants give each section's inclusive bounds for the range queries.
/// [`ButtonMapping::PopulateMappings`] hardcodes every entry.
#[copyable]
pub enum Mapping: u32 {
    pub const FIRST_GENERIC_MAPPING: Mapping = Mapping::MAPPING_PAUSE,
    pub const LAST_GENERIC_MAPPING: Mapping = Mapping::MAPPING_COMMLINK,
    pub const FIRST_ON_FOOT_MAPPING: Mapping = Mapping::MAPPING_FIRE_GRAPPLING_HOOK,
    pub const LAST_ON_FOOT_MAPPING: Mapping = Mapping::MAPPING_WALK,
    pub const FIRST_CONTEXT_SPECIFIC_ON_FOOT_MAPPING: Mapping = Mapping::MAPPING_RELEASE_TETHERS_WITH_RETRACT,
    pub const LAST_CONTEXT_SPECIFIC_ON_FOOT_MAPPING: Mapping = Mapping::MAPPING_KEEP_RAGDOLLING,
    pub const FIRST_GENERIC_VEHICLE_MAPPINGS: Mapping = Mapping::MAPPING_LOOK_BACK_CAM,
    pub const LAST_GENERIC_VEHICLE_MAPPINGS: Mapping = Mapping::MAPPING_VEHICLE_RELEASE_GRAPPLE,
    pub const FIRST_GENERIC_LAND_VEHICLE_MAPPINGS: Mapping = Mapping::MAPPING_HANDBRAKE,
    pub const LAST_GENERIC_LAND_VEHICLE_MAPPINGS: Mapping = Mapping::MAPPING_SOUND_HORN_SIREN_LAND_VEHICLE,
    pub const FIRST_CAR_MAPPINGS: Mapping = Mapping::MAPPING_TURN_LEFT,
    pub const LAST_CAR_MAPPINGS: Mapping = Mapping::MAPPING_STUNT_JUMP_CAR,
    pub const FIRST_MOTORCYCLE_MAPPINGS: Mapping = Mapping::MAPPING_FIRE_WEAPON_MOTORCYCLE,
    pub const LAST_MOTORCYCLE_MAPPINGS: Mapping = Mapping::MAPPING_LEAN_RIGHT_MOTORCYCLE,
    pub const FIRST_GENERIC_SEA_VEHICLE_MAPPINGS: Mapping = Mapping::MAPPING_NITROUS_SEA_VEHICLE,
    pub const LAST_GENERIC_SEA_VEHICLE_MAPPINGS: Mapping = Mapping::MAPPING_SOUND_HORN_SIREN_SEA_VEHICLE,
    pub const FIRST_BOAT_MAPPINGS: Mapping = Mapping::MAPPING_FIRE_VEHICLE_WEAPON_PRIMARY_BOAT,
    pub const LAST_BOAT_MAPPINGS: Mapping = Mapping::MAPPING_STUNT_JUMP_BOAT,
    pub const FIRST_JETSKI_MAPPINGS: Mapping = Mapping::MAPPING_FIRE_WEAPON_JETSKI,
    pub const LAST_JETSKI_MAPPINGS: Mapping = Mapping::MAPPING_HOLSTER_WEAPON_JETSKI,
    pub const FIRST_GENERIC_AIR_VEHICLE_MAPPINGS: Mapping = Mapping::MAPPING_FIRE_VEHICLE_WEAPON_PRIMARY_AIR_VEHICLE,
    pub const LAST_GENERIC_AIR_VEHICLE_MAPPINGS: Mapping = Mapping::MAPPING_FIRE_VEHICLE_WEAPON_SECONDARY_AIR_VEHICLE,
    pub const FIRST_HELICOPTER_MAPPINGS: Mapping = Mapping::MAPPING_HELI_INC_ALTITUDE,
    pub const LAST_HELICOPTER_MAPPINGS: Mapping = Mapping::MAPPING_NITROUS_HELICOPTER,
    pub const FIRST_PLANE_MAPPINGS: Mapping = Mapping::MAPPING_PLANE_TURN_RIGHT,
    pub const LAST_PLANE_MAPPINGS: Mapping = Mapping::MAPPING_NITROUS_PLANE,
    pub const FIRST_UI_MAPPING: Mapping = Mapping::MAPPING_UI_OK,
    pub const LAST_UI_MAPPING: Mapping = Mapping::MAPPING_UI_PAGE_PREV,
    pub const FIRST_WEAPONIZED_WINGSUIT_MAPPING: Mapping = Mapping::MAPPING_WEAPONIZED_WINGSUIT_TAKEOFF,
    pub const LAST_WEAPONIZED_WINGSUIT_MAPPING: Mapping = Mapping::MAPPING_WEAPONIZED_WINGSUIT_SECONDARY_WEAPON,
    pub const FIRST_MECH_MAPPING: Mapping = Mapping::MAPPING_MECH_MOVE_FORWARD,
    pub const LAST_MECH_MAPPING: Mapping = Mapping::MAPPING_MECH_FIRE_RIGHT_HAND_WEAPON,

    MAPPING_PAUSE = 0x0,
    MAPPING_COMMLINK = 0x1,
    END_GENERIC_MAPPINGS = 0x2,
    MAPPING_FIRE_GRAPPLING_HOOK = 0x3,
    MAPPING_RETRACT_TETHERS = 0x4,
    MAPPING_RELEASE_TETHERS_NON_CHORDED = 0x5,
    MAPPING_FIRE_RIGHT = 0x6,
