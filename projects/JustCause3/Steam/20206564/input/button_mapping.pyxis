    END_CONTEXT_SPECIFIC_ON_FOOT_MAPPINGS = 0x2C,
    MAPPING_LOOK_BACK_CAM = 0x2D,
    MAPPING_RECENTER_CAM = 0x2E,
    MAPPING_EXIT_VEHICLE = 0x2F,
    MAPPING_ATTACHED_TO_PARACHUTE = 0x30,
    MAPPING_TOGGLE_MAGNET = 0x31,
    MAPPING_VEHICLE_RELEASE_GRAPPLE = 0x32,
