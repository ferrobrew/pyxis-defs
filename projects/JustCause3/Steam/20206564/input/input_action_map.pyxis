use types::std_vector::Vector;

/// The digital state of an [`InputDeviceEffector`].
#[copyable]
pub enum EffectorState: u32 {
    /// Idle, with no input this frame.
    Idle = 0x0,
    /// Idle, in the alternate idle slot.
    Idle2 = 0x1,
    /// Clicked this frame: a one-frame press edge.
    Clicked = 0x2,
    /// Pressed or held.
    Pressed = 0x3,
    /// Released this frame.
    Released = 0x4,
    /// Held latched by [`Freeze`](InputDeviceEffector::Freeze), ignoring the device poll.
    Frozen = 0x5,
}

/// One input effector slot. The pointer [`InputActionMap::GetActionEffector`] returns is the head of a
/// linked-list node whose extra id / next fields follow this struct; reading the effector itself uses
/// only these fields.
///
/// The device poll (`CInputDeviceEffector::Update`) runs once per
/// [`InputDeviceManager::Update`](input::input_device_manager::InputDeviceManager::Update) for every
/// effector bound to a device. It overwrites [`m_Value`](Self::m_Value) with the device's reading and
/// advances [`m_State`](Self::m_State) against the device's button threshold:
/// [`Idle`](EffectorState::Idle) moves to [`Idle2`](EffectorState::Idle2);
/// [`Idle2`](EffectorState::Idle2) accumulates [`m_StateTime`](Self::m_StateTime) and becomes
/// [`Clicked`](EffectorState::Clicked) above the threshold; [`Clicked`](EffectorState::Clicked)
/// zeroes the time and becomes [`Pressed`](EffectorState::Pressed) or
/// [`Released`](EffectorState::Released); [`Pressed`](EffectorState::Pressed) accumulates the time
/// and becomes [`Released`](EffectorState::Released) at or below the threshold; and
/// [`Released`](EffectorState::Released) becomes [`Clicked`](EffectorState::Clicked) or
/// [`Idle`](EffectorState::Idle). The readers report [`m_StateTime`](Self::m_StateTime) as the time
/// pressed only in [`Pressed`](EffectorState::Pressed), and as the time pressed before release
/// only in [`Released`](EffectorState::Released); "pressed" means
/// [`Pressed`](EffectorState::Pressed) or [`Clicked`](EffectorState::Clicked).
///
/// The `m_Value`, `m_State`, and `m_StateTime` offsets are confirmed against their uses.
#[size(0x14), align(4)]
pub type InputDeviceEffector {
    /// The analog value, e.g. trigger pressure or stick axis. [`Click`](Self::Click)
    /// sets it to `1.0`.
    pub m_Value: f32,
    pub m_PrevValue: f32,
    pub m_State: EffectorState,
    pub m_IsAnalogue: bool,
    pub m_IsDeltaBased: bool,
    pub m_IsUpdated: bool,
    /// Injects a click that survives the next device poll.
    pub m_ForceClick: bool,
    pub m_StateTime: f32,
}
impl InputDeviceEffector {
    /// Drives a one-frame press edge: sets `m_Value` to `1.0` and the state to
    /// [`EffectorState::Clicked`].
    #[address(0x140_2EE_630)]
    pub fn Click(&mut self);

    /// Sets `m_Value` and drives the [`EffectorState::Pressed`] state, zeroing
    /// [`m_PrevValue`](Self::m_PrevValue) and [`m_StateTime`](Self::m_StateTime). The next device
    /// poll moves a pressed effector whose device reads nothing to
    /// [`EffectorState::Released`], so a press repeated every frame reads as pressed with a hold
    /// time that never grows. Does nothing on the [`null_effector`].
    #[address(0x140_2EE_660)]
    pub fn Press(&mut self, value: f32);

    /// Latches into [`EffectorState::Frozen`], ignoring the device poll until cleared.
    #[address(0x140_2EE_6B0)]
    pub fn Freeze(&mut self);

    /// Sets `m_ForceClick` so the click survives the next per-frame poll.
    #[address(0x140_2EE_6D0)]
    pub fn ForceClick(&mut self);
}

