use aim::target::FactionRelation;

/// How a character of faction `from` stands toward one of faction `to`, from the game's faction
/// table: [`E_RELATION_ALLIED`](FactionRelation::E_RELATION_ALLIED),
/// [`E_RELATION_HOSTILE`](FactionRelation::E_RELATION_HOSTILE), or
/// [`E_RELATION_NONE`](FactionRelation::E_RELATION_NONE) when the table is not loaded or either
/// faction is not in it. Factions are those
/// [`Character::GetFaction`](character::character::Character::GetFaction) returns. The player aim's
/// target relation ([`Target::m_PlayerFactionRelation`](aim::target::Target::m_PlayerFactionRelation))
/// is this from the player's faction to the target's.
#[address(0x140_4CF_0B0)]
pub fn GetRelation(from: i32, to: i32) -> FactionRelation;
